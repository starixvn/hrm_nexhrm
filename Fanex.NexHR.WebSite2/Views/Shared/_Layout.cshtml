@using Fanex.NexHR.Core;

<!DOCTYPE html>
<html xml:lang="en" lang="en">
<head>
    <meta charset="utf-8" />
    <title>@AppSetting.HRMName - @ViewBag.Title</title>
    <meta name="viewport" content="width=device-width" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
   @* @Styles.Render("~/Content/sitecss")
    @RenderSection("css", false)*@
</head>
<body class="locale_en production">
    <header>
       @* @Html.Action("Header", "UI")
        <ul id="nav-mobile" class="side-nav fixed">
            @Html.Action("NavBar", "UI")
        </ul>*@
    </header>
    <main>
        <section id="section_content">
            <div class="content_wrap">
                <section id="section_breadcrumb">
                    <div class="separator js-separator">
                        <div class="js-view-title separator-view-title" id="view_title">
                            <div class="breadcrumb">
                                @RenderSection("Breadcrumb", required: false)
                            </div>
                        </div>
                        <div class="js-menu separator-menu">
                            @RenderSection("SeparatorMenu", required: false)
                        </div>
                    </div>
                </section>
                <section id="section_body">
                    <div class="content_scroll">
                        <div class="loading-process" style="display: none"></div>
                        @RenderBody()
                    </div>
                </section>
            </div>
        </section>
        <div class="right_wrap">
            @RenderSection("Right", required: false)
        </div>
    </main>
    <footer></footer>
    <div id="message">
    </div>
    @*<script type="text/javascript">
        var isHRRole = '@Roles.IsUserInRole("HR")' === 'True';
    </script>*@
    @*@Scripts.Render("~/bundles/sitejs")
    @RenderSection("js", false)
    @Html.Action("GlobalScript", "UI")*@
</body>
</html>

