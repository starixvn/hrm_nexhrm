@helper NagivationItem(string controllerName, string actionName, string title, string iconName = "star")
    {
     
        controllerName = controllerName.ToLower();
        actionName = actionName.ToLower();
        string selected = string.Empty;
        if (
            ViewBag.Controller.ToString().Equals(controllerName, StringComparison.OrdinalIgnoreCase)
            &&
            ViewBag.Action.ToString().Equals(actionName, StringComparison.OrdinalIgnoreCase)
            )
        {
            selected = " selected";
        }
    
    <div id="@(controllerName + "_" + actionName)" class="el @selected">
        <span class="icon @iconName"></span>@Html.ActionLink(title, actionName, controllerName)
    </div>
}
