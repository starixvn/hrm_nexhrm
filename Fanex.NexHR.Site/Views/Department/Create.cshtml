@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.DepartmentViewModel
@{
	ViewBag.Title = @Labels.Create;
}
@section css{
	@Url.CombresLink("departmentcss")
}
@section js{
	@Url.CombresLink("departmenteditjs")
}
@section Breadcrumb {
	<span class="step">@Labels.HRSpace</span>
	<a href="@Url.Action("index", "department")" class="step">@Labels.DepartmentManagement</a>
	<span class="step">@ViewBag.Title</span>
}
<h2>@Labels.Create</h2>

@using (Html.BeginForm())
{
	<div class="bunhat">
	@Html.ValidationSummary(true)
	@if (ViewBag.Inserted != null && ViewBag.Inserted == true)
	{
		<div class="success">@Messages.CreatedSuccessfully</div> 
	}

	@Html.HiddenFor(model => model.ManagerId)

	<div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.Code)
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Code)
			@Html.ValidationMessageFor(model => model.Code)
		</div>
	</div>

	<div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.Name)
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Name)
			@Html.ValidationMessageFor(model => model.Name)
		</div>
	</div>

	<div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.ManagerName)
		</div>
		<div class="input">
			@Html.TextBox("Manager", string.Empty, new { placeholder = Messages.SearchEmployeeWatermark })
		</div>
	</div>

	<div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.ParentId)
		</div>
		<div class="input">
			@Html.DropDownListFor(model => model.ParentId, new SelectList(ViewBag.Departments, "DepartmentId", "Name"), "-- " + @Messages.SelectParent + " --")
		</div>
	</div>

	<div class="formrow">
		<div class="label">

		</div>
		<div class="input">
			<input type="submit" value="@Labels.Add"/>
			<a href="@Url.Action("index", "department")" class="button">@Labels.Back</a>
		</div>
	</div>

</div>
}
