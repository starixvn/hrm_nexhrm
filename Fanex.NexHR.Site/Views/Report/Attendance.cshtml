@using Fanex.NexHR.Core;
@model Fanex.NexHR.ViewModels.EmployeeAttendanceViewModel
@{
    ViewBag.Title = "Attendance report";
}

@section css{
    @Url.CombresLink("attendancereportcss")
}
@section js{
    @Url.CombresLink("attendancereportjs")
}

@section Breadcrumb {
    <span class="step">Company Space</span> <span class="step">@ViewBag.Title</span>
}

<h2>Attendance report</h2>

<div class="container_24 bunhat">
    @using (Html.BeginGetForm())
    {
        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
        <div class="grid_20">
        <div class="grid_2 gridlabel">
            @Labels.DateRange
        </div>
        <div class="grid_4">
            <select id="Date" name="Date">
                <option value="0">
                    @Labels.DateRange</option>
                <option value="1">
                    @Labels.ToDay</option>
                <option value="2">
                    @Labels.Yesterday</option>
                <option value="3">
                    @Labels.CurrentWeek</option>
                <option value="4">
                    @Labels.LastWeek</option>
                <option value="5">
                    @Labels.CurrentMonth</option>
                <option value="6">
                    @Labels.LastMonth</option>
                <option value="7">
                    @Labels.SinceLastMonth</option>
            </select>
            @Html.Hidden("DateOption", Model.DateOption)
        </div>
        <div class="grid_2">
            @Labels.FromDate
        </div>
        <div class="grid_4">
            @Html.DatePicker("FromDate", Model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now.AddMonths(4))
        </div>
        <div class="grid_2">
            @Labels.ToDate
        </div>
        <div class="grid_4">
            @Html.DatePicker("ToDate", Model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now.AddMonths(4))
        </div>
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_20">
        <div class="grid_2">
            @Html.LabelFor(model => model.AttendanceType, "Request")
        </div>
        <div class="grid_4">
            @{
        var types = new List<SelectListItem>
                {
                    new SelectListItem() {Text = "All", Value = "0"}, 
                    new SelectListItem() {Text = "Checkin", Value = "1"},
                    new SelectListItem() {Text = "Checkout", Value = "2"},
                    new SelectListItem() {Text = "Late in", Value = "3"},
                    new SelectListItem() {Text = "Early out", Value = "4"},
                    new SelectListItem() {Text = "Not working", Value = "5"},
                };
            }
            @Html.DropDownListFor(model => model.AttendanceType, types)
        </div>
        
        <div class="grid_2">
            @Labels.Team
        </div>
        <div class="grid_4">
            <select id="GroupId" name="GroupId">
                <option value="">@Labels.AllTeams</option>
                @foreach (Fanex.NexHR.Models.Team item in ViewBag.Groups)
                { 
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </div>
        <div class="grid_2">
            @Html.LabelFor(model => model.EmpId)
        </div>
        <div class="grid_4">
            @Html.TextBox("Employee", Model.Employee, new { placeholder = @Fanex.NexHR.Resources.Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmpId)
            @Html.ValidationMessageFor(model => model.EmpId)
        </div>
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_20">
        <div class="grid_2">&nbsp</div>
        <div class="grid_4">
            @Html.CheckBoxFor(model => model.ExcludeUserDelete)
            <label for="ExcludeUserDelete"> Exclude Users deleted </label>
        </div>
        
        <div class="grid_2">&nbsp</div>
        
        <div class="grid_5">
            <input type="button" value="@Labels.Submit" id="view"/>
            <input type="button" value="@Labels.Excel" id="exportExcel"/>
        </div>
        </div>
        <div class="clear"></div>
    }
</div>

<div class="clear"></div>
<div class="space"></div>

<table id="data" class="data persist-area">
    <thead>
        <tr class = "persist-header">
            <th>
                #
            </th>
            <th>
                @Labels.Date
            </th>
            <th>
                @Labels.Code
            </th>
            <th>
                @Labels.Nick
            </th>
            <th>
                @Labels.FullName
            </th>
            <th>
                @Labels.Team
            </th>
            <th>
                @Labels.Shift
            </th>
            <th>
                @Labels.CheckIn
            </th>
            <th>
                @Labels.CheckOut
            </th>
            <th>
                @Labels.TotalHours
            </th>
            <th>
                @Labels.LateIn
            </th>
            <th>
                @Labels.EarlyOut
            </th>
            <th>
                @Labels.Request
            </th>
            <th>
                @Labels.Note
            </th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
<script id="itemTemplate" type="text/x-jquery-tmpl">
    <tr {{if IsNotWork != 0}}class="offdate"{{else ShiftId}} {{else}} class="noshift"{{/if}}>
        <td>${index()}</td>
        <td class="ddMMyyyy">
            ${jsonToShortDate(AttendanceDate)}
        </td>
        <td>
            ${Code}
        </td>
        <td title="${FullName}" class="left tooltip">
            ${NickName}
        </td>
        <td class="left">
            ${FullName}
        </td>
        <td class="tooltip" title="${Team}">
            ${TeamCode}
        </td>
        <td>
            ${ShiftCode}
        </td>
        <td>
            {{if InFixed}}${jsonTojsDate(InFixed).format("HH:MM")}{{/if}}
        </td>
        <td>
            {{if OutFixed}}${jsonTojsDate(OutFixed).format("HH:MM")}{{/if}}
        </td>
        <td>
            {{if TotalWorkHours > 0}}
                ${totalHoursToTime(TotalWorkHours)}
            {{/if}}
        </td>
        <td>
            {{if LateIn > 0}}
                ${displayMinute(LateIn)}
            {{/if}}
        </td>
        <td>
            {{if EarlyOut > 0}}
                ${displayMinute(EarlyOut)}
            {{/if}}
        </td>
        <td class='left'>
            {{if Requests != null > 0}}
                {{each Requests}}
                    <a href='javascript:;' class="tooltip-request req" 
                            data-requesttype="${RequestType.Id}"
                            data-fromdate="${FromDate}"
                            data-todate="${ToDate}" 
                            data-createddate="${CreatedDate}" 
                            data-fromshift="${FromShift.Name}"
                            {{if ToShift != null}} data-toshift="${ToShift.Name}" {{else}} data-toshift="" {{/if}}
                            data-totaldays="${TotalDays}"
                            data-totalmins="${TotalMins}"
                            data-remark='${Remark}'>
                            {{if RequestType.Id == 6}}  ${RequestType.Name} {{else}} ${RequestType.Name} {{/if}}
                        </a>
                {{/each}}
               
            {{/if}}
        </td>
        <td class="left">
            ${Notes}
        </td>
    </tr>
</script>
