@model Fanex.NexHR.ViewModels.RequestsMonitoringViewModel
@{
    ViewBag.Title = Labels.RequestMonitoring;
}
@section css{
    @Url.CombresLink("requestmonitoringcss")
}
@section js{
    @Url.CombresLink("requestmonitoringjs")
}
@section Breadcrumb {
    @if ((bool)ViewBag.isLeader)
    {
        <a class="step">Personal</a> 
    }
    else
    {
        <a class="step">HR Space</a> 
    }
    <a class="step">@ViewBag.Title</a>
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
    <div class="container_24 bunhat">
        <div class="grid_20">
            <div class="grid_3 gridlabel">
                @Labels.DateRange
            </div>
            <div class="grid_4">
                <select id="Date" name="Date" style="min-width:150px;">
                    <option value="0">
                        @Labels.DateRange</option>
                    <option value="1">
                        @Labels.ToDay</option>
                    <option value="2">
                        @Labels.Yesterday</option>
                    <option value="3">
                        @Labels.CurrentWeek</option>
                    <option value="4">
                        @Labels.LastWeek</option>
                    <option value="5">
                        @Labels.CurrentMonth</option>
                    <option value="6">
                        @Labels.LastMonth</option>
                    <option value="7">
                        @Labels.SinceLastMonth</option>
                </select>
                @Html.Hidden("DateOption", Model.DateOption)
            </div>
            <div class="grid_2 gridlabel">
                @Html.LabelFor(model => model.FromDate)
            </div>
            <div class="grid_4">
                @Html.DatePickerFor(model => model.FromDate)
            </div>

            <div class="grid_2 gridlabel">
                @Html.LabelFor(model => model.ToDate)
            </div>

            <div class="grid_4">
                @Html.DatePickerFor(model => model.ToDate)
            </div>
        </div>
        <div class="clear"></div>
        <div class="space"></div>
        <div class="grid_20">
        <div class="grid_3 gridlabel">@Html.LabelFor(model => model.MaxRequest)</div>
        <div class="grid_4">@RazorHelper.MaxRequestDropDownList(Model.MaxRequest)
        <input type="submit" value="@Labels.Submit" class="processing-submit" style="float:right"/>
        </div>
        </div>
        <div class="clear"></div>
    </div>
    
}
<div class="clear">
</div>
<table class="data persist-area">
    <thead class ="persist-header">
        <tr>
            <th rowspan="2">
                #
            </th>
            <th rowspan="2">@Labels.Name
            </th>
            <th rowspan="2">@Labels.Nick
            </th>
            <th rowspan="2">@Labels.Team
            </th>
            <th colspan="4">@Labels.Leave</th>
            <th colspan="2">@Labels.CheckInOut </th>
            <th rowspan="2">@Labels.LateInEarlyOut (Times)
            </th>
             <th rowspan="2">@Labels.Absent (Times)
            </th>
        </tr>
        <tr>
            <th>Request (Times)</th>
            <th>Annual (Days)</th>
            <th>Unpaid (Days)</th>
            <th>Others (Days)</th>
            <th>Request (Times)</th>
            <th>Missing (Times)</th>
            @* <th> (Times)</th>
            <th> (Times)</th>*@
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.EntityList.Count > 0)
        {
            int index = 1;
            var requestModel = new RequestViewModel();

            foreach (RequestsMonitoring request in ViewBag.EntityList)
            {
                requestModel = new RequestViewModel
                {
                    DateOption = 0,
                    FromDate = ViewBag.FromDate,
                    ToDate = ViewBag.ToDate,
                    EmployeeId = request.Requester.Id,
                    Employee = request.Requester.NickName + " (" + request.Requester.FullName + ")",
                    TeamId = -2,
                    StatusId = (byte)RequestStatuse.Approve,
                    IsFilterByEffectedDate = true
                };

            <tr>
                <td>@(index++)
                </td>
                <td class="left">@request.Requester.FullName
                </td>
                <td>@request.Requester.NickName
                </td>
                <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code
                </td>
                <td class="@(request.TotalLeaveTimes > Model.MaxRequest ? "overloadRequest" : string.Empty)">
                    @if (request.TotalLeaveTimes > 0)
                    {
                        requestModel.RequestType = 1;
                        if ((bool)ViewBag.isLeader)
                        {
                            <a href="@Url.Action("member", "request", requestModel)">@request.TotalLeaveTimes</a>
                        }
                        else
                        {
                            <a href="@Url.Action("hrview", "request", requestModel)">@request.TotalLeaveTimes</a>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="@(request.TotalAnnualLeave > Model.MaxRequest ? "overloadRequest" : string.Empty)">
                    @if (request.TotalAnnualLeave > 0)
                    {
                        requestModel.RequestType = 1;
                        if ((bool)ViewBag.isLeader)
                        {
                            <a href="@Url.Action("member", "request", requestModel)">@request.TotalAnnualLeave.ToString("0.0")</a>
                        }
                        else
                        {
                            <a href="@Url.Action("hrview", "request", requestModel)">@request.TotalAnnualLeave.ToString("0.0")</a>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="@(request.TotalUnpaidLeave > Model.MaxRequest ? "overloadRequest" : string.Empty)">
                    @if (request.TotalUnpaidLeave > 0)
                    {
                        requestModel.RequestType = 1;
                        if ((bool)ViewBag.isLeader)
                        {
                            <a href="@Url.Action("member", "request", requestModel)">@request.TotalUnpaidLeave.ToString("0.0")</a>
                        }
                        else
                        {
                            <a href="@Url.Action("hrview", "request", requestModel)">@request.TotalUnpaidLeave.ToString("0.0")</a>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="@(request.TotalOtherLeave > Model.MaxRequest ? "overloadRequest" : string.Empty)">
                    @if (request.TotalOtherLeave > 0)
                    {
                        requestModel.RequestType = 1;
                        if ((bool)ViewBag.isLeader)
                        {
                            <a href="@Url.Action("member", "request", requestModel)">@request.TotalOtherLeave.ToString("0.0")</a>
                        }
                        else
                        {
                            <a href="@Url.Action("hrview", "request", requestModel)">@request.TotalOtherLeave.ToString("0.0")</a>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="@(request.TotalCheckInOutTimes > Model.MaxRequest ? "overloadRequest" : string.Empty)">
                    @if (request.TotalCheckInOutTimes > 0)
                    {
                        requestModel.RequestType = 4;
                        if ((bool)ViewBag.isLeader)
                        {
                            <a href="@Url.Action("member", "request", requestModel)">@request.TotalCheckInOutTimes</a>
                        }
                        else
                        {
                            <a href="@Url.Action("hrview", "request", requestModel)">@request.TotalCheckInOutTimes</a>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="@(request.TotalMissingCheckInOutTimes > Model.MaxRequest ? "overloadRequest" : string.Empty)">
                    @if (request.TotalMissingCheckInOutTimes > 0)
                    {
                        var model = new EmployeeAttendanceViewModel() 
                        { 
                            EmpId = request.Requester.Id,
                            Employee = request.Requester.DisplayName,
                            FromDate = ViewBag.FromDate,
                            ToDate = ViewBag.ToDate
                        };
                        <a href="@Url.Action("attendance", "report", model)">@request.TotalMissingCheckInOutTimes</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="@(request.LateInEarlyOutTimes > Model.MaxRequest ? "overloadRequest" : string.Empty)">
                    @if (request.LateInEarlyOutTimes > 0)
                    {
                        var model = new EmployeeAttendanceViewModel()
                        {
                            EmpId = request.Requester.Id,
                            Employee = request.Requester.DisplayName,
                            FromDate = ViewBag.FromDate,
                            ToDate = ViewBag.ToDate
                        };
                        <a href="@Url.Action("attendance", "report", model)">@request.LateInEarlyOutTimes</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="@(request.TotalAbsent > Model.MaxRequest ? "overloadRequest" : string.Empty)">
                    @if (request.TotalAbsent > 0)
                    {
                        var model = new EmployeeAttendanceViewModel()
                        {
                            EmpId = request.Requester.Id,
                            Employee = request.Requester.DisplayName,
                            FromDate = ViewBag.FromDate,
                            ToDate = ViewBag.ToDate
                        };
                        <a href="@Url.Action("attendance", "report", model)">@request.TotalAbsent</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
            </tr>
            }
        }
        else
        { 
            @RazorHelper.DisplayNoInformation(colspan: 12);
        }
    </tbody>
</table>
