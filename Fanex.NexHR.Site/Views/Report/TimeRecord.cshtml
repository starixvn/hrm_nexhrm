@using Fanex.NexHR.ViewModels
@model TimeRecordViewModel
@{
    ViewBag.Title = @Labels.TimeRecord;
}
@section css{
    @Url.CombresLink("timerecordcss")
}
@section js{
    @Url.CombresLink("timerecordjs")
}
@section Breadcrumb {
    <a class="step">Company Space</a> <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
<div class="clear">
</div>

<div class="container_24 bunhat">
    @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
    <div class="grid_19">
        <div class="grid_2 gridlabel">
            @Labels.DateRange
        </div>
        <div class="grid_4">
            <select id="Date" name="Date">
                <option value="0">
                    @Labels.DateRange</option>
                <option value="1">
                    @Labels.ToDay</option>
                <option value="2">
                    @Labels.Yesterday</option>
                <option value="3">
                    @Labels.CurrentWeek</option>
                <option value="4">
                    @Labels.LastWeek</option>
                <option value="5">
                    @Labels.CurrentMonth</option>
                <option value="6">
                    @Labels.LastMonth</option>
                <option value="7">
                    @Labels.SinceLastMonth</option>
            </select>
            @Html.Hidden("DateOption", Model.DateOption)
        </div>

        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.FromDate)
        </div>
        <div class="grid_4">
            @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>

        <div class="grid_2 gridlabel">
            @Html.LabelFor(model => model.ToDate)
        </div>
        <div class="grid_4">
            @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
        </div>
    </div>
    <div class="clear"></div>
    <div class="space"></div>
    <div class="grid_19">
    <div class="grid_2 gridlabel">
        @Html.LabelFor(model => model.TeamIds)
    </div>
    <div class="grid_4">
        <select id="GroupId" name="GroupId">
            <option value="">@Labels.AllTeams</option>
            @foreach (Team item in Model.Teams)
            { 
                <option value="@item.Id">@item.Name</option>
            }
        </select>
    </div>

    <div class="grid_2">
        @Html.LabelFor(model => model.Employee)
    </div>
    <div class="grid_4">
        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
        @Html.HiddenFor(model => model.EmployeeId)
    </div>

    <div class="grid_5">
        <input id="btnSubmit" type="button" value="@Labels.Submit"/>
    </div>
    </div>
    <div class="clear"></div>
</div>
<div class="clear">
</div>
<div class="space">
</div>
<div id="TimeRecordContent"></div>

<ul id="outMenu" class="hide">
    <li class="out"><a command="out" href="javascript:;">@Labels.Out</a>
    </li>
</ul>
<ul id="inMenu" class="hide">
    <li class="in"><a command="in" href="javascript:;">@Labels.In</a>
    </li>
</ul>
<ul id="inOutMenu" class="hide">
    <li class="in"><a command="in" href="javascript:;">@Labels.In</a>
    </li>
    <li class="out"><a command="out" href="javascript:;">@Labels.Out</a>
    </li>
</ul>