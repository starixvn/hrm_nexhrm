@model HRLeaderDashboardModel
<h2 class="section">
    @Labels.MyMemberRequest</h2>
<table class="data" id="myspace">
    <thead>
        <tr>
            <th rowspan="2" class="firstColumn">@Labels.Request
            </th>
            <th rowspan="2">@Labels.Pending
            </th>
            <th colspan="2" class="center">
                @Labels.CurrentMonth
            </th>
            <th colspan="2" class="center">
                @Labels.LastMonth
            </th>
        </tr>
        <tr>
            <th>@Labels.Approved
            </th>
            <th>@Labels.Rejected
            </th>
            <th>@Labels.Approved
            </th>
            <th>@Labels.Rejected
            </th>
        </tr>
    </thead>
    <tbody>
    @{
        var requestModel = new RequestViewModel
        {
            DateOption = 0,
            FromDate = Model.FromDateLeave > Model.FromDateCheckInOut ? Model.FromDateCheckInOut : Model.FromDateLeave,
            ToDate = Model.ToDateLeave > Model.ToDateCheckInOut ? Model.ToDateLeave : Model.ToDateCheckInOut,
            StatusId = (byte)RequestStatuse.Pending,
            TeamId = -2,
            IsFilterByEffectedDate = true
        };
    }
        <tr>
            <td class="firstColumn">@Labels.Leave
            </td>
            <td>
                @if (Model.LeavePending > 0)
                {
                    requestModel.RequestType = 1;
                    <a href="@Url.Action("member", "request", requestModel)">@Model.LeavePending.ToString()</a>
                }
                else
                {
                    <span>0</span>
                }
            </td>
            <td>@Model.LeaveApprovedCurrentMonth
            </td>
            <td>@Model.LeaveRejectedCurrentMonth
            </td>
            <td>@Model.LeaveApprovedLastMonth
            </td>
            <td>@Model.LeaveRejectedLastMonth
            </td>
        </tr>
        <tr>
            <td class="firstColumn">@Labels.CheckInOut
            </td>
            <td>
                @if (Model.CheckInOutPending > 0)
                {
                    requestModel.RequestType = 4;
                    <a href="@Url.Action("member", "request", requestModel)">@Model.CheckInOutPending.ToString()</a>
                }
                else
                {
                    <span>0</span>
                }
            </td>
            <td>@Model.CheckInOutApprovedCurrentMonth
            </td>
            <td>@Model.CheckInOutRejectedCurrentMonth
            </td>
            <td>@Model.CheckInOutApprovedLastMonth
            </td>
            <td>@Model.CheckInOutRejectedLastMonth
            </td>
        </tr>
    </tbody>
</table>
