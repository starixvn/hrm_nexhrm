@model Fanex.NexHR.Models.EmployeeShift 

@if (Model != null)
{
    ViewBag.Title = "Working schedule of " + ViewBag.Employee.NickName;
}

@section css{
    @Url.CombresLink("employeewscss")
}
@section js{
    @Url.CombresLink("employeewsjs")
}

@section Breadcrumb {
    <span class="step">HR Space</span>
    <a class="step" href="@Url.Action("usermanagement", "employee")">User management</a>

    @if(Model != null)
    {
        <span class="step">@ViewBag.Title</span>
    }
}

@if (Model != null)
{
    <script>
        var id = @ViewBag.Employee.Id;
    </script>

    <h2>Working schedule of @ViewBag.Employee.NickName</h2>
    <div class="container_24">
    @using (Html.BeginForm())
    {

        @Html.ValidationSummary(true)
        if (ViewBag.Updated == true)
        {
            <div class="success flash">@Messages.Saved</div> 
        }
    
        <div class="section">
            <input id="scheduledefault" type="radio" name="schedule" />
            <label for="scheduledefault">Default working schedule</label>

            <input id="schedulemonth" type="radio" name="schedule" />
            <label for="schedulemonth">Edit by month</label>
        </div>
    
        <div class="clear"></div>
    
        <div class="grid_3">
            Sun<br />
            @(ViewBag.WeekWorking != null ? ViewBag.WeekWorking[0].WorkDate.ToShortDateString() : string.Empty)
        </div>
        <div class="grid_3">
            Mon<br />
            @(ViewBag.WeekWorking != null ? ViewBag.WeekWorking[1].WorkDate.ToShortDateString() : string.Empty)
        </div>
        <div class="grid_3">
            Tue<br />
            @(ViewBag.WeekWorking != null ? ViewBag.WeekWorking[2].WorkDate.ToShortDateString() : string.Empty)
        </div>
        <div class="grid_3">
            Wed<br />
            @(ViewBag.WeekWorking != null ? ViewBag.WeekWorking[3].WorkDate.ToShortDateString() : string.Empty)
        </div>
        <div class="grid_3">
            Thu<br />
            @(ViewBag.WeekWorking != null ? ViewBag.WeekWorking[4].WorkDate.ToShortDateString() : string.Empty)
        </div>
        <div class="grid_3">
            Fri<br />
            @(ViewBag.WeekWorking != null ? ViewBag.WeekWorking[5].WorkDate.ToShortDateString() : string.Empty)
        </div>
        <div class="grid_3">
            Sat<br />
            @(ViewBag.WeekWorking != null ? ViewBag.WeekWorking[6].WorkDate.ToShortDateString() : string.Empty)
        </div>
    
        <div class="clear"></div>
    
        <div class="grid_3">
            @RazorHelper.ShiftDropDownList("SunShiftId", Model.SunShiftId, (IList<SelectListItem>)ViewBag.Shifts)
        </div>
        <div class="grid_3">
            @RazorHelper.ShiftDropDownList("MonShiftId", Model.MonShiftId, (IList<SelectListItem>)ViewBag.Shifts)
        </div>
        <div class="grid_3">
            @RazorHelper.ShiftDropDownList("TueShiftId", Model.TueShiftId, (IList<SelectListItem>)ViewBag.Shifts)
        </div>
        <div class="grid_3">
            @RazorHelper.ShiftDropDownList("WedShiftId", Model.WedShiftId, (IList<SelectListItem>)ViewBag.Shifts)
        </div>
        <div class="grid_3">
            @RazorHelper.ShiftDropDownList("ThuShiftId", Model.ThuShiftId, (IList<SelectListItem>)ViewBag.Shifts)
        </div>
        <div class="grid_3">
            @RazorHelper.ShiftDropDownList("FriShiftId", Model.FriShiftId, (IList<SelectListItem>)ViewBag.Shifts)
        </div>
        <div class="grid_3">
            @RazorHelper.ShiftDropDownList("SatShiftId", Model.SatShiftId, (IList<SelectListItem>)ViewBag.Shifts)
        </div>
        <div class="clear"></div>
    
        <div>
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.EmpId)
            <input type="submit" value="@Labels.Save" />
        </div>

    }
    </div>
}
else
{
    <h2>@Messages.NoDataIsAvailable</h2>
}