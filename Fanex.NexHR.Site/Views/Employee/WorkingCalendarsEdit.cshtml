@model Fanex.NexHR.ViewModels.ChangeWorkingCalendarsViewModel
@section css{
    @Url.CombresLink("workingcalendarscss")
}
@section js{
    @Url.CombresLink("workingcalendarsjs")
}
@{
    ViewBag.Title = Labels.ChangeWorkingDayForWholeCompany;
}

@section Breadcrumb {
    <span class="step">Company Space</span><a href="@Url.Action("workingcalendars", "employee")" class="step">Company Space</a>
    <span class="step">@ViewBag.Title</span>
}

<h2>@ViewBag.Title</h2>

<div class="bunhat">
@using (Html.BeginForm())
{
        @Html.ValidationSummary()
        if (ViewBag.Requested == true)
        {
        <div class="success">@Fanex.NexHR.Resources.Messages.Saved</div>
        <input type="hidden" id="successed" value="true" />
        }

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model=>model.Date, Labels.Date)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.Date)
            </div>
            <div class="clear">
            </div>
        </div> 
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model=>model.IsOfDay, Labels.DateType)
            </div>
            <div class="input">
            @{
            var types = new List<SelectListItem>
            {
                new SelectListItem() {Text = Labels.Work, Value = "0"},
                new SelectListItem() {Text = Labels.Off, Value = "1"},
            };      
            }
            @Html.RadioButtonList(model => model.IsOfDay, types)

            </div>
            <div class="clear">
            </div>

            <div class="formrow">
                <div class="label">
                    &nbsp;
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Save" class="button-primary submit"/>
                <a href="@Url.Action("WorkingCalendars", "employee")" class="button">@Labels.Back</a>
            </div>
            <div class="clear">
            </div>
        </div>
        </div> 
}
</div>
