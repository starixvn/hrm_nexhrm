@model Fanex.NexHR.Models.Employee
@{
    ViewBag.Title = "Edit";
}
@section css{
    @Url.CombresLink("employeeeditcss")
}
@section js{
    @Url.CombresLink("employeeeditjs")
}
@section Breadcrumb
{
    <span class="step" href="javascript:;">HR Space</span> <a class="step" href="@Url.Action("usermanagement", "employee")">
        User management</a>
    @if (Model != null)
    {
        <span class="step">Edit @(Model.FullName)'s information</span>
    }
}
@if (Model != null)
{
    using (Html.BeginForm())
    {
@*<script src="http://maps.google.com/maps/api/js?sensor=true" type="text/javascript"></script>*@
    
    <script type="text/javascript" src="http://maps.googleapis.com/maps/api/js?libraries=places&sensor=false"></script>
   
    
    <div class="bunhat">
        @Html.ValidationSummary(true)
        @if (ViewBag.Updated == true)
        {
            <div class="success flash">
                Saved</div> 
        }
        else if (ViewBag.Updated == false)
        { 
            <div class="error flash">@Messages.ErrorTryAgain</div> 
        }
        <div class="formrow">
            <div class="label">
                Avatar
            </div>
            <div class="input">
                <img id="avatar" src="~/employee/avatar/@(Model.Code)?f=@(Fanex.NexHR.Core.Utilities.RandomString(4))" alt="@Model.FullName" /><br />
                <input type="file" id="file" />
                <input type="button" id="upload" value="Upload" />
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Code)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Code)
                @Html.ValidationMessageFor(model => model.Code)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.DomainUsername)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.DomainUsername)
                @Html.ValidationMessageFor(model => model.DomainUsername)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.FullName)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.FullName)
                @Html.ValidationMessageFor(model => model.FullName)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.NickName)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.NickName)
                @Html.ValidationMessageFor(model => model.NickName)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.DOB)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.DOB)
                @Html.ValidationMessageFor(model => model.DOB)
            </div>
            <div class="input" id="DOBPicker">
            </div>
            @Html.HiddenFor(model => model.DOB)
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Email)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Email)
                @Html.ValidationMessageFor(model => model.Email)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.JobTitleId)
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.JobTitleId, new SelectList(ViewBag.JobTitles, "Id", "Name"), new { @style = "width : 230px;" })
                @Html.ValidationMessageFor(model => model.JobTitleId)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Phone)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Phone)
                @Html.ValidationMessageFor(model => model.Phone)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Gender)
            </div>
            <div class="input">
                @{
        var gender = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "Unknown", Value = ""}, 
                        new SelectListItem() {Text = "Female", Value = "0"},
                        new SelectListItem() {Text = "Male", Value = "1"}
                    };
                }
                @Html.DropDownListFor(model => model.Gender, gender)
                @Html.ValidationMessageFor(model => model.Gender)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.CardNo)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.CardNo)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Address)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Address)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.CurrentAddress)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.CurrentAddress)
            </div>
        </div>
        @*Google Map*@
        <div class="formrow">
            <div style="border: 1px solid #ccc; background: #e5e5e5; padding: 10px;">
                <input type="text" id="geoMapAddress" />
                <input type="button" value="find" id="searchmap" />
                Latitude:  @Html.TextBoxFor(model => model.GeoMapLatitude, new { @class = "latlng"})
                Longtitude: @Html.TextBoxFor(model => model.GeoMapLongtitude, new { @class = "latlng"})
                Distance: @Html.TextBoxFor(model => model.DistanceToCompany, new { @class = "distance" }) km
            </div>
            <div id="map-canvas" style="min-width: 930px; height: 500px">
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Team)
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.Team.Id, new SelectList(ViewBag.Groups, "Id", "Name"))
                @Html.ValidationMessageFor(model => model.Team.Id)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.SubGroups)
            </div>
            <div class="input subteam">
                @Html.CheckBoxListFor(p => p.SubGroupArray, new SelectList(ViewBag.Groups, "Id", "Name"))
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.LeaderGroups)
            </div>
            <div class="input subteam">
                @Html.CheckBoxListFor(p => p.LeaderGroupsArray, new SelectList(ViewBag.Groups, "Id", "Name"))
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Roles)
            </div>
            <div class="input">
                @{
        var roles = new List<SelectListItem>
                    {
                        new SelectListItem() {Text = "Assistant leader", Value = "1"},
                        new SelectListItem() {Text = "Leader", Value = "2"},
                        new SelectListItem() {Text = "Human resource", Value = "3"},
                        new SelectListItem() {Text = "System admin", Value = "4"}
                    };
                }
                @Html.CheckBox("Member", true, new { disabled = true })
                @Html.Label("Member", "Member")
                @Html.CheckBoxListFor(model => model.RoleArray, roles)
                @Html.ValidationMessageFor(model => model.RoleArray)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.JoinedDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.JoinedDate)
                @Html.ValidationMessageFor(model => model.JoinedDate)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ConfirmedDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ConfirmedDate)
                @Html.ValidationMessageFor(model => model.ConfirmedDate)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ResignedDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ResignedDate)
                @Html.ValidationMessageFor(model => model.ResignedDate)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Skype)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Skype)
                @Html.ValidationMessageFor(model => model.Skype)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Yahoo)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Yahoo)
                @Html.ValidationMessageFor(model => model.Yahoo)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Mariage, "Marriage")
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Mariage)
                @Html.ValidationMessageFor(model => model.Mariage)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.PassportNo)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.PassportNo)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.PassportExp)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.PassportExp)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                Leave balance
            </div>
            <div class="input">
                @Model.AnnualLeaveBalance day(s) <a href="~/annualleavebalance/employee/@Model.Id">Update</a>
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                Working calendar
            </div>
            <div class="input">
                <a href="~/employee/defaultschedule/@Model.Id">Update</a>
            </div>
        </div>
        <!--TOEIC score-->
        <div class="formrow">
            <div class="label">
                TOEIC score
            </div>
            <div class="input">
                @if (Model.TOEICScore != null)
                {
                    <table>
                        <tr>
                            <td style="padding-right: 10px;">
                                <table class="toeic">
                                    <thead>
                                        <tr>
                                            <th>@Labels.L
                                            </th>
                                            <th>@Labels.R
                                            </th>
                                            <th>@Labels.S
                                            </th>
                                            <th>@Labels.W
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>@(Model.TOEICScore.Listening.HasValue ? Model.TOEICScore.Listening.Value.ToString() : "-")
                                            </td>
                                            <td>@(Model.TOEICScore.Reading.HasValue ? Model.TOEICScore.Reading.Value.ToString() : "-")
                                            </td>
                                            <td>@(Model.TOEICScore.Speaking.HasValue ? Model.TOEICScore.Speaking.Value.ToString() : "-")
                                            </td>
                                            <td>@(Model.TOEICScore.Writing.HasValue ? Model.TOEICScore.Writing.Value.ToString() : "-")
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td>
                                <a id="toeic" href="javascript:;">Update</a>
                            </td>
                        </tr>
                    </table>
                }
                else
                {
                    <a id="toeic" href="javascript:;">Update</a>
                }
            </div>
        </div>
        <!--End of TOEIC score-->
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Enabled)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.Enabled)
                @Html.ValidationMessageFor(model => model.Enabled)
            </div>
        </div>
        <div class="formrow">
            <div class="label">
                &nbsp;
            </div>
            <div class="input">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                <input type="submit" value="Save" />
                <input type="button" id="delete" value="Delete?" />
            </div>
        </div>
    </div>
    }
    <div id="dialog-toeic" title="Update TOEIC Score">
        &nbsp;</div>
}
else
{
    <h2>@Messages.NoDataIsAvailable</h2>
}