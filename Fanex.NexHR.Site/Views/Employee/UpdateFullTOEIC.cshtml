@model Fanex.NexHR.Models.Toeic
@{ DateTime currentDate = DateTime.Today; }
<form id="frmUpdFullTOEIC">
	<div id="divErrorCont" class="">&nbsp;</div>
	<div class="formrow">
		<div class="label">
			@Labels.Employee
		</div>
		<div class="input">
			<input type="text" value="@ViewBag.EmployeeName" disabled />
			@Html.HiddenFor(model => model.EmpId)
		</div>
	</div>
    <div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.InputDate, Labels.ExpiredDate)
		</div>
		<div class="input">
			@Html.DatePickerFor(model => model.InputDate)
			@Html.ValidationMessageFor(model => model.InputDate)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.LRExamDate)
		</div>
		<div class="input">
			@Html.DatePickerFor(model => model.LRExamDate, currentDate.AddYears(-100), currentDate)
			@Html.ValidationMessageFor(model => model.LRExamDate)
		</div>
	</div>
    
	<div class="formrow">
		<div class="label">
			@Labels.NewOldListening
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Listening)
			@Html.ValidationMessageFor(model => model.Listening)
			/
			@Html.EditorFor(model => model.OldListening)
			@Html.ValidationMessageFor(model => model.OldListening)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Labels.NewOldReading
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Reading)
			@Html.ValidationMessageFor(model => model.Reading)
			/
			@Html.EditorFor(model => model.OldReading)
			@Html.ValidationMessageFor(model => model.OldReading)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.SWExamDate)
		</div>
		<div class="input">
			@Html.DatePickerFor(model => model.SWExamDate, currentDate.AddYears(-100), currentDate)
			@Html.ValidationMessageFor(model => model.SWExamDate)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Labels.NewOldSpeaking
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Speaking)
			@Html.ValidationMessageFor(model => model.Speaking)
			/
			@Html.EditorFor(model => model.OldSpeaking)
			@Html.ValidationMessageFor(model => model.OldSpeaking)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Labels.NewOldWriting
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Writing)
			@Html.ValidationMessageFor(model => model.Writing)
			/
			@Html.EditorFor(model => model.OldWriting)
			@Html.ValidationMessageFor(model => model.OldWriting)
		</div>
	</div>
</form>