@model MySpaceViewModel

@section css{
    @Url.CombresLink("mydashboardcss")
}
@section js{
    @Url.CombresLink("mydashboardjs")
}
@{
    ViewBag.Title = "Dashboard";
}

@section Breadcrumb {
    <a class="step" href="#">Personal</a> <span class="step">@ViewBag.Title</span>
}

<h2>@Labels.GeneralInfo</h2>
<table class="data dashboard-company" >
    <thead>
    <tr>
        <th></th>
        <th>@Labels.ToDay</th>
        <th>@Labels.Yesterday</th>
    </tr>
    </thead>
    <tbody >
    <tr>
        <td class="firstColumn">@Labels.LeaveRequests</td>
        <td class="left">
            @Html.Raw(Model.CompanyLeaveToDay)
        </td>
        <td class="left">
            @Html.Raw(Model.CompanyLeaveYesterday)
        </td>
       </tr>
       <tr>
        <td class="firstColumn">@Labels.CheckInOutRequest</td>
        <td class="left">
            @Html.Raw(Model.CompanyCheckInOutToDay)
        </td>
        <td class="left">
            @Html.Raw(Model.CompanyCheckInOutYesterday)
        </td>
       </tr>
       <tr>
        <td class="firstColumn">@Labels.MissingCheckInOut</td>
        <td class="left">@Html.Raw(Model.CompanyMissingCheckInOutToDay)</td>
        <td class="left">@Html.Raw(Model.CompanyMissingCheckInOutYesterday)</td>
       </tr>
       <tr>
        <td class="firstColumn">@Labels.LateInEarlyOut</td>
        <td class="left">@Html.Raw(Model.CompanyLateInEarlyOutToDay)</td>
        <td class="left">@Html.Raw(Model.CompanyLateInEarlyOutYesterday)</td>
       </tr>
        <tr>
        <td class="firstColumn">@Labels.Absent</td>
        <td class="left">@Html.Raw(Model.CompanyAbsentToDay)</td>
        <td class="left">@Html.Raw(Model.CompanyAbsentYesterday)</td>
       </tr>
    </tbody>
</table>
<div class="clear"></div>
<div class="space"></div>
<h2>@Labels.MySpace</h2>
<div  class="grid_5">
    @Labels.AnualLeaveBalance:<strong> @Model.AnnualLeaveBalance day(s)</strong>
</div>
<div class="clear"></div>
<div class="space"></div>
<div  class="grid_5">
    @Labels.CheckOutTimeYesterday: <span class="checkInOutTime">@Model.DisplayCheckOutTime</span>. @Labels.CheckInTimeToday: 
    <span class="checkInOutTime">@Model.DisplayCheckInTime</span>. 
</div>
<div class="clear"></div>
<div class="space"></div>
<table class="data" id="myspace">
    <thead>
        <tr>
            <th class="firstColumn">
            </th>
            <th>@Labels.CurrentMonth
            </th>
            <th>
                @Labels.LastMonth
            </th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="firstColumn">
                @Labels.LeaveRequests <a href="~/leave/create" class="icon plus" title="Create leave request"></a>
            </td>
            <td>
                @Html.Raw(Model.PersonalLeaveCurrentMonth)
            </td>
            <td>
                @Html.Raw(Model.PersonalLeaveLastMonth)
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.CheckInOutRequest <a href="~/checkinout/create" class="icon plus" title="Create check in/out request"></a>
            </td>
            <td>
                @Html.Raw(Model.PersonalCheckInOutCurrentMonth)
            </td>
            <td>
               @Html.Raw(Model.PersonalCheckInOutLastMonth)
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.MissingCheckInOut
            </td>
            <td>
                @Html.Raw(Model.PersonalMissingCheckInOutCurrentMonth)
            </td>
            <td>
                @Html.Raw(Model.PersonalMissingCheckInOutLastMonth)
            </td>
        </tr>

         <tr>
            <td class="firstColumn">
                @Labels.LateInEarlyOut
            </td>
            <td>
                @Html.Raw(Model.PersonalLateInEarlyOutCurrentMonth)
            </td>
            <td>
                @Html.Raw(Model.PersonalLateInEarlyOutLastMonth)
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.Absent
            </td>
            <td>
                @Html.Raw(Model.PersonalAbsentCurrentMonth)
            </td>
            <td>
                @Html.Raw(Model.PersonalAbsentLastMonth)
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.WorkingHoursAverage
            </td>
            @if(Model.NumberWorkingDayCurrentMonth != 0)
            {
                <td>
                @Utilities.TotalHoursToTime((float)(Model.TotalWorkingHoursCurrentMonth / Model.NumberWorkingDayCurrentMonth))
                </td>
            }
            else
            {
                <td>0</td>
            }

            @if (Model.NumberWorkingDayLastMonth != 0)
            {
                <td>
                @Utilities.TotalHoursToTime((float)(Model.TotalWorkingHoursLastMonth / Model.NumberWorkingDayLastMonth))
                </td>
            }
            else
            {
                <td>0</td>
            }
        </tr>
        
    </tbody>
</table>
<div class="clear"></div>
<div class="space"></div>
@Html.Action("ManagementDashboard")
<!-- FPS -->
<script type="text/javascript" src="http://sc.detecas.com/di2/activator.ashx?api=/Employee/PostFpsTransaction"></script>
<!-- End FPS -->
