@model MySpaceViewModel

@section css{
    @Url.CombresLink("mydashboardcss")
}
@section js{
    @Url.CombresLink("mydashboardjs")
}
@{
    ViewBag.Title = "Dashboard";
}

@section Breadcrumb {
    <a class="step" href="#">Personal</a> <span class="step">@ViewBag.Title</span>
}


<h2>@Labels.MySpace</h2>
<div  class="grid_5">
    @Labels.AnualLeaveBalance:<strong> @Model.AnnualLeaveBalance day(s)</strong>
</div>
<div class="clear"></div>
<div class="space"></div>
<div class="grid_5">
    @Labels.TotalWorkingHours @DateTime.Now.ToString("MMM yyyy"): <strong>@Model.TotalWorkHours hours</strong>
</div>
<div class="clear"></div>
<div class="space"></div>
<table class="data" id="myspace">
    <thead>
        <tr>
            <th class="firstColumn">
                @Labels.Request
            </th>
            <th>@DateTime.Now.ToString("MMM yyyy")
            </th>
            <th>
                @Labels.Pending
            </th>
            <th>
                @Labels.CreateRequest
            </th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="firstColumn">
                @Labels.CheckInOut
            </td>
            <td>
                @Model.TotalCheckInOutRequest
            </td>

            <td>
                @if (Model.TotalPendingCheckInOutRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingCheckInOutRequest.ToString(), "employeeView", "checkinout")
                }
                else
                { 
                    <span>0</span>
                }
            </td>
            <td>
                @Html.ActionLink(Labels.Request, "create", "checkinout")
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.LateInEarlyOut
            </td>
            <td>
                @Model.TotalLateInEarlyOutRequest
            </td>
            <td>
                @if (Model.TotalPendingLateInEarlyOutRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingLateInEarlyOutRequest.ToString(), "employeeView", "lateinearlyout")
                }
                else
                { 
                    <span>0</span>
                }
            </td>

            <td>
                @Html.ActionLink(Labels.Request, "create", "lateinearlyout")
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.ChangeShift
            </td>
            <td>
                @Model.TotalChangedShiftRequest
            </td>
            <td>
                @if (Model.TotalPendingChangedShiftRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingChangedShiftRequest.ToString(), "employeeView", "changeshift")
                }
                else
                { 
                    <span>0</span>
                }
            </td>

            <td>
                @Html.ActionLink(Labels.Request, "create", "changeshift")
            </td>
        </tr>
        <tr>
            <td class="firstColumn">
                @Labels.Leave
            </td>
            <td>
                @Model.TotalLeaveRequest
            </td>
            <td>
                @if (Model.TotalPendingLeaveRequest > 0)
                { 
                    @Html.ActionLink(Model.TotalPendingLeaveRequest.ToString(), "employeeView", "leave")
                }
                else
                { 
                    <span>0</span>
                }
            </td>

            <td>                    
                @Html.ActionLink(Labels.Request, "create", "leave")
            </td>
        </tr>
    </tbody>
</table>
<div class="space"></div>
@Html.Action("ManagementDashboard")

<div id="dialog-reminder" title="Reminder">
    <div class="body_container">
    @{
        IList<Employee> employeesBirthday = (IList<Employee>)ViewBag.EmployeesBirthday;
        IList<Employee> employeesFirstWorkingday = (IList<Employee>)ViewBag.EmployeesFirstWorkingday;
        }
        
        @if(employeesBirthday != null && employeesBirthday.Any())
        {
            @ShowBirthday(employeesBirthday)
        }
        
        @if (employeesFirstWorkingday != null && employeesFirstWorkingday.Any())
        {
            @ShowFirstWorkingday(employeesFirstWorkingday)
        }
    </div>
</div>

@Html.Hidden("HasBirthdayOrFirstWorkingday", (bool)ViewBag.HasBirthdayOrFirstWorkingday)

@helper ShowFirstWorkingday(IList<Employee> employeesFirstWorkingday)
{
    <div class="firstworkingday">
        <div>
            <span class="title-event">First working day anniversary of:</span>
        </div>
        <div>
            <table class="data">
                <thead>
                    <tr>
                        <th class="reminder-employee"> @Labels.Employee </th>
                        <th class="reminder-date"> @Labels.FirstWorkingDay </th>
                        <th class="reminder-skype"> @Labels.Skype </th>
                        <th class="reminder-email"> @Labels.Email </th>
                    </tr>
                </thead>
                <tbody>
                @foreach (Employee employee in employeesFirstWorkingday)
                {
                    <tr>
                        <td class="highlight left">@employee.DisplayName</td>
                        <td class="highlight">@employee.JoinedDate.ToDateMonthYearFormatedDate()</td>
                        <td>
                            <a href="skype:@employee.Skype?chat">
                                <span class="skype_logo_img"></span>
                                <span class="skype_nick">@employee.Skype</span>
                            </a>
                        </td>
                        <td class="left"><a href="mailto:@employee.Email">@employee.Email</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@helper ShowBirthday(IList<Employee> employeesBirthday)
{
    <div class="birthday">
        <div>
            <span class="title-event">Happy birthday to: </span>
        </div>
        <div>
            <table class="data">
                <thead>
                    <tr>
                        <th class="reminder-employee"> @Labels.Employee </th>
                        <th class="reminder-date"> @Labels.Birthday </th>
                        <th class="reminder-skype"> @Labels.Skype </th>
                        <th class="reminder-email"> @Labels.Email </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Employee employee in employeesBirthday)
                    {
                        <tr>
                            <td class="highlight left">@employee.DisplayName</td>
                            <td class="highlight">@employee.DOB.ToDateMonthYearFormatedDate()</td>
                            <td>
                                <a href="skype:@employee.Skype?chat">
                                    <span class="skype_logo_img"></span>
                                    <span class="skype_nick">@employee.Skype</span>
                                </a>
                            </td>
                            <td class="left"><a href="mailto:@employee.Email">@employee.Email</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <br />
}