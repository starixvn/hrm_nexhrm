@model Fanex.NexHR.ViewModels.TOEICViewModel
@{ DateTime currentDate = DateTime.Today; }
<form id="frmUpdateTOEIC">
	<div id="divErrorCont" class="">&nbsp;</div>
	<div class="formrow">
		<div class="label">
			@Labels.Employee
		</div>
		<div class="input">
			@Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
			@Html.HiddenFor(model => model.EmpId)
		</div>
	</div>
    <div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.InputDate, Labels.ExpiredDate)
		</div>
		<div class="input">
			@Html.DatePickerFor(model => model.InputDate)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.LRExamDate)
		</div>
		<div class="input">
			@Html.DatePickerFor(model => model.LRExamDate, currentDate.AddYears(-100), currentDate)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Labels.Listening
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Listening)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Labels.Reading
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Reading)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Html.LabelFor(model => model.SWExamDate)
		</div>
		<div class="input">
			@Html.DatePickerFor(model => model.SWExamDate, currentDate.AddYears(-100), currentDate)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Labels.Speaking
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Speaking)
		</div>
	</div>
	<div class="formrow">
		<div class="label">
			@Labels.Writing
		</div>
		<div class="input">
			@Html.EditorFor(model => model.Writing)
		</div>
	</div>
</form>