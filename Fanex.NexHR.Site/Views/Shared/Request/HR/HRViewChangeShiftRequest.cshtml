@model IList<Fanex.NexHR.Models.Request.ChangingShift>
<table class="data persist-area">
    <thead>
        <tr class="persist-header">
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>@Labels.RequestDate
            </th>
            <th>@Labels.From
            </th>
            <th>@Labels.To
            </th>
            <th>@Labels.CreatedDate
            </th>
            <th>@Labels.Remark
            </th>
            <th>@Labels.Status
            </th>
            <th>@Labels.History
            </th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;}
            @foreach (Fanex.NexHR.Models.Request.ChangingShift request in Model)
            { 
                <tr id="row@(request.Id)">
                    <td>@(index++)
                    </td>
                    <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code
                    </td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName.ToString()
                    </td>
                    <td class="ddMMyyyy highlight">@request.RequestedDate.ToDateMonthYearFormatedDate()
                    </td>
                    <td class="highlight">@request.FromShift.Name.ToString()
                    </td>
                    <td class="highlight">@request.ToShift.Name.ToString()
                    </td>
                    <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @*@RazorHelper.ModifierDisplay(request.ModifiedBy.NickName, request.ModifiedBy.FullName, request.ModifiedDate, request.Id)*@
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }
                    @if ((bool)ViewBag.IsAllowChangeStatus)
                    {
                        <!-- If view from menu "HR Space" -->
                        if (Roles.IsUserInRole("HR"))
                        {
                            switch (request.Status.Id)
                            {
                                case 1: //Pending
                        <td>
                            <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() tooltip" title="@request.Requester.NickName had @request.TotalDaysRequestInMonth approved request(s) in @request.RequestedDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</a>
                        </td>
                                                                                                                                                                                                                                                                     break;
                                case 2: //Approve
                        <td>
                            <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                        </td>
                                                                                                                                                                                                                            break;
                                case 3: //Reject
                        <td>
                            <a href="javascript:;" class="tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                        </td>
                                                                                                                                                                         break;
                            }
                        }
                        else
                        { 
                        <td class="tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()
                        </td> 
                        }
                    }
                    else
                    {
                        <!-- If view from menu "Company Space" -->
                        switch (request.Status.Id)
                        {
                            case 1: //Pending
                        <td>
                            <a href="javascript:;" class="tooltip" title="@request.Requester.NickName had @request.TotalDaysRequestInMonth approved request(s) in @request.RequestedDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</a>
                        </td>
                                                                                                                                                                                                                                                                     break;
                            case 2: //Approve
                        <td>
                            <a href="javascript:;" class="tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                        </td>
                                                                                                                                                                                                                            break;
                            case 3: //Reject
                        <td>
                            <a href="javascript:;" class="tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                        </td>
                                                                                                                                                                         break;
                        }
                    }
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.Type.RequestHistoryFilter">
                            @Labels.View </a>
                    </td>
                </tr>  
            }
        </tbody>
    }
    else
    { 
        @RazorHelper.DisplayNoInformation(colspan: 12);
    }
</table>
@RazorHelper.ProcessMenu()
