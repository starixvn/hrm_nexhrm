@model IList<Fanex.NexHR.Models.Request.RequestEntity>
<table class="data persist-area">
    <thead>
        <tr class="persist-header">
            <th>
                #
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Employee
            </th>
            <th>
                Request
            </th>
            @*<th>@Labels.RequestDate</th>*@
            <th>
                Details
            </th>
            <th>@Labels.Remark
            </th>
            <th>@Labels.CreatedDate
            </th>
            @*<th>Total day(s)</th>*@
            <th>@Labels.Status
            </th>
            <th>@Labels.History
            </th>
        </tr>
    </thead>
    @if (ViewBag.EntityList.Count > 0)
    {
        <tbody>
            @{int index = 1;
              RequestViewModel options = (RequestViewModel)ViewBag.Options;
            }
            @foreach (Fanex.NexHR.Models.Request.RequestEntity request in Model)
            {
                var requestModel = new RequestViewModel
                {
                    DateOption = options.DateOption,
                    FromDate = options.FromDate,
                    ToDate = options.ToDate,
                    EmployeeId = request.Requester.Id,
                    Employee = request.Requester.NickName + " (" + request.Requester.FullName + ")",
                    TeamId = options.TeamId == null ? -2 : options.TeamId,
                    StatusId = options.StatusId,
                    RequestType = request.Type.RequestFilter
                };
                
                <tr id="row@(request.Id)">
                    <td>@(index++)
                    </td>
                    <td  class="tooltip" title="@request.Requester.Team.Name">
                        @request.Requester.Team.Code
                    </td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName.ToString()
                    </td>
                    <td class="highlight">
                        @if (ViewBag.Leader == true)
                        { 
                            <a href="@Url.Action("member", "request", requestModel)">
                                @if (request.Type.Id == (int)RequestTypes.Leave)
                                {
                                    @request.LeaveType
                                }
                                else
                                {
                                    @request.Type.Name
                                }
                            </a>
                        }
                        else
                        {
                            if ((bool)ViewBag.IsAllowChangeStatus)
                            {
                                <a href="@Url.Action("hrview", "request", requestModel)">
                                    @if (request.Type.Id == (int)RequestTypes.Leave)
                                    {
                                        @request.LeaveType
                                    }
                                    else
                                    {
                                        @request.Type.Name
                                    }
                                </a>
                            }
                            else
                            {
                                 <a href="@Url.Action("employeeview", "request", requestModel)">
                                    @if (request.Type.Id == (int)RequestTypes.Leave)
                                    {
                                        @request.LeaveType
                                    }
                                    else
                                    {
                                        @request.Type.Name
                                    }
                                </a>
                            }
                        }
                    </td>
                    <td class="left">
                        @Html.Raw(Fanex.NexHR.Services.RequestService.ToRequestMessage(request))
                    </td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    { 
                        <td class="tooltip" title="@request.Remark">
                            <span class="icon remark" alt="remark" />
                        </td>
                    }
                    else
                    {
                        <td>
                            -
                        </td>
                    }
                    <td class="ddMMyyyyhhmm">
                        @request.CreatedDate.ToShortFormatedDate()
                    </td>
                    @if ((bool)ViewBag.IsAllowChangeStatus)
                    {
                        <!-- If view from menu "HR Space" -->
                        switch (request.Status.Id)
                        {
                            case 1: //Pending
                                if (request.Type.Id == 6)
                                {
                                    <td>
                                        <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() tooltip" title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved day(s) in @request.FromDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</a>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() tooltip" title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.RequestedDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</a>
                                    </td>
                                }

                                break;
                            case 2: //Approve
                                <td>
                                    <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                                </td>
                                                                                                                                                                                                                                    break;
                            case 3: //Reject
                                <td>
                                    <a requestid="@request.Id" href="javascript:;" class="tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                                </td>
                                                                                                                                                                                                         break;
                        }
                    }
                    else
                    {
                        <!-- If view from menu "Company Space" -->
                        switch (request.Status.Id)
                        {
                            case 1: //Pending
                                if (request.Type.Id == 6)
                                {
                                    <td>
                                        <a href="javascript:;" class="tooltip" title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved day(s) in @request.FromDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</a>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <a href="javascript:;" class="tooltip" title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.RequestedDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</a>
                                    </td>
                                }

                                break;
                            case 2: //Approve
                                <td>
                                    <a href="javascript:;" class="tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                                </td>
                                                                                                                                                                                 break;
                            case 3: //Reject
                                <td>
                                    <a href="javascript:;" class="tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                                </td>
                                                                                                                                                                                 break;
                        }
                    }
                    <td>
                        <a class="viewhistory" href="javascript:;" id="/request/hrviewhistory?id=@request.Id&type=@request.Type.RequestHistoryFilter">
                            @Labels.View </a>
                    </td>
                </tr>  
            }
        </tbody>
    }
    else
    { 
        @RazorHelper.DisplayNoInformation(colspan: 9);
    }
</table>
@RazorHelper.ProcessMenu()
