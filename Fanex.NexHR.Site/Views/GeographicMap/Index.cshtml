@section css{
    @Url.CombresLink("geolocationcss")
}
@section js{
    @Url.CombresLink("geolocationjs")
}
@{
    ViewBag.Title = "Employee Geolocation Map";
}
@section Breadcrumb {
    <span class="step">Company Space</span> <span class="step">@ViewBag.Title</span>
}
<div class="formrow">
    Employee: 
    @Html.Editor("Employee")
    <input type="button" value="Search" id="searchmap" />
</div>
<script src="http://maps.google.com/maps/api/js?sensor=false" type="text/javascript"></script>
<div id="map_canvas">
</div>
@Html.Hidden("currentUser", (string)ViewBag.NickName)
@Html.Hidden("roleHR", (bool)ViewBag.RoleHR)
@Html.Hidden("Latitude")
@Html.Hidden("Longitude")
