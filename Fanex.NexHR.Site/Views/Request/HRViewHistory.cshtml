@model Fanex.NexHR.ViewModels.RequestViewModel
@using Fanex.NexHR.Models.Request
@{
    ViewBag.Title = Labels.RequestHistory;
    Layout = null;
}
@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("sitejs")
}
@section Breadcrumb {
    <a class="step">HR</a> <span class="step">@ViewBag.Title</span>
}
@switch ((int)ViewBag.requestType)
{
    case 1:
        IList<RequestEntity> entityCheckInOut = ViewBag.EntityList;
        Html.RenderPartial("Request/HR/HRViewCheckInOutRequestHistory", entityCheckInOut);
        break;
    case 2:
		IList<RequestEntity> entityLateInEarlyOut = ViewBag.EntityList;
        Html.RenderPartial("Request/HR/HRViewLateInEarlyOutRequestHistory", entityLateInEarlyOut);
        break;
    case 3:
		IList<RequestEntity> entityChangeShift = ViewBag.EntityList;
        Html.RenderPartial("Request/HR/HRViewChangeShiftRequestHistory", entityChangeShift);
        break;
    case 4:
		IList<RequestEntity> entityLeave = ViewBag.EntityList;
        Html.RenderPartial("Request/HR/HRViewLeaveRequestHistory", entityLeave);
        break;
   
}
