@model Fanex.NexHR.ViewModels.RequestViewModel
@using Fanex.NexHR.Models.Request;
@{
    ViewBag.Title = Labels.MemberRequest;
    IList<RequestEntity> requests = ViewBag.EntityList;
}
@section css{
    @Url.CombresLink("managerequestscss")
}
@section js{
    @Url.CombresLink("managerequestsjs")
}
@section Breadcrumb {
    <a class="step">Leader View</a> <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
<div>
    @Html.Partial("CriteriaPanel", Model)
</div>

@switch (Model.RequestType)
{
    case 1:
        Html.RenderPartial("Request/Member/MemberLeaveRequest", requests);
        break;
    case 4:
        Html.RenderPartial("Request/Member/MemberCheckInOutRequest", requests);
        break;
    case 5:
        Html.RenderPartial("Request/AllRequest", requests);
        break;
}
<div id="dialoghistorycontent"/>