@model Fanex.NexHR.ViewModels.RequestViewModel
@using Fanex.NexHR.Models.Request
@{
    ViewBag.Title = Labels.EmployeeRequest;
    IList<RequestEntity> requests = ViewBag.EntityList;
}
@section css{
    @Url.CombresLink("managerequestscss")
}
@section js{
    @Url.CombresLink("hrrequestsjs")
}
@section Breadcrumb {
    @if ((bool)ViewBag.IsAllowChangeStatus)
    {
        <span class="step">HR Space</span>
    }
    else
    {
        <span class="step">Company Space</span>
    }
    <span class="step">@ViewBag.Title</span>
}
<h2>@ViewBag.Title</h2>
<div>
    @Html.Partial("CriteriaPanel", Model)
</div>

@switch (Model.RequestType)
{
    case 1: // Annual Leave
        Html.RenderPartial("Request/HR/HRViewLeaveRequest", requests);
        break;
    case 4: // Check-In/Out
        Html.RenderPartial("Request/HR/HRViewCheckInOutRequest", requests);
        break;
    case 5: // All Request
        Html.RenderPartial("Request/AllRequest", requests);
        break;
}
<div id="dialoghistorycontent"/>