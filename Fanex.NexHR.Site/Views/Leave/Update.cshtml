@model Fanex.NexHR.ViewModels.LeaveRequestViewModel
@{
    ViewBag.Title = Labels.LeaveRequest;
}

@section css{
    @Url.CombresLink("leavecss")
}
@section js{
    @Url.CombresLink("leavejs")
}

@section Breadcrumb {
    <a class="step">Personal</a> <a class="step">@ViewBag.Title</a>
}

<h2>@Labels.Edit</h2>
<div class="bunhat">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)

        if (ViewBag.Updated == true)
        {
            <div class="success">@Fanex.NexHR.Resources.Messages.RequestUpdated</div> 
            <input type="hidden" id="successed" value="true" />
            <input type="hidden" id="year" value="@ViewBag.Year" />
        }
        
        <div class="formrow">
            <div class="label">
                @Fanex.NexHR.Resources.Labels.RequestCode
            </div>
            <div class="input">
                <strong>Rq.@Model.Id</strong>
            </div>
            <div class="clear"></div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.LeaveTypeId)
            </div>
            <div class="input">
                @Html.DropDownListFor(model => model.LeaveTypeId, new SelectList(ViewBag.LeaveTypes, "Id", "Name"))
                @Html.ValidationMessageFor(model => model.LeaveTypeId)
            </div>
            <div class="clear"></div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.HalfDayOff)
            </div>
            <div class="input">
                @Html.CheckBoxFor(model => model.HalfDayOff)
            </div>
            <div class="clear">
            </div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Employee)
            </div>
            <div class="input">
                @Html.DisplayFor(model => model.Employee)
            </div>
            <div class="clear"></div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.FromDate, Labels.FromDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.FromDate,
                 new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                 new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(3).AddDays(-1), 
                 unavailDates: (IEnumerable<DateTime>)ViewBag.UnavailDates)
                <span class="time hide">
                    @Html.DropDownListFor(model => model.FromTime, Utilities.TimeSteps(30))
                </span>
            </div>
            <div class="clear"></div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.ToDate, Labels.ToDate)
            </div>
            <div class="input">
                @Html.DatePickerFor(model => model.ToDate, unavailDates: (IEnumerable<DateTime>)ViewBag.UnavailDates)
                <span class="time hide">
                    @Html.DropDownListFor(model => model.ToTime, Utilities.TimeSteps(30))
                </span>
            </div>
            <div class="clear"></div>
        </div>
        
         <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TotalDays)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.TotalDays)
            </div>
            <div class="clear"></div>
        </div>

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Remark)
            </div>
            <div class="input">
                @Html.TextAreaFor(model => model.Remark)
            </div>
            <div class="clear"></div>
        </div>
        
        <div class="formrow">
            <div class="label">
                @Html.HiddenFor(model => model.DisplayName)
                @Html.HiddenFor(model => model.Employee)
                @Html.HiddenFor(model => model.EmployeeId)
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.LeaveTypeName)
                &nbsp;
            </div>
            <div class="input">
                <input type="submit" value="@Labels.Update"/>
                <a href="@Url.Action("employeeview", "leave")" class="button">@Labels.Back</a>
            </div>
            <div class="clear"></div>
        </div>
    }
</div>