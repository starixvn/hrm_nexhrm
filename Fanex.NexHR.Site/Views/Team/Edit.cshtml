@model Fanex.NexHR.ViewModels.TeamViewModel

@{
    ViewBag.Title = Labels.Team;
}

@section css{
    @Url.CombresLink("sitecss")
}
@section js{
    @Url.CombresLink("teamjs")
}
@section Breadcrumb {
    <span class="step">HR Space</span>
    <a href="@Url.Action("index", "team")" class="step">Team Management</a>
    @if(Model != null)
    {
        <span class="step">@Model.TeamName</span>
    }
}

@if (Model != null)
{
    <h2>@Labels.Edit</h2>

    using (Html.BeginForm())
    {
    <div class="bunhat">
        @Html.ValidationSummary(true)
        @if (ViewBag.Updated == true)
        {
        <div class="success">@Messages.TeamUpdated</div> 
        }

        @Html.HiddenFor(model => model.CreatedDate)
        @Html.HiddenFor(model => model.CreatedBy)
        @Html.HiddenFor(model => model.ModifiedDate)
        @Html.HiddenFor(model => model.ModifiedBy)

        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TeamCode)
            
            </div>
            <div class="input">
                @Html.EditorFor(model => model.TeamCode)
                @Html.ValidationMessageFor(model => model.TeamCode)
            </div>
        </div>
    
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.TeamName)
            </div>
            <div class="input">
                @Html.EditorFor(model => model.TeamName)
                @Html.ValidationMessageFor(model => model.TeamName)
            </div>
        </div>
    
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.Leader)
            </div>
            <div class="input">
                @Html.TextBox("Leader", Model.Leader, new { placeholder = Messages.SearchEmployeeWatermark })
            
                @Html.ValidationMessage("Leader")
            
                @Html.HiddenFor(model => model.Leader)
                @Html.HiddenFor(model => model.LeaderId)
            </div>
        </div>
    
        <div class="formrow">
            <div class="label">
                @Html.LabelFor(model => model.AssistantLeader)
            </div>
            <div class="input">
                @Html.TextBox("AssistantLeader", Model.AssistantLeader, new { placeholder = Messages.SearchEmployeeWatermark })
            
               @* @Html.ValidationMessage("AssistantLeader")*@
            
                @Html.HiddenFor(model => model.AssistantLeader)
                @Html.HiddenFor(model => model.AssistantLeaderId)
            </div>
        </div>
    
		<div class="formrow">
			<div class="label">
				@Html.LabelFor(model => model.DepartmentId)
			</div>
			<div class="input">
				@Html.DropDownListFor(model => model.DepartmentId, new SelectList(ViewBag.Departments, "DepartmentId", "Name"), "-- " + @Messages.SelectDepartment + " --")
			</div>
		</div>

		<div class="formrow">
			<div class="label">
				@Html.LabelFor(model => model.ParentId)
			</div>
			<div class="input">
				@Html.DropDownListFor(model => model.ParentId, new SelectList(ViewBag.Groups, "Id", "Name"), "-- " + @Messages.SelectParentTeam + " --")
			</div>
		</div>

        <div class="formrow">
            <div class="label">

            </div>
            <div class="input">
                <input type="submit" value="@Labels.Update"/>
                <a href="@Url.Action("index", "team")" class="button">@Labels.Back</a>
            </div>
        </div>

    </div>
    }
}
else
{
    <h2>@Messages.NoDataIsAvailable</h2>  
}
