<?xml version="1.0" encoding="utf-8" ?>
<siteMap xmlns="http://schemas.microsoft.com/AspNet/SiteMap-File-1.0">
    <siteMapNode title="Root"  changeFrequency="Always"  updatePriority="Normal">
        <siteMapNode title="Personal">
            <siteMapNode title="My dashboard" controller="employee" action="MySpace" icon="news" />
            <siteMapNode title="Leave request" controller="leave" action="employeeview" icon="calendar7" hoverController="leave" hoverAction="create" hoverIcon="plus" />
            <siteMapNode title="Change shift" controller="changeshift" action="employeeview" icon="clock3" hoverController="changeshift" hoverAction="create" hoverIcon="plus" />
            <siteMapNode title="Late in - Early out" controller="lateinearlyout" action="employeeview" icon="clock2" hoverController="lateinearlyout" hoverAction="create" hoverIcon="plus" />
            <siteMapNode title="Check in - Check out" controller="checkinout" action="employeeview" icon="clock1" hoverController="checkinout" hoverAction="create" hoverIcon="plus" />
            <siteMapNode title="My Timesheet" controller="report" action="timesheet" icon="calendar8" />
            <siteMapNode title="My calendar" controller="employee" action="myworkingschedule" icon="calendar" />
            <siteMapNode title="Members' requests" controller="request" action="member" icon="user1" roles="AssistantLeader"/>
            <siteMapNode title="Requests statistic" controller="report" action="LeaderRequestMonitoring" icon="search" roles="AssistantLeader" id="1"/>
            <siteMapNode title="My profile" controller="account" action="index" icon="user" />
        </siteMapNode>
        <siteMapNode title="HR space" roles="HR" >
            <siteMapNode title="Employees' requests" controller="request" action="hrview" icon="user1" roles="HR" />
            <siteMapNode title="Requests monitoring" controller="report" action="HRRequestMonitoring" icon="search" roles="HR"/>
            <siteMapNode title="Annual leave balance" controller="annualleavebalance" action="index" icon="calendar6" />
            <siteMapNode title="User management" controller="employee" action="UserManagement" icon="users" />
            <siteMapNode title="Team management" controller="team" action="index" icon="setting" />
            <siteMapNode title="Create account" controller="employee" action="create" icon="adduser" />
            <siteMapNode title="Job title management" controller="jobtitle" action="jobtitlemanagement" icon="user" />
        </siteMapNode>
        <siteMapNode title="Company space">
            <siteMapNode title="Staff info" controller="employee" action="index" icon="users" />
            <siteMapNode title="Staff TOEIC score" controller="employee" action="toeicmanagement" icon="news" />
            <siteMapNode title="Working calendars" controller="employee" action="workingcalendars" icon="calendar" />
            <siteMapNode title="Employees' requests" controller="request" action="employeeview"  icon="user1" />
            <siteMapNode title="Daily requests" controller="request" action="dailyview"  icon="user1" />
            <siteMapNode title="Attendance report" controller="report" action="attendance" icon="calendar1" />
            <siteMapNode title="Leave summary" controller="report" action="leavesummary" icon="calendar4" />
            <siteMapNode title="Total working hours" controller="report" action="totalworkinghours" icon="clock" />
            <siteMapNode title="Holiday" controller="holiday" action="index" icon="holiday" />
            <siteMapNode title="Shift info" controller="shift" action="index" icon="calendar3" />
             <siteMapNode title="Geolocation map" controller="geographicmap" action="index" icon="search" />
            <siteMapNode title="Extension numbers" controller="ExtensionNo" action="index" icon="mobile" />
            <siteMapNode title="Company memo" controller="memo" action="index" icon="memo" />
        </siteMapNode>
    </siteMapNode>
</siteMap>
