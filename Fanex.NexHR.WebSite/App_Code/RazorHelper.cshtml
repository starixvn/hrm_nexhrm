@using System.Globalization
@using Fanex.NexHR.Core.Enums;
@using Fanex.NexHR.Core;
@using Fanex.NexHR.Models;
@using Fanex.NexHR.Resources;

@helper RequestType(short type)
{
switch (type)
{
    case 1:
            <text>Check in</text>
        break;
    case 2:
            <text>Check out</text>
        break;
    case 3:
            <text>Late in</text>
        break;
    case 4:
            <text>Early out</text>
        break;
    case 5:
            <text>Change shift</text>
        break;
    case 6:
            <text>Leave request</text>
        break;
}
}
@helper FormatDate(DateTime? date)
{
    <span>
        @if (date.HasValue)
        {
            @date.Value.ToString("MMM dd, yyyy hhH:mm")
        }
    </span>
}
@helper DisplayNoInformation(int colspan)
{
    <tr>
        <td colspan="@colspan"></td>
    </tr>
    <tr>
        <td colspan="@colspan" rowspan="2">
            @Messages.NoInformation
        </td>
    </tr>
}
@helper StatusDropDownList(byte status = (byte)RequestStatuse.Pending, bool isShowAll = true, string controlName = "status")
{
    <select name="@controlName" id="@controlName">
        @if (isShowAll)
        {
            <option selected="@(status == 0)" value="0">All</option>
        }
        <option selected="@(status == (byte)RequestStatuse.Pending)" value="@Convert.ToByte(RequestStatuse.Pending)">@Labels.Pending</option>
        <option selected="@(status == (byte)RequestStatuse.Reject)" value="@Convert.ToByte(RequestStatuse.Reject)">@Labels.Rejected</option>
        <option selected="@(status == (byte)RequestStatuse.Approve)" value="@Convert.ToByte(RequestStatuse.Approve)">@Labels.Approved</option>
    </select>

}
@helper StatusDisplayByHR(long statusId, Fanex.NexHR.Models.Request.RequestStatus status)
{
if (status.Id != (byte)RequestStatuse.Reject)
{
        <td>
            <a requestid="@statusId" href="javascript:;" class="@status.Name tooltip">@status.Name</a>
        </td>
}
else
{
        <td>
            @status.Name
        </td>
}
}
@helper ModifierDisplay(string nickName, string fullName, DateTime? modifiedDate, long requestId)
{
if (!string.IsNullOrWhiteSpace(nickName))
{
    if (modifiedDate > new DateTime(2000, 1, 1))
    {
            <td id="pb@(requestId)">
                @nickName, @modifiedDate.ToShortFormatedDate()
            </td>
    }
    else
    {
            <td id="pb@(requestId)">
                @nickName
            </td>
    }
}
else
{
        <td id="pb@(requestId)">
            N/A
        </td>
}
}
@helper TeamDropDownList(List<Team> teamList, string controlName = "team")
{
    <select name="@controlName" id="@controlName">
        @if (teamList != null && teamList.Count > 0)
        {
            foreach (Team team in teamList)
            {
                <option value="@team.Name">@team.Name</option>
            }
        }
    </select>
}
@helper EmployeeDropDownList(List<string> employeeList)
{
    <select id="employee">
        @foreach (string emp in employeeList)
        {
            <option value="@emp">@emp</option>
        }
    </select>
}
@helper ShiftInfoTable(dynamic shiftInfoList)
{
    <div id="shifts" class="m-t--m">
        <table class="table bordered striped highlight table-custom centered" style="width: 700px;">
            <thead>
                <tr>
                    <th>
                        @Labels.Shift
                    </th>
                    <th>
                        @Labels.CheckIn
                    </th>
                    <th>
                        @Labels.CheckOut
                    </th>
                    <th>
                        @Labels.BreakTimeMins
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (Shift item in shiftInfoList)
                {
                    <tr>
                        <td>
                            @item.Name
                        </td>
                        <td>
                            @item.BeginCheckInTime &nbsp;@((item.BeginCheckInTime == item.EndCheckInTime) ? string.Empty : "- " + item.EndCheckInTime)
                        </td>
                        <td>
                            @item.BeginCheckOutTime &nbsp;@((item.BeginCheckOutTime == item.EndCheckOutTime) ? string.Empty : "- " + item.EndCheckOutTime)
                        </td>
                        <td>
                            @((item.BreakTimeMins == 0) ? string.Empty : "12:00 - 13:00")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@helper RequestCheckInOutLegend()
{
    <div id="requestInfo">
        <div class="requestInfo">
            <ul>
                <li>
                    In a month, if the employee forgets to check-in and/or check-out:
                    <ul>
                        <li>
                            More than 2 times (except requests for Afternoon Shift 2 - A2), a reminder from
                            HR will be issued via email and HR will also be responsible for requesting and approving
                            those Check-in/out requests.
                        </li>
                        <li>
                            More than 5 times, an Explanation Letter will be requested to be sent to HR and
                            CC’ed to The Management.
                        </li>
                    </ul>
                </li>
                <li>Deadline to submit a Check-in/out request is 3 working days. </li>
            </ul>
        </div>
    </div>
}
@helper RequestLeaveLegend()
{
    <div id="requestInfo">
        <div class="requestInfo">
            <ul>
                <li>1 day leave - submitted 1 working-day in advance. </li>
                <li>2 -> 4 days leave - submitted 2 working-days in advance. </li>
                <li>
                    5 days leave or more - submitted 5 working-days in advance and must be approved
                    by the Management.
                </li>
            </ul>
        </div>
    </div>
}
@helper LateInEarlyOutTimeFormat(int mins, short type)
{
if (type == (byte)Fanex.NexHR.Core.Enums.RequestType.LateIn)
{
        <span>+@mins'</span>
}
else
{
        <span>-@mins'</span>
}
}
@helper MinuteDropDownList(string name, int step)
{
    <select id="@name" name="@name">
        @{
            var index = 60;
        }
        @while (index > 0)
        {
            <option value="@index">@index'</option>
            index -= step;
        }
    </select>
}
@helper MaxRequestDropDownList(int maxRequest, string name = "MaxRequest")
{
    <select id="@name" name="@name" class="minWidthDropdown">
        @for (int i = 1; i <= 10; i++)
        {
            <option selected="@(i == maxRequest)" value="@i">@i</option>
        }
    </select>
}
@helper ShiftDropDownList(string name, int? currentValue, IList<System.Web.Mvc.SelectListItem> listItem)
{
    <select id="@name" name="@name">
        <option value="">@Labels.Off</option>
        @{
            var value = currentValue != null ? currentValue.ToString() : string.Empty;
        }
        @foreach (var item in listItem)
        {
            <option value="@item.Value" selected="@(item.Value == value)">@item.Text</option>
        }
    </select>
}
@helper DateRangeDropDownList(string name, int selectValue)
{
    <select id="@name" name="@name">
        @{
            foreach (DateRangeFilter dateRange in (DateRangeFilter[])Enum.GetValues(typeof(DateRangeFilter)))
            {
                var value = (int)dateRange;
                <option value="@value" selected="@(value == selectValue)">@Utilities.GetDescription(dateRange)</option>
            }
        }
    </select>
}

@helper RequestTypeFilter(string name, int selectValue)
{
    <select id="@name" name="@name">
        @{
            foreach (RequestTypeFilterForAttendance requestType in (RequestTypeFilterForAttendance[])Enum.GetValues(typeof(RequestTypeFilterForAttendance)))
            {
                var value = (int)requestType;
                <option value="@value" selected="@(value == selectValue)">@Utilities.GetDescription(requestType)</option>
            }
        }
    </select>
}

@helper RequestMonitoringType(string name, int selectValue)
{
    <select id="@name" name="@name">
        @{
            foreach (RequestMonitoringType requestType in (RequestMonitoringType[])Enum.GetValues(typeof(RequestMonitoringType)))
            {
                var value = (int)requestType;
                <option value="@value" selected="@(value == selectValue)">@Utilities.GetDescription(requestType)</option>
            }
        }
    </select>
}

@helper DisplayMinute(double minutes)
{
var hour = Math.Floor(minutes / 60);
var minute = minutes % 60;
string display;

if (hour == 0)
{
    display = minute > 9 ? "00:" + minute : "00:0" + minute;
}
else
{
    display = (hour > 9 ? hour.ToString(CultureInfo.InvariantCulture) : "0" + hour) + ":" + (minute > 9 ? minute.ToString(CultureInfo.InvariantCulture) : "0" + minute);
}

    <span>@display</span>
}

@helper TotalHoursToTime(decimal value)
{
var display = string.Empty;
var hour = Math.Floor(value);

if (hour > 0)
{
    display = hour < 10 ? "0" + hour + "h" : hour + "h";
}

var minute = Math.Round((value - hour) * 60);

    <span>@(minute < 10 ? display + "0" + minute + "\'" : display + minute + "\'")</span>
}

@helper DisplayLimitedString(string value)
{
if (value.Length > 50)
{
    value = value.Substring(0, 50) + "...";
}

    <span class="truncate-remark">@value</span>
}

@helper DisplayFormatTotalLateInEarlyOut(int minutes, int times, int employeeId, DateTime fromDate, DateTime toDate, bool isHightlight = true)
{
var url = "LateInEarlyOutDetail?employeeId=" + employeeId + "&fromDate=" + fromDate.ToDateMonthYearFormatedDate()
    + "&toDate=" + toDate.ToDateMonthYearFormatedDate();

if (minutes != 0)
{
        <td>
            <a class="@((times > 3 && isHightlight) ? "red-color" : string.Empty)" href="@url">@((minutes / 60.0).ToString("0.0")) / @times</a>
        </td>
}
else
{
        <td>-</td>
}
}

@helper DisplayNumber(float value)
{
if (value == 0)
{
        <td>-</td>
}
else
{
        <td class="@(value > 0 ? string.Empty : "red-color")">@value.ToString("0.0")</td>
}
}