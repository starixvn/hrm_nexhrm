<?xml version="1.0" encoding="utf-8" ?>
<siteMap xmlns="http://schemas.microsoft.com/AspNet/SiteMap-File-1.0">
    <siteMapNode title="Root"  changeFrequency="Always"  updatePriority="Normal">
        <siteMapNode title="Personal">
            <siteMapNode title="My dashboard" controller="employee" action="MySpace" icon="action-home" />
            <siteMapNode title="Leave request" controller="leave" action="employeeview" icon="action-account-box" hoverController="leave" hoverAction="create" hoverIcon="plus" />
            <siteMapNode title="Check in - Check out" controller="checkinout" action="employeeview" icon="action-schedule" hoverController="checkinout" hoverAction="create" hoverIcon="plus" />
            <siteMapNode title="My Timesheet" controller="report" action="timesheet" icon="av-web" />
            <siteMapNode title="My Time Record" controller="report" action="mytimerecord" icon="action-description" />
            <siteMapNode title="My calendar" controller="employee" action="myworkingschedule" icon="action-today" />
            <siteMapNode title="Members' requests" controller="request" action="member" icon="action-perm-identity" roles="AssistantLeader" />
            <siteMapNode title="Requests statistic" controller="report" action="LeaderRequestMonitoring" icon="action-find-in-page" roles="AssistantLeader" id="1" />
            <siteMapNode title="My profile" controller="account" action="index" icon="action-account-circle" />
        </siteMapNode>
        <siteMapNode title="HR space" roles="HR">
            <siteMapNode title="Employees' requests" controller="request" action="hrview" icon="action-perm-identity" roles="HR" />
            <siteMapNode title="Requests monitoring" controller="report" action="HRRequestMonitoring" icon="action-search" roles="HR" />
            <siteMapNode title="Annual leave balance" controller="annualleavebalance" action="index" icon="action-today" />
            <siteMapNode title="User management" controller="employee" action="UserManagement" icon="action-account-box" />
            <siteMapNode title="Team management" controller="team" action="index" icon="action-settings" />
            <siteMapNode title="Create account" controller="employee" action="create" icon="social-person-add" />
            <siteMapNode title="Job title management" controller="jobtitle" action="jobtitlemanagement" icon="action-account-circle" />
            <!--<siteMapNode title="Department management" controller="department" action="index" icon="setting" />-->
            <siteMapNode title="Time Record" controller="report" action="timerecord" icon="notification-event-note" />
        </siteMapNode>
        <siteMapNode title="Company space">
            <siteMapNode title="Staff info" controller="employee" action="index" icon="file-folder-shared" />
            <siteMapNode title="Staff TOEIC score" controller="employee" action="toeicmanagement" icon="action-grade" />
            <siteMapNode title="Working calendars" controller="employee" action="workingcalendars" icon="action-today" />
            <siteMapNode title="Employees' requests" controller="request" action="employeeview"  icon="action-account-box" />
            <siteMapNode title="Attendance report" controller="report" action="attendance" icon="notification-event-note" />

            <siteMapNode title="Late In/Early Out" controller="report" action="lateinearlyoutsummary" icon="action-alarm" />
            <siteMapNode title="Leave summary" controller="report" action="leavesummary" icon="action-description" />
            <siteMapNode title="Total working hours" controller="report" action="totalworkinghours" icon="action-alarm-add" />
            <siteMapNode title="Holiday" controller="holiday" action="index" icon="image-photo" />
            <siteMapNode title="Shift info" controller="shift" action="index" icon="action-info-outline" />
            <siteMapNode title="Geolocation map" controller="geographicmap" action="index" icon="maps-place" />
            <siteMapNode title="Extension numbers" controller="ExtensionNo" action="index" icon="hardware-phone-android" />
            <siteMapNode title="Company memo" controller="memo" action="index" icon="action-assignment" />
        </siteMapNode>
    </siteMapNode>
</siteMap>