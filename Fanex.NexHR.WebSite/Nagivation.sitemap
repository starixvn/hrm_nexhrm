<?xml version="1.0" encoding="utf-8" ?>
<siteMap xmlns="http://schemas.microsoft.com/AspNet/SiteMap-File-1.0">
  <siteMapNode title="Root"  changeFrequency="Always"  updatePriority="Normal">
    <siteMapNode title="Personal" roles="Member,SpecialUser">
      <siteMapNode title="My Dashboard" controller="dashboard" action="index" icon="home" roles="Member,SpecialUser" />
      <siteMapNode title="Leave Request" controller="leave" action="employeeview" icon="account-box" roles="Member,SpecialUser" />
      <siteMapNode title="Check In/Check Out" controller="checkinout" action="employeeview" icon="clock" roles="Member,SpecialUser" />
      <siteMapNode title="My Attendance" controller="report" action="timesheet" icon="table" roles="Member,SpecialUser" />
      <siteMapNode title="NEX Request" controller="overtime" action="index" icon="calendar-clock" roles="Member" />
      <siteMapNode title="Member Requests" controller="request" action="member" icon="account" roles="AssistantLeader,SpecialUser" />
      <siteMapNode title="Requests Statistic" controller="report" action="LeaderRequestMonitoring" icon="file-find" roles="AssistantLeader" id="1" />
      <siteMapNode title="My Profile" controller="employee" action="myprofile" icon="account-box-outline" roles="Member,SpecialUser" />
      <siteMapNode title="Late in/Early out" controller="LateEarly" action="index" icon="alarm" roles="Member" />"
    </siteMapNode>
    <siteMapNode title="HR Space" roles="HR">
      <siteMapNode title="Employee Requests" controller="request" action="hrview" icon="account-box" roles="HR" />
      <siteMapNode title="Requests Monitoring" controller="report" action="HRRequestMonitoring" icon="eye" roles="HR" />
      <siteMapNode title="User Management" controller="employee" action="UserManagement" icon="settings-box" roles="HR" />
      <siteMapNode title="Team Management" controller="team" action="index" icon="account-multiple" roles="HR" />
      <siteMapNode title="Create Account" controller="employee" action="create" icon="account-plus" roles="HR" />
      <siteMapNode title="Job Title Management" controller="jobtitle" action="index" icon="book" roles="HR" />
      <siteMapNode title="Time Record" controller="report" action="timerecord" icon="calendar-clock" roles="HR" />
      <siteMapNode title="Late In/Early Out Violation" controller="report" action="lateinearlyoutdiscipline" icon="alarm" roles="HR" />
      <siteMapNode title="Working Hours Statistic" controller="report" action="workinghoursstatistic" icon="alarm-plus" roles="HR" />
      <siteMapNode title="Head Count Report" controller="report" action="headcount" icon="account" roles="HR" />
      <siteMapNode title="Bio Station Management" controller="BioStationManagement" action="Index" icon="fingerprint" roles="HR" />
    </siteMapNode>
    <siteMapNode title="Company Space" roles="Member">
      <siteMapNode title="Staff Info" controller="employee" action="index" icon="folder-account" roles="Member" />
      <siteMapNode title="Staff TOEIC Score" controller="toeic" action="toeicmanagement" icon="trophy-award" roles="Member" />
      <siteMapNode title="Working Calendar" controller="calendar" action="workingcalendars" icon="calendar" roles="Member" />
      <siteMapNode title="Employee Requests" controller="request" action="employeeview"  icon="account-box" roles="Member" />
      <siteMapNode title="Attendance Report" controller="report" action="attendance" icon="bulletin-board" roles="Member" />
      <siteMapNode title="Late In/Early Out" controller="report" action="lateinearlyout" icon="alarm" roles="Member" />
      <siteMapNode title="Leave Summary" controller="annualleave" action="index" icon="clipboard-text" roles="Member" />
      <siteMapNode title="NEX Summary" controller="overtime" action="overtimesummary" icon="clipboard-text" roles="Member" />
      <siteMapNode title="Total Working Hours" controller="report" action="totalworkinghour" icon="alarm-plus" roles="Member" />
      <siteMapNode title="Geolocation Map" controller="geographicmap" action="index" icon="map-marker" roles="Member" />
      <siteMapNode title="Extension Numbers" controller="ExtensionNo" action="index" icon="cellphone" roles="Member" />
      <siteMapNode title="Company Memo" controller="memo" action="index" icon="file-document-box" roles="Member" />
      <siteMapNode title="Company Event" controller="companyevent" action="index" icon="file-document-box" roles="Member" />
    </siteMapNode>
  </siteMapNode>
</siteMap>