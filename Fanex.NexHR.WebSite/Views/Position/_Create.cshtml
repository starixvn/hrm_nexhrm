@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.CreatePositionViewModel

<form id="create-form" asp-action="create" data-ajax="true" data-ajax-method="post" data-ajax-success="position.onSuccess">
    <div asp-validation-summary="All"></div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.Name</label>
            </div>
            <div class="left select--l">
                <input asp-for="@Model.PositionName"/>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.Code</label>
            </div>
            <div class="left select--l">
                <input asp-for="@Model.PositionCode"/>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.DisplayOrder</label>
            </div>
            <div class="left select--l">
                <input asp-for="@Model.DisplayOrder" type="number" min="0"/>
            </div>
        </div>
    </div>
</form>