@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.ManagementGrade.UpdateManagementGradeViewModel

@{
	DateTime currentDate = DateTime.Today;
	var managementGrade = ViewBag.ManagementGrade;
	var hasOldManagementGrade = Model.OldManagementGradeId > 0;
}

<form id="frmUpdateManagementGrade" class="form management-grade">
	<div id="divManagementErrorCont" class="">
		&nbsp;
	</div>
	<div class="row form-input">
		<div class="col employee-name">
			<div class="left label--l">
				<label>@Labels.Employee</label>
			</div>
			<div class="left input--m">
				@Model.Employee
				<input asp-for="EmployeeId" type="hidden"/>
			</div>
		</div>
	</div>
	@if (hasOldManagementGrade)
	{
		<div class="row form-input">
			<div class="col">
				<div class="left label--l">
					<label>@Labels.CurrentGrade</label>
				</div>
				<div class="left select--m">
					<select asp-for="OldManagementGradeId" asp-items="@(new SelectList(managementGrade, "Id", "Name"))" disabled>
					</select>
					<input asp-for="OldManagementGradeId" type="hidden" />
				</div>
			</div>
		</div>
	}
	<div class="row form-input">
		<div class="col">
			<div class="left label--l">
				<label>@Labels.NewGrade</label>
			</div>
			<div class="left select--m">
				<select asp-for="ManagementGradeId" asp-items="@(new SelectList(managementGrade, "Id", "Name"))"></select>
			</div>
		</div>
	</div>
	<div class="row form-input">
		<div class="col">
			<div class="left label--l">
				<label>@Labels.EffectiveDate</label>
			</div>
			<div class="datepicker-button left">
				<date-picker name="ManagementEffectiveDate" value="currentDate"></date-picker>
				<i class="mdi-action-event calendar-icon left"></i>
			</div>
		</div>
	</div>
	<div class="row form-input">
		<div class="col">
			<div class="left label--l">
				<label>@Labels.Remark</label>
			</div>
			<div class="left input--m">
				<textarea class="textarea" asp-for="Note" />
			</div>
		</div>
	</div>
	@if (hasOldManagementGrade)
	{
		<div class="row form-input">
			<div class="col">
				<div class="left label--l">
					<label class="promotion-label">@Labels.Promotion</label>
				</div>
				<div class="left input--m">
					<input asp-for="IsPromotion" type="checkbox" class="styled-checkbox"/>
				</div>
			</div>
		</div>
	}
</form>