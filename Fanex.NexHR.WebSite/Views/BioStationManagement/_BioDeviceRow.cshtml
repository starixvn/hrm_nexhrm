@using Fanex.NexHR.ViewModels.Bio
@model BioDeviceViewModel

<tr id="bio-device-@Model.DeviceId">
    <td>@Model.DeviceId</td>
    <td>@Model.DeviceName</td>
    <td>@Model.DisplayName</td>
    <td>@Model.ActiveLabel</td>
    <td>@Model.Status</td>
    <td>
        <a data-ajax="true" data-ajax-mode="replace" data-ajax-update="#dialog" href="@Url.Action("EditBioDevice", new { id = Model.DeviceId })"
           data-ajax-success="bioManagement.onLoadingEditBioSuccess">
            <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
        </a>
       
        <a id="reload-bio-@Model.DeviceId" class="hide" data-ajax="true" data-ajax-mode="replace-with" data-ajax-update="#bio-device-@Model.DeviceId" 
           href="@Url.Action("ReloadBioDevice", new { id = Model.DeviceId })">
        </a>
    </td>
</tr>