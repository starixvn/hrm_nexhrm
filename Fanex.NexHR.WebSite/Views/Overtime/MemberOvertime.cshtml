@using Fanex.NexHR.ViewModels.Overtime
@model MemberOvertimeViewModel
<div class="loading-process" style="display: none;"></div>
<div class="form form-stl-table">
    <form id="form">
        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
        <div class="row form-input">
            <div class="col m-r--l">
                <div class="left label--m">
                    <label>@Labels.DateRange</label>
                </div>
                <div class="left select--s">
                    @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFilter.DateRange)
                </div>
            </div>
            <div class="col-two-item">
                <div class="col m-r--l">
                    <div class="left label--l">
                        @Html.LabelFor(model => model.FromDate)
                    </div>
                    <div class="left datepicker-button select--s">
                        @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1))
                        <i class="mdi-action-event calendar-icon left"></i>
                    </div>
                </div>
                <div class="col m-r--xl">
                    <div class="left label--m">
                        @Html.LabelFor(model => model.ToDate)
                    </div>
                    <div class="left datepicker-button select--s">
                        @Html.DatePickerFor(model => model.ToDate)
                        <i class="mdi-action-event calendar-icon left"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="row form-input">
            <div class="col m-r--l">
                <div class="left label--m">
                    @Html.LabelFor(m => m.Status)
                </div>
                <div class="left select--s">
                    @RazorHelper.StatusDropDownList((byte)Model.Status, true, "Status")
                </div>
            </div>
            <div class="col m-r--l">
                <div class="left label--l">
                    @Html.LabelFor(model => model.CreatedName, Labels.RequestedBy)
                </div>
                <div class="left input--m">
                    @Html.HiddenFor(m => m.CreatedBy)
                    @Html.TextBoxFor(m => m.CreatedName, new { placeholder = Messages.SearchEmployeeWatermark })
                </div>
            </div>
            <div class="col m-r--l m-l--s">
                <div class="left input--m">
                    <input class="btn-submit waves-effect waves-light m-r--m" type="button" value="@Labels.Submit" id="btn-submit" />
                    @if (!Fanex.NexHR.Web.Utilities.UserHasOnlyHRRole())
                    {
                        <a class="btn-request waves-effect waves-light" href="@Url.Action("Create")">@Labels.NewRequest</a>
                    }
                </div>
            </div>
        </div>
    </form>
</div>
<div class="p-x--s">
    <table id="dataMemberOT" class="table bordered striped highlight table-custom centered">
        <thead>
            <tr>
                <th>#</th>
                <th>@Labels.RequestedBy</th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.TotalHours</th>
                <th>@Labels.TotalMembers</th>
                <th>@Labels.Project</th>
                <th>@Labels.Status</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script type="text/javascript">
    var isOnlyHRRole = '@Fanex.NexHR.Web.Utilities.UserHasOnlyHRRole()' === 'True';
</script>