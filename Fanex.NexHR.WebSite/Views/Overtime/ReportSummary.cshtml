@model IEnumerable<Overtime>

@{
    Layout = null;
    var index = 1;
}
@if (Model.Any())
{
    foreach (var item in Model)
    {
        <tr>
            <td>@(index++)</td>
            <td>@item.CreatedBy.NickName</td>
            <td class="align-left">@item.CreatedBy.FullName</td>
            <td>@item.Date.ToDateMonthYearFormatedDate()</td>
            <td>@item.Hour</td>
            <td>@Html.ActionLink(item.TotalMember.ToString(), "overtimerequest", "report", new { @CreatedBy = item.CreatedBy.Id, @FromDate = item.Date.ToString("dd MMMM, yyyy"), @ToDate = item.Date.ToString("dd MMMM, yyyy"), @Status = item.Status }, null)</td>
            <td class="tooltip" title="@item.Description">
                <span class="mdi mdi-message-text" alt="remark" />
            </td>

            @if (item.Status == (int)RequestStatuse.Pending)
            {
                <td>
                    <a requestid="@item.Id" href="javascript:;" class="@RequestStatuse.Pending.ToString() c-pending">
                        @Labels.Pending<i class="mdi-navigation-arrow-drop-down"></i>
                    </a>
                </td>
            }
            @if (item.Status == (int)RequestStatuse.Approve)
            {
                <td>
                    <a requestid="@item.Id" href="javascript:;" class="@RequestStatuse.Approve.ToString() c-approve">
                        @Labels.Approved<i class="mdi-navigation-arrow-drop-down"></i>
                    </a>
                </td>
            }

            @if (item.Status == (int)RequestStatuse.Reject)
            {
                <td class="c-reject">
                    @Labels.Rejected
                </td>
            }

        </tr>
    }
}
else
{
    <tr>
        <td colspan="8"></td>
    </tr>
    <tr>
        <td colspan="8">@Labels.NoData</td>
    </tr>
}