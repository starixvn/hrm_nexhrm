@model List<ExtensionNoViewModel>
@section css {
}
@section js {
    @Scripts.Render("~/bundles/extensionnojs");
}
@{
    ViewBag.Title = Labels.ExtensionNumber;
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s9 l9 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form hidden">
                        @if (Roles.IsUserInRole("HR"))
                        {
                            <div class="col">
                                @Html.ActionLink("New Extension Number", "AddNewMember", null, new { @class = "white-text btn-request waves-effect waves-light m-r--s" })
                                @Html.ActionLink("Manage External Group", "ManageExternalGroup", null, new { @class = "white-text btn-submit waves-effect waves-light m-r--s" })
                            </div>
                        }
                    </div>
                    <div class="p-x--s">
                        <table class="data table bordered striped highlight table-custom centered" id="data">
                            <thead>
                                <tr>
                                    <th>
                                        #
                                    </th>
                                    <th>
                                        Full Name
                                    </th>
                                    <th>
                                        Nick
                                    </th>
                                    <th>
                                        Extension Number
                                    </th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th>
                                            Edit
                                        </th>
                                        <th>
                                            Delete
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    int index = 1;
                                    foreach (Fanex.NexHR.ViewModels.ExtensionNoViewModel item in Model)
                                    {
                                        if (item.ListExt.Count > 0)
                                        {
                                    <tr>
                                        <td class="rowdivider align-left" colspan="19">
                                            <b>@item.Name.ToUpper()</b>
                                        </td>
                                    </tr>
                                        }
                                        foreach (Fanex.NexHR.Models.ExtensionNoModel ext in item.ListExt)
                                        {
                                    <tr id="@ext.EmpExtId">
                                        <td>
                                            @(index++)
                                        </td>
                                        <td class="align-left">
                                            @ext.FullName
                                        </td>
                                        <td>
                                            @ext.NickName
                                        </td>
                                        <td style="color: #0789D1;">
                                            @ext.ExtensionNo
                                        </td>
                                        @if (Roles.IsUserInRole("HR"))
                                        {
                                            <td>
                                                <a href="@Url.Action("EditExtensionNumber", "ExtensionNo", new { isInternal = ext.IsInternal, empExtID = ext.EmpExtId })">
                                                    <i class='mdi mdi-border-color mdi-dark'></i></a>
                                            </td>
                                            <td>
                                                <a href="javascript:;" class="deleteExt"><i class='mdi mdi-delete mdi-dark'></i>
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                        }
                                    }
                                }
                                else
                                {
                                    @RazorHelper.DisplayNoInformation(colspan: 5);
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
