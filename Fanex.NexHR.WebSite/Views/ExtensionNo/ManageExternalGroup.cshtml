@model List<ExtensionNoModel>
@section css {
}
@section js {
    @Scripts.Render("~/bundles/extensionnojs");
}
@{
    ViewBag.Title = "External Group";
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="row form-input p-y--m">
                        <div class="col">
                            <a id="btnNewExternalGroup" class="btn-request waves-effect waves-light" href="javascript:;">@Labels.NewExternalGroup</a>
                        </div>
                    </div>
                    <div class='p-x--s'>
                        <table id="data" class="table bordered striped highlight table-custom centered">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.GroupName</th>
                                    <th>@Labels.Edit</th>
                                    <th>@Labels.Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    int index = 1;
                                    foreach (ExtensionNoModel item in Model)
                                    {
                                    <tr id="@item.TeamId">
                                        <td>
                                            @(index++)
                                        </td>
                                        <td class="align-left">
                                            <span class="groupName">@item.TeamName</span>
                                        </td>
                                        <td>
                                            <a href="javascript:;" class="editExternal">
                                                <i class='mdi mdi-border-color mdi-dark'></i>
                                            </a>
                                        </td>
                                        <td>
                                            @if (item.TotalMember > 0)
                                            {
                                                <a href="javascript:;" style="cursor: default">
                                                    <i class='mdi mdi-delete mdi-disabled mdi-dark mdi-18px'></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="javascript:;" class="deleteExternal">
                                                    <i class='mdi mdi-delete mdi-dark mdi-18px'></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                    }
                                }
                                else
                                {
                                    @RazorHelper.DisplayNoInformation(colspan: 4);
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="dialog-form" title="Add new External Group">
                        <p class="validateTips"></p>
                        <form class="form">
                        <div class="row form-input">
                            <div class="left label--m left-align">
                                <label>@Labels.GroupName</label>
                            </div>
                            <div class="left input--m input">
                                <input type="text" name="name" id="name" class="text ui-widget-content ui-corner-all" />
                            </div>
                        </div>
                        </form>
                    </div>
                    <div id="dialog-form_edit" title="Update External Group" style="display: none">
                        <p class="validateTips"></p>
                        <form class="form">
                        <div class="row form-input">
                            <div class="left label--l left-align">
                                <label>@Labels.GroupName</label>
                            </div>
                            <div class="left input--m input">
                                <input type="text" name="name" id="name_edit" class="text ui-widget-content ui-corner-all" />
                            </div>
                        </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
