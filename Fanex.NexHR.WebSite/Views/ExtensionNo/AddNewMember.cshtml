@using Fanex.NexHR.Core
@model Fanex.NexHR.Models.ExtensionNoModel
@{
    ViewBag.Title = "New Extension Number";
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/addextensionnojs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 l7 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @{ Html.EnableClientValidation(false); }
                        @using (Html.BeginForm())
                        {
                            @Html.ValidationSummary()

                            if (ViewBag.Requested == true)
                            {
                            <div class="row validation-summary-success">
                                <div class="col success green-text">
                                    <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>Extension number has
                                    been created successfully!</div>
                            </div>
                            <input type="hidden" id="successed" value="true" />
                            }

                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.IsInternal, Labels.IsInternal)
                                    </div>
                                    <div class="left input">
                                        @Html.MaterializeCheckBoxFor(model => model.IsInternal, new { @class = "filled-in" })
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.Label("Group")
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new List<SelectListItem>(), "all")
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input" id="EmployeeField">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.Employee)
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FullName, Labels.FullName)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.FullName)
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.NickName, Labels.Nickname)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.NickName)
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.ExtensionNo, Labels.ExtensionNo)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.ExtensionNo)
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">&nbsp;
                                        @Html.Hidden("EmpId")
                                        @Html.Hidden("IsAddForm", true)
                                    </div>
                                    <span class="button-hrm waves-effect waves-light btn orange darken-2 m-r--s">
                                        <input type="submit" value="@Fanex.NexHR.Resources.Labels.Add" /></span> <a class="button-hrm waves-effect waves-light btn grey darken-1"
                                            href="~/extensionno/index">@Labels.Back</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
