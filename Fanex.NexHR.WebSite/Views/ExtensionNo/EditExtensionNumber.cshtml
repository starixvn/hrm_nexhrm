@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model ExtensionNoModel
@{
    ViewBag.Title = "Update Extension Number";
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/ExtensionNo/addextensionno.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/addextensionno.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <form action="/ExtensionNo/EditExtensionNumber?isInternal=@Model.IsInternal&empExtID=@Model.EmpExtId" method="post">
                            <div asp-validation-summary="All"></div>
                            @if ((bool)ViewBag.Updated)
                            {
                                <div class="row validation-summary-success">
                                    <div class="col success green-text">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>Extension number has
                                        been updated successfully!
                                    </div>
                                </div>
                                <input type="hidden" id="successed" value="true" />
                            }

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label asp-for="@Model.IsInternal">@Labels.IsInternal</label>
                                    </div>
                                    <div class="left checkbox">
                                        <input class="filled-in" id="IsInternal" name="IsInternal" type="checkbox" value="true">
                                        <label for="IsInternal"></label>
                                        <input name="IsInternal" type="hidden" value="false">
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input m-t--s">
                                <div class='col'>
                                    <div class="left label--l">
                                        <label asp-for="@Labels.Group">@Labels.Group</label>
                                    </div>
                                    <div class="left select--m">
                                        <select asp-for="@Model.TeamId" asp-items="@(List<SelectListItem>)ViewBag.Group">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input" id="EmployeeField">
                                <div class='col'>
                                    <div class="left label--l">
                                        <label asp-for="@Model.Employee">@Labels.Employee</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="@Model.Employee"/>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        <label asp-for="@Model.FullName">@Labels.FullName</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="@Model.FullName"/>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        <label asp-for="@Model.NickName">@Labels.EnglishName</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="@Model.NickName"/>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        <label asp-for="@Model.ExtensionNo">@Labels.ExtensionNo</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="@Model.ExtensionNo"/>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input line-button">
                                <div class='col'>
                                    <div class="left label--l">
                                        &nbsp;
                                        <input type="hidden" asp-for="EmpId"/>
                                    </div>
                                    <div class="left">
                                        <a class="btn-back waves-effect waves-light" href="@Url.Action("Index","ExtensionNo")">@Labels.Cancel</a>
                                        <input class="btn-submit waves-effect waves-light right" type="submit" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
