@using Fanex.NexHR.Models.Memo
@model Memo
@{
    var memoSubject = Model != null ? Model.Subject : Labels.NoData;
    ViewBag.Title = memoSubject + " - " + Labels.Memo;
}
@section css {
}
@section js {
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.EditMemo</span>
                </div>
                <div class="card-body">
                    <div class='p-x--s'>
                        @if (!ReferenceEquals(Model, null))
                        {
                            <table class="data memo table bordered striped highlight table-custom">
                                <thead>
                                    <tr>
                                        <th colspan="4">@Model.Subject</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><b>@Labels.To</b></td>
                                        <td>@Model.SentTo</td>
                                        <td><b>@Labels.RefNo</b></td>
                                        <td><b>@Model.RefNo</b></td>
                                    </tr>
                                    <tr>
                                        <td><b>@Labels.ForInfo</b></td>
                                        <td>@Model.ForInfo</td>
                                        <td><b>@Labels.TotalPages</b></td>
                                        <td>@Model.TotalPages</td>
                                    </tr>
                                    <tr>
                                        <td><b>@Labels.From</b></td>
                                        <td>@Model.SentFrom</td>
                                        <td><b>@Labels.Date</b></td>
                                        <td>
                                            @Model.SentDate.ToDateMonthYearFormatedDate()
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><b>Category</b></td>
                                        <td colspan="3"><b>@Model.CategoryName</b></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4">
                                            @Html.Raw(Model.Contents)
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <a href="@Url.Action("index")" class="btn-back waves-effect waves-light m-t--m">@Labels.Back</a>
                        }
                        else
                        {
                            <h2>@Messages.ThisContentHasAlreadyBeenDeleted</h2>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
