@using Fanex.NexHR.Core;
@using Fanex.NexHR.Models
@model Fanex.NexHR.ViewModels.MemoViewModel
@{
    ViewBag.Title = Labels.CompanyMemo;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/memoindexjs");
}
@section Breadcrumb {
}
<div class="loading-process" style="display: none">
</div>
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        <div class="form">
                            <div class='row form-input'>
                                <div class="col" style="display: none;">
                                    <div class='left label--m'>
                                        @Html.LabelFor(model => model.Content)
                                    </div>
                                    <div class='left input--l'>
                                        @Html.TextBoxFor(model => model.Content)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class='col m-r--m'>
                                    <div class='left label--s'>
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class='left label--m'>
                                        @Html.LabelFor(model => model.Category)
                                    </div>
                                    <div class="left select--s">
                                        @Html.DropDownListFor(model => model.Category, new SelectList(ViewBag.MemoCategories, "id", "Name"), new SelectListItem() { Value = "-1", Text = "All" }, new { @class = "aaaa" })
                                    </div>
                                </div>
                                <div class='col'>
                                    <a href="javascript:;" id="submit" class="button-hrm waves-effect waves-light btn white-text blue darken-2 m-r--s">
                                        Submit</a> @*<input type="submit" id="submit" class="button-hrm waves-effect waves-light btn white-text blue darken-2 m-r--s" value="@Labels.Submit" />*@
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        @Html.ActionLink("Create new Memo", "Create", null, new { @class = "button-hrm waves-effect waves-light btn white-text orange darken-1 white-text" })
                                    }
                                </div>
                            </div>
                        </div>
                            
                        <div class='p-x--s'>
                            <table id="memo" class="data persist-area table bordered striped highlight table-custom centered">
                                <thead>
                                    <tr class="persist-header">
                                        <th>
                                            #
                                        </th>
                                        <th>@Labels.RefNo
                                        </th>
                                        <th>@Labels.Subject
                                        </th>
                                        <th>
                                            Category
                                        </th>
                                        <th>@Labels.Date
                                        </th>
                                        @if (Roles.IsUserInRole("HR"))
                                        {
                                            <th>@Labels.Edit
                                            </th>
                                            <th>@Labels.Delete
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>                            
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var isHR = '@Roles.IsUserInRole("HR")' == 'True' ? true : false;    
</script>
<script id="template" type="text/x-jquery-tmpl"> 
    <tr id="row_${Id}">
        <td class='center'>
            ${index()}
        </td>
        <td>
            ${RefNo}
        </td>
        <td class="txt-left">
            <a href="/memo/detail/${Id}">${Subject}</a>
        </td>
        <td>
            ${CategoryName}
        </td>
        <td class="ddMMyyyy">
            ${formatDate(SentDate, 'dd MMM, yyyy')}                                                    
        </td>      

        {{if isHR}}
            <td title="Edit">
            <a href="/memo/edit/${Id}"><i class='mdi mdi-border-color mdi-dark'>
            </i></a>
            </td>
            <td title="Delete">
                <a href="javascript:;" onclick="deleteMemo(${Id}, '${Contents}', ${MemoType});">
                    <i class='mdi mdi-delete mdi-dark'></i></a>
            </td>                                    
        {{/if}}           
    </tr> 
</script>
