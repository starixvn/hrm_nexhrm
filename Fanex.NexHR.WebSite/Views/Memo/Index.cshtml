@using Fanex.NexHR.Core;
@using Fanex.NexHR.Models
@model Fanex.NexHR.ViewModels.MemoViewModel
@{
    ViewBag.Title = Labels.CompanyMemo;
}
@section css {
}
@section js {
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        <div class="form">
                            <div class='row form-input'>
                                <div class="col" style="display: none;">
                                    <div class='left label--m'>
                                        @Html.LabelFor(model => model.Content)
                                    </div>
                                    <div class='left input--l'>
                                        @Html.TextBoxFor(model => model.Content)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class='col m-r--m'>
                                    <div class='left label--s'>
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--s">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class='left label--m'>
                                        @Html.LabelFor(model => model.Category)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.Category, new SelectList(ViewBag.MemoCategories, "id", "Name"), new SelectListItem() { Value = "-1", Text = "All" }, new { @class = "aaaa" })
                                    </div>
                                </div>
                                <div class='col'>
                                    <span class="button-hrm waves-effect waves-light btn white-text blue darken-2 m-r--s">
                                        <input type="submit" id="submit" class="processing-submit" value="@Labels.Submit" />
                                    </span>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <span class="button-hrm waves-effect waves-light btn white-text orange darken-1">@Html.ActionLink("Create new Memo", "Create", null, new { @class = "white-text" })</span>
                                    }
                                </div>
                            </div>
                        </div>
                            
                        <div class='p-x--s'>
                            <table id="memo" class="data persist-area table bordered striped highlight table-custom">
                                <thead>
                                    <tr class="persist-header">
                                        <th>
                                            #
                                        </th>
                                        <th>@Labels.RefNo
                                        </th>
                                        <th>@Labels.Subject
                                        </th>
                                        <th>
                                            Category
                                        </th>
                                        <th>@Labels.Date
                                        </th>
                                        @if (Roles.IsUserInRole("HR"))
                                        {
                                            <th>@Labels.Edit
                                            </th>
                                            <th>@Labels.Delete
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                @if (ViewBag.EntityList.Count > 0)
                                {
                                    <tbody>
                                        @{int index = 1;}
                                        @foreach (Memo item in ViewBag.EntityList)
                                        {

                                            <tr id="row_@item.Id">
                                                <td class='center'>@(index++)
                                                </td>
                                                <td>
                                                    @item.RefNo
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("detail", "memo", new { Id = item.Id })">@item.Subject</a>
                                                </td>
                                                <td>
                                                    @item.CategoryName
                                                </td>
                                                <td class="ddMMyyyy">
                                                    @item.SentDate.ToDateMonthYearFormatedDate()
                                                </td>
                                                @if (Roles.IsUserInRole("HR"))
                                                {
                                                    <td class="center" title="Edit">
                                                        <a href="@Url.Action("edit", "memo", new { Id = item.Id })"><i class='mdi mdi-border-color mdi-dark'>
                                                        </i></a>
                                                    </td>
                                                    <td class="center" title="Delete">
                                                        <a href="javascript:;" onclick="deleteMemo(@item.Id, '@System.Web.HttpUtility.HtmlEncode(item.Contents)', @item.MemoType);">
                                                            <i class='mdi mdi-delete mdi-dark'></i></a>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                }
                                else
                                {
                                    @RazorHelper.DisplayNoInformation(7)
                                }
                            </table>
                        </div>                            
                    }
                </div>
            </div>
        </div>
    </div>
</div>
