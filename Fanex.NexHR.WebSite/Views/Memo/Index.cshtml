@model MemoViewModel
@{
    ViewBag.Title = Labels.CompanyMemo;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/memoindexjs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        <div class="form">
                            <div class='row form-input'>
                                <div class="col" style="display: none;">
                                    <div class='left label--m'>
                                        @Html.LabelFor(model => model.Content)
                                    </div>
                                    <div class='left input--l'>
                                        @Html.TextBoxFor(model => model.Content)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class='col m-r--m'>
                                    <div class='left label--s'>
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class='left label--m'>
                                        @Html.LabelFor(model => model.Category)
                                    </div>
                                    <div class="left select--s">
                                        @Html.DropDownListFor(model => model.Category, new SelectList(Model.MemoCategories, "Id", "Name"), new SelectListItem() { Value = "-1", Text = "All" })
                                    </div>
                                </div>
                                <div class='col m-l--m'>
                                    <div class='left label--s'>
                                        @Html.LabelFor(model => model.Status)
                                    </div>
                                    <div class="left select--s">                                        
                                        @Html.DropDownListFor(model => model.Status, Model.StatusTypes)
                                    </div>
                                </div>
                                <div class='col'>
                                    <a href="javascript:;" id="submit" class="btn-submit waves-effect waves-light m-r--b">@Labels.Submit</a>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        @Html.ActionLink("Create New Memo", "Create", null, new { @class = "btn-request waves-effect waves-light" })
                                    }
                                </div>
                            </div>
                        </div>
                        <div class='p-x--s'>
                            <table id="memo" class="data table bordered striped highlight table-custom centered">
                                <thead>
                                    <tr>
                                        <th>@Labels.SymbolCount</th>
                                        <th>@Labels.RefNo</th>
                                        <th>@Labels.Subject</th>
                                        <th>@Labels.Category</th>
                                        <th>@Labels.Date</th>
                                        <th>@Labels.Status</th>
                                        @if (Roles.IsUserInRole("HR"))
                                        {
                                            <th>@Labels.Edit</th>
                                            <th>@Labels.Delete</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/x-jsrender"> 
    <tr id="row_{{:Id}}">
        <td>{{:~index()}}</td>
        <td>{{:RefNo}}</td>
        <td class="align-left">
            <a href="/memo/detail/{{:Id}}">{{:Subject}}</a>
        </td>
        <td>{{:CategoryName}}</td>
        <td>
            {{:~formatDate(SentDate, 'dd MMM, yyyy')}}
        </td>
        <td>{{:Status==1?"Active":"Deactive"}}</td>
        {{if ~isHRRole}}
            <td title="Edit">
                <a href="/memo/edit/{{:Id}}">
                    <i class='mdi mdi-border-color mdi-dark'></i>
                </a>
            </td>
            <td title="Delete">
                <a href="javascript:;" onclick="deleteMemo({{:Id}}, '{{:Contents}}', {{:MemoType}});">
                    <i class='mdi mdi-delete mdi-dark'></i>
                </a>
            </td>
        {{/if}}
    </tr> 
</script>
