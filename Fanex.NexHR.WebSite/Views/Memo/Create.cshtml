@using Fanex.NexHR.Core
@model Fanex.NexHR.Models.Memo
@{
    ViewBag.Title = Labels.CompanyMemo;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/memoeditjs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 l10 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.CreateMemo</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm())
                        {
                            <div class="container_24 bunhat">
                                <div class="validation-summary-errors" id="error">
                                </div>
                                @if ((bool)ViewBag.Updated)
                                {
                                    <div class="success flash">
                                        Created Successful!</div>
                                }
                                @Html.HiddenFor(model => model.Id)
                                @Html.HiddenFor(model => model.TotalPages)
                                @Html.HiddenFor(model => model.AttachFile)
                                @Html.HiddenFor(model => model.MemoType)
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.Subject, Labels.Subject)
                                        </div>
                                        <div class="left input-subject">
                                            @Html.EditorFor(model => model.Subject)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.RefNo, Labels.RefNo)
                                        </div>
                                        <div class="left input--m">
                                            @Html.EditorFor(model => model.RefNo)
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.Category)
                                        </div>
                                        <div class="left select--s">
                                            @Html.DropDownListFor(model => model.Category, new SelectList(ViewBag.MemoCategories, "Id", "Name"))
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.ForInfo, Labels.ForInfo)
                                        </div>
                                        <div class="left input--m">
                                            @Html.EditorFor(model => model.ForInfo)
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.SentDate, Labels.SentDate)
                                        </div>
                                        <div class="datepicker-button left select--s">
                                            @Html.DatePickerFor(model => model.SentDate)
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.SentTo, Labels.SentTo)
                                        </div>
                                        <div class="left input--m">
                                            @Html.EditorFor(model => model.SentTo)
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.SentFrom, Labels.SentFrom)
                                        </div>
                                        <div class="left input--m">
                                            @Html.EditorFor(model => model.SentFrom)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.SendMail, Labels.SendMail)
                                        </div>
                                        <div class="left">
                                            @Html.MaterializeCheckBoxFor(model => model.SendMail, new { @class = "filled-in" })
                                            @Html.ValidationMessageFor(model => model.SendMail)
                                        </div>
                                        <div class="left label--xl">
                                            <label for="SendMail">@Labels.SendToAllEmployee</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--m">
                                            &nbsp</div>
                                        <div class="left">
                                            @{
                                var types = new List<SelectListItem>
            {
                new SelectListItem() {Text = "Upload", Value = "1", Selected = true},
                new SelectListItem() {Text = "FCK Editor", Value = "0"},
            };    
                                            }
                                            @Html.RadioButtonList(model => model.MemoType, types)
                                        </div>
                                    </div>
                                </div>
                                <div id="upload" class="row form-input m-t--m">
                                    <div class="col">
                                        <div class="left label--m">
                                            &nbsp;</div>
                                        <div class="left">
                                            <input type="file" id="fileName" size="55" multiple />
                                        </div>
                                        <div class="left">
                                            @Html.MaterializeCheckBox("override", new { @class = "filled-in" })
                                        </div>
                                        <div class="left label--m">
                                            <label for="override">
                                                Override</label>
                                        </div>
                                    </div>
                                </div>
                                <div id="content" class="row form-input m-t--m">
                                    <div class="col">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.Contents)
                                        </div>
                                        <div class="left input--l">
                                            @Html.TextAreaFor(model => model.Contents)
                                        </div>
                                    </div>
                                </div>
                                <div class="row m-t--m">
                                    <div class="col">
                                        <div class="left label--m">
                                            &nbsp;
                                        </div>
                                        <div class="left">
                                            @Html.AntiForgeryToken()
                                            
                                                <input type="submit" class="button-primary submit btn-submit waves-effect waves-light m-r--m" value="@Labels.Save" />
                                            <a href="@Url.Action("index", "memo")" class="btn-back waves-effect waves-light">
                                                @Labels.Back
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
