@model Memo
@{
    ViewBag.Title = Labels.Edit;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/memoeditjs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.EditMemo</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        <div class="form">
                            @Html.ValidationSummary()
                            @if ((bool)ViewBag.Updated)
                            {
                                <div class="row validation-summary-success">
                                    <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>Edit Successful !
                                    <input type="hidden" id="successed" value="true" />
                                </div>
                            }
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.TotalPages)
                            @Html.HiddenFor(model => model.AttachFile)
                            @Html.HiddenFor(model => model.MemoType)
                            @Html.Hidden("pathName", Model.Contents)
                            <div class='row form-input'>
                                <div class='col'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Subject)
                                    </div>
                                    <div class="left input-subject">
                                        @Html.EditorFor(model => model.Subject)
                                    </div>
                                </div>
                            </div>
                            <div class='row form-input'>
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.RefNo, Labels.RefNo)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.RefNo)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Category)
                                    </div>
                                    <div class="left input--s">
                                        @Html.DropDownListFor(model => model.Category, new SelectList(Model.MemoCategories, "Id", "Name"))
                                    </div>
                                </div>
                            </div>
                            <div class='row form-input'>
                                <div class='col m-r--m'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ForInfo, Labels.ForInfo)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.ForInfo)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.SentDate, Labels.SentDate)
                                    </div>
                                    <div class="datepicker-button left select--s">
                                        @Html.DatePickerFor(model => model.SentDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class='row form-input'>
                                <div class='col m-r--m'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.SentTo, Labels.SentTo)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.SentTo)
                                    </div>
                                </div>
                                <div class='col m-r--l'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.SentFrom, Labels.SentFrom)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.SentFrom)
                                        @Html.ValidationMessageFor(model => model.SentFrom)
                                    </div>
                                </div>                                
                            </div>
                            <div class='row form-input'>
                                <div class='col m-r--m'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.SendMail, Labels.SendMail)
                                    </div>
                                    <div class="left">
                                        @Html.MaterializeCheckBoxFor(model => model.SendMail, new { @class = "filled-in" })
                                        @Html.ValidationMessageFor(model => model.SendMail)
                                    </div>
                                    <div class="left label--xl">
                                        <label for="SendMail">@Labels.SendToAllEmployee</label>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Status)
                                    </div>
                                    <div class="left input--m">
                                        @{
                        var status = new List<SelectListItem>
                                                {
                                                    new SelectListItem() {Text = "Active", Value = "1", Selected = true},
                                                    new SelectListItem() {Text = "Deactive", Value = "0"},
                                                };
                                        }
                                        @Html.RadioButtonList(model => model.Status, status)
                                    </div>
                                </div>

                            </div>
                            <div class='row form-input'>
                                <div class='col'>
                                    <div class='left label--m'>
                                        &nbsp;
                                    </div>
                                    <div class="left">
                                        @{
                        var types = new List<SelectListItem>
                                            {
                                                new SelectListItem() {Text = "Upload", Value = "1", Selected = true},
                                                new SelectListItem() {Text = "FCK Editor", Value = "0"},
                                            };
                                        }
                                        @Html.RadioButtonList(model => model.MemoType, types)
                                    </div>
                                </div>
                            </div>
                            <div id="upload">
                                <div class="row form-input m-t--m">
                                    <div class='col'>
                                        <div class='left label--m'>
                                            &nbsp;
                                        </div>
                                        <div class="left input--m">
                                            <input type="file" id="fileName" size="55" multiple />
                                        </div>
                                        <div class="left">
                                            @Html.MaterializeCheckBox("override", new { @class = "filled-in" })
                                        </div>
                                        <div class="left label--m">
                                            <label for="override">
                                                Override
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="left label--m">
                                        &nbsp;
                                    </div>
                                    <div id="attach">
                                        <div id="allAttachFile">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input" id="content">
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Contents)
                                    </div>
                                    <div class="left select--l">
                                        @Html.TextAreaFor(model => model.Contents)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-t--m">
                                <div class="col">
                                    <div class="left label--m">
                                        &nbsp;
                                    </div>
                                    @Html.AntiForgeryToken()
                                    <a class="btn-back waves-effect waves-light" href="@Url.Action("index", "memo")">@Labels.Back</a>
                                    <input type="submit" value="@Labels.Save" id="saveMemo" class="btn-submit waves-effect waves-light right" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
