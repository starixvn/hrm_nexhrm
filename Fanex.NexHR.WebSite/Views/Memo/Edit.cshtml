@using Fanex.NexHR.Core
@model Fanex.NexHR.Models.Memo
@{
    ViewBag.Title = Labels.Edit;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/memoeditjs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.EditMemo</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        <div class="form">
                            <div class="validation-summary-errors" id="error" style="display: none;">
                            </div>
                            @if ((bool)ViewBag.Updated)
                            {
                                <div class="row validation-summary-success">
                                    <div class="col success green-text">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>Edited Successful!</div>
                                </div>
                            }
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.TotalPages)
                            @Html.HiddenFor(model => model.AttachFile)
                            @Html.HiddenFor(model => model.MemoType)
                            @Html.Hidden("pathName", Model.Contents)
                            <!-- Gets replaced with TinyMCE, remember HTML in a textarea should be encoded -->
                            <div class='row form-input'>
                                <div class='col'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Subject)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Subject)
                                    </div>
                                </div>
                            </div>
                            <div class='row form-input'>
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.RefNo)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.RefNo)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Category)
                                    </div>
                                    <div class="left input--m">
                                        @Html.DropDownListFor(model => model.Category, new SelectList(ViewBag.MemoCategories, "Id", "Name"))
                                    </div>
                                </div>
                            </div>
                            <div class='row form-input'>
                                <div class='col m-r--m'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ForInfo)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.ForInfo)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.SentDate)
                                    </div>
                                    <div class="left input--m">
                                        @Html.DatePickerFor(model => model.SentDate)
                                    </div>
                                </div>
                            </div>
                            <div class='row form-input'>
                                <div class='col m-r--m'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.SentTo)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.SentTo)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.SentFrom)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.SentFrom)
                                        @Html.ValidationMessageFor(model => model.SentFrom)
                                    </div>
                                </div>
                                <div class='col'>
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.SendMail)
                                    </div>
                                    <div class="left input--m">
                                        @Html.CheckBoxFor(model => model.SendMail)<label for="SendMail">@Labels.SendToAllEmployee</label>
                                        @Html.ValidationMessageFor(model => model.SendMail)
                                    </div>
                                </div>
                            </div>
                            <div class='row form-input'>
                                <div class='col'>
                                    <div class='left label--m'>
                                        &nbsp;</div>
                                    <div class="left">
                                        @{
                            var types = new List<SelectListItem>
                                            {
                                                new SelectListItem() {Text = "Upload", Value = "1", Selected = true},
                                                new SelectListItem() {Text = "FCK Editor", Value = "0"},
                                            };
                                        }
                                        @Html.RadioButtonList(model => model.MemoType, types)
                                    </div>
                                </div>
                            </div>
                            <div id="upload">
                                <div id="upload">
                                    <div class="row form-input m-t--m">
                                        <div class='col'>
                                            <div class='left label--m'>
                                                &nbsp;</div>
                                            <div class="left input--m">
                                                <input type="file" id="fileName" size="55" multiple />
                                            </div>
                                            <div class="left input--m">
                                                <input type="checkbox" id="override" size="55" />
                                                <span>override</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="attach" class="grid_20 formrow">
                                    <div class="grid_2">
                                        <br />
                                    </div>
                                    <div class="grid_17">
                                        <div id="allAttachFile">
                                        </div>
                                    </div>
                                </div>
                                <div class="clear">
                                </div>
                                <div class="space">
                                </div>
                            </div>
                            <div class="row fomr-input" id="content">
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Contents)
                                    </div>
                                    <div class="left select--l">
                                        @Html.TextAreaFor(model => model.Contents)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-t--m">
                                <div class="col">
                                    @Html.AntiForgeryToken()
                                    <span class="button-hrm waves-effect waves-light btn orange darken-1 m-r--s">
                                        <input type="submit" value="Save" id="saveMemo" /></span> <a class="button-hrm waves-effect waves-light btn grey darken-1" href="@Url.Action("index", "memo")">@Labels.Back</a>
                                </div>
                            </div>
                        </div>                        

                        <span class="button-hrm waves-effect waves-light btn green darken-1 m-l--s">@Html.ActionLink("Back to Memo list", "index", null, new { @class = "white-text" })</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
