@using Fanex.NexHR.ViewModels.SkypeAccount
@model SkypeAccountFilter

@{
            ViewBag.Title = "Skype Account Management";
}
@section js
{
    <script src="~/Scripts/Views/SkypeAccount/skype-account.js"></script>
    <script src="~/Scripts/Views/Employee/_employee.search.in.company.js"></script>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm("GetEmployeeSkypeAccount", "SkypeAccount", FormMethod.Get, new { id = "skype-account-filter" }))
                        {
                            <div class="row form-input">
                                <div class="col m-l--l m-r--l">
                                    <div class="left label--s">
                                        @Html.Label(Labels.Team)
                                    </div>
                                    <div class="left select-team">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.IsConfirmed)
                                    </div>
                                    <div class="left input--m">
                                        @Html.DropDownListFor(model => model.IsConfirmed, new SelectListItem[] {
                                                       new SelectListItem { Value = null, Text = Labels.All },
                                                       new SelectListItem { Value = "true", Text = Labels.Yes },
                                                       new SelectListItem { Value = "false", Text = Labels.No },
                                                         }
                                                       )
                                    </div>
                                </div>

                                <div class="col">
                                    <input type="submit" value="@Labels.Submit" class="processing-submit btn-submit waves-effect waves-light m-r--m" />
                                </div>
                            </div>
                        }
                    </div>
                    <div id="list-account">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="skype-account-dialog" class="skype-dialog"></div>