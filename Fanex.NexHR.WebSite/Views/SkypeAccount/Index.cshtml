@using Fanex.NexHR.Resources
﻿@using Fanex.NexHR.ViewModels.SkypeAccount
@model SkypeAccountFilter

@{
    ViewBag.Title = "Skype Account Management";
}

@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
    @section Scripts {
    <environment include="Development">
        <script src="~/js/Views/SkypeAccount/skype-account.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/skypeaccount.min.js" asp-append-version="true"></script>
    </environment>
}

    <div class="row content">
        <div class="col s12 card-container-base">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                    </div>
                    <div class="card-body">
                        <div class="form form-stl-table">
                            <form asp-controller="SkypeAccount" asp-action="GetEmployeeSkypeAccount" method="get" id="skype-account-filter">
                                <div class="row form-input">
                                    <div class="col m-l--l m-r--l">
                                        <div class="left label--s">
                                            <label>@Labels.Team</label>
                                        </div>
                                        <div class="left select-team">
                                            <select asp-for="TeamId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                                <option value="">@Labels.All</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col m-r--l">
                                        <div class="left label--m">
                                            <label>@Labels.Employee</label>
                                        </div>
                                        <div class="left input--m">
                                            <input asp-for="@Model.Employee" placeholder="@Messages.SearchEmployeeWatermark" />
                                            <input type="hidden" asp-for="@Model.EmployeeId" />
                                        </div>
                                    </div>
                                    <div class="col m-r--l">
                                        <div class="left label--m">
                                            <label>Confirmed</label>
                                        </div>
                                        <div class="left input--m">
                                            <select asp-for="IsConfirmed">
                                                <option value=null>@Labels.All</option>
                                                <option value="true">@Labels.Yes</option>
                                                <option value="false">@Labels.No</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <input type="submit" value="@Labels.Submit" class="processing-submit btn-submit waves-effect waves-light m-r--m" />
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div id="list-account" class="p-x--s over-auto">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="skype-account-dialog" class="skype-dialog"></div>
