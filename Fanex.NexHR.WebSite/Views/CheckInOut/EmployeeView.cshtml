@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.MyCheckInOutRequests;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render("~/bundles/empcheckinoutjs")
}
@section Breadcrumb {
}
<div class="row content">    
    @using (Html.BeginForm("employeeview", "checkinout", FormMethod.Post))
    {
        <div class="col s12 card-container-base my-request">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                    </div>
                    <div class="card-body">
                        <div class="form">
                            <div class="row form-input">
                                <input type="hidden" value="CheckInOut" id="RequestType" />
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label>
                                            @Labels.Year:</label>
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPicker("Year", 2010, (int)ViewBag.Year)
                                    </div>
                                </div>
                                <div class="col button">
                                    <span class="button-hrm waves-effect waves-light btn blue darken-2"><input type="submit" id="submit" value="@Labels.Submit" /></span>
                                </div>
                                <div class="col button">
                                    <a href="@Url.Action("Create")" class="button-hrm waves-effect waves-light btn orange darken-1">Check In/Out Request</a>
                                </div>
                            </div>
                        </div>

                        <div class="p-x--s">
                            <table class="table bordered striped highlight centered table-custom">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>@Labels.Employee
                                        </th>
                                        <th>@Labels.Team
                                        </th>
                                        <th>@Labels.Request
                                        </th>
                                        <th>@Labels.Shift
                                        </th>
                                        <th>@Labels.RequestDate
                                        </th>
                                        <th>@Labels.CreatedDate
                                        </th>
                                        <th>@Labels.Status
                                        </th>
                                    </tr>
                                </thead>
                                @if (Model.Count > 0)
                                {
                                    <tbody>
                                        @{int index = 1;}
                                        @{string selectedClass = string.Empty;}
                                        @foreach (RequestEntity request in Model)
                                        {
                                            selectedClass = (index % 2 == 0) ? "class=odd" : string.Empty;

                                            <tr  @selectedClass id="row@(request.Id)">
                                                <td>@(index++)
                                                </td>
                                                <td class="tooltip" title="@request.Requester.FullName">
                                                    @request.Requester.NickName
                                                </td>
                                                <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code
                                                </td>
                                                <td class="highlight">@request.RequestType.ToString()
                                                </td>
                                                <td class="highlight">@request.FromShift.Name.ToString()
                                                </td>
                                                <td class="highlight">@request.FromDate.ToShortFormatedDate()
                                                </td>
                                                <td>@request.CreatedDate.ToShortFormatedDate()
                                                </td>
                                                @if (request.Status.ToString() == RequestStatuse.Pending.ToString())
                                                {
                                                    <td>
                                                        <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() c-pedding">@request.Status.ToString()</a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td class="tooltip c-approve" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                }
                                else
                                {
                                    @RazorHelper.DisplayNoInformation(colspan: 10);
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>  
    }
    @RazorHelper.EmployeeProcessMenu()
</div>