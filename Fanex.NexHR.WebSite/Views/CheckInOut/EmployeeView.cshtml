@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.MyCheckInOutSummary;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render(
        "~/bundles/contextmenujs",
        "~/bundles/empcheckinoutjs")
}
@section Breadcrumb {
}

<div class="row content">
    @using (Html.BeginForm("employeeview", "checkinout", FormMethod.Post))
    {
        <div class="col s12 card-container-base my-request">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                    </div>
                    <div class="card-body">
                        <div class="form">
                            <div class="row form-input">
                                <input type="hidden" value="CheckInOut" id="RequestType" />
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label>@Labels.Year</label>
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPicker("Year", 2010, DateTime.Now.Year)
                                    </div>
                                </div>
                                <div class="col">
                                    <a id="submit" class="btn-submit waves-effect waves-light m-r--s" href="javascript:;">@Labels.Submit</a>
                                    <a class="btn-request waves-effect waves-light" href="@Url.Action("Create")">@Labels.CheckInOutRequest</a>
                                </div>
                            </div>
                        </div>
                        <div id="list-check-in-out-request" class="p-x--s">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>