@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.MyCheckInOutRequests;
}
@section css{
}
@section js{
}
@section Breadcrumb {
}
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    <input type="hidden" value="CheckInOut" id="RequestType" />

    <span>Year:</span>
    @Html.YearPicker("Year", 2010, (int)ViewBag.Year)

    <input type="submit" id="submit" value="@Labels.Submit" class="button-primary submit processing-submit" />
    <div class="button-icon">
        <span class="icon plus"></span>@Html.ActionLink("Check In/Out Request", "Create")</div>
    <table class="table bordered striped highlight table-custom">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>@Labels.Employee
                </th>
                <th>@Labels.Team
                </th>
                <th>@Labels.Request
                </th>
                <th>@Labels.Shift
                </th>
                <th>@Labels.RequestDate
                </th>
                <th>@Labels.CreatedDate
                </th>
                <th>@Labels.Status
                </th>
            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            <tbody>
                @{int index = 1;}
                @{string selectedClass = string.Empty;}
                @foreach (RequestEntity request in Model)
                {
                    selectedClass = (index % 2 == 0) ? "class=odd" : string.Empty;

                    <tr  @selectedClass id="row@(request.Id)">
                        <td>@(index++)
                        </td>
                        <td class="tooltip" title="@request.Requester.FullName">
                            @request.Requester.NickName
                        </td>
                        <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code
                        </td>
                        <td class="highlight">@request.RequestType.ToString()
                        </td>
                        <td class="highlight">@request.FromShift.Name.ToString()
                        </td>
                        <td class="ddMMyyyyhhmm highlight">@request.FromDate.ToShortFormatedDate()
                        </td>
                        <td class="ddMMyyyyhhmm">@request.CreatedDate.ToShortFormatedDate()
                        </td>
                        @if (request.Status.ToString() == RequestStatuse.Pending.ToString())
                        {
                            <td>
                                <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString()">@request.Status.ToString()</a>
                            </td>
                        }
                        else
                        {
                            <td class="tooltip" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()
                            </td>
                        }
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 10);
        }
    </table>
}
@RazorHelper.EmployeeProcessMenu()