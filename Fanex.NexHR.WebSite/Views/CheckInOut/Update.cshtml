@using Fanex.NexHR.ViewModels.CheckInOutRequest
@model CheckInOutRequestViewModel
@{
    ViewBag.Title = Labels.MyCheckInOut;
}
@section css{
    @Styles.Render("~/Content/myrequestcss")
}
@section js{
    @Scripts.Render("~/bundles/contextmenujs", "~/bundles/empcheckinoutjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Edit</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm("update", "checkinout", FormMethod.Post, new { @class = "form-create-update" }))
                        {
                            @Html.ValidationSummary(true)
                            if (ViewBag.Updated == true)
                            {
                                <div class="row">
                                    <div class="col success green-text m-b--m">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.RequestUpdated
                                    </div>
                                    <input type="hidden" id="successed" value="true" />
                                    <input type="hidden" id="year" value="@ViewBag.Year" />
                                </div>
                            }
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.CheckInOutType, Labels.Request)
                                    </div>
                                    <div class="left input--m">
                                        <span class="label">@Model.CheckInOutType.ToText()</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left">
                                        <span class="label">@Html.DisplayFor(model => model.Employee)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--xl">
                                        <label>@Labels.RequestTime</label>
                                    </div>
                                    <div class="left">
                                        <div class="datepicker-button left select--s">
                                            @Html.DatePickerFor(model => model.ForDate,
                                                Utilities.RequestAvailableFromDate,
                                                DateTime.Now)
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                        <div class="col m-l--m">
                                            @*@Html.Html5Number(0, 23, 1, Model.Hour, new { Name = "Hour", MaxLength = "2", id = "Hour" })*@
                                            @Html.TextBoxFor(x => x.Hour, new { type = "number", min = "0", max = "23", step = "1", MaxLength = "2", id = "Hour", name = "Hour" })
                                        </div>
                                        <div class="col p-0">:</div>
                                        <div class="col">
                                            @*@Html.Html5Number(0, 59, 1, Model.Minute, new { Name = "Minute", MaxLength = "2", id = "Minute" })*@
                                            @Html.TextBoxFor(x => x.Hour, new { type = "number", min = "0", max = "59", step = "1", MaxLength = "2", id = "Minute", name = "Minute" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-b--m">
                                <div class="col">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.Shift)
                                    </div>
                                    <div class="left">
                                        <span id="shiftname" class="label">@Model.Shift</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xl">&nbsp;</div>
                                    <div class="left">
                                        @Html.HiddenFor(model => model.Employee)
                                        @Html.HiddenFor(model => model.EmployeeId)
                                        @Html.HiddenFor(model => model.Id)
                                        @Html.HiddenFor(model => model.CheckInOutType)
                                        @Html.HiddenFor(model => model.Shift)
                                        @Html.HiddenFor(model => model.ForRequest)
                                        @Html.HiddenFor(model => model.InTime)
                                        @Html.HiddenFor(model => model.OutTime)
                                        <a href="@Url.Action("EmployeeView")" class="btn-back waves-effect waves-light">@Labels.Cancel</a>
                                        <input class="btn-submit waves-effect waves-light right" type="submit" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>