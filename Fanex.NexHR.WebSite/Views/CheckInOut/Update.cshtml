@using System.Web.Mvc.Html5;
@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.CheckInOutRequestViewModel
@{
    ViewBag.Title = Labels.MyCheckInOutSummary;
}
@section css{
    @Styles.Render("~/Content/myrequestcss")
}
@section js{
    @Scripts.Render("~/bundles/empcheckinoutjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 l7 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Edit</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm("update", "checkinout", FormMethod.Post, new { @class = "form-create-update" }))
                        {
                            @Html.ValidationSummary(true)
                            if (ViewBag.Updated == true)
                            {
                                <div class="row">
                                    <div class="col success green-text m-b--m"><i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Fanex.NexHR.Resources.Messages.RequestUpdated</div>
                                    <input type="hidden" id="successed" value="true" />
                                    <input type="hidden" id="year" value="@ViewBag.Year" />
                                </div>
                            }
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xl">
                                        <label>@Fanex.NexHR.Resources.Labels.RequestCode</label>
                                    </div>
                                    <div class="left label--m">
                                        <label class="txt-bold">Rq.@Model.Id</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.CheckInOutType, Labels.Request)
                                    </div>
                                    <div class="left input--m">
                                        <span class="label">@Model.CheckInOutType.ToText()</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left">
                                        <span class="label">@Html.DisplayFor(model => model.Employee)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--xl">
                                        <label>@Fanex.NexHR.Resources.Labels.RequestTime</label>
                                    </div>
                                    <div class="left">
                                        <div class="datepicker-button left select--s">
                                            @Html.DatePickerFor(model => model.ForDate,
                                                Utilities.RequestAvailableFromDate,
                                                DateTime.Now,
                                                unavailDates: (IEnumerable<DateTime>)ViewBag.UnavailDates)
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                        <div class="col m-l--m">
                                            @Html.Html5Number(0, 23, 1, Model.Hour, new { Name = "Hour", MaxLength = "2", id = "Hour" })
                                        </div>
                                        <div class="col p-0">:</div>
                                        <div class="col">
                                                @Html.Html5Number(0, 59, 1, Model.Minute, new { Name = "Minute", MaxLength = "2", id = "Minute" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.Shift)
                                    </div>
                                    <div class="left">
                                        <span id="shiftname" class="label">@Model.Shift</span>
                                        <a id="shiftinfo" href="javascript:;" title="@Fanex.NexHR.Resources.Labels.ShiftInfo"><span class="icon shiftinfo"></span></a>
                                        <div class="hide">
                                            @RazorHelper.ShiftInfoTable(ViewBag.Shifts)
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="label"></div>
                                <div class="input">
                                    @Html.HiddenFor(model => model.Employee)
                                    @Html.HiddenFor(model => model.DisplayName)
                                    @Html.HiddenFor(model => model.EmployeeId)
                                    @Html.HiddenFor(model => model.Id)
                                    @Html.HiddenFor(model => model.CheckInOutType)
                                    @Html.HiddenFor(model => model.Shift)
                                    @Html.HiddenFor(model => model.ForRequest)
                                    @Html.Hidden("InTime")
                                    @Html.Hidden("OutTime")
                                    <span class="button-hrm waves-effect waves-light btn orange darken-1 m-r--s"><input type="submit" value="@Labels.Update" /></span>
                                    <a class="button-hrm waves-effect waves-light btn grey darken-1" href="@Url.Action("employeeview", "checkinout")" class="button">@Labels.Back</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>