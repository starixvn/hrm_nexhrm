@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model RequestViewModel
@{
    ViewBag.Title = Labels.MemberRequests;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/contextmenu.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/simplepagination.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/myrequest.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/jquery.contextMenu.min.js" asp-append-version="true"></script>
        <script src="~/js/Libs/jquery.simplePagination.js" asp-append-version="true"></script>
        <script src="~/js/Views/Request/mgr.requests.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.team.js" asp-append-version="true"></script>

    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/simplepagination.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/managerequests.min.js" asp-append-version="true"></script>
    </environment>
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @await Html.PartialAsync("CriteriaPanel", Model)
                    <div id="all-request"></div>
                    <div id="dialoghistorycontent" class="full-view-width over-auto"></div>
                </div>
            </div>
        </div>
    </div>
</div>
