@model RequestViewModel
@using (Html.BeginForm())
{
    @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
    @Html.Hidden("ActionName", (string)ViewBag.ActionName)
    <div class="form">
        <div class="row form-input">
            <div class="col m-r--l">
                <div class="left label--m">
                    <label>@Labels.DateRange</label>
                </div>
                <div class="left select--m">
                    @RazorHelper.DateRangeDropDownList("Date", Model.DateOption)
                    @Html.Hidden("DateOption", Model.DateOption)
                </div>
            </div>
            <div class="col m-r--l">
                <div class="left label--m">
                    @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                </div>
                <div class="left datepicker-button select--s">
                    @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1))
                    <i class="mdi-action-event calendar-icon from-date left"></i>
                </div>
            </div>
            <div class="col m-r--l m-l--70">
                <div class="left label--m">
                    @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                </div>
                <div class="left datepicker-button select--s">
                    @Html.DatePickerFor(model => model.ToDate)
                    <i class="mdi-action-event calendar-icon to-date left"></i>
                </div>
            </div>
            <div class="col m-r--l">
                <div class="left label--m">
                    @Html.LabelFor(model => model.ToDate, Labels.FilterBy)
                </div>
                <div class="left select--m">
                    @Html.DropDownListFor(model => model.IsFilterByEffectedDate, Model.DateTypes)
                </div>
            </div>
            <div class="col m-r--l">
                <div class="left label--m">
                    @Html.LabelFor(model => model.StatusId)
                </div>
                <div class="left filter-status">
                    @RazorHelper.StatusDropDownList(Model.StatusId, controlName: "statusId")
                </div>
            </div>
            <div class="col m-r--l">
                <div class="left label--m">
                    @Html.LabelFor(model => model.TeamCollection)
                </div>
                <div class="left select--m">
                    @Html.DropDownList("TeamId", Model.GetSelectListItemTeam(Model.TeamId))
                </div>
            </div>
            <div class="col m-r--l">
                <div class="left label--m">
                    @Html.LabelFor(model => model.Employee)
                </div>
                <div class="left input--m">
                    @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                    @Html.HiddenFor(model => model.EmployeeId)
                </div>
            </div>
        </div>
        <div class="row form-input">
        </div>
        <div class="row form-input">
            <div class="col m-r--l">
                <div class="left label--m">
                    @Html.LabelFor(model => model.LeaveTypeId)
                </div>
                <div class="left select--m">
                    @Html.DropDownListFor(model => model.LeaveTypeId, new SelectList(Model.LeaveTypeCollection, "Id", "Name"))
                </div>
            </div>
            <div class="col">
                <div class="left label--m">
                    @Html.LabelFor(model => model.RequestType, Labels.Request)
                </div>
                <div class="left">
                    @Html.RadioButtonList(model => model.RequestType, Model.RequestTypes)
                </div>
            </div>
            <input id="submit" class="btn-submit waves-effect waves-light m-l--s-" type="button" value="@Labels.Submit" />
        </div>
    </div>
}