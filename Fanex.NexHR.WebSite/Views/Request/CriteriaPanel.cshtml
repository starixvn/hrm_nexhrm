@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model RequestViewModel

<div class="form form-stl-table">
    <input id="DateTime-Now" name="DateTime-Now" type="hidden"
        value="@DateTimeOffset.Now.DateTime.ToClientTimeZone().ToString("MMMM dd, yyyy")">
    <input id="ActionName" name="ActionName" type="hidden" value="@Model.PartialActionName">
    <form class="form-filter" action="">
        <div class="row form-input">
            <div class="col m-r--m">
                <div class="left label--m">
                    <label>@Labels.DateRange</label>
                </div>
                <div class="left select--daterange">
                        <select id="Date" name="Date">
                            @{
                                foreach (DateRangeFilter dateRange in (DateRangeFilter[])Enum.GetValues(typeof(DateRangeFilter)))
                                {
                                    var value = (int)dateRange;
                                    <option value="@value" selected="@(value == Model.DateOption)">@Utilities.GetDescription(dateRange)</option>
                                }
                            }
                        </select>
                    <input type="hidden" asp-for="DateOption"/>
                </div>
            </div>
            <div class="col m-r--m">
                <div class="left label--m">
                    <label>@Labels.FromDate</label>
                </div>
                <div class="left datepicker-button select--datepicker">
                    <date-picker 
                        name="FromDate"
                        min-date="new DateTimeOffset(2010, 1, 1, 0, 0, 0, TimeSpan.Zero).DateTime"
                        value="Model.FromDate"
                    >
                    </date-picker>
                    <i class="mdi-action-event calendar-icon from-date left"></i>
                </div>
            </div>
            <div class="col m-r--m">
                <div class="left label--m">
                    <label>@Labels.ToDate</label>
                </div>
                <div class="left datepicker-button select--datepicker">
                    <date-picker 
                        name="ToDate"
                        value="Model.ToDate"
                    >
                    </date-picker>
                    <i class="mdi-action-event calendar-icon from-date left"></i>
                </div>
            </div>
            <div class="col">
                <div class="left label--m">
                    <label>@Labels.FilterBy</label>
                </div>
                <div class="left select--datepicker">
                    <select asp-for="IsFilterByEffectedDate" asp-items="@Model.DateTypes"></select> 
                </div>
            </div>
        </div>
        <div class="row form-input">
            <div class="col m-r--m">
                <div class="left label--m">
                    <label>Team</label>
                </div>
                <div class="left select--m">
                    <select asp-for="TeamId" asp-items="@Model.GetSelectListItemTeam(Model.TeamId)"></select> 
                </div>
            </div>
            <div class="col m-r--m">
                <div class="left label--m">
                    <label>Status</label>
                </div>
                <div class="left select--datepicker">
                    <select name="statusId" id="statusId">
                        <option selected="@(Model.StatusId == 0)" value="0">All</option>
                        <option selected="@(Model.StatusId == (byte)RequestStatuse.Pending)" value="@Convert.ToByte(RequestStatuse.Pending)">@Labels.Pending</option>
                        <option selected="@(Model.StatusId == (byte)RequestStatuse.Reject)" value="@Convert.ToByte(RequestStatuse.Reject)">@Labels.Rejected</option>
                        <option selected="@(Model.StatusId == (byte)RequestStatuse.Approve)" value="@Convert.ToByte(RequestStatuse.Approve)">@Labels.Approved</option>
                    </select>
                </div>
            </div>
            <div class="col m-r--m">
                <div class="left label--m">
                    <label>Employee</label>
                </div>
                <div class="left input--m">
                    <input asp-for="Employee" placeholder="@Messages.SearchEmployeeWatermark"/>
                    <input type="hidden" asp-for="EmployeeId"/>
                </div>
            </div>
        </div>
        <div class="row form-input">
            <div class="col m-r--m">
                <div class="left label--m">
                    <label>Leave Type</label>
                </div>
                <div class="left select--m">
                    <select asp-for="LeaveTypeId" asp-items="@(new SelectList(Model.LeaveTypes, "Id", "Name"))"></select> 
                </div>
            </div>
            <div class="col">
                <div class="left label--m">
                    <label>Request</label>
                </div>
                <div class="left">
                    @foreach (var item in @Extensions.RequestTypes)
                    {
                        <div class="radioButton">
                            <input class="with-gap" type="radio" name="RequestType" id="RequestType_@item.Value" value="@item.Value" checked="@(item.Value==Model.RequestType.ToString())"/>
                            <label for="RequestType_@item.Value">@item.Text</label>
                        </div>
                    }
                </div>
            </div>
            <input type="hidden" asp-for="ItemsPerPage"/>
            <input type="hidden" asp-for="CurrentPage"/>
            <input type="hidden" asp-for="RequestViewType"/>
        <div class="left">
            <input id="submit" class="btn-submit waves-effect waves-light m-r--m" type="button" value="@Labels.Submit" />
            @if (Model.RequestViewType == RequestViewType.LeaderView)
            {
                <a class="btn-request waves-effect waves-light m-r--m left" href="javascript:;" id="btn-approve">Approve</a>
                <a class="btn-request waves-effect waves-light m-r--m left" href="javascript:;" id="btn-reject">Reject</a>
            }
        </div>
            </div>
    </form>
</div>