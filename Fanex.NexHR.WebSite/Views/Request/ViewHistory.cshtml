@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.RequestHistory;
    Layout = null;
}
@section css{
}
@section js{
}
@section Breadcrumb {
}
@switch ((int)ViewBag.requestType)
{
    case 1:
        Html.RenderPartial("History/CheckInOutRequestHistory", Model);
        break;
    case 2:
        Html.RenderPartial("History/LateInEarlyOutRequestHistory", Model);
        break;
    case 3:
        Html.RenderPartial("History/ChangeShiftRequestHistory", Model);
        break;
    case 4:
        Html.RenderPartial("History/LeaveRequestHistory", Model);
        break;
}