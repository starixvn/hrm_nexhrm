@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.RequestHistory;
    Layout = null;
}

@switch ((int)ViewBag.requestType)
{
    case 1:
    case 2:
        Html.RenderPartial("History/CheckInOutRequestHistory", Model);
        break;
    case 6:
        Html.RenderPartial("History/LeaveRequestHistory", Model);
        break;
}