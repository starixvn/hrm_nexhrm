@using Fanex.NexHR.Models.Request
@using Fanex.NexHR.Resources
@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.RequestHistory;
    Layout = null;
}

@switch ((int)ViewBag.requestType)
{
    case 1:
    case 2:
        <partial name="History/CheckInOutRequestHistory" model="Model" />
        break;
    case 6:
        <partial name="History/LeaveRequestHistory" model="Model" />
        break;
}