@model RequestViewModel
@{
    ViewBag.Title = Labels.RequestHistory;
    Layout = null;
    IList<RequestEntity> requests = ViewBag.EntityList;
}
@section css{
}
@section js{
}
@section Breadcrumb {
}
@switch ((int)ViewBag.requestType)
{
    case 1:
        Html.RenderPartial("History/CheckInOutRequestHistory", requests);
        break;
    case 2:
        Html.RenderPartial("History/LateInEarlyOutRequestHistory", requests);
        break;
    case 3:
        Html.RenderPartial("History/ChangeShiftRequestHistory", requests);
        break;
    case 4:
        Html.RenderPartial("History/LeaveRequestHistory", requests);
        break;
}