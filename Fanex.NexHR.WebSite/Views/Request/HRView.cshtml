@model Fanex.NexHR.ViewModels.RequestViewModel
@using Fanex.NexHR.Models.Request
@{
    ViewBag.Title = Labels.EmployeeRequest;
    IList<RequestEntity> requests = ViewBag.EntityList;
}
@section css{
}
@section js{
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @Html.Partial("CriteriaPanel", Model)
                    @{
                        Html.RenderPartial("AllRequest", requests);
                    }
                    <div id="dialoghistorycontent" />
                </div>
            </div>
        </div>
    </div>
</div>
