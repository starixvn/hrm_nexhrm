@model RequestViewModel
@{
    ViewBag.Title = Labels.EmployeeRequest;
}
@section css{
    @Styles.Render(
        "~/Content/contextmenucss",
        "~/Content/simplepaginationcss",
        "~/Content/view-mobile")
}
@section js{
    @Scripts.Render(
        "~/bundles/contextmenujs",
        "~/bundles/simplepaginationjs",
        "~/bundles/managerequestsjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base employee-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @Html.Partial("CriteriaPanel", Model)
                    <div id="all-request" class="cover-form-mb table-request-employeeview"></div>
                    <div id="dialoghistorycontent" class="full-view-width over-auto"></div>
                </div>
            </div>
        </div>
    </div>
</div>