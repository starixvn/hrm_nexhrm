@using Fanex.NexHR.Core
@using Fanex.NexHR.Models.Request
@using Fanex.NexHR.Resources
@model IList<RequestEntity>
<table class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.Employee</th>
            <th>@Labels.LeaveType</th>
            <th>@Labels.From</th>
            <th>@Labels.To</th>
            <th>@Labels.Total</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Remark</th>
            <th>@Labels.Status</th>
            <th>@Labels.ProcessedBy</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            {
                <tr id="row@(request.Id)">
                    <td>@(index++)</td>
                    <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code</td>
                    <td class="tooltip" title="@request.Requester.FullName">@request.Requester.NickName</td>
                    <td>@request.LeaveType.Name</td>
                    @if (request.TotalDays == (decimal)0.5)
                    {
                        <td>@request.FromDate.ToShortFormatedDate()</td>
                        <td>@request.ToDate.ToShortFormatedDate()</td>
                    }
                    else
                    {
                        <td>@request.FromDate.ToDateMonthYearFormatedDate()</td>
                        <td>@request.ToDate.ToDateMonthYearFormatedDate()</td>
                    }
                    <td>@request.TotalDays.ToString("0.0")</td>
                    <td>@request.CreatedDate.ToShortFormatedDate()</td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <td class="tooltip" title="@request.Remark">
                            <span class="mdi mdi-message-text" alt="remark"></span>
                        </td>
                    }
                    else
                    {
                        <td>-</td>
                    }
                    <td>@request.Status.ToString()</td>
                    @if (!string.IsNullOrWhiteSpace(request.ModifiedBy.NickName))
                    {
                        if (request.ModifiedDate > new DateTimeOffset(2000, 1, 1, 0, 0, 0, TimeSpan.Zero).DateTime)
                        {
                            <td id="pb@(request.Id)">
                                @request.ModifiedBy.NickName, @request.ModifiedDate.ToShortFormatedDate()
                            </td>
                        }
                        else
                        {
                            <td id="pb@(request.Id)">
                                @request.ModifiedBy.NickName
                            </td>
                        }
                    }
                    else
                    {
                        <td id="pb@(request.Id)">
                            N/A
                        </td>
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        <tr>
            <td colspan="12"></td>
        </tr>
        <tr>
            <td colspan="12" rowspan="2">
                @Messages.NoInformation
            </td>
        </tr>
    }
</table>