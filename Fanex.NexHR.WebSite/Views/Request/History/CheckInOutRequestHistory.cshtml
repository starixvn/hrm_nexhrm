@model IList<RequestEntity>
<table class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.Employee</th>
            <th>@Labels.Request</th>
            <th>@Labels.Shift</th>
            <th>@Labels.RequestTime</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Status</th>
            <th>@Labels.ProcessedBy</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @{int index = 1;}
            @foreach (RequestEntity request in Model)
            {
                <tr id="row@(request.Id)">
                    <td>@(index++)</td>
                    <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code</td>
                    <td class="tooltip" title="@request.Requester.FullName">
                        @request.Requester.NickName
                    </td>
                    <td>@request.RequestType.ToString()</td>
                    <td>@request.FromShift.Name</td>
                    <td>@request.FromDate.ToShortFormatedDate()</td>
                    <td>@request.CreatedDate.ToShortFormatedDate()</td>
                    <td>@request.Status.ToString()</td>
                    @RazorHelper.ModifierDisplay(request.ModifiedBy.NickName, request.ModifiedBy.FullName, request.ModifiedDate, request.Id)
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 11)
    }
</table>