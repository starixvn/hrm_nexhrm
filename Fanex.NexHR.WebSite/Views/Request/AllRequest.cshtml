@model IList<RequestEntity>
<div class="p-x--s">
    <table class="data persist-area table bordered striped highlight centered table-custom">
        <thead>
            <tr class="persist-header">
                <th>#</th>
                <th>@Labels.Team</th>
                <th>@Labels.Employee</th>
                <th>@Labels.Request</th>
                <th>@Labels.Details</th>
                <th>@Labels.Remark</th>
                <th>@Labels.CreatedDate</th>
                <th>@Labels.Status</th>
                <th>@Labels.History</th>
            </tr>
        </thead>
        @if (ViewBag.EntityList.Count > 0)
        {
            <tbody>
                @{
                    int index = 1;
                    RequestViewModel options = (RequestViewModel)ViewBag.Options;
                }
                @foreach (RequestEntity request in Model)
                {
                    var annualBalance = string.Empty;
                    if (request.LeaveType.Id == 2 || request.LeaveType.Id == 30)
                    {
                        annualBalance = "Annual Balance " + request.FromDate.Year + ": " + request.Requester.AnnualLeaveBalance + " && ";
                    }
                    var requestModel = new RequestViewModel
                    {
                        DateOption = options.DateOption,
                        FromDate = options.FromDate,
                        ToDate = options.ToDate,
                        EmployeeId = request.Requester.Id,
                        Employee = request.Requester.NickName + " (" + request.Requester.FullName + ")",
                        TeamId = options.TeamId == null ? -2 : options.TeamId,
                        StatusId = options.StatusId,
                        RequestType = request.RequestType.RequestFilter,
                        IsFilterByEffectedDate = options.IsFilterByEffectedDate
                    };
                    <tr id="row@(request.Id)">
                        <td>@(index++)</td>
                        <td  class="tooltip" title="@request.Requester.Team.Name">
                            @request.Requester.Team.Code
                        </td>
                        <td class="tooltip" title="@request.Requester.FullName">
                            @request.Requester.NickName.ToString()
                        </td>
                        <td>
                            @if ((bool)ViewBag.Leader)
                            {
                                <a href="@Url.Action("member", "request", requestModel)">
                                    @if (request.RequestType.Id == (int)RequestType.Leave)
                                    {
                                        @request.LeaveType.Name
                                    }
                                    else
                                    {
                                        @request.RequestType.Name
                                    }
                                </a>
                            }
                            else
                            {
                                if ((bool)ViewBag.IsAllowChangeStatus)
                                {
                                    <a href="@Url.Action("hrview", "request", requestModel)">
                                        @if (request.RequestType.Id == (int)RequestType.Leave)
                                        {
                                            @request.LeaveType.Name
                                        }
                                        else
                                        {
                                            @request.RequestType.Name
                                        }
                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action("employeeview", "request", requestModel)">
                                        @if (request.RequestType.Id == (int)RequestType.Leave)
                                        {
                                            @request.LeaveType.Name
                                        }
                                        else
                                        {
                                            @request.RequestType.Name
                                        }
                                    </a>
                                }
                            }
                        </td>
                        <td class="txt-left">
                            @Html.Raw(RequestService.ToRequestMessage(request))
                        </td>
                        @if (!string.IsNullOrWhiteSpace(request.Remark))
                        {
                            <td class="tooltip" title="@request.Remark">
                                <span class="mdi mdi-message-text" alt="remark" />
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                        }
                        <td>
                            @request.CreatedDate.ToShortFormatedDate()
                        </td>
                        @if ((bool)ViewBag.IsAllowChangeStatus && (!(bool)ViewBag.Leader || ((bool)ViewBag.Leader && request.IsAllowUpdateStatus)))
                        {
                            <!-- If view from menu "HR Space" -->
                            switch (request.Status.Id)
                            {
                                case 1: //Pending
                                    if (request.RequestType.Id == 6)
                                    {
                                        <td>
                                            <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() tooltip c-pending" 
                                                title="@(annualBalance + " had " + request.TotalDaysRequestInMonth.ToString("0.#") + " approved day(s) in " + request.FromDate.ToMonthAndYearFormatedDate())">@request.Status.ToString()</a>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() tooltip c-pending" 
                                                title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.RequestedDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</a>
                                        </td>
                                    }
                                    break;
                                case 2: //Approve
                                    <td>
                                        <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() tooltip c-approve" 
                                            title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                                    </td>
                                    break;
                                case 3: //Reject
                                    <td>
                                        <a requestid="@request.Id" href="javascript:;" class="tooltip" 
                                            title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</a>
                                    </td>
                                    break;
                            }
                        }
                        else
                        {
                            <!-- If view from menu "Company Space" -->
                            switch (request.Status.Id)
                            {
                                case 1: //Pending
                                    if (request.RequestType.Id == 6)
                                    {
                                        <td>
                                            <span class="tooltip status-nochange c-pending" 
                                                title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved day(s) in @request.FromDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</span>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <span class="tooltip status-nochange c-pending" 
                                                title="@request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.RequestedDate.ToMonthAndYearFormatedDate()">@request.Status.ToString()</span>
                                        </td>
                                    }
                                    break;
                                case 2: //Approve
                                    <td>
                                        <span class="tooltip status-nochange c-approve" 
                                            title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</span>
                                    </td>
                                    break;
                                case 3: //Reject
                                    <td>
                                        <span class="tooltip status-nochange c-approve" 
                                            title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()</span>
                                    </td>
                                    break;
                            }
                        }
                        <td>
                            <a class="viewhistory" href="javascript:;" id="/request/viewhistory?requestId=@request.Id&requestType=@request.RequestType.RequestHistoryFilter">@Labels.View</a>
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 9);
        }
    </table>
</div>
