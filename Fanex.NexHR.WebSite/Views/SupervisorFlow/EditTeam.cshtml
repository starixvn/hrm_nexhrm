@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.SupervisorFlow.TeamViewModel

<form id="edit-form" asp-action="editteam" data-ajax="true" data-ajax-method="post"
    data-ajax-success="supervisor.onUpdateTeamSuccess">
    <div asp-validation-summary="All"></div>
    <div class="row form-input m-b--m">
        <div class="left label--m">
            <label>@Labels.Team</label>
        </div>
        <div class="left input-custom ">
            @Model.GroupName
            <input asp-for="@Model.GroupId" type="hidden" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--m">
            <label>@Labels.Supervisor</label>
        </div>
        <div class="left input-custom">
            <select asp-for="ApproverIds" asp-items="@Model.Employees" class="select-2 disabled">
            </select>
        </div>
    </div>
</form>