@using Fanex.NexHR.Resources
@{
    ViewBag.Title = @Labels.FlowSetting;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Views/suppervisor-flow.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/conversationmanagement.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/select2.js" asp-append-version="true"></script>
        <script src="~/js/Libs/jquery.unobtrusive-ajax.js" asp-append-version="true"></script>
        <script src="~/js/Libs/jquery.validate.unobtrusive.js" asp-append-version="true"></script>
        <script src="~/js/Views/SupervisorFlow/supervisor.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/supervisor.min.js" asp-append-version="true"></script>
    </environment>
}
<div class="row content">
    <div class="col s12 card-container-base card-my-newx">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <ul class="tabs">
                        <li class="tab col"><a class="active card-title" href="#list-team">@Labels.TeamSetting</a></li>
                        <li class="tab col"><a class="card-title" href="#personal" onclick="loadPersonalSupervisor(true)">@Labels.PersonalSetting</a></li>
                        <li class="tab col"><a class="card-title" href="#detail" onclick="loadDetail(true)">@Labels.Detail</a></li>
                    </ul>
                </div>
                <div class="card-body">
                    <div id="list-team"></div>
                    <div id="personal">
                        <div class="form">
                            <div class="row form-input">
                                <div class="col m-l--l">
                                    <a class="btn-request waves-effect waves-light btn m-r--m" href="@Url.Action("Create")"
                                        data-ajax="true" data-ajax-mode="replace" data-ajax-update="#dialog-supervisor" data-ajax-success="supervisor.onLoadingCreateFormSuccess">
                                        @Labels.NewPersonalSetting
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div id="list-personal"></div>
                    </div>
                    <div id="detail">
                        <div class="form row form-input">
                            <div class="left label--m">
                                <label>@Labels.Keyword</label>
                            </div>
                            <div class="col filter-keyword m-r--l">
                                <input type="text" id="Keyword" placeholder="@Messages.SearchEmployeeWatermark" />
                            </div>
                            <div class="col">
                                <input type="button" id="submit" class="btn-submit waves-effect waves-light" value="@Labels.Submit" />
                            </div>
                        </div>
                        <div id="list-detail"></div>
                    </div>
                    <div id="dialog-supervisor"></div>
                </div>
            </div>
        </div>
    </div>
</div>