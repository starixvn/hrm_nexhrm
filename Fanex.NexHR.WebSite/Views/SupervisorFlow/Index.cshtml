@using Fanex.NexHR.Resources
@{
    ViewBag.Title = "Supervisor Flow";
    var searchMessages = (ViewBag.Tab == "Team") ? Messages.SearchEmployeeWatermark : "team name";
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/contextmenu.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Views/suppervisor-flow.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/jquery.contextMenu.min.js" asp-append-version="true"></script>
        <script src="~/js/Views/SupervisorFlow/supervisor.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/supervisor.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base card-my-newx">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <ul class="tabs">
                        <li class="tab col"><a class="@(ViewBag.Tab == "Team" ? "active" : string.Empty) card-title" href="#myOT">@Labels.Team</a></li>
                        <li class="tab col"><a class="@(ViewBag.Tab == "Personal" ? "active" : string.Empty) card-title" href="#memberOT">Personal</a></li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="form row form-input">
                        <div class="left label--m">
                            <label>@Labels.Keyword</label>
                        </div>
                        <div class="left">
                            <input type="text" id="Keyword" placeholder="@searchMessages" />
                        </div>
                        <div class="col">
                            <input type="button" id="submit" class="btn-submit waves-effect waves-light" value="@Labels.Submit" />
                        </div>
                    </div>
                    <div id="team">
                        <div class="loading-process" style="display: none;"></div>
                    </div>
                    <div id="personal"></div>
                </div>
            </div>
        </div>
    </div>
</div>