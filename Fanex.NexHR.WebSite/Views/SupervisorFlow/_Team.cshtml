@using Fanex.NexHR.Core
@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IEnumerable<TeamSupervisor>
@{
    var employees = ViewBag.employees;
    int[] ApproverId = [];
    var index = 1;
}
    <div class="team-list">
        <div class="header">Team List</div>
        <div class="list-body">
            <div class="content">
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="item" id="@(item.Id)" onclick="selectTeam(@item.Id, '@item.Name')">
                            <div class="team-name">@item.Name</div>
                            @if (!string.IsNullOrEmpty(item.ApproverIds))
                            {
                                <div class="icon-check"/>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="no-data">@Labels.NoData</div>
                }
            </div>
        </div>
    </div>
    <form id="frmTeamUpdate">
        @if (ViewBag.Inserted == true)
        {
            <input type="hidden" id="successed" value="true" />
        }
        <div class="flow-process">
            <div class="process-item">
                <div class="team-process">
                    <div class="header">@Labels.Team</div>
                    <div class="content">
                        <div class="team-detail">
                            <div class="icon-team"></div>
                            <div class="team-selected"></div>
                        </div>
                    </div>
                </div>
                <div class="approver-process">
                    <div class="header">@Labels.Approver</div>
                    <div class="content">
                        <div>
                            <select asp-for="@ApproverId" asp-items="@employees"
                                class="select-2 disabled">
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="button-group">
                <button type="button" class="btn btn-cancel btn btn-default m-r--s">@Labels.Delete</button>
                <button type="button" class="btn btn-primary">@Labels.Submit</button>
            </div>
        </div>
    </form>
    <div class="flow-list">
        <table id="data-detail" class="table bordered striped highlight table-custom centered">
            <thead>
                <tr>
                    <th>@Labels.SymbolCount</th>
                    <th>@Labels.Team</th>
                    <th>@Labels.Approver</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any(item => !string.IsNullOrEmpty(item.ApproverIds)))
                {
                    foreach (var item in Model.Where(item => !string.IsNullOrEmpty(item.ApproverIds)))
                    {
                        <tr id="row@(item.Id)">
                            <td>@(index++)</td>
                            <td class="align-left">@item.Name</td>
                            <td class="align-left">@item.ApproverNames</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">@Labels.NoData</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
