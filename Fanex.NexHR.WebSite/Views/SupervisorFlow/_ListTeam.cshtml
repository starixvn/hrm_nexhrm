@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model IEnumerable<TeamSupervisor>
@{
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
    var index = 1;
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th style="width:5%">@Labels.SymbolCount</th>
            <th style="width:34%">@Labels.Team</th>
            <th style="width:55%">@Labels.Supervisor</th>
            @if (isHRRole)
            {
                <th style="width:6%">@Labels.Edit</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr id="row@(item.GroupId)">
                    <td>@(index++)</td>
                    <td class="align-left">@item.GroupName</td>
                    <td class="align-left">@item.Approvers</td>
                    @if (isHRRole)
                    {
                        <td class="action-column">
                            <a class="btn-edit" data-ajax="true" data-ajax-mode="replace" data-ajax-update="#dialog-supervisor"
                                href="@Url.Action("EditTeam", new { groupId = item.GroupId })"
                                data-ajax-success="supervisor.onLoadingEditTeamFormSuccess">
                                <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">@Labels.NoData</td>
            </tr>
        }
    </tbody>
</table>
