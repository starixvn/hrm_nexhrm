@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.SupervisorFlow.CreatePersonalViewModel

<form id="edit-form" asp-action="editpersonal" data-ajax="true" data-ajax-method="post" data-ajax-success="supervisor.onUpdateSuccess">
    <div asp-validation-summary="All"></div>
    <div class="row form-input m-b--m">
        <div class="left label--m">
            <label>@Labels.Employee</label>
        </div>
        <div class="left input-custom ">
            @Model.Employee
            <input asp-for="@Model.EmpId" type="hidden" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--m">
            <label>@Labels.Approvers</label>
        </div>
        <div class="left input-custom">
            <select asp-for="ApproverIds" asp-items="@Model.Employees"
                class="select-2 disabled">
            </select>
        </div>
    </div>
</form>