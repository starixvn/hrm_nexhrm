@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model IEnumerable<DetailSupervisor>
@{
    var index = 1;
}
<table id="data" class="table bordered striped highlight centered table-custom table-detail">
    <thead>
        <tr>
            <th style="width:4%">@Labels.SymbolCount</th>
            <th style="width:10%">@Labels.EnglishName</th>
            <th style="width:20%">@Labels.FullName</th>
            <th style="width:20%">@Labels.Team</th>
            <th style="width:46%">@Labels.Supervisor</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr id="row@(item.EmpId)">
                    <td >@(index++)</td>
                    <td class="align-left">@item.Nickname</td>
                    <td class="align-left">@item.FullName</td>
                    <td class="align-left">@item.GroupName</td>
                    <td class="align-left">@item.ApproversName</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">@Labels.NoData</td>
            </tr>
        }
    </tbody>
</table>
