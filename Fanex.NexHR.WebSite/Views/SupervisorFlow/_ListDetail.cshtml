@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IEnumerable<DetailSupervisor>
@{
    var index = 1;
}
<table id="data" class="table bordered striped highlight centered table-custom table-detail">
    <thead>
        <tr>
            <th style="width:5%">@Labels.SymbolCount</th>
            <th style="width:10%">@Labels.EnglishName</th>
            <th style="width:20%">@Labels.FullName</th>
            <th style="width:15%">@Labels.Department</th>
            <th style="width:15%">@Labels.Team</th>
            <th style="width:20%">@Labels.Supervisor</th>
            <th style="width:15%">@Labels.AutoApproveRequest</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr id="row@(item.EmpId)">
                    <td>@(index++)</td>
                    <td class="align-left">@item.Nickname</td>
                    <td class="align-left">@item.FullName</td>
                    <td class="align-left">@item.DepartmentName</td>
                    <td class="align-left">@item.GroupName</td>
                    <td class="align-left">@item.Approvers</td>
                    <td class="align-center">@(item.AutoApproveRequest ? @Labels.AutoApproveRequest : "")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">@Labels.NoData</td>
            </tr>
        }
    </tbody>
</table>
