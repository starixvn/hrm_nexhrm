@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model IEnumerable<PersonalSupervisor>
@{
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
    var index = 1;
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th style="width:5%">@Labels.SymbolCount</th>
            <th style="width:14%">@Labels.EnglishName</th>
            <th style="width:30%">@Labels.FullName</th>
            <th style="width:45%">@Labels.Supervisor</th>
                @if (isHRRole)
            {
                <th  style="width:6%">@Labels.Edit</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr id="row@(item.EmpId)">
                    <td >@(index++)</td>
                    <td class="align-left">@item.Nickname</td>
                    <td class="align-left">@item.FullName</td>
                    <td class="align-left">@item.Approvers</td>
                    @if (isHRRole)
                    {
                        <td class="action-column">
                            <a class="btn-edit"
                                data-ajax="true" data-ajax-mode="replace" data-ajax-update="#dialog-supervisor"
                            href="@Url.Action("EditPersonal", new { empId = item.EmpId})"
                            data-ajax-success="supervisor.onLoadingEditPersonalFormSuccess">
                                <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">@Labels.NoData</td>
            </tr>
        }
    </tbody>
</table>
