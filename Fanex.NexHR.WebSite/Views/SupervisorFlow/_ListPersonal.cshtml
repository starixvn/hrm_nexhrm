@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model IEnumerable<PersonalSupervisor>
@{
    var isHRRole = sessionService.CurrentEmployee.RoleList.Any(r => r == (short)Role.HR || r == (short)Role.SA);
    var index = 1;
}
<div class="cover-form-mb table-team">
    <table id="data" class="table bordered striped highlight centered responsive-table table-custom">
        <thead>
            <tr>
                <th>@Labels.SymbolCount</th>
                <th>@Labels.EnglishName</th>
                <th>@Labels.FullName</th>
                <th>@Labels.Approver</th>
                 @if (isHRRole)
                {
                    <th>@Labels.Edit</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr id="row@(item.EmpId)">
                        <td>@(index++)</td>
                        <td class="align-left">@item.Nickname</td>
                        <td class="align-left">@item.FullName</td>
                        <td class="align-left">@item.ApproverNames</td>
                        @if (isHRRole)
                        {
                            <td class="action-column">
                                <a class="btn-edit"
                                 data-ajax="true" data-ajax-mode="replace" data-ajax-update="#dialog-supervisor"
                                @* href="@Url.Action("EditTeam", new { groupId = item.GroupId, groupName = item.GroupName, ApproverIds = item.ApproverIds})" *@
                                href="@Url.Action("EditPersonal", new { id = item.EmpId })"
                                data-ajax-success="supervisor.onLoadingEditFormSuccess">
                                    <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">@Labels.NoData</td>
                </tr>
            }
        </tbody>
    </table>
</div>
