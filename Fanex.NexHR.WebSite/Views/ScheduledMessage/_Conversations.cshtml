@model IEnumerable<Fanex.NexHR.ViewModels.ScheduledMessage.ConversationViewModel>

@{
    var isHR = User.IsInRole(Role.HR.EnumToString());
}

@if (Model.Any())
{
    foreach (var item in Model)
    {
        <tr id="conversation-@item.ConversationId">
            <td>@item.ConversationName</td>

            <td>@item.SkypeConversationId</td>
            @if (isHR)
            {
                <td>@item.PermittedEmployees</td>
            }
            <td>@Html.MaterializeCheckBox("IsActive-" + item.ConversationId, item.IsActive, new { @class = " filled-in", onclick = "return false" })</td>

            <td>
                <a data-ajax="true" data-ajax-mode="replace" data-ajax-update="#dialog" href="@Url.Action("EditConversation", new { id = item.ConversationId })"
                   data-ajax-success="conversationManagement.onLoadingEditFormSuccess">
                    <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
                </a>
            </td>
        </tr>
    }
}
else
{
    <tr><td colspan="@(isHR ? 5 : 4)">@Labels.NoData</td></tr>
}