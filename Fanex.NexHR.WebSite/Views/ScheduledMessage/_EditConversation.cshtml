@model Fanex.NexHR.ViewModels.ScheduledMessage.EditConversationViewModel

@using (Html.AjaxBeginForm("EditConversation", null, new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "conversationManagement.onEditSuccess",
}, new { id = "edit-conversation-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ConversationId"/>

    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>Name</label>
            </div>
            <div class="left input--l">
                <input asp-for="ConversationName"/>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>Conversation ID</label>
            </div>
            <div class="left select--l">
                <input asp-for="SkypeConversationId"/>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>Active</label>
            </div>
            <div class="left">
                <input class="filled-in" asp-for="IsActive" type="checkbox" value="true">
                <label for="IsActive"></label>
            </div>
        </div>
    </div>

    if (Model.HasHRRole)
    {
        <div class="row form-input">
            <div class="col">
                <div class="left label--l">
                    <label>Permitted Employees</label>
                </div>
                <div class="left input--l">
                    <select asp-for="PermittedEmployeeIds" asp-items="@Model.Employees" class="select-2"></select>
                </div>
            </div>
        </div>
    }
}