@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@{
    ViewBag.Title = Labels.ScheduledMessage;
    ViewData["Year"] = 1999;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/scheduledmessage.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/leaverequest.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/jquery.validate.unobtrusive.js" asp-append-version="true"></script>
        <script src="~/js/Views/ScheduledMessage/scheduled-message.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/scheduledmessage.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base scheduledmessage">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">
                        @ViewBag.Title
                        <a href="https://docs.google.com/document/d/1A-HZT1NniPHi24xhZCga-NpoBbb5qqHu-O5KjI8j45k" target="_blank"><i class="mdi mdi-information-outline"></i></a>
                    </span>
                </div>
                <div class="card-body card-leave-detail">
                    @using (Html.AjaxBeginForm("Search", "ScheduledMessage", null, new AjaxOptions
                    {
                        InsertionMode = InsertionMode.Replace,
                        UpdateTargetId = "scheduled-message-body",
                        HttpMethod = "GET"
                    }, new { id = "search-form" }))
                    {
                        <div class="form clearfix">
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--s">
                                        <label>@Labels.Year</label>
                                    </div>
                                    <div class="left select--xs">
                                        <select name="Year" id="Year" asp-items="@Extensions.YearPicker(2010, DateTime.Now.Year)">
                                        </select>    
                                    </div>
                                    <i class="btn-submit waves-effect waves-light waves-input-wrapper m-r--b" style="">
                                        <input id="btn-submit" class="waves-button-input" type="submit" value="@Labels.Submit">
                                    </i>
                                </div>
                                <div class="col">
                                    @if(@ViewBag.NumberOfConversations > 0)
                                    {
                                        @Html.AjaxActionLink("New Message", "Create", null, new AjaxOptions {
                                            InsertionMode = InsertionMode.Replace,
                                            UpdateTargetId = "dialog",
                                            OnSuccess = "scheduledMessage.onLoadingCreateFormSuccess"
                                        }, new { @class= "btn-request waves-effect waves-light m-r--s" })
                                    }
                                    else
                                    {
                                        <input id="btnNewMessage_Fail" type="button" class="btn-request waves-effect waves-light m-r--s" value="New Message"/>
                                    }
                                    <a asp-controller="ScheduledMessage" asp-action="ManageConversations" class="btn-request waves-effect waves-light m-r--s">@Labels.ManageConversations</a>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="p-x--s m-t--m cover-table">
                        <table id="scheduled-message-table" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th>@Labels.Conversation</th>
                                    <th>@Labels.SendDate</th>
                                    <th>@Labels.Content</th>
                                    <th>@Labels.CreatedBy</th>
                                    <th>@Labels.Action</th>
                                </tr>
                            </thead>
                            <tbody id="scheduled-message-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="dialog">
</div>