@{
    ViewBag.Title = Labels.ScheduledMessage;
}

@section css{
    @Styles.Render("~/Content/scheduledmessagecss")
}

@section js{
    @Scripts.Render("~/bundles/scheduledmessagejs")
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">
                        @ViewBag.Title
                        <a href="@AppSetting.ScheduledMessageUserGuide" target="_blank"><i class="mdi mdi-information-outline"></i></a>
                    </span>
                </div>
                <div class="card-body">
                    @using (Ajax.BeginForm("Search", "ScheduledMessage", null, new AjaxOptions
                    {
                        InsertionMode = InsertionMode.Replace,
                        UpdateTargetId = "scheduled-message-body",
                        HttpMethod = "GET"
                    }, new { id = "search-form" }))
                    {
                        <div class="form clearfix">
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--s">
                                        <label>@Labels.Year</label>
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPicker("Year", 2010, DateTime.Now.Year)
                                    </div>
                                </div>
                                <div class="col">
                                    <i class="btn-submit waves-effect waves-light waves-input-wrapper m-r--b" style="">
                                        <input id="btn-submit" class="waves-button-input" type="submit" value="@Labels.Submit">
                                    </i>

                                    @Ajax.ActionLink("New Message", "Create", null, new AjaxOptions {
                                       InsertionMode = InsertionMode.Replace,
                                       UpdateTargetId = "dialog",
                                       OnSuccess = "scheduledMessage.onLoadingCreateFormSuccess"
                                   }, new { @class= "btn-request waves-effect waves-light m-r--s" })

                                    @Html.ActionLink(Labels.ManageConversations, "ManageConversations", null, new { @class = "btn-request waves-effect waves-light m-r--s" })
                                </div>
                            </div>
                        </div>
                    }

                    <div class="p-x--s m-t--m">
                        <table id="scheduled-message-table" class="table bordered striped highlight centered responsive-table table-custom">
                            <thead>
                                <tr>
                                    <th>@Labels.Conversation</th>
                                    <th>@Labels.SendDate</th>
                                    <th>@Labels.Content</th>
                                    <th>@Labels.CreatedBy</th>
                                    <th>@Labels.Action</th>
                                </tr>
                            </thead>
                            <tbody id="scheduled-message-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="dialog">
</div>