@model Fanex.NexHR.ViewModels.ScheduledMessage.EditScheduledMessageViewModel

@using (Html.AjaxBeginForm("Edit", null, new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "scheduledMessage.onEditSuccess"
}, new { id = "edit-form" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ScheduledMessageId"/>
    <div asp-validation-summary="All"></div>

    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>Conversation</label>
            </div>
            <div class="left select--l">
                <select asp-for="ConversationId" asp-items="@Model.Conversations"></select>
            </div>
        </div>
    </div>
    <div class="row form-input" style="margin-bottom: 1rem">
        <div class="col">
            <div class="left label--l">
                <label>Repeat</label>
            </div>
            <div class="left">
                <input type="checkbox" asp-for="IsRepeat" class="filled-in"/>
                <label for="IsRepeat"></label>
            </div>
        </div>
    </div>

    <div class="row form-input" id="type-of-cron-edit" style="@(Model.IsRepeat ? "" : "display:none")">
        <div class="col">
            <div class="left label--l">
                <label>Repeat every</label>
            </div>
            <div class="left select-repeat">
                <input type="number" asp-for="StepNumber" min = "1" max = "99" step = "1" MaxLength = "2"/>
            </div>
            <div class="left select-repeat ml-2rem">
                <select asp-for="RepeatTypeId" asp-items="@Model.RepeatTypes" class="material-select"></select>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label id="lable-time">@(Model.IsRepeat ? "From" : "Send date")</label>
            </div>
            <div class="datepicker-button left select-repeat">
                <date-picker 
                    name="SendDate"
                    value="Model.SendDate"
                >
                </date-picker>
                <i class="mdi-action-event calendar-icon from-date left"></i>
            </div>
        </div>
        <div class="col">
            <div class="left input-xs input-hour">
                <span class="time">
                    <input type="number" asp-for="Hour" min = "0" max = "23" step = "1" MaxLength = "2"/>
                </span>
            </div>
        </div>
        <div class="col divide">:</div>
        <div class="col">
            <div class="left input-xs input-minute">
                <span class="time">
                    <input type="number" asp-for="Minute" min = "0" max = "59" step = "5" MaxLength = "2"/>
                </span>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>Content</label>
            </div>
            <div class="left input--l">
                <textarea asp-for="Content" class="materialize-textarea" rows="5"></textarea>
            </div>
        </div>
    </div>
}