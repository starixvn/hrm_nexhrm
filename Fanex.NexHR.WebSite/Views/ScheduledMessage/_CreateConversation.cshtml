@model Fanex.NexHR.ViewModels.ScheduledMessage.CreateConversationViewModel

@using (Ajax.BeginForm("CreateConversation", null, new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "scheduledMessage.onCreateConversationSuccess"
}, new { id = "create-conversation-form" }))
{
    @Html.AntiForgeryToken()
    <div class="row form-input">
        <div class="col">
            <div class="left label--m">
                @Html.LabelFor(model => model.ConversationId)
            </div>
            <div class="left select--l">
                @Html.TextBoxFor(model => model.ConversationId)
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--m">
                @Html.LabelFor(model => model.ConversationName)
            </div>
            <div class="left input--l">
                @Html.TextBoxFor(model => model.ConversationName)
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--m">
                @Html.LabelFor(model => model.PermittedEmployeeIds)
            </div>
            <div class="left input--l">
                @Html.ListBoxFor(model => model.PermittedEmployeeIds, Model.Employees, new { @class = "select-2" })
            </div>
        </div>
    </div>
}