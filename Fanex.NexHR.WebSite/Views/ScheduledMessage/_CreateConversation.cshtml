@model Fanex.NexHR.ViewModels.ScheduledMessage.CreateConversationViewModel

@using (Html.AjaxBeginForm("CreateConversation", null, new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "conversationManagement.onCreateSuccess"
}, new { id = "create-conversation-form" }))
{
    @Html.AntiForgeryToken()
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>Name</label>
            </div>
            <div class="left input--l">
                <input asp-for="ConversationName"/>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>Conversation ID</label>
            </div>
            <div class="left select--l">
                <input asp-for="SkypeConversationId"/>
            </div>
        </div>
    </div>
    if (Model.HasHRRole)
    {
        <div class="row form-input">
            <div class="col">
                <div class="left label--l">
                    <label>Permitted Employees</label>
                </div>
                <div class="left input--l">
                    <select asp-for="PermittedEmployeeIds" asp-items="@Model.Employees" class="select-2"></select>
                </div>
            </div>
        </div>
    }
}