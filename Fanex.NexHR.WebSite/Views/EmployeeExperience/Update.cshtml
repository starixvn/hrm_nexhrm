@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.EmployeeExperience
@model EmployeeExperienceViewModel
@{
    DateTime currentDate = DateTime.Today; 
}
<form id="frmUpdateExperience" class="form form-update-experience">
    <div id="divErrorCont" class="">
        &nbsp;
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>Type</label>
        </div>
        <div class="left input--m">
            <select class="typeExperience" name="Type" id="typeId">
                <option selected="@(Model.Type == "Course")" value="Course">Course</option>
                <option selected="@(Model.Type == "Certificate")" value="Certificate">Certificate</option>
                <option selected="@(Model.Type == "Training")" value="Training">Training</option>
            </select>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Employee</label>
        </div>
        <div class="left input--m">
            <input asp-for="Employee" disabled value="@Model.Employee" placeholder="@Messages.SearchEmployeeWatermark"/>
            <input asp-for="EmployeeId" type="hidden" />
            <input asp-for="Id" type="hidden" value="@Model.Id" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>Department</label>
        </div>
        <div class="left input--m">
            <input asp-for="Department" value="@Model.Department" />
            <input asp-for="DepartmentId" type="hidden" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>Name</label>
        </div>
        <div class="left input--m">
            <input asp-for="Name" value="@Model.Name" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label id="address">Study Place</label>
        </div>
        <div class="left input--m">
            <input asp-for="Organization" value="@Model.Organization" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label id="fromdate">Start Date</label>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="ExamDate"
                         min-date="currentDate.AddYears(-100)"
                         max-date="currentDate"
                         value="@Model.StartDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label id="todate">End Date</label>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="ExpirationDate"
                         min-date="currentDate.AddYears(-100)"
                         max-date="currentDate"
                         value="@Model.ExpirationDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
</form>