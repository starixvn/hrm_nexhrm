@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Holiday
@model HolidayViewModel
@{
    ViewBag.Title = Labels.Holiday;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Holiday/holiday.edit.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/holidayedit.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.CreateHoliday</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        <div class="form form-stl-table">
                            @Html.ValidationSummary(true)
                            @if (ViewBag.Inserted == true)
                            {
                                <input type="hidden" id="successed" value="true" />
                                <div class="row validation-summary-success">
                                    <div class="col success green-text"><i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>Created Successful!</div>
                                </div>
                            }

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Name, Labels.HolidayName)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.Name)
                                        @Html.ValidationMessageFor(model => model.Name)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>Date(s)</label>
                                    </div>
                                    <div class="left">
                                        @{
                                            var numDay = Model.ToDate.Day - Model.FromDate.Day + 1;
                                        }
                                        <input type="number" name="numDay" id="numDay" min="1" max="15" step="1" value="@numDay" />
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left">
                                        <div class="select--s datepicker-button">
                                            <date-picker
                                                name="FromDate"
                                                value="Model.FromDate"
                                            >
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.FromDate)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left">
                                        <div class="select--s datepicker-button">
                                            <date-picker
                                                name="ToDate"
                                                value="Model.ToDate"
                                            >
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.ToDate)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input line-button">
                                <div class="col">
                                    <div class="left label--l">&nbsp;</div>
                                    <div class="left">
                                        @Html.AntiForgeryToken()
                                        <a class="btn-back waves-effect waves-light" href="@Url.Action("index", "holiday")">@Labels.Back</a>
                                        <input id="btnAdd" class="btn-submit waves-effect waves-light right" type="submit" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
