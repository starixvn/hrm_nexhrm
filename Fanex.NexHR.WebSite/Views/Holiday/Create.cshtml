@using Fanex.NexHR.ViewModels.Holiday
@model HolidayViewModel
@{
    ViewBag.Title = Labels.Holiday;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/holidayedit");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.CreateHoliday</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                        {
                            <div class="form" style="min-width: 400px">
                                @Html.ValidationSummary(true)
                                @if (ViewBag.Inserted == true)
                                {
                                    <input type="hidden" id="successed" value="true" />
                                    <div class="row validation-summary-success">
                                        <div class="col success green-text"><i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>Created Successful!</div>
                                    </div>
                                }

                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.Name, Labels.HolidayName)
                                        </div>
                                        <div class="left input--m">
                                            @Html.EditorFor(model => model.Name)
                                            @Html.ValidationMessageFor(model => model.Name)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            <label>Date(s)</label>
                                        </div>
                                        <div class="left">
                                            @{
                                                var numDay = Model.ToDate.Day - Model.FromDate.Day + 1;
                                            }
                                            <input type="number" name="numDay" id="numDay" min="1" max="15" step="1" value="@numDay" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                        </div>
                                        <div class="left">
                                            <div class="select--s datepicker-button">
                                                @Html.DatePickerFor(model => model.FromDate)
                                                <i class="mdi-action-event calendar-icon left"></i>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.FromDate)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                        </div>
                                        <div class="left">
                                            <div class="select--s datepicker-button">
                                                @Html.DatePickerFor(model => model.ToDate)
                                                <i class="mdi-action-event calendar-icon left"></i>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ToDate)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="left label--l">&nbsp;</div>
                                    <div class="left col">
                                        @Html.AntiForgeryToken()
                                        <a class="btn-back waves-effect waves-light" href="@Url.Action("index", "holiday")" class="button">@Labels.Back</a>
                                        <input class="btn-submit waves-effect waves-light right" type="submit" value="Add" />
                                    </div>
                                </div>
                            </div>
                        }
                </div>
            </div>
        </div>
    </div>
</div>
