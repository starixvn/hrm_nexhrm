@using System.Web.Mvc.Html5;
@using Fanex.NexHR.Core
@model Fanex.NexHR.Models.Holiday
@{
    ViewBag.Title = Labels.Holiday;
}
@section css {
}
@section js {
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 l7 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @if (Model != null)
                    {
                        using (Html.BeginForm())
                        {
                        <div class="form">
                            @Html.ValidationSummary(true)
                            @if (ViewBag.Updated == true)
                            {
                                <div class="row validation-summary-success">
                                    <div class="col success green-text"><i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>Edited Successful!</div>                                    
                                </div>
                            }
                            @Html.HiddenFor(model => model.Id)
                           
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.HolidayName)
                                    </div>
                                    <div class="left input--m">
                                        @Html.EditorFor(model => model.HolidayName)
                                        @Html.ValidationMessageFor(model => model.HolidayName)
                                    </div>
                                </div> 
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>Date(s)</label>
                                    </div>
                                    <div class="left input--xs">
                                        @{
                                            var numDay = Model.ToDate.Day - Model.FromDate.Day + 1;
                                        }
                                        <input type="number" name="numDay" id="numDay" min="1" max="15" step="1" value="@numDay">
                                    </div>
                                </div>                                
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FromDate)
                                    </div>
                                    <div class="left datepicker-button input--s">
                                        @Html.DatePickerFor(model => model.FromDate)
                                        @Html.ValidationMessageFor(model => model.FromDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>                                
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.ToDate)
                                    </div>
                                    <div class="left datepicker-button input--s">
                                        @Html.DatePickerFor(model => model.ToDate)
                                        @Html.ValidationMessageFor(model => model.ToDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    @Html.AntiForgeryToken()
                                    <input class="btn-submit waves-effect waves-light button-primary submit m-r--s" type="submit" value="Save" />
                                    <a class="button-hrm waves-effect waves-light btn white-text grey darken-1" href="@Url.Action("index", "holiday")">@Labels.Back</a>
                                </div>
                            </div>
                        </div>
                        }
                    }
                    else
                    {
                        <h2>@Messages.NoDataIsAvailable</h2>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
