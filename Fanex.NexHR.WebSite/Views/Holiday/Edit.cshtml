@using Fanex.NexHR.ViewModels.Holiday
@model HolidayViewModel
@{
    ViewBag.Title = Labels.Holiday;
}
@section css {
    @Styles.Render("~/Content/view-mobile")
}
@section js {
    @Scripts.Render("~/bundles/holidayedit");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @if (Model != null)
                    {
                        <div class="form form-stl-table">
                            @using (Html.BeginForm())
                            {

                                @Html.HiddenFor(model => model.Id)
                                @Html.ValidationSummary(true)
                                if (ViewBag.Updated == true)
                                {
                                    <input type="hidden" id="successed" value="true" />
                                    <div class="row validation-summary-success">
                                        <div class="col success green-text">
                                            <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>Edited Successful!
                                        </div>
                                    </div>
                                }
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.Name, Labels.HolidayName)
                                        </div>
                                        <div class="left input--m">
                                            @Html.EditorFor(model => model.Name)
                                            @Html.ValidationMessageFor(model => model.Name)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            <label>
                                                Date(s)
                                            </label>
                                        </div>
                                        <div class="left">
                                            @{
                                                var numDay = Model.ToDate.Day - Model.FromDate.Day + 1;
                                            }
                                            <input type="number" name="numDay" id="numDay" min="1" max="15" step="1" value="@numDay">
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                        </div>
                                        <div class="left">
                                            <div class="select--s datepicker-button">
                                                @Html.DatePickerFor(model => model.FromDate)
                                                <i class="mdi-action-event calendar-icon left"></i>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.FromDate)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                        </div>
                                        <div class="left">
                                            <div class="select--s datepicker-button">
                                                @Html.DatePickerFor(model => model.ToDate)
                                                <i class="mdi-action-event calendar-icon left"></i>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ToDate)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input line-button">
                                    <div class="col">
                                        <div class="left label--l">
                                            &nbsp;
                                        </div>
                                        <div class="left">
                                            @Html.AntiForgeryToken()
                                            <a class="btn-back waves-effect waves-light" href="@Url.Action("index", "holiday")">@Labels.Cancel</a>
                                            <input id="btnSave" class="btn-submit waves-effect waves-light submit right" type="submit" value="@Labels.Submit" />
                                        </div>
                                    </div>
                                </div>

                            }
                        </div>
                    }
                    else
                    {
                        <h2>@Messages.NoDataIsAvailable</h2>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
