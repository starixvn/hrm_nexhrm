@model IList<Holiday>
@{
    ViewBag.Title = Labels.Holidays;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/holidays")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginGetForm())
                    {
                        <div class="form">
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--s">
                                        <label>@Labels.Year</label>
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPicker("year", 2010, (int)ViewBag.year)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" id="submit" value="@Labels.Submit" class="btn-submit waves-effect waves-light m-r--m" />
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        @Html.ActionLink(Labels.NewHoliday, "Create", "", new { @class = "btn-request waves-effect waves-light" })
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Name</th>
                                    <th>@Labels.From</th>
                                    <th>@Labels.To</th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th>@Labels.Edit</th>
                                        <th>@Labels.Delete</th>
                                    }
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var isHR = '@Roles.IsUserInRole("HR")' == 'True';
</script>
<script id="template" type="text/x-jquery-tmpl"> 
    <tr id="row_${Id}">
        <td class='center'>
            ${index()}
        </td>
        <td class="align-left">
            ${HolidayName}
        </td>
        <td>
            ${formatDate(FromDate, 'dd MMM, yyyy')}
        </td>
        <td class="ddMMyyyy">
            ${formatDate(ToDate, 'dd MMM, yyyy')}
        </td>
        {{if isHR}}
            <td class="cmd">
                <a href="/holiday/edit/${Id}">
                    <i class="mdi mdi-border-color mdi-dark"></i>
                </a>
            </td>
            <td class="cmd">
                <a href="javascript:;" onclick="deleteHoliday(${Id});">
                    <i class="mdi mdi-delete mdi-dark"></i>
                </a>
            </td>
        {{/if}}
    </tr> 
</script>
