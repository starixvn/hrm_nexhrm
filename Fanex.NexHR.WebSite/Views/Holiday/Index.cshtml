@using Fanex.NexHR.Core;
@using Fanex.NexHR.Models
@model IList<Fanex.NexHR.Models.Holiday>
@{
    ViewBag.Title = Labels.Holidays;
    bool isHRRole = Roles.IsUserInRole("HR");
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/holidays")
}
@section Breadcrumb {
}
<div class="loading-process" style="display: none">
</div>
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginGetForm())
                    {
                        <div class="form">
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--s">
                                        <label>
                                            Year</label>
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPicker("year", 2010, (int)ViewBag.year)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" id="submit" value="@Labels.Submit" class="processing-submit btn-submit waves-effect waves-light m-r--m" />
                                    @if (isHRRole)
                                    {
                                        @Html.ActionLink("New Holiday", "Create", "", new { @class = "button-hrm waves-effect waves-light btn orange darken-1 white-text" })
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    <div class="p-x--s">
                        <table id="data" class="data persist-area table bordered striped highlight centered table-custom" style="width: 800px;">
                            <thead>
                                <tr class="persist-header">
                                    <th>
                                        #
                                    </th>
                                    <th>@Labels.Name
                                    </th>
                                    <th>@Labels.From
                                    </th>
                                    <th>@Labels.To
                                    </th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th>@Labels.Edit
                                        </th>
                                        <th>@Labels.Delete
                                        </th>
                                    }
                                </tr>
                            </thead>
                            @if (Model.Any())
                            {
                                <tbody>
                                    @{int index = 1;}
                                    @foreach (Holiday item in Model)
                                    {
                                        <tr id="row@(item.Id)">
                                            <td>@(index++)
                                            </td>
                                            <td class="align-left">
                                                @item.HolidayName
                                            </td>
                                            <td class="ddMMyyyy">
                                                @item.FromDate.ToDateMonthYearFormatedDate()
                                            </td>
                                            <td class="ddMMyyyy">
                                                @item.ToDate.ToDateMonthYearFormatedDate()
                                            </td>
                                            @if (Roles.IsUserInRole("HR"))
                                            {
                                                <td class="cmd">
                                                    <a href="@Url.Action("Edit", "Holiday", new { Id = item.Id })"><i class="mdi mdi-border-color mdi-dark">
                                                    </i>
                                                </td>
                                                <td class="cmd">
                                                    <a href="javascript:;" onclick="deleteHoliday(@item.Id);"><i class="mdi mdi-delete mdi-dark">
                                                    </i>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            }
                            else
                            {                                
                                @RazorHelper.DisplayNoInformation(colspan: 7);
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var isHR = '@Roles.IsUserInRole("HR")' == 'True' ? true : false;    
</script>
<script id="template" type="text/x-jquery-tmpl"> 
    <tr id="row_${Id}">
        <td class='center'>
            ${index()}
        </td>
        <td class="align-left">
            ${HolidayName}
        </td>
        <td>            
            ${formatDate(FromDate, 'dd MMM, yyyy')}   
        </td>
        <td class="ddMMyyyy">
            ${formatDate(ToDate, 'dd MMM, yyyy')}                                                    
        </td>      

        {{if isHR}}
            <td class="cmd">            
                <a href="/holiday/edit/${Id}"><i class="mdi mdi-border-color mdi-dark">
                </i>
            </td>
            <td class="cmd">
                <a href="javascript:;" onclick="deleteHoliday(${Id});"><i class="mdi mdi-delete mdi-dark">
                </i>
            </td>                                  
        {{/if}}           
    </tr> 
</script>
