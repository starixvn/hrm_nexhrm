@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.Employee.ChangePasswordViewModel
@{
    ViewBag.Title = Labels.ChangePassword;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
	                    @if (ViewBag.Success == true)
	                    {
		                    <input type="hidden" id="successed" value="true" />
		                    <div class="row validation-summary-success">
			                    <div class="col success green-text">
				                    <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Labels.PasswordChangedSuccessfully
			                    </div>
		                    </div>
	                    }
                        <form asp-controller="employee" asp-action="submitchangepassword" method="post">
                            <div asp-validation-summary="All"></div>

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        <label>@Labels.CurrentPassword</label>
                                    </div>
                                    <div class="col left input--l">
                                        <input type="password" required asp-for="CurrentPassword" value="" />
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        <label>@Labels.NewPassword</label>
                                    </div>
                                    <div class="col left input--l">
                                        <input type="password" required asp-for="NewPassword" value="" />
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        <label>@Labels.ConfirmNewPassword</label>
                                    </div>
                                    <div class="col left input--l">
                                        <input type="password" required asp-for="ConfirmNewPassword" value="" />
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m col-btn">
                                    <div class="left label--xl">&nbsp;</div>
                                    <div class="left col">
                                        <input class="btn-submit waves-effect waves-light" type="submit"
                                            value="@Labels.Save" />
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>