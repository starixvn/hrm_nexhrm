@model IList<WorkingCalendarsViewModel>
@section css {
    @Styles.Render("~/Content/monthpickercss", "~/Content/monthpickercss", "~/Content/workingcalendarscss")
}
@section js {
    @Scripts.Render("~/bundles/workingcalendarsjs", "~/bundles/monthpickerjs")
}
@{
    ViewBag.Title = "Working calendar";
}
@{
    //Set max month we can select in MonthPick
    int Month = 12;
    int Year = DateTime.Now.GetMaxDate().Year + 1;

    var maxDate = new System.Text.StringBuilder();
    maxDate.AppendFormat("{0}/{1}/1", Year, Month);
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginGetForm())
                        {
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--s">
                                        <label>@Labels.Month</label>
                                    </div>
                                    <div class="left select--m">
                                        <div id="monthPickr"></div>
                                        <input type="hidden" id="hdtoday" value="@maxDate.ToString()" />
                                        <input type="hidden" id="hdmonth" value="@ViewBag.CurrentDate" />
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left">
                                        <input type="hidden" id="Year" name="Year" value="@ViewBag.Year" />
                                        <input type="hidden" id="Month" name="Month" value="@ViewBag.Month" />
                                        <input type="hidden" id="maxDate" value="@maxDate.ToString()" />
                                        <span class="button-hrm waves-effect waves-light btn blue darken-2 m-r--m">
                                            <input type="submit" value="@Labels.Submit" class="processing-submit" /></span>
                                    </div>
                                    <div class="left">
                                        @if (Roles.IsUserInRole("HR"))
                                        {
                                            <a class="button-hrm waves-effect waves-light btn orange darken-1" href="javascript:;"
                                                id="btnAddCalendar">@Labels.AddEmployeeCalendar</a>
                                        }
                                    </div>
                                </div>
                            </div>   
                        }
                    </div>
                    <div class="datagrid-wrap panel-body p-x--s">
                        <div class="datagrid-view">
                            <div class="datagrid-view1">
                                <div class="datagrid-header">
                                    <div style="display: block;" class="datagrid-header-inner">
                                        <table cellspacing="0" cellpadding="0" border="0">
                                            <tbody>
                                                <tr style="background-color: #ccc;">
                                                    <td colspan="3" align="right">
                                                        <div style="width: 150px; text-align: right;" class="datagrid-cell">
                                                            <b style="text-transform: uppercase">@(new DateTime(ViewBag.Year, ViewBag.Month, 1).ToString("MMM yyyy"))</b>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <div class="datagrid-cell-rownumber">
                                                            #
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div style="width: 150px; text-align: left;" class="datagrid-cell ">
                                                            @Labels.FullName
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div style="width: 90px; text-align: left;" class="datagrid-cell ">
                                                            @Labels.Nick
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="datagrid-body">
                                    <div class="datagrid-body-inner">
                                        <table cellspacing="0" cellpadding="0" border="0">
                                            <tbody>
                                                @{int rowId = 1;}
                                                @foreach (WorkingCalendarsViewModel employee in Model)
                                                {
                                                    <tr>
                                                        <td class="datagrid-header-rownumber">
                                                            <div class="datagrid-cell-rownumber">
                                                                @rowId
                                                            </div>
                                                        </td>
                                                        <td class="datagrid-fullname">
                                                            <div style="width: 150px; text-align: left;" class="datagrid-cell ">
                                                                @employee.FullName
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div style="width: 90px; text-align: left;" class="datagrid-cell ">
                                                                @employee.NickName
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    rowId++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="datagrid-view2">
                                <div class="datagrid-header">
                                    <div style="display: block;" class="datagrid-header-inner">
                                        <table cellspacing="0" cellpadding="0" border="0">
                                            <tbody>
                                                @{
                                                    int daysInMonth = Model.Count != 0
                                                        ? Model[0].Days
                                                        : DateTime.DaysInMonth(ViewBag.Year, ViewBag.Month);
                                                    <tr style="background-color: #ccc;">
                                                        @for (int i = 1; i <= daysInMonth; i++)
                                                        {

                                                            <td>
                                                                <div style="width: 50px; text-align: center;" class="datagrid-cell ">
                                                                    @i
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                    <tr>
                                                        @for (int i = 1; i <= daysInMonth; i++)
                                                        {
                                                            DateTime dt = new DateTime(ViewBag.Year, ViewBag.Month, i);
                                                            <td class="@((dt.DayOfWeek == DayOfWeek.Saturday || dt.DayOfWeek == DayOfWeek.Sunday) ? "SatSunDay" : string.Empty)">
                                                                <div style="width: 50px; text-align: center;" class="datagrid-cell">
                                                                    @dt.ToString("ddd")
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="datagrid-body">
                                    <table cellspacing="0" cellpadding="0" border="0" class="shift-grid">
                                        <tbody>
                                            @{
                                                foreach (UserChangedShift user in ViewBag.UserChangeShift)
                                                {
                                                    foreach (WorkingCalendarsViewModel employee in Model)
                                                    {
                                                        if (employee.EmpId == user.Id)
                                                        {
                                                            for (int i = 0; i < employee.WorkingDays.Count; i++)
                                                            {
                                                                if (user.Day == i + 1)
                                                                {
                                                                    var prefix = "_";
                                                                    employee.WorkingDays[i] = prefix + employee.WorkingDays[i];
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                foreach (HalfDayOff item in ViewBag.HalfDayOffs)
                                                {
                                                    foreach (WorkingCalendarsViewModel employee in Model)
                                                    {
                                                        if (employee.EmpId == item.Id)
                                                        {
                                                            for (int i = 0; i < employee.WorkingDays.Count; i++)
                                                            {
                                                                if (item.Day == i + 1)
                                                                {
                                                                    employee.WorkingDays[i] = "-" + employee.WorkingDays[i];
                                                                }
                                                            }
                                                        }
                                                    }

                                                }
                                            }
                                            @foreach (WorkingCalendarsViewModel employee in Model)
                                            {
                                                var day = 1;
                                                <tr class="row">
                                                    @foreach (string shift in employee.WorkingDays)
                                                    {
                                                        if (!string.IsNullOrEmpty(shift) && shift[0].Equals('_'))
                                                        {
                                                        <td class="ChangeShift">
                                                            <div class="datagrid-cell">
                                                                @shift.Substring(1)
                                                            </div>
                                                        </td>
                                                        }
                                                        else if (!string.IsNullOrEmpty(shift) && shift[0].Equals('-'))
                                                        {
                                                        <td class="HAL">
                                                            <div class="datagrid-cell">
                                                                @shift.Substring(1)
                                                            </div>
                                                        </td>
                                                        }
                                                        else if (shift.Equals("AL"))
                                                        {
                                                        <td class="AL">
                                                            <div class="datagrid-cell">
                                                                @shift
                                                            </div>
                                                        </td>
                                                        }
                                                        else if (shift.Equals("UPL"))
                                                        {
                                                        <td class="UPL">
                                                            <div class="datagrid-cell">
                                                                @shift
                                                            </div>
                                                        </td>
                                                        }
                                                        else if (shift.Equals("HAL"))
                                                        {
                                                        <td class="HAL">
                                                            <div class="datagrid-cell">
                                                                @shift
                                                            </div>
                                                        </td>
                                                        }
                                                        else if (shift.Equals("OFF") || shift.Equals("PH"))
                                                        {
                                                        <td class="OFF">
                                                            <div class="datagrid-cell">
                                                                @shift
                                                            </div>
                                                        </td>
                                                        }
                                                        else if (shift.Equals("BL"))
                                                        {
                                                        <td class="BL">
                                                            <div class="datagrid-cell">
                                                                @shift
                                                            </div>
                                                        </td>
                                                        }
                                                        else if (shift.Equals("BT"))
                                                        {
                                                        <td class="BT">
                                                            <div class="datagrid-cell">
                                                                @shift
                                                            </div>
                                                        </td>
                                                        }
                                                        else if (shift.Contains('/'))
                                                        {
                                                        <td class="HH">
                                                            <div class="datagrid-cell">
                                                                @shift
                                                            </div>
                                                        </td>
                                                        }
                                                        else
                                                        {
                                                        <td>
                                                            <div class="datagrid-cell">
                                                                @shift
                                                            </div>
                                                        </td>
                                                        }
                                                        day++;
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="container_24" id="colordef">
                        <div class="grid_2 AL tooltip alpha" title="Annual Leave">
                            AL</div>
                        <div class="grid_2 HAL tooltip" title="Half Annual Leave">
                            AL</div>
                        <div class="grid_2 UPL tooltip alpha" title="Unpaid Leave">
                            UPL</div>
                        <div class="grid_2 OFF tooltip" title="Public Holiday/Off Day">
                            PH/OFF</div>
                        <div class="grid_2 BL tooltip" title="Bereavement Leave">
                            BL</div>
                        <div class="grid_2 BT tooltip" title="Business Trip">
                            BT</div>
                        <div class="grid_2 ChangeShift tooltip" title="Change Shift">
                            CS</div>
                        <div class="grid_2 tooltip" title="Wedding Leave">
                            WL</div>
                        <div class="grid_2 tooltip" title="Maternity Leave">
                            ML</div>
                        <div class="grid_2 HH tooltip" title="2 Leave Half Day">
                            H/H</div>
                    </div>
                    <div class="hide">
                        <div id="addform" title="Add Calendars">
                            @Html.Action("WorkingCalendarInsert")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
