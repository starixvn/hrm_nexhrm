@model IEnumerable<EmployeeBirthdayViewModel>
@{
    ViewBag.Title = Labels.EmployeeBirthday;
}
@section css {
    @Styles.Render("~/Content/staffbirthdaycss")
}
@section js {
    @Scripts.Render("~/bundles/staffbirthdayjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 l7 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="p-x--s m-t--m">
                        <table id="data" class="table bordered striped highlight centered responsive-table table-custom" style="width: 700px;">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.FullName</th>
                                    <th>@Labels.Nick</th>
                                    <th>@Labels.DateOfBirth</th>
                                    <th>@Labels.Month</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                var index = 1; 
                                var cssClass = string.Empty;
                                
                                foreach (var item in Model)
                                {
                                    switch (item.Month)
                                    {
                                        case 1: cssClass = "january";
                                            break;
                                        case 2: cssClass = "february";
                                            break;
                                        case 3: cssClass = "march";
                                            break;
                                        case 4: cssClass = "april";
                                            break;
                                        case 5: cssClass = "may";
                                            break;
                                        case 6: cssClass = "june";
                                            break;
                                        case 7: cssClass = "july";
                                            break;
                                        case 8: cssClass = "august";
                                            break;
                                        case 9: cssClass = "september";
                                            break;
                                        case 10: cssClass = "october";
                                            break;
                                        case 11: cssClass = "november";
                                            break;
                                        case 12: cssClass = "december";
                                            break;
                                        default:
                                            break;
                                    }

                                    <tr class="@cssClass">
                                        <td>@index</td>
                                        <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.NickName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Month)</td>
                                    </tr>
                                    
                                    index++;
                                }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
