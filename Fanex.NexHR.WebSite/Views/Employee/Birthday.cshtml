@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Employee
@model IEnumerable<EmployeeBirthdayViewModel>
@{
    ViewBag.Title = Labels.EmployeeBirthday;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/staffbirthday.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Employee/employee.birthday.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/staffbirthday.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="p-x--s m-t--m over-auto cover-form-mb table-team">
                        <table id="data" class="table bordered striped highlight centered responsive-table table-custom" style="width: 700px;">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.FullName</th>
                                    <th>@Labels.EnglishName</th>
                                    <th>@Labels.DateOfBirth</th>
                                    <th>@Labels.Month</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 1;
                                    var cssClass = string.Empty;
                                    if ((bool)ViewBag.ShowOneMonth)
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@index</td>
                                                <td class="align-left">@item.FullName</td>
                                                <td>@item.NickName</td>
                                                <td>@item.DateOfBirth</td>
                                                <td>@item.Month</td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                    else
                                    {
                                        foreach (var item in Model)
                                        {
                                            switch (item.Month)
                                            {
                                                case 1: cssClass = "january";
                                                    break;
                                                case 2: cssClass = "february";
                                                    break;
                                                case 3: cssClass = "march";
                                                    break;
                                                case 4: cssClass = "april";
                                                    break;
                                                case 5: cssClass = "may";
                                                    break;
                                                case 6: cssClass = "june";
                                                    break;
                                                case 7: cssClass = "july";
                                                    break;
                                                case 8: cssClass = "august";
                                                    break;
                                                case 9: cssClass = "september";
                                                    break;
                                                case 10: cssClass = "october";
                                                    break;
                                                case 11: cssClass = "november";
                                                    break;
                                                case 12: cssClass = "december";
                                                    break;
                                            }
                                            <tr class="@cssClass">
                                                <td>@index</td>
                                                <td class="align-left">@item.FullName</td>
                                                <td>@item.NickName</td>
                                                <td>@item.DateOfBirth</td>
                                                <td>@item.Month</td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>