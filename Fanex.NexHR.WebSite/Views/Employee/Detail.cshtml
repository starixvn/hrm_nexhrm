@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model Fanex.NexHR.Models.Employee
@{
    var isHRRole = sessionService.CurrentEmployee.RoleList.Any(r => r == (short)Role.HR || r == (short)Role.SA);
    var count = 0;
    const string certificate = "Certificate";
    const string formatDate = "dd MMMM yyyy";
}
@if (Model != null)
{
    ViewBag.Title = Model.NickName + " - " + Model.FullName;
}
else
{
    ViewBag.Title = string.Empty;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/myprofile.min.css" asp-append-version="true">
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.StaffInfo</span>
                </div>
                <div class="card-body">
                    @if (Model != null)
                    {
                        <div class="avatarbox m-t--m">
                            <div class="row">
                                <div class="col">
                                    <div class="avatar">
                                        <img src="~/employee/avatar/@(Model.Code)" alt="@Model.NickName" />
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="row">
                                        <div class="col name">@Model.FullName</div>
                                    </div>
                                    <div class="row">
                                        <div class="col m-r--xl">
                                            <div class="pinfo">
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.StaffCode:</span> <span>@Model.Code</span>
                                                </p>
                                                <p class="accinfo">
                                                    <span class="label--l">Domain:</span> <span>@Model.DomainUsername</span>
                                                </p>
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.Email:</span> <span><a href="mailto:@Model.Email">@Model.Email</a></span>
                                                </p>
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.Phone:</span> <span>@Model.Phone</span>
                                                </p>
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.Skype:</span> <span><a href="skype:@(Model.Skype)?chat">@Model.Skype</a></span>
                                                </p>
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.Telegram:</span> <span><a href="ymsgr:SendIM?@(Model.Yahoo)">@Model.Yahoo</a></span>
                                                </p>
                                                @if (@isHRRole)
                                                {   
                                                    <p class="accinfo">
                                                        <span class="label--l">@Labels.Address:</span> <span>@Model.Address</span>
                                                    </p>
                                                    <p class="accinfo">
                                                        <span class="label--l">@Labels.CurrentAddress:</span> <span class="address">@Model.CurrentAddress</span>
                                                    </p>
                                                }
                                            </div>
                                        </div>
                                        <div class="col">
                                            <div class="pinfo">
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.FullName:</span> <span class="txt-bold">@Model.FullName</span>
                                                </p>
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.NickName:</span> <span class="txt-bold">@Model.NickName</span>
                                                </p>
                                                <p class="accinfo">
                                                    <span class="label--l">D.O.B:</span> <span class="txt-bold">@Model.DateOfBirth.ToString("dd MMM, yyyy")</span>
                                                </p>
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.Gender:</span> <span class="txt-bold">@(Model.Gender == 1 ? "Male" : "Female")</span>
                                                </p>                                                
                                                @if (@isHRRole)
                                                {
                                                    <p class="accinfo">
                                                    <span class="label--l">@Labels.Marriage:</span> <span class="txt-bold">@(Model.Mariage == null ? "Unknown" : (Model.Mariage == true ? "Yes" : "No"))</span>
                                                    </p>                                                   
                                                    <p class="accinfo">
                                                        <span class="label--l">@Labels.IdNo.:</span> <span class="txt-bold">@Model.CardNo</span>
                                                    </p>
                                                    <p class="accinfo">
                                                        <span class="label--l">@Labels.IssuedDate:</span> <span class="txt-bold">
                                                            @if (Model.IssuedDate != null)
                                                            {
                                                                @Model.IssuedDate.Value.ToString("dd MMM, yyyy")
                                                            }</span>
                                                    </p>
                                                    <p class="accinfo">
                                                        <span class="label--l">@Labels.IssuedPlace:</span> <span class="txt-bold">@Model.IssuedPlace</span>
                                                    </p>
                                                            if (Model.PassportNo != null)
                                                            {
                                                    <p class="accinfo">
                                                        <span class="label--l">@Labels.PassportNo:</span> <span class="txt-bold">@Model.PassportNo</span>
                                                    </p>
                                                            }
                                                            if (Model.PassportExp != null)
                                                            {
                                                    <p class="accinfo">
                                                        <span class="label--l">@Labels.PassportExp:</span> <span class="txt-bold">@Model.PassportExp.ToDateMonthYearFormatedDate()</span>
                                                    </p>
                                                            }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="jobinformation m-t--m p-x--s">
                            <div class="boxtitle">
                                @Labels.JobInformation
                            </div>
                            <div class="pinfo">
                                <p class="accinfo">
                                    <span class="label--l">@Labels.JobTitle:</span> <span class="txt-bold">
                                        @if (Model.JobTitle != null)
                                        {
                                            @Model.JobTitle.Name
                                        }</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.Team:</span> <span class="txt-bold">@Model.Team.Name</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.Roles:</span> <span class="txt-bold">@Model.DisplayRoles()</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.JoinedDate:</span> <span class="txt-bold">
                                        @if (Model.JoinedDate != null)
                                        {
                                            @Model.JoinedDate.ToDateMonthYearFormatedDate()
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.ConfirmedDate:</span> <span class="txt-bold">
                                        @if (Model.ConfirmedDate != null)
                                        {
                                            @Model.ConfirmedDate.ToDateMonthYearFormatedDate()
                                        }
                                    </span>
                                </p>
                                @if (Model.ResignedDate != null)
                                {
                                    <p class="accinfo">
                                        <span class="label--l">@Labels.LastWorkingDate:</span> <span class="txt-bold">@Model.ResignedDate.ToDateMonthYearFormatedDate()</span>
                                    </p>
                                }
                            </div>
                        </div>
                        <div class="experiencereport m-t--l p-x--s">
                        <div class="boxtitle">
                            Experience
                        </div>
                        <div class="experience">
                            <table class="table bordered striped highlight centered table-custom">
                                <thead>
                                    <tr>
                                        <th width="4%">#</th>
                                        <th width="17%">Department</th>
                                        <th width="10%">Type</th>
                                        <th width="23%">Name</th>
                                        <th width="23%">Detail</th>
                                        <th width="23%">Organization</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.EmployeeExperiences != null && Model.EmployeeExperiences.Count > 0)
                                    {
                                        foreach (var item in Model.EmployeeExperiences)
                                        {
                                            count++;
                                            var detail = item.EmployeeExperienceType.Equals(certificate) ?
                                            ("Exam Date: " + @item.ExamDate.ToString(formatDate) + " - " + "Expiration Date: " + @item.ExpirationDate.ToString(formatDate)) :
                                            ("Time: " + @item.StartDate.ToString(formatDate) + " - " + @item.EndDate.ToString(formatDate));
                                            <tr>
                                                <td>@count</td>
                                                <td>@item.DepartmentName</td>
                                                <td>@item.EmployeeExperienceType</td>
                                                <td>@item.EmployeeExperienceName</td>
                                                <td>@detail</td>
                                                <td>@item.Organization</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6"></td>
                                        </tr>
                                        <tr>
                                            <td colspan="6" rowspan="2">
                                                @Messages.NoInformation
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    }
                    else
                    {
                        <h2>@Messages.NoDataIsAvailable</h2>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
