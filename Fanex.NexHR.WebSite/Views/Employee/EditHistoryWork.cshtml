@model WorkingHistoryViewModel
@{
    Layout = null;
}
<style>
    select {
        display: block;
    }
</style>
<form id="frmEditHistoryWork" class="form">
    <div id="divErrorCont" class=""></div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Date</label>
            <input type="hidden" value="@Model.Id" name="Id" />
            <input type="hidden" value="@Model.EmpId" name="EmpId" />
        </div>
        <div class="datepicker-button left select--m">
            @Html.DatePickerFor(model => model.AffectedDate)
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.UpdateTeam</label>
        </div>
        <div class="left select--m" style="border: 1px solid #d0d0d0; border-radius: 3px; margin: 0 0 15px 0;">
            @Html.DropDownListFor(model => model.GroupName, new SelectList(Model.Teams, "Name", "Name"))
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.UpdateJobtitle</label>
        </div>
        <div class="left select--m" style="border: 1px solid #d0d0d0;border-radius: 3px;">
            @Html.DropDownListFor(model => model.JobtitleName, new SelectList(Model.JobTitles, "Name", "Name"))
        </div>
    </div>
</form>
