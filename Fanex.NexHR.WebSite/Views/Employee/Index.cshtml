@model StaffInfoViewModel
@{
    ViewBag.Title = Labels.StaffInfo;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/staffinfojs")
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.Keyword, Labels.Keyword)
                                </div>
                                <div class="left input--m">
                                    @Html.TextBoxFor(model => model.Keyword, new { placeholder = Messages.SearchEmployeeWatermark })
                                </div>
                            </div>
                            <div class="col">
                                <div class="left label--s">
                                    @Html.LabelFor(model => model.TeamId, Labels.Team)
                                </div>
                                <div class="left select--m">
                                    @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                </div>
                            </div>
                            <div class="col">
                                <a id="query" class="btn-submit waves-effect waves-light m-r--b" href="javascript:;">@Labels.Submit</a>
                                @if (Roles.IsUserInRole("HR"))
                                {  
                                    <a id="exportExcel" class="waves-effect waves-light btn-export-excel m-r--b" >@Labels.Excel</a>
                                }
                                <a class="btn-request waves-effect waves-light" href="@Url.Action("birthday", "employee")">@Labels.StaffBirthday</a>
                            </div>
                        </div> 
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered responsive-table table-custom">
                        <thead>
                            <tr>
                                <th>@Labels.SymbolCount</th>
                                <th class="col-sorter">
                                    @Labels.Nick
                                    <div class="sorter" data-property="NickName"></div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.FullName
                                    <div class="sorter" data-property="FullName"></div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.Team
                                    <div class="sorter" data-property="CodeOfTeam"></div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.JobTitle
                                    <div class="sorter" data-property="JobTitle"></div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.Skype
                                    <div class="sorter" data-property="Skype"></div>
                                </th>
                                <th>@Labels.Phone</th>
                                <th class="col-sorter">
                                    @Labels.DoB
                                    <div class="sorter" data-property="DateOfBirth"></div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.JoinedDate
                                    <div class="sorter" data-property="JoinedDate"></div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/x-jsrender">
    <tr id="row{{:Id}}" {{if Enabled == false }} class="disabled" {{/if}}>
        <td>{{:~index()}}</td>
        <td class="nick align-left" data-code="{{:Code}}">
            <a href="/employee/detail?employeeId={{:Id}}">{{:NickName}}</a>
        </td>
        <td class="align-left">{{:FullName}}</td>
        <td title="{{:Team.Name}}" class="tooltip">{{:Team.Code}}</td>
        <td class="align-left">{{:JobTitle && JobTitle.Name}}</td>
        <td class="align-left"><a href="skype:{{:Skype}}?chat">{{:Skype}}</a></td>
        <td>{{:Phone}}</td>
        <td>{{:~formatDate(DateOfBirth, 'dd MMM, yyyy')}}</td>
        <td>
            {{if JoinedDate != null}}
                {{:~formatDate(JoinedDate, 'dd MMM, yyyy')}}
            {{/if}}
        </td>      
    </tr>
</script>
