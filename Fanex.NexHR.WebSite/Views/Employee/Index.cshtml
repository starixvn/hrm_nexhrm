@{
    ViewBag.Title = "Staff info";
}
@section css {
}
@section js {
}
@section Breadcrumb {
}
<script type="text/javascript">
    var enable = true;
</script>
<h2>@ViewBag.Title</h2>
<div>
    @Labels.Keyword
    <input id="keyword" type="text" placeholder="@Fanex.NexHR.Resources.Messages.SearchEmployeeWatermark" />
    @Labels.Team
    <select id="group" class="team-select">
        <option value="">All teams</option>
        @foreach (Fanex.NexHR.Models.Team item in ViewBag.Groups)
        {
            <option value="@item.Id">@item.Name</option>
        }
    </select>
    <input id="query" type="button" value="Submit" />
    <div class="button-icon">
        <span class="icon arrow_right_medium"></span><a href="~/employee/birthday">Staff Birthday</a></div>
</div>
<div id="gridStaffInfo" class="freegrid">
</div>