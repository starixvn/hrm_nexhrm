@{
    ViewBag.Title = "Staff info";
}
@section css {
}
@section js {
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <script type="text/javascript">
                        var enable = true;
                    </script>                    
                    <div class="form">
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    <label>@Labels.Keyword</label>
                                </div>
                                <div class="left input--m">
                                    <input id="keyword" type="text" placeholder="@Fanex.NexHR.Resources.Messages.SearchEmployeeWatermark" />   
                                </div>
                            </div>
                            <div class="col">
                                <div class="left label--s">
                                    <label>@Labels.Team</label>
                                </div>    
                                <div class="left select--m">
                                    <select id="group" class="team-select">
                                        <option value="">All teams</option>
                                        @foreach (Fanex.NexHR.Models.Team item in ViewBag.Groups)
                                        {
                                            <option value="@item.Id">@item.Name</option>
                                        }
                                    </select>
                                </div>                        
                            </div>   
                            <div class="col">
                                <span class="button-hrm waves-effect waves-light btn blue darken-2 m-r--s"><input id="query" type="button" value="Submit" /></span>
                                <a class="button-hrm waves-effect waves-light btn orange darken-1" href="~/employee/birthday"><i class="mdi mdi-cake-variant mdi-24px left"></i>Staff Birthday</a></div>
                            </div>                         
                        </div>                       
                    <div id="gridStaffInfo" class="freegrid">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
