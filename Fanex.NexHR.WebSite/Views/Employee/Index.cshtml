@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Employee
@model StaffInfoViewModel
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@{
    ViewBag.Title = Labels.StaffInfo;
    var isHRRole = sessionService.CurrentEmployee.RoleList.Any(r => r == (short)Role.HR || r == (short)Role.SA);
    var teams = new SelectList(Model.Teams, "Id", "Name");
}

@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Employee/employee.index.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/staffinfo.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    <label asp-for="@Model.Keyword">@Labels.Keyword</label>
                                </div>
                                <div class="left input--m">
                                    <input asp-for="@Model.Keyword" placeholder="@Messages.SearchEmployeeWatermark"/>
                                </div>
                            </div>
                            <div class="col">
                                <div class="left label--s">
                                    <label asp-for="@Model.TeamId">@Labels.Team</label>
                                </div>
                                <div class="left select--m team">
                                    <select asp-for="@Model.TeamId" asp-items="@teams">
                                        <option value="">@Labels.AllTeams</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col col-btn-submit-excel">
                                <a id="query" class="btn-submit waves-effect waves-light m-r--b" href="javascript:;">@Labels.Submit</a>
                                @if (@isHRRole)
                                {
                                    <a id="exportExcel" class="waves-effect waves-light btn-export-excel m-r--b">@Labels.Excel</a>
                                }
                                <a class="btn-request waves-effect waves-light" href="@Url.Action("birthday", "employee")">@Labels.StaffBirthday</a>
                            </div>
                        </div>
                    </div>
                    <div class="p-x--s over-auto cover-form-mb table-team">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th class="col-sorter">
                                        @Labels.Nick
                                        <div class="sorter" data-property="NickName"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.FullName
                                        <div class="sorter" data-property="FullName"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.Team
                                        <div class="sorter" data-property="CodeOfTeam"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.JobTitle
                                        <div class="sorter" data-property="JobTitles"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.Skype
                                        <div class="sorter" data-property="Skype"></div>
                                    </th>
                                    <th>@Labels.Phone</th>
                                    <th class="col-sorter">
                                        @Labels.DoB
                                        <div class="sorter" data-property="DateOfBirth"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.JoinedDate
                                        <div class="sorter" data-property="JoinedDate"></div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/x-jsrender">
    <tr id="row{{:Id}}" {{if Enabled == false }} class="disabled" {{/if}}>
        <td>{{:~index()}}</td>
        <td class="nick align-left" data-code="{{:Code}}">
            <a href="/employee/detail?employeeId={{:Id}}">{{:NickName}}</a>
        </td>
        <td class="align-left">{{:FullName}}</td>
        <td title="{{:TeamName}}" class="tooltip">{{:TeamCode}}</td>
        <td class="align-left">{{:JobTitle}}</td>
        <td class="align-left"><a href="skype:{{:Skype}}?chat">{{:Skype}}</a></td>
        <td>{{:Phone}}</td>
        <td>{{:~formatDate(DateOfBirth, 'dd MMM, yyyy')}}</td>W
        <td>
            {{if JoinedDate != null}}
            {{:~formatDate(JoinedDate, 'dd MMM, yyyy')}}
            {{/if}}
        </td>
    </tr>
</script>