@model IList<HistoryWork>
<input type="hidden" id="empId" value="@ViewBag.empid" />
<table id="data" class="table bordered striped highlight centered responsive-table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Team</th>
            <th>@Labels.JobTitle</th>
            <th>@Labels.AffectedDate</th>
            <th>@Labels.ModifiedDate</th>
            <th>@Labels.ModifiedBy</th>
            <th>@Labels.Edit</th>
            <th>@Labels.Delete</th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @{int index = 1;}
            @foreach (var history in Model)
            {
                <tr id="history">
                    <td>@(index++)<input type="hidden" id="employeeId" value="@ViewBag.empid" /></td>
                    <td class="align-left">@history.GroupName</td>
                    <td class="align-left">@history.JobtitleName</td>
                    <td>@history.AffectedDate.ToDateMonthYearFormatedDate()</td>
                    <td>@history.ModifiedDate.ToShortFormatedDate()</td>
                    <td>@history.NickName</td>
                    <td class="cmd">
                        @if (DateTime.Today.AddMonths(-1) < history.ModifiedDate)
                        {
                            <a href="javascript:;" onclick="editHistoryWork(@history.Id);">
                                <i class="mdi mdi-border-color mdi-dark"></i>
                            </a>
                        }
                        else
                        {
                            <a href="javascript:;">
                                <i class="mdi mdi-border-color" style=" color: rgba(0, 0, 0, 0.2);"></i>
                            </a>
                        }
                    </td>
                    <td class="cmd">
                        @if (DateTime.Today.AddMonths(-1) < history.ModifiedDate)
                        {
                            <a href="javascript:;" onclick="deleteHistoryWork(@history.Id,@history.EmpId);">
                                <i class="mdi mdi-delete mdi-dark mdi-18px"></i>
                            </a>
                        }
                        else
                        {
                            <a href="javascript:;">
                                <i class="mdi mdi-delete mdi-disabled mdi-dark mdi-18px"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 9)
    }
</table>
