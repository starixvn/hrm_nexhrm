@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums;
@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Services.Interfaces;
@model IEnumerable<EmployeeJobGrade>
@inject ISessionService sessionService;
@{
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
}
<style>
    .ui-dialog .ui-dialog-content {
        padding:unset !important;
    }
</style>

<table class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.EffectiveDate</th>
            <th>@Labels.JobGrade</th>
            @if (@isHRRole)
            {
                <th>@Labels.Remark</th>
            }    
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @{
                int index = 1;
            }
            @foreach (EmployeeJobGrade jobGrade in Model)
            {
                <tr id="row@(jobGrade.JobGradeId)">
                    <td>@(index++)</td>
                    <td>@jobGrade.AffectedDate?.ToString("dd MMM, yyyy")</td>
                    <td>@jobGrade.JobGradeName</td> 
                    @if (@isHRRole)
                    {
                        <td>@jobGrade.Note</td>
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        <tr>
            <td colspan="4"></td>
        </tr>
        <tr>
            <td colspan="4" rowspan="2">
                @Messages.NoInformation
            </td>
        </tr>
    }
</table>