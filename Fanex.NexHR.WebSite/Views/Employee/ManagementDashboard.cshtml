@model HRLeaderDashboardModel
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.MyMemberRequest</span>
                </div>
                <div class="card-body p-t--m">
                    <div class="p-x--s">
                        <table class="table bordered striped highlight responsive-table table-custom" id="myspace">
                            <thead>
                                <tr>
                                    <th rowspan="2">@Labels.Request</th>
                                    <th rowspan="2">@Labels.Pending</th>
                                    <th colspan="2">@Labels.Approved</th>
                                </tr>
                                <tr>
                                    <th>@Labels.CurrentMonth</th>
                                    <th>@Labels.LastMonth</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var requestLink = "/request/member?DateOption=0&TeamId=-2&IsFilterByEffectedDate=true&StatusId={0}&FromDate={1}&ToDate={2}&RequestType={3}";
                                    var requestModel = new RequestViewModel
                                    {
                                        DateOption = 0,
                                        FromDate = Model.FromDateLeave > Model.FromDateCheckInOut ? Model.FromDateCheckInOut : Model.FromDateLeave,
                                        ToDate = Model.ToDateLeave > Model.ToDateCheckInOut ? Model.ToDateLeave.Date : Model.ToDateCheckInOut.Date,
                                        StatusId = (byte)RequestStatuse.Pending,
                                        TeamId = -2,
                                        IsFilterByEffectedDate = true
                                    };
                                }
                                <tr>
                                    <td class="first-column">@Labels.Leave</td>
                                    <td>
                                        @if (Model.LeavePending > 0)
                                        {
                                            requestModel.RequestType = 1;
                                            var url = string.Format(requestLink, (byte)RequestStatuse.Pending, requestModel.FromDate.ToDateMonthYearFormatedDate(),
                                                requestModel.ToDate.ToDateMonthYearFormatedDate(), requestModel.RequestType);
                                                
                                            <a href="@url">@Model.LeavePending.ToString()</a>
                                        }
                                        else
                                        {
                                            <span>0</span>
                                        }
                                    </td>
                                    <td>@Model.LeaveApprovedCurrentMonth</td>
                                    <td>@Model.LeaveApprovedLastMonth</td>
                                </tr>
                                <tr>
                                    <td class="first-column">@Labels.CheckInOut</td>
                                    <td>
                                        @if (Model.CheckInOutPending > 0)
                                        {
                                            requestModel.RequestType = 4;
                                            var url = string.Format(requestLink, (byte)RequestStatuse.Pending, requestModel.FromDate.ToDateMonthYearFormatedDate(),
                                               requestModel.ToDate.ToDateMonthYearFormatedDate(), requestModel.RequestType);
                                            <a href = "@url">@Model.CheckInOutPending.ToString()</a>
                                        }
                                        else
                                        {
                                            <span>0</span>
                                        }
                                    </td>
                                    <td>@Model.CheckInOutApprovedCurrentMonth</td>
                                    <td>@Model.CheckInOutApprovedLastMonth</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

