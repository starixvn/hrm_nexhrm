@{
    ViewBag.Title = Labels.EmployeeManagement;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/usermanagementjs")
}
@section Breadcrumb {
}
<div class="loading-process" style="display: none">
</div>
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <div class="row form-input">
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    <label>@Labels.Keyword</label>
                                </div>
                                <div class="left filter-keyword">
                                    <input id="keyword" type="text" placeholder="@Messages.SearchEmployeeWatermark" />
                                </div>
                            </div>
                            <div class="col m-r--l">
                                <div class="left label--s">
                                    <label>@Labels.Team</label>
                                </div>
                                <div class="left select--m">
                                    @Html.DropDownList("group", new SelectList(Model.Groups, "Id", "Name"), Labels.AllTeams)
                                </div>
                            </div>
                            <div class="col m-r--l">
                                <div class="left filter-title-lbl">
                                    <label>@Labels.Title</label></div>
                                <div class="left filter-title">
                                    @Html.DropDownList("title", new SelectList(Model.JobTitles, "Id", "Name", Model.JobTitleId), Labels.AllTitles)
                                </div>
                            </div>                            
                        </div>
                        <div class="row form-input">                            
                            <div class="col">
                                <div class="left label--m">&nbsp;</div>
                                <div class="left radioButton">
                                    <input class="with-gap" name="name" type="radio" id="active" checked="checked" />
                                    <label for="active" class="m-r--l">@Labels.ActiveUsers</label>
                                    <input class="with-gap" name="name" type="radio" id="enable" />
                                    <label class="m-r--l" for="enable">@Labels.DisabledUsers</label>
                                    <input class="with-gap" name="name" type="radio" id="IsDeleted" />
                                    <label class="m-r--l" for="IsDeleted">@Labels.DeletedUsers</label>
                                </div>
                            </div>
                            <div class="col">
                            <a id="query" class="btn-submit waves-effect waves-light m-r--s" href="javascript:;" style="margin-left: -40px;">@Labels.Submit</a>
                            <a id="exportExcel" class="waves-effect waves-light btn-export-excel" href="javascript:;">@Labels.Excel</a>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="jobtitleid" value="@Model.JobTitleId" />
                <div class="p-x--s">
                    <table id="data" class="table bordered striped highlight centered responsive-table table-custom">
                        <thead>
                            <tr>
                                <th>@Labels.SymbolCount
                                </th>
                                <th class="col-sorter">
                                    @Labels.Code
                                    <div class="sorter" data-property="Code">
                                    </div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.Nick
                                    <div class="sorter" data-property="NickName">
                                    </div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.FullName
                                    <div class="sorter" data-property="FullName">
                                    </div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.Team
                                    <div class="sorter" data-property="CodeOfTeam">
                                    </div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.Gender
                                    <div class="sorter" data-property="Gender">
                                    </div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.JobTitle
                                    <div class="sorter" data-property="JobTitle">
                                    </div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.DoB
                                    <div class="sorter" data-property="DateOfBirth">
                                    </div>
                                </th>
                                <th class="col-sorter">
                                    @Labels.JoinedDate
                                    <div class="sorter" data-property="JoinedDate">
                                    </div>
                                </th>
                                <th>@Labels.Edit
                                </th>
                                <th>@Labels.Schedule
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/x-jquery-tmpl">
    <tr id="row${Id}" {{if Enabled == false }}class="disabled"{{/if}}>
        <td>
            ${index()}
        </td>
        <td>
            ${Code}
        </td>
        <td class="nick" data-code="${Code}">
            <a href="/employee/detail/${Id}">${NickName}</a>
        </td>
        <td class="align-left">${FullName}</td>
        <td title="${Team["Name"]}" class="tooltip">${Team["Code"]}</td>
        <td>
            {{if Gender == 0 }}
                F
            {{else}}
                M
            {{/if}}
        </td>
        <td class="align-left">${JobTitle}</td>
        <td>${formatDate(DateOfBirth, 'dd MMM, yyyy')}</td>
        <td>
            {{if JoinedDate != null}}
                ${formatDate(JoinedDate, 'dd MMM, yyyy')}
            {{/if}}
        </td>
        <td>
            {{if !IsDeleted}}
                <a href="/employee/edit/${Id}"><i class="mdi mdi-border-color mdi-dark mdi-18px"></i></a>
            {{else}}
                -
            {{/if}}
        </td>
        <td>
            {{if !IsDeleted}}
                <a href="/employee/defaultschedule/${Id}"><i class="mdi mdi-border-color mdi-dark mdi-18px"></i></a>
            {{else}}
                -
            {{/if}}
        </td>
    </tr>
</script>
