@using Fanex.NexHR.Core
@model Fanex.NexHR.Models.Employee
@{
    ViewBag.Title = Labels.Edit;
}
@section css {
}
@section js {
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 l7 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Edit</span>
                </div>
                <div class="card-body">
                    @if (Model != null) {
                        using (Html.BeginForm()) {

                        <script type="text/javascript" src="http://maps.googleapis.com/maps/api/js?libraries=places&sensor=false"></script>

                        <div class="form">
                            @Html.ValidationSummary(true)
                            @if (ViewBag.Updated == true)
                            {
                                <div class="success flash">
                                    Saved</div>
                            }
                            else if (ViewBag.Updated == false)
                            {
                                <div class="error flash">@Messages.ErrorTryAgain</div>
                            }
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>Avatar</label>
                                    </div>
                                    <div class="left m-b--m">
                                        <img id="avatar" src="~/employee/avatar/@(Model.Code)?f=@(Fanex.NexHR.Core.Utilities.RandomString(4))" alt="@Model.FullName" /><br />
                                        <span class="fileUpload"><input class="chooseFile" type="file" id="file" /></span>
                                        <span class="button-hrm waves-effect waves-light btn orange darken-1 m-r--s"><input type="button" id="upload" value="Upload" /></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Code, "Staff Code")
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Code)
                                        @Html.ValidationMessageFor(model => model.Code)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.EmployeeCard)
                                    </div>
                                    <div class="left input--l">
                                        @Html.TextBoxFor(model => model.EmployeeCard, new { maxlength = "10" })
                                        @Html.ValidationMessageFor(model => model.EmployeeCard)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.DomainUsername)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.DomainUsername)
                                        @Html.ValidationMessageFor(model => model.DomainUsername)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FullName)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.FullName)
                                        @Html.ValidationMessageFor(model => model.FullName)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.NickName)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.NickName)
                                        @Html.ValidationMessageFor(model => model.NickName)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.DateOfBirth)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.DateOfBirth)
                                        @Html.ValidationMessageFor(model => model.DateOfBirth)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                    <div class="input" id="DOBPicker">
                                    </div>
                                    @Html.HiddenFor(model => model.DateOfBirth)
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Email)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Email)
                                        @Html.ValidationMessageFor(model => model.Email)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.JobTitleId)
                                    </div>
                                    <div class="left select--l">
                                        @Html.DropDownListFor(model => model.JobTitleId, new SelectList(ViewBag.JobTitles, "Id", "Name"), new { @style = "width : 230px;" })
                                        @Html.ValidationMessageFor(model => model.JobTitleId)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Phone)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Phone)
                                        @Html.ValidationMessageFor(model => model.Phone)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Gender)
                                    </div>
                                    <div class="left select--l">
                                        @{
                                            var gender = new List<SelectListItem>
                                            {
                                                new SelectListItem() {Text = "Female", Value = "0"},
                                                new SelectListItem() {Text = "Male", Value = "1"}
                                            };
                                        }
                                        @Html.DropDownListFor(model => model.Gender, gender)
                                        @Html.ValidationMessageFor(model => model.Gender)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.CardNo, "Id No.")
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.CardNo)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.IssuedDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.IssuedDate, maxDate: DateTime.Now)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.IssuedPlace, "Issuing Authority")
                                    </div>
                                    <div class="left input--l">
                                        @Html.TextAreaFor(model => model.IssuedPlace, new { @class = "materialize-textarea" })
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Address)
                                    </div>
                                    <div class="left input--l">
                                        @Html.TextAreaFor(model => model.Address, new { @class = "materialize-textarea" })
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.CurrentAddress)
                                    </div>
                                    <div class="left input--l">
                                        @Html.TextAreaFor(model => model.CurrentAddress, new { @class = "materialize-textarea" })
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="label showHideGeolocationMap">
                                    <a id="showHideMap">Geolocation Map (Expanse/Collapse)</a>
                                </div>
                                <div class="input">
                                    <label>
                                    </label>
                                </div>
                            </div>
                            @*Google Map*@
                            <div class="row form-input" id="geolocationMap">
                                <div class="col">
                                    <div class='left input--s m-r--m'><input type="text" id="geoMapAddress" /></div>
                                    <div class='left button-hrm waves-effect waves-light btn grey darken-1'><input type="button" value="Search" id="searchmap" /></div>
                                </div>    
                                <div class='col geolocationMap'>
                                    <div class='left select--s'>Latitude: @Html.TextBoxFor(model => model.GeoMapLatitude, new { @class = "latlng" })</div>
                                    <div class='left select--s'>Longtitude: @Html.TextBoxFor(model => model.GeoMapLongtitude, new { @class = "latlng" })</div>
                                    <div class='left select--xs'>Distance: @Html.TextBoxFor(model => model.DistanceToCompany, new { @class = "distance" })</div>
                                </div>
                                <div id="map-canvas" style="min-width: 930px; height: 500px">
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Team)
                                    </div>
                                    <div class="left select--l">
                                        @Html.DropDownListFor(model => model.Team.Id, new SelectList(ViewBag.Groups, "Id", "Name"))
                                        @Html.ValidationMessageFor(model => model.Team.Id)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-b--m">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.SubGroups)
                                    </div>
                                    <div class="left input--l subteam">
                                        @Html.CheckBoxListFor(p => p.SubGroupArray, new SelectList(ViewBag.Groups, "Id", "Name"))
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-b--m">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.LeaderGroups)
                                    </div>
                                    <div class="left input--l subteam">
                                        @Html.CheckBoxListFor(p => p.LeaderGroupsArray, new SelectList(ViewBag.Groups, "Id", "Name"))
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Roles)
                                    </div>
                                    <div class="input">
                                        @{
                                            var roles = new List<SelectListItem>
                                            {
                                                new SelectListItem() {Text = "Assistant leader", Value = "1"},
                                                new SelectListItem() {Text = "Leader", Value = "2"},
                                                new SelectListItem() {Text = "Human resource", Value = "3"},
                                                new SelectListItem() {Text = "System admin", Value = "4"}
                                            };
                                        }
                                        @Html.CheckBox("Member", true, new { disabled = true })
                                        @Html.Label("Member", "Member")
                                        @Html.CheckBoxListFor(model => model.RoleArray, roles)
                                        @Html.ValidationMessageFor(model => model.RoleArray)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.JoinedDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.JoinedDate)
                                        @Html.ValidationMessageFor(model => model.JoinedDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.ConfirmedDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ConfirmedDate)
                                        @Html.ValidationMessageFor(model => model.ConfirmedDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.ResignedDate, "Last Working Date")
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ResignedDate)
                                        @Html.ValidationMessageFor(model => model.ResignedDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Skype)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Skype)
                                        @Html.ValidationMessageFor(model => model.Skype)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Yahoo)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Yahoo)
                                        @Html.ValidationMessageFor(model => model.Yahoo)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Mariage, "Marriage")
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Mariage)
                                        @Html.ValidationMessageFor(model => model.Mariage)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.PassportNo)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.PassportNo)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.PassportExp)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.PassportExp)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>Leave balance</label>
                                    </div>
                                    <div class="left input--l">
                                        <span class="m-r--s black-text">@Model.AnnualLeaveBalance day(s)</span> <a href="~/annualleavebalance/employee/@Model.Id">Update</a>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>Working calendar</label>
                                    </div>
                                    <div class="left">
                                        <a href="~/employee/defaultschedule/@Model.Id">Update</a>
                                    </div>
                                </div>
                            </div>
                            <!--TOEIC score-->
                            <div class="row form-input">
                                <div class="col">
                                   <div class="left label--l">
                                        <label>TOEIC score</label>
                                    </div>
                                    <div class="left input">
                                        @if (Model.ToeicScore != null)
                                        {
                                            <table>
                                                <tr>
                                                    <td style="padding-right: 10px;">
                                                        <table class="toeic">
                                                            <thead>
                                                                <tr>
                                                                    <th>@Labels.L</th>
                                                                    <th>@Labels.R</th>
                                                                    <th>@Labels.S</th>
                                                                    <th>@Labels.W</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td>@(Model.ToeicScore.Listening.HasValue ? Model.ToeicScore.Listening.Value.ToString() : "-")</td>
                                                                    <td>@(Model.ToeicScore.Reading.HasValue ? Model.ToeicScore.Reading.Value.ToString() : "-")</td>
                                                                    <td>@(Model.ToeicScore.Speaking.HasValue ? Model.ToeicScore.Speaking.Value.ToString() : "-")</td>
                                                                    <td>@(Model.ToeicScore.Writing.HasValue ? Model.ToeicScore.Writing.Value.ToString() : "-")</td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                    <td>
                                                        <a id="toeic" href="javascript:;">Update</a>
                                                    </td>
                                                </tr>
                                            </table>
                                        }
                                        else
                                        {
                                            <a id="toeic" href="javascript:;">Update</a>
                                        }
                                    </div>
                                </div>
                            </div>
                            <!--End of TOEIC score-->
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Enabled)
                                    </div>
                                    <div class="left input">
                                        @Html.EditorFor(model => model.Enabled)
                                        @Html.ValidationMessageFor(model => model.Enabled)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    @Html.AntiForgeryToken()
                                    @Html.HiddenFor(model => model.Id)
                                    <span class="button-hrm waves-effect waves-light btn blue darken-2 m-r--m"><input type="submit" value="Save" /></span>
                                    <span class="button-hrm waves-effect waves-light btn red darken-1"><input type="button" id="delete" value="Delete?" /></span>
                                </div>
                            </div>
                        </div>
                        }
                        <div id="dialog-toeic" title="Update TOEIC Score">&nbsp;</div>
                    }
                    else
                    {
                        <div class='row form-input m-t--m'>
                            <div class='col'>
                                <span>@Messages.NoDataIsAvailable</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
