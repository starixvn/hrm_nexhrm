@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Employee
@model EditEmployeeViewModel
@{
    ViewBag.Title = Labels.Edit;
}
@section Styles {
<link rel="stylesheet" href="~/minify/css/employeeedit.min.css" asp-append-version="true">
}
@section Scripts {
<environment include="Development">
    <script src="~/js/Libs/birthdaypicker.js" asp-append-version="true"></script>
    <script src="~/js/Libs/select2.js" asp-append-version="true"></script>
    <script src="~/js/Views/Employee/employee.edit.js" asp-append-version="true"></script>
    <script src="~/js/Views/Employee/employee.profile.js" asp-append-version="true"></script>
</environment>
<environment exclude="Development">
    <script src="~/minify/js/employeeedit.min.js" asp-append-version="true"></script>
    <script src="~/minify/js/employee.profile.min.js" asp-append-version="true"></script>
</environment>
}

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8">
    <link rel="stylesheet" type="text/css" href="https://js.api.here.com/v3/3.1/mapsjs-ui.css" />
    <script type="text/javascript" src="https://js.api.here.com/v3/3.1/mapsjs-core.js"></script>
    <script type="text/javascript" src="https://js.api.here.com/v3/3.1/mapsjs-service.js"></script>
    <script type="text/javascript" src="https://js.api.here.com/v3/3.1/mapsjs-ui.js"></script>
    <script type="text/javascript" src="https://js.api.here.com/v3/3.1/mapsjs-mapevents.js"></script>
    <script>window.ENV_VARIABLE = 'developer.here.com'</script>
</head>
<body>
    <div class="row content">
        <input type="hidden" asp-for="@Model.Id" />
        <input type="hidden" asp-for="@Model.JobGradeId" />
        <input type="hidden" asp-for="@Model.ManagementGradeId" />
        <div id="dialog-show-history-jobgrade" class="full-view-width over-auto"></div>
        <div class="col s12 card-container-base">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@Labels.Edit</span>
                    </div>
                    <div class="card-body">
                        @if (Model != null)
                        {
                            using (Html.BeginForm())
                            {
                                <script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyADr32LIjcxE7pM5BzdZO_t8AFDyTv9LsE&libraries=places&sensor=false"></script>
                                <input type="hidden" asp-for="LastUrl" />
                                <div class="form">
                                    <div asp-validation-summary="All"></div>
                                    @if (ViewBag.Updated == true)
                                    {
                                        <input type="hidden" id="successed" value="true" />

                                        <div class="success row validation-summary-success">
                                            <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.UpdatedSuccessfully
                                        </div>
                                    }
                                    <div class="row form-input">
                                        <div class="col">
                                            <div class="left label--mxxl">
                                                <label>@Labels.Avatar</label>
                                            </div>
                                            <div class="left m-b--m">
                                                <img id="avatar" class="img-employee" src="~/employee/avatar/@(Model.Code)?f=@(Utilities.RandomString(4))" /><br />
                                                <span class="fileUpload">
                                                    <input class="chooseFile" type="file" id="file" />
                                                </span>
                                                <input class="btn-request waves-effect waves-light m-r--s right" type="button" id="upload" value="Upload" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="Code">@Labels.StaffCode</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="Code" />
                                                <span asp-validation-for="Code"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="EmployeeCard">@Labels.EmployeeCard</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="EmployeeCard" maxlength="10" />
                                                <span asp-validation-for="EmployeeCard"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="DomainUsername">@Labels.DomainUsername</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="DomainUsername" />
                                                <span asp-validation-for="DomainUsername"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="FullName">@Labels.FullName</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="FullName" />
                                                <span asp-validation-for="FullName"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="NickName">@Labels.EnglishName</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="NickName" />
                                                <span asp-validation-for="NickName"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="DateOfBirth">@Labels.DateOfBirth</label>
                                            </div>
                                            <div class="left">
                                                <div class="datepicker-button select--s">
                                                    <date-picker name="DateOfBirth"
                                                         value="@Model.DateOfBirth">
                                                    </date-picker>
                                                    <i class="mdi-action-event calendar-icon left"></i>
                                                </div>
                                                <span asp-validation-for="DateOfBirth"></span>
                                            </div>
                                            <input type="hidden" asp-for="DateOfBirth" />
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="PlaceOfBirth">@Labels.PlaceOfBirth</label>
                                            </div>
                                            <div class="left input--l">
                                                <textarea asp-for="PlaceOfBirth" class="materialize-textarea"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="Email">@Labels.Email</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="Email" />
                                                <span asp-validation-for="Email"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="EducationBackground">@Labels.EducationBackground</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="EducationBackground" />
                                                <span asp-validation-for="EducationBackground"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
	                                    <div class="col m-r--m">
		                                    <div class="left label--mxxl">
			                                    <label for="JobTitleId">@Labels.JobTitle</label>
		                                    </div>
		                                    <div class="left select--l">
			                                    <select asp-for="JobTitleId" asp-items="@(new SelectList(Model.JobTitles, "Id", "Name"))">
			                                    </select>
			                                    <span asp-validation-for="JobTitleId"></span>
		                                    </div>
	                                    </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col">
                                            <div class="left label--mxxl">
                                                <label>@Labels.JobGrade</label>
                                            </div>
                                            <div class="left input--l">
                                                <span id="JobGradeCode" class="txt-bold tooltip"
	                                                  title="@(Model.JobGradeCode != null ? $"{Labels.EffectiveDate}: {Model.AffectedDate.ToDateMonthYearFormatedDate()}" : "")">
		                                            @(Model.JobGradeCode ?? "")
	                                            </span>
                                                <a class="viewhistoryjobgrade" id="viewhistoryjobgrade" href="javascript:;" style="margin-left:5px; margin-right:10px;" @(Model.JobGradeCode == null ? "hidden" : "")>
		                                            <i class="mdi mdi-information-outline mdi-dark tooltip" title="View history"></i>
	                                            </a>
	                                            <a class="btn-ok waves-effect waves-light" id="jobGrade" href="javascript:;">
		                                            @Labels.Update
	                                            </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input m-t--m">
	                                    <div class="col">
		                                    <div class="left label--mxxl">
			                                    <label>@Labels.ManagementGrade</label>
		                                    </div>
		                                    <div class="left input--l">
                                                <span id="ManagementGradeCode" class="txt-bold tooltip"
			                                          title="@(Model.ManagementGradeCode != null ? $"{Labels.EffectiveDate}: {Model.AffectedDate.ToDateMonthYearFormatedDate()}" : "")">
				                                    @(Model.ManagementGradeCode ?? "")
			                                    </span>
                                                <a class="viewhistoryjobgrade" id="viewhistorymanagementgrade" href="javascript:;" style="margin-left:5px; margin-right:10px;" @(Model.ManagementGradeCode == null ? "hidden" : "")>
				                                    <i class="mdi mdi-information-outline mdi-dark tooltip" title="View history"></i>
			                                    </a>
			                                    <a class="btn-ok waves-effect waves-light" id="managementGrade" href="javascript:;">
				                                    @Labels.Update
			                                    </a>
		                                    </div>
	                                    </div>
                                    </div>
                                    <div class="row form-input m-t--m">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="Phone">@Labels.Phone</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="Phone" />
                                                <span asp-validation-for="Phone"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="Gender">@Labels.Gender</label>
                                            </div>
                                            <div class="left select--l">
                                                @{
                                                    var gender = new List<SelectListItem>
                                        {
                                        new SelectListItem {Text = "Female", Value = "0"},
                                        new SelectListItem {Text = "Male", Value = "1"}
                                        };
                                                }
                                                <select asp-for="Gender" asp-items="@gender">
                                                </select>
                                                <span asp-validation-for="Gender"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col">
                                            <div class="left label--mxxl">
                                                <label for="CardNo">Id No.</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="CardNo" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col">
                                            <div class="left label--mxxl">
                                                <label for="IssuedDate">@Labels.IssuedDate</label>
                                            </div>
                                            <div class="left datepicker-button select--s">
                                                <date-picker name="IssuedDate"
                                                     value="@Model.IssuedDate"
                                                     max-date="@DateTimeOffset.Now.DateTime.ToClientTimeZone()">
                                                </date-picker>
                                                <i class="mdi-action-event calendar-icon left"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col">
                                            <div class="left label--mxxl">
                                                <label for="IssuedPlace">@Labels.IssuingAuthority</label>
                                            </div>
                                            <div class="left input--l">
                                                <textarea asp-for="IssuedPlace" class="materialize-textarea"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col">
                                            <div class="left label--mxxl">
                                                <label for="Address">@Labels.Address</label>
                                            </div>
                                            <div class="left input--l">
                                                <textarea asp-for="Address" class="materialize-textarea"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col">
                                            <div class="left label--mxxl">
                                                <label for="CurrentAddress">@Labels.CurrentAddress</label>
                                            </div>
                                            <div class="left input--l">
                                                <textarea asp-for="CurrentAddress" class="materialize-textarea"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="ContactName">@Labels.ContactName</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="ContactName" />
                                                <span asp-validation-for="ContactName"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="UserRelationship">@Labels.UserRelationship</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="UserRelationship" />
                                                <span asp-validation-for="UserRelationship"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="ContactPhone">@Labels.ContactPhone</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="ContactPhone" />
                                                <span asp-validation-for="ContactPhone"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="ContactAddress">@Labels.ContactAddress</label>
                                            </div>
                                            <div class="left input--l">
                                                <textarea asp-for="ContactAddress" class="materialize-textarea"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="label showHideGeolocationMap m-l--s">
                                            <a id="showHideMap">@Labels.GeolocationMap (@Labels.Expanse/@Labels.Collapse)</a>
                                        </div>
                                        <div class="input">
                                            <label>
                                            </label>
                                        </div>
                                    </div>
                                    @*Google Map*@
                                    <div class="row form-input p-x--s" id="geolocationMap">
                                        <div class="left m-r--l">
                                            <div class='left input--m m-r--l'>
                                                <input type="text" id="geoMapAddress" />
                                            </div>
                                            <div class='left'>
                                                <input class="btn-submit waves-effect waves-light" type="button" value="Search" id="searchmap" />
                                            </div>
                                        </div>
                                        <div class='geolocationMap'>
                                            <div class="col m-r--l">
                                                <div class='left label--m'>
                                                    <label>Latitude: </label>
                                                </div>
                                                <div class="left input--m">
                                                    <input asp-for="GeoMapLatitude" class="latlng" />
                                                </div>
                                            </div>
                                            <div class="col m-r--l">
                                                <div class='left label--m'>
                                                    <label>Longtitude: </label>
                                                </div>
                                                <div class="left input--m">
                                                    <input asp-for="GeoMapLongtitude" class="latlng" />
                                                </div>
                                            </div>
                                            <div class="col m-r--l">
                                                <div class='left label--m'>
                                                    <label>Distance: </label>
                                                </div>
                                                <div class="left input--s">
                                                    <input asp-for="DistanceToCompany" class="distance" />
                                                </div>
                                            </div>
                                        </div>
                                        <div id="map-canvas" style="width: 100%; height: 50vh;margin-bottom:5rem">
                                        </div>
                                    </div>
                                    <div class="row form-input m-t--m">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="TeamId">@Labels.Team</label>
                                            </div>
                                            <div class="left select--l">
                                                <select asp-for="TeamId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                                </select>
                                                <span asp-validation-for="TeamId"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input m-b--m">
                                        <div class="col">
                                            <div class="left label--mxxl">
                                                <label>Other team(s)</label>
                                            </div>
                                            <div class="left input--l subteam">
                                                @for (var i = 0; i < Model.Teams.Count; i++)
                                                {
                                                    var id = "SubGroupArray" + @Model.Teams[i].Id.ToString();
                                                    var isChecked = Array.IndexOf(@Model.SubGroupArray, @Model.Teams[i].Id.ToString()) > -1;
                                                    <input checked="@isChecked" class="filled-in SubGroupArray" id="@id" name="SubGroupArray" type="checkbox" value="@Model.Teams[i].Id">
                                                    <label for="@id">@Model.Teams[i].Name</label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label>@Labels.Roles</label>
                                            </div>
                                            <div class="left role input--l">
                                                @{
                                                    var roles = new List<SelectListItem>
                                        {
                                        new SelectListItem {Text = "Assistant leader", Value = "1"},
                                        new SelectListItem {Text = "Leader", Value = "2"},
                                        new SelectListItem {Text = "Human resource", Value = "3"},
                                        new SelectListItem {Text = "System admin", Value = "4"}
                                        };
                                                }
                                                <input type="checkbox" class="filled-in" id="Member" name="Member" checked="checked"
                                               disabled="disabled" value="true" />
                                                <label for="Member">@Labels.Member</label>
                                                @for (var i = 0; i < roles.Count; i++)
                                                {
                                                    var id = "RoleArray" + roles[i].Value.ToString();
                                                    var isChecked = Array.IndexOf(@Model.RoleArray, roles[i].Value.ToString()) > -1;
                                                    <input checked="@isChecked" class="filled-in" id="@id" name="RoleArray" type="checkbox" value="@roles[i].Value.ToString()">
                                                    <label for="@id">@roles[i].Text</label>
                                                }
                                                <span asp-validation-for="RoleArray"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input m-t--m">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="GroupDate">@Labels.GroupDate</label>
                                            </div>
                                            <div class="left">
                                                <div class="datepicker-button select--s">
                                                    <date-picker name="GroupDate"
                                                         value="@Model.GroupDate">
                                                    </date-picker>
                                                    <i class="mdi-action-event calendar-icon left"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="JoinedDate">@Labels.JoinedDate</label>
                                            </div>
                                            <div class="left">
                                                <div class="datepicker-button select--s">
                                                    <date-picker name="JoinedDate"
                                                         value="@Model.JoinedDate">
                                                    </date-picker>
                                                    <i class="mdi-action-event calendar-icon left"></i>
                                                </div>
                                                <span asp-validation-for="JoinedDate"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="ConfirmedDate">@Labels.ConfirmedDate</label>
                                            </div>
                                            <div class="left">
                                                <div class="datepicker-button select--s">
                                                    <date-picker name="ConfirmedDate"
                                                         value="@Model.ConfirmedDate">
                                                    </date-picker>
                                                    <i class="mdi-action-event calendar-icon left"></i>
                                                </div>
                                                <span asp-validation-for="ConfirmedDate"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="ResignedDate">@Labels.LastWorkingDate</label>
                                            </div>
                                            <div class="left">
                                                <div class="datepicker-button select--s">
                                                    <date-picker name="ResignedDate"
                                                         value="@Model.ResignedDate">
                                                    </date-picker>
                                                    <i class="mdi-action-event calendar-icon left"></i>
                                                </div>
                                                <span asp-validation-for="ResignedDate"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="Skype">@Labels.Skype</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="Skype" />
                                                <span asp-validation-for="Skype"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="Yahoo">@Labels.Telegram</label>
                                            </div>
                                            <div class="left input--l">
                                                <input asp-for="Yahoo" />
                                                <span asp-validation-for="Yahoo"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-input">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label for="Marriage">@Labels.Marriage</label>
                                            </div>
                                            <div class="left input">
                                                <input class="filled-in" asp-for="Marriage" type="checkbox">
                                                <label for="Marriage"></label>
                                                <span asp-validation-for="Marriage"></span>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col">
                                        <div class="left label--mxxl">
                                            <label for="PassportNo">@Labels.PassportNo</label>
                                        </div>
                                        <div class="left input--l">
                                            <input asp-for="PassportNo" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--mxxl">
                                            <label for="PassportExp">@Labels.PassportExp</label>
                                        </div>
                                        <div class="left datepicker-button select--s">
                                            <date-picker name="PassportExp"
                                                 value="@Model.PassportExp">
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--mxxl">
                                            <label for="SocialInsuranceNo">@Labels.SocialInsuranceNo</label>
                                        </div>
                                        <div class="left input--l">
                                            <input asp-for="SocialInsuranceNo" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--mxxl">
                                            <label>@Labels.LeaveBalance</label>
                                        </div>
                                        <div class="left input--l">
                                            <a class="btn-ok waves-effect waves-light" href="~/annualleave/employee?employeeId=@Model.Id&Year=@DateTimeOffset.Now.DateTime.ToClientTimeZone().Year">@Labels.Update</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col">
                                        <div class="left label--mxxl">
                                            <label>@Labels.WorkingCalendar</label>
                                        </div>
                                        <div class="left">
                                            <a class="btn-ok waves-effect waves-light" href="~/employee/defaultschedule/@Model.Id">@Labels.Update</a>
                                        </div>
                                    </div>
                                </div>
                                <!--TOEIC score-->
                                <div class="row form-input m-t--m">
                                    <div class="col toeic-scrore">
                                        <div class="left label--mxxl">
                                            <label>@Labels.ToeicScore</label>
                                        </div>
                                        <div class="left input">
                                            @if (Model.ToeicScore != null)
                                            {
                                                <table class="table centered">
                                                    <tr>
                                                        <td style="padding: 0;">
                                                            <table class="toeic">
                                                                <thead>
                                                                    <tr>
                                                                        <th>
                                                                            @Labels.L
                                                                        </th>
                                                                        <th>
                                                                            @Labels.R
                                                                        </th>
                                                                        <th>
                                                                            @Labels.S
                                                                        </th>
                                                                        <th>
                                                                            @Labels.W
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <tr>
                                                                        <td>
                                                                            @(Model.ToeicScore.Listening.HasValue ? Model.ToeicScore.Listening.Value.ToString() : "-")
                                                                        </td>
                                                                        <td>
                                                                            @(Model.ToeicScore.Reading.HasValue ? Model.ToeicScore.Reading.Value.ToString() : "-")
                                                                        </td>
                                                                        <td>
                                                                            @(Model.ToeicScore.Speaking.HasValue ? Model.ToeicScore.Speaking.Value.ToString() : "-")
                                                                        </td>
                                                                        <td>
                                                                            @(Model.ToeicScore.Writing.HasValue ? Model.ToeicScore.Writing.Value.ToString() : "-")
                                                                        </td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        </td>
                                                        <td>
                                                            <a class="btn-ok waves-effect waves-light m-l--s" id="toeic" href="javascript:;">@Labels.Update</a>
                                                        </td>
                                                    </tr>
                                                </table>
                                            }
                                            else
                                            {
                                                <a class="btn-ok waves-effect waves-light" id="toeic" href="javascript:;">@Labels.Update</a>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <!--End of TOEIC score-->
                                <div class="row form-input m-t--m">
                                    <div class="col m-r--m">
                                        <div class="left label--mxxl">
                                            <label for="Enabled">Enabled</label>
                                        </div>
                                        <div class="left input">
                                            <input class="filled-in" asp-for="Enabled" type="checkbox">
                                            <label for="Enabled"></label>
                                            <span asp-validation-for="Enabled"></span>
                                        </div>
                                    </div>
                                    <div class="col">
                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col m-r--m">
                                        <div class="left label--mxxl">
                                            <label for="IsSpecialUser">@Labels.SpecialUser</label>
                                        </div>
                                        <div class="left input">
                                            <input class="filled-in" asp-for="IsSpecialUser" type="checkbox">
                                            <label for="IsSpecialUser"></label>
                                            <span asp-validation-for="IsSpecialUser"></span>
                                        </div>
                                    </div>
                                    <div class="col">
                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col m-r--m">
                                        <div class="left label--mxxl">&nbsp;</div>
                                        <div class="left">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" asp-for="Id" />
                                            <input class="btn-delete waves-effect waves-light m-r--m" type="button" id="delete" value="@Labels.Delete?" />
                                            <input class="btn-submit waves-effect waves-light" type="submit" value="@Labels.Save" />
                                        </div>
                                    </div>
                                </div>
                            }
                            <div id="dialog-toeic" title="Update TOEIC Score">&nbsp;</div>
                            <div id="dialog-jobGrade" title="Update Job Grade">&nbsp;</div>
                            <div id="dialog-managementGrade" title="Update Management Grade">&nbsp;</div>
                            <div id="dialog-approver" title="Update Employee's Approver">&nbsp;</div>
                        }
                        else
                        {
                            <div class='row form-input m-t--m'>
                                <div class='col'>
                                    <span>@Messages.NoDataIsAvailable</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>