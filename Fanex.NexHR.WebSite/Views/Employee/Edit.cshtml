@model EditEmployeeViewModel
@{
    ViewBag.Title = Labels.Edit;
}
@section css {
    @Styles.Render("~/Content/employeeeditcss")
}
@section js {
    @Scripts.Render("~/bundles/employeeeditjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Edit</span>
                </div>
                <div class="card-body">
                    @if (Model != null)
                    {
                        using (Html.BeginForm())
                        {
                            <script type="text/javascript" src="http://maps.googleapis.com/maps/api/js?key=AIzaSyADr32LIjcxE7pM5BzdZO_t8AFDyTv9LsE&libraries=places&sensor=false"></script>

                            <div class="form">
                                @Html.ValidationSummary()
                                @if (ViewBag.Updated == true)
                                {
                                    <input type="hidden" id="successed" value="true" />
                                    <div class="success row validation-summary-success">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.UpdatedSuccessfully
                                    </div>
                                }
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--xl">
                                            <label>@Labels.Avatar</label>
                                        </div>
                                        <div class="left m-b--m">
                                            <img id="avatar" class="img-employee" src="~/employee/avatar/@(Model.Code)?f=@(Utilities.RandomString(4))" /><br />
                                            <span class="fileUpload">
                                                <input class="chooseFile" type="file" id="file" />
                                            </span>
                                            <input class="btn-request waves-effect waves-light m-r--s right" type="button" id="upload" value="Upload" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Code, Labels.StaffCode)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.Code)
                                            @Html.ValidationMessageFor(model => model.Code)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.EmployeeCard, Labels.EmployeeCard)
                                        </div>
                                        <div class="left input--l">
                                            @Html.TextBoxFor(model => model.EmployeeCard, new { maxlength = "10" })
                                            @Html.ValidationMessageFor(model => model.EmployeeCard)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.DomainUsername, Labels.DomainUsername)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.DomainUsername)
                                            @Html.ValidationMessageFor(model => model.DomainUsername)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.FullName, Labels.FullName)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.FullName)
                                            @Html.ValidationMessageFor(model => model.FullName)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.NickName, Labels.NickName)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.NickName)
                                            @Html.ValidationMessageFor(model => model.NickName)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.DateOfBirth, Labels.DateOfBirth)
                                        </div>
                                        <div class="left">
                                            <div class="row input--l">
                                                <div class="datepicker-button select--s">
                                                    @Html.DatePickerFor(model => model.DateOfBirth)
                                                    <i class="mdi-action-event calendar-icon left"></i>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.DateOfBirth)
                                            </div>
                                            @*<div class="row">
                                                    <div id="DOBPicker">
                                                    </div>
                                                </div>*@
                                        </div>
                                        @Html.HiddenFor(model => model.DateOfBirth)
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Email, Labels.Email)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.Email)
                                            @Html.ValidationMessageFor(model => model.Email)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.JobTitleId, Labels.JobTitle)
                                        </div>
                                        <div class="left select--l">
                                            @Html.DropDownListFor(model => model.JobTitleId, new SelectList(Model.JobTitles, "Id", "Name"))
                                            @Html.ValidationMessageFor(model => model.JobTitleId)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Phone, Labels.Phone)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.Phone)
                                            @Html.ValidationMessageFor(model => model.Phone)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Gender, Labels.Gender)
                                        </div>
                                        <div class="left select--l">
                                            @{
                                                var gender = new List<SelectListItem>
                                            {
                                                new SelectListItem {Text = "Female", Value = "0"},
                                                new SelectListItem {Text = "Male", Value = "1"}
                                            };
                                            }
                                            @Html.DropDownListFor(model => model.Gender, gender)
                                            @Html.ValidationMessageFor(model => model.Gender)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.CardNo, Labels.IdNo + ".")
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.CardNo)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.IssuedDate, Labels.IssuedDate)
                                        </div>
                                        <div class="left datepicker-button select--s">
                                            @Html.DatePickerFor(model => model.IssuedDate, maxDate: DateTime.Now)
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.IssuedPlace, Labels.IssuingAuthority)
                                        </div>
                                        <div class="left input--l">
                                            @Html.TextAreaFor(model => model.IssuedPlace, new { @class = "materialize-textarea" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Address, Labels.Address)
                                        </div>
                                        <div class="left input--l">
                                            @Html.TextAreaFor(model => model.Address, new { @class = "materialize-textarea" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.CurrentAddress, Labels.CurrentAddress)
                                        </div>
                                        <div class="left input--l">
                                            @Html.TextAreaFor(model => model.CurrentAddress, new { @class = "materialize-textarea" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="label showHideGeolocationMap m-l--s">
                                        <a id="showHideMap">@Labels.GeolocationMap (@Labels.Expanse/@Labels.Collapse)</a>
                                    </div>
                                    <div class="input">
                                        <label>
                                        </label>
                                    </div>
                                </div>
                                @*Google Map*@
                                <div class="row form-input p-x--s" id="geolocationMap">
                                    <div class="left m-r--l">
                                        <div class='left input--m m-r--l'>
                                            <input type="text" id="geoMapAddress" />
                                        </div>
                                        <div class='left'>
                                            <input class="btn-submit waves-effect waves-light" type="button" value="Search" id="searchmap" />
                                        </div>
                                    </div>
                                    <div class='geolocationMap'>
                                        <div class="col m-r--l">
                                            <div class='left label--m'>
                                                <label>Latitude: </label>
                                            </div>
                                            <div class="left input--m">
                                                @Html.TextBoxFor(model => model.GeoMapLatitude, new { @class = "latlng" })
                                            </div>
                                        </div>
                                        <div class="col m-r--l">
                                            <div class='left label--m'>
                                                <label>Longtitude: </label>
                                            </div>
                                            <div class="left input--m">
                                                @Html.TextBoxFor(model => model.GeoMapLongtitude, new { @class = "latlng" })
                                            </div>
                                        </div>
                                        <div class="col m-r--l">
                                            <div class='left label--m'>
                                                <label>Distance: </label>
                                            </div>
                                            <div class="left input--s">
                                                @Html.TextBoxFor(model => model.DistanceToCompany, new { @class = "distance" })
                                            </div>
                                        </div>
                                    </div>
                                    <div id="map-canvas" style="width: 100%; height: 50rem">
                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.TeamId, Labels.Team)
                                        </div>
                                        <div class="left select--l">
                                            @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"))
                                            @Html.ValidationMessageFor(model => model.TeamId)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input m-b--m">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.SubGroups)
                                        </div>
                                        <div class="left input--l subteam">
                                            @Html.MaterializeCheckBoxListFor(model => model.SubGroupArray, new SelectList(Model.Teams, "Id", "Name"), new { @class = "filled-in SubGroupArray" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input m-b--m">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.LeaderGroups)
                                        </div>
                                        <div class="left input--l subteam">
                                            @Html.MaterializeCheckBoxListFor(model => model.LeaderGroupsArray, new SelectList(Model.Teams, "Id", "Name"), new { @class = "filled-in LeaderGroupsArray" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Roles)
                                        </div>
                                        <div class="left role input--l">
                                            @{
                                                var roles = new List<SelectListItem>
                                            {
                                                new SelectListItem {Text = "Assistant leader", Value = "1"},
                                                new SelectListItem {Text = "Leader", Value = "2"},
                                                new SelectListItem {Text = "Human resource", Value = "3"},
                                                new SelectListItem {Text = "System admin", Value = "4"}
                                            };
                                            }
                                            <input type="checkbox" class="filled-in" id="Member" name="Member" checked="checked"
                                                   disabled="disabled" value="true" />
                                            <label for="Member">@Labels.Member</label>
                                            @Html.MaterializeCheckBoxListFor(model => model.RoleArray, roles, new { @class = "filled-in" })
                                            @Html.ValidationMessageFor(model => model.RoleArray)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.JoinedDate, Labels.JoinedDate)
                                        </div>
                                        <div class="left">
                                            <div class="datepicker-button select--s">
                                                @Html.DatePickerFor(model => model.JoinedDate)
                                                <i class="mdi-action-event calendar-icon left"></i>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.JoinedDate)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.ConfirmedDate, Labels.ConfirmedDate)
                                        </div>
                                        <div class="left">
                                            <div class="datepicker-button select--s">
                                                @Html.DatePickerFor(model => model.ConfirmedDate)
                                                <i class="mdi-action-event calendar-icon left"></i>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ConfirmedDate)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.ResignedDate, Labels.LastWorkingDate)
                                        </div>
                                        <div class="left">
                                            <div class="datepicker-button select--s">
                                                @Html.DatePickerFor(model => model.ResignedDate)
                                                <i class="mdi-action-event calendar-icon left"></i>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ResignedDate)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Skype, Labels.Skype)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.Skype)
                                            @Html.ValidationMessageFor(model => model.Skype)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Yahoo, Labels.Yahoo)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.Yahoo)
                                            @Html.ValidationMessageFor(model => model.Yahoo)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Mariage, Labels.Marriage)
                                        </div>
                                        <div class="left input--l">
                                            @Html.MaterializeCheckBoxFor(model => model.Mariage, new { @class = "filled-in" })
                                            @Html.ValidationMessageFor(model => model.Mariage)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.PassportNo, Labels.PassportNo)
                                        </div>
                                        <div class="left input--l">
                                            @Html.EditorFor(model => model.PassportNo)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.PassportExp, Labels.PassportExp)
                                        </div>
                                        <div class="left datepicker-button select--s">
                                            @Html.DatePickerFor(model => model.PassportExp)
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--xl">
                                            <label>@Labels.LeaveBalance</label>
                                        </div>
                                        <div class="left input--l">
                                            <span class="m-r--s black-text">@Model.AnnualLeaveBalance day(s)</span>
                                            <a class="btn-ok waves-effect waves-light" href="~/annualleave/employee?employeeid=@Model.Id&year=@DateTime.Now.Year">@Labels.Update</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col">
                                        <div class="left label--xl">
                                            <label>@Labels.WorkingCalendar</label>
                                        </div>
                                        <div class="left">
                                            <a class="btn-ok waves-effect waves-light" href="~/employee/defaultschedule?employeeId=@Model.Id">@Labels.Update</a>
                                        </div>
                                    </div>
                                </div>
                                <!--TOEIC score-->
                                <div class="row form-input m-t--m">
                                    <div class="col">
                                        <div class="left label--xl">
                                            <label>@Labels.ToeicScore</label>
                                        </div>
                                        <div class="left input">
                                            @if (Model.ToeicScore != null)
                                            {
                                                <table class="table centered">
                                                    <tr>
                                                        <td style="padding: 0;">
                                                            <table class="toeic">
                                                                <thead>
                                                                    <tr>
                                                                        <th>
                                                                            @Labels.L
                                                                    </th>
                                                                    <th>
                                                                        @Labels.R
                                                                </th>
                                                                <th>
                                                                    @Labels.S
                                                            </th>
                                                            <th>
                                                                @Labels.W
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            @(Model.ToeicScore.Listening.HasValue ? Model.ToeicScore.Listening.Value.ToString() : "-")
                                                    </td>
                                                    <td>
                                                        @(Model.ToeicScore.Reading.HasValue ? Model.ToeicScore.Reading.Value.ToString() : "-")
                                                </td>
                                                <td>
                                                    @(Model.ToeicScore.Speaking.HasValue ? Model.ToeicScore.Speaking.Value.ToString() : "-")
                                            </td>
                                            <td>
                                                @(Model.ToeicScore.Writing.HasValue ? Model.ToeicScore.Writing.Value.ToString() : "-")
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                        <td>
                            <a class="btn-ok waves-effect waves-light m-l--s" id="toeic" href="javascript:;">@Labels.Update</a>
                        </td>
                    </tr>
                </table>
                                            }
                                            else
                                            {
                                                <a class="m-l--s btn-ok waves-effect waves-light" id="toeic" href="javascript:;">@Labels.Update</a>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <!--End of TOEIC score-->
                                <div class="row form-input m-t--m">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">
                                            @Html.LabelFor(model => model.Enabled)
                                        </div>
                                        <div class="left input">
                                            @Html.MaterializeCheckBoxFor(model => model.Enabled, new { @class = "filled-in" })
                                            @Html.ValidationMessageFor(model => model.Enabled)
                                        </div>
                                    </div>
                                    <div class="col">
                                    </div>
                                </div>
                                <div class="row form-input m-t--m">
                                    <div class="col m-r--m">
                                        <div class="left label--xl">&nbsp;</div>
                                        <div class="left">
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(model => model.Id)
                                            <input class="btn-delete waves-effect waves-light m-r--m" type="button" id="delete" value="@Labels.Delete?" />
                                            <input class="btn-submit waves-effect waves-light" type="submit" value="@Labels.Save" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                                                }
                                                <div id="dialog-toeic" title="Update TOEIC Score">&nbsp;</div>
                                                }
                                                else
                                                {
                                                    <div class='row form-input m-t--m'>
                                                        <div class='col'>
                                                            <span>@Messages.NoDataIsAvailable</span>
                                                        </div>
                                                    </div>
                                                }
                </div>
            </div>
        </div>
    </div>
</div>