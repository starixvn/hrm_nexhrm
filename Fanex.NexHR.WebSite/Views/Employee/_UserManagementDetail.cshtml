@model IList<Employee>
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount
            </th>
            <th class="col-sorter">
                @Labels.Code
                <div class="sorter" data-property="Code">
                </div>
            </th>
            <th class="col-sorter">
                @Labels.Nick
                <div class="sorter" data-property="NickName">
                </div>
            </th>
            <th class="col-sorter">
                @Labels.FullName
                <div class="sorter" data-property="FullName">
                </div>
            </th>
            <th class="col-sorter">
                @Labels.Team
                <div class="sorter" data-property="CodeOfTeam">
                </div>
            </th>
            <th class="col-sorter">
                @Labels.Gender
                <div class="sorter" data-property="Gender">
                </div>
            </th>
            <th class="col-sorter">
                @Labels.JobTitle
                <div class="sorter" data-property="JobTitle">
                </div>
            </th>
            <th class="col-sorter">
                @Labels.DoB
                <div class="sorter" data-property="DateOfBirth">
                </div>
            </th>
            <th class="col-sorter">
                @Labels.JoinedDate
                <div class="sorter" data-property="JoinedDate">
                </div>
            </th>
            <th>@Labels.Edit
            </th>
            <th>@Labels.Schedule
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            var index = 0;
            foreach (Employee employee in Model)
            {
                index++;
                var cssClass = employee.Enabled == false ? "disabled" : "";
                <tr id="row@employee.Id" class="@cssClass">
                    <td>@index</td>
                    <td>@employee.Code</td>
                    <td class="nick" data-code="@employee.Code">
                        <a href="/employee/detail/@employee.Id">@employee.NickName</a>
                    </td>
                    <td class="align-left">@employee.FullName</td>
                    <td title="@employee.Team.Name" class="tooltip">@employee.Team.Code</td>
                    <td>
                        @if(employee.Gender == 0){
                            <span>F</span>
                        }
                        else
                        {
                            <span>M</span>
                        }
                    </td>
                    <td class="align-left">@employee.JobTitle</td>
                    <td>@employee.DateOfBirth.ToDateMonthYearFormatedDate()</td>
                    <td>
                        @if (employee.JoinedDate != null){
                            employee.JoinedDate.ToDateMonthYearFormatedDate();
                        }
                    </td>
                    <td>
                        @if (!employee.IsDeleted){
                            <a href="/employee/edit/@employee.Id"><i class="mdi mdi-border-color mdi-dark mdi-18px"></i></a>
                        }
                        else{
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (!employee.IsDeleted){
                            <a href="/employee/defaultschedule/@employee.Id"><i class="mdi mdi-border-color mdi-dark mdi-18px"></i></a>
                        }
                        else{
                            <span>-</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(11)
        }
    </tbody>
</table>