@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Employee
@using Fanex.NexHR.Core
@inject AppSetting settings;
@model TransferEmployeeViewModel
@{
    ViewBag.Title = Labels.EmployeeTransfer;

    var Employee = settings.HRMName == "NexHRM" ? Labels.NexEmployee : Labels.LumiEmployee;
    var LastWorkingDate = settings.HRMName == "NexHRM" ? Labels.NexLastWorkingDate : Labels.LumiLastWorkingDate;
    var EffectedDate = settings.HRMName == "NexHRM" ? Labels.LumiEffectDate : Labels.NexEffectDate;
    var Team = settings.HRMName == "NexHRM" ? Labels.LumiTeam : Labels.NexTeam;
    var Shift = settings.HRMName == "NexHRM" ? Labels.LumiShift : Labels.NexShift;
}

@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Employee/employee.transfer.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/employeetransferjs.min.js" asp-append-version="true"></script>
    </environment>
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-calendar-working">
                        @using (Html.BeginForm("transfer", "employee", FormMethod.Post))
                        {
                            @Html.ValidationSummary()
                            if (ViewBag.Requested == true)
                            {
                                <div class="row validation-summary-success">
                                    <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.RequestCreated
                                    <input type="hidden" id="successed" value="true" />
                                    <input type="hidden" id="year" value="@ViewBag.Year" />
                                </div>
                            }
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xxl">
                                        @Html.LabelFor(model => model.Employee, Employee)
                                    </div>
                                    <div class="left select--m employee">
                                        @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xxl">
                                        @Html.LabelFor(model => model.LastWorkingDate, LastWorkingDate)
                                    </div>
                                    <div class="left datepicker-button select--m">
                                        <date-picker name="LastWorkingDate"
                                                 value="@Model.LastWorkingDate">
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xxl">
                                        @Html.LabelFor(model => model.AffectedDate, EffectedDate)
                                    </div>
                                    <div class="left datepicker-button select--m">
                                        <date-picker name="AffectedDate"
                                                 value="@Model.AffectedDate">
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xxl">
                                        @Html.LabelFor(model => model.GroupId, Team)
                                    </div>
                                    <div class="left select--m groudId">
                                        @Html.DropDownListFor(model => model.GroupId, new SelectList(Model.LumiGroups, "Id", "Name"))
                                        @Html.HiddenFor(model => model.GroupName)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xxl">
                                        @Html.LabelFor(model => model.ShiftId, Shift)
                                    </div>
                                    <div class="left select--m shiftId">
                                        @Html.DropDownListFor(model => model.ShiftId, new SelectList(Model.LumiShifts, "Id", "Name"))
                                        @Html.HiddenFor(model => model.ShiftName)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xxl">
                                        @Html.LabelFor(model => model.IsTransferAnnualLeaveBalance, Labels.IsTransferAlBalance)
                                    </div>
                                    <div class="left input--m isTransferAL">
                                        <input asp-for="IsTransferAnnualLeaveBalance" type="checkbox" class="filled-in" />
                                        <label for="IsTransferAnnualLeaveBalance"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xxl">
                                        @Html.LabelFor(model => model.IsTransferNexBalance, Labels.IsTransferNexBalance)
                                    </div>
                                    <div class="left input--m isTransferLateInEarlyOut">
                                        <input asp-for="IsTransferNexBalance" type="checkbox" class="filled-in" />
                                        <label for="IsTransferNexBalance"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--xxl">
                                        @Html.LabelFor(model => model.IsTransferLateInEarlyOut, Labels.IsTransferLateInEarlyOutBalance)
                                    </div>
                                    <div class="left input--m isTransferLateInEarlyOut">
                                        <input asp-for="IsTransferLateInEarlyOut" type="checkbox" class="filled-in" />
                                        <label for="IsTransferLateInEarlyOut"></label>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input line-button">
                                <div class="col">
                                    <div class="left label--xxl">&nbsp;</div>
                                    <div class="left">
                                        <a href="@Url.Action("Index")" class="btn-back waves-effect waves-light">@Labels.Cancel</a>
                                        <input type="submit" class="btn-submit waves-effect waves-light right" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </div>


                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>