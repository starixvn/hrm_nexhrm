@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@{
    const string Certificates = "Certificates";
    const string InternalTraining = "Internal Training";
    const string FormatDate = "dd MMM yyyy";
    var isHRRole = sessionService.CurrentEmployee.RoleList.Any(r => r == (short)Role.HR || r == (short)Role.SA);
}
@model Employee
@{
    ViewBag.Title = Labels.MyProfile;
}
@section Styles {
    <link rel="stylesheet" href="~/css/Views/training-and-development.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/myprofile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Employee/employee.profile.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/employee.profile.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <input type="hidden" asp-for="@Model.Id" />
    <input type="hidden" asp-for="@Model.NickName" />
    <div id="dialog-show-history-jobgrade" class="full-view-width over-auto"></div>
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="left-profile">
                        <div class="header-avatar">
                            <div class="avatar">
                                <img src="@Url.Action("Avatar","Employee", new {id=Model.Code})" alt="@Model.NickName" />
                            </div>
                            <div class="pinfo">
                                <p class="name">@Model.FullName</p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.StaffCode:</span> <span>@Model.Code</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.Domain:</span> <span>@Model.DomainUsername</span>
                                </p>
                            </div>
                        </div>
                        <div class="personal-info">
                            <div class="info-title">
                                Personal Information
                            </div>
                            <div class="info-body">
                                <p class="accinfo">
                                <span class="label--mxxl">@Labels.Email:</span> <span><a href="mailto:@Model.Email">@Model.Email</a></span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.Phone:</span> <span>@Model.Phone</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.Skype:</span> <span><a href="skype:@(Model.Skype)?chat">@Model.Skype</a></span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.Telegram:</span> <span><a href="ymsgr:SendIM?@(Model.Yahoo)">@Model.Yahoo</a></span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.EducationBackground:</span> <span>@Model.EducationBackground</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.Address:</span> <span>@Model.Address</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.CurrentAddress:</span> <span class="address">@Model.CurrentAddress</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.ContactName:</span> <span>@Model.ContactName</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.Relationship:</span> <span>@Model.UserRelationship</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.ContactPhone:</span> <span>@Model.ContactPhone</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.ContactAddress:</span> <span class="address">@Model.ContactAddress</span>
                                </p>

                                <p class="accinfo">
                                <span class="label--mxxl">@Labels.FullName:</span> <span class="txt-bold">@Model.FullName</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.EnglishName:</span> <span class="txt-bold">@Model.NickName</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.DoB:</span> <span class="txt-bold">@Model.DateOfBirth.ToString("dd MMM, yyyy")</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.PlaceOfBirth:</span> <span class="txt-bold">@Model.PlaceOfBirth</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.Gender:</span> <span class="txt-bold">@(Model.Gender == 1 ? "Male" : "Female")</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.Marriage:</span> <span class="txt-bold">@(Model.Marriage ? "Yes" : "No")</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.IdNo:</span> <span class="txt-bold">@Model.CardNo</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.IssuedDate:</span> <span class="txt-bold">
                                        @if(Model.IssuedDate != null)
                                        {
                                            var issuedDate = (DateTime)Model.IssuedDate;
                                            @issuedDate.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.IssuingAuthority:</span> <span class="txt-bold">@Model.IssuedPlace</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.PassportNo:</span> <span class="txt-bold">@Model.PassportNo</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.PassportExp:</span> <span class="txt-bold">
                                        @if(Model.PassportExp != null)
                                        {
                                            var passportExp = (DateTime)Model.PassportExp;
                                            @passportExp.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--mxxl">@Labels.SocialInsuranceNo:</span> <span class="txt-bold">@Model.SocialInsuranceNo</span>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="right-profile">
                        <div class="job-information">
                            <div class="info-title">
                                @Labels.JobInformation
                            </div>
                            <div class="info-body">
                                <p class="accinfo">
                                    <span class="label--l">@Labels.JobTitle:</span> <span class="txt-bold">
                                        @if (Model.JobTitle != null)
                                        {
                                            @Model.JobTitle.Name
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.JobGrade:</span> 
                                    <span class="txt-bold tooltip" title="@($"{Labels.EffectiveDate}: {Model.AffectedDate.ToString("dd MMM, yyyy")}")">
                                        @if (Model.JobGradeCode != null)
                                        {
                                            @Model.JobGradeCode
                                        }
                                    </span>
                                    @if (Model.JobGradeCode != null)
                                    {
                                        <span class="label--l" style="margin-left: 5px;">
                                            <a class="viewhistoryjobgrade" href="javascript:;" id="">
                                                <i class="mdi mdi-information-outline mdi-dark mdi-24px tooltip" title="View history"></i>
                                            </a>
                                        </span>
                                    }
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.Team:</span> <span class="txt-bold">@Model.Team.Name</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.Roles:</span> <span class="txt-bold">@Model.DisplayRoles()</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.JoinedDate:</span> <span class="txt-bold">
                                        @if (Model.JoinedDate != null)
                                        {
                                            var date = (DateTime)Model.JoinedDate;
                                            @date.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.GroupDate:</span> <span class="txt-bold">
                                        @{
                                            var groupDate1 = (DateTime)Model.GroupDate;
                                            @groupDate1.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--l">@Labels.ConfirmedDate:</span> <span class="txt-bold">
                                        @if (Model.ConfirmedDate != null)
                                        {
                                            var date = (DateTime)Model.ConfirmedDate;
                                            @date.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                @if (Model.ResignedDate != null)
                                {
                                    var date = (DateTime)Model.ResignedDate;
                                    <p class="accinfo">
                                        <span class="label--l">@Labels.LastWorkingDate:</span> <span class="txt-bold">@date.ToString("dd MMM, yyyy")</span>
                                    </p>
                                }
                            </div>
                        </div>
                        <div class="trainingAndDevelopmentsreport m-t--l p-x--s">
                            <div class="boxtitle">
                                @Labels.LearningAndDevelopment
                            </div>
                            @foreach(var item in Model.TrainingAndDevelopmentTypes)
                            {
                                var trainingAndDevelopments = Model.TrainingAndDevelopments.Where(x => x.TypeId == item.Id).ToList();
                                <div class="development">
                                    @if(trainingAndDevelopments.Count > 0)
                                    {
                                        <div class="boxdevelopmenttitle">
                                            @trainingAndDevelopments[0].TypeName
                                        </div>
                                        foreach (var trainingAndDevelopment in trainingAndDevelopments)
                                        {
                                            if (trainingAndDevelopment.TypeName == InternalTraining)
                                            {
                                                <div class="detail training">
                                                    <p class="name bold">@trainingAndDevelopment.Name</p>
                                                    <p title="@trainingAndDevelopment.Publish" class=" icon-publish icon-@trainingAndDevelopment.Publish" />
                                                    <p>Conducted by:</p>
                                                    <p class="conductedby italic">@trainingAndDevelopment.ConductedBy</p>
                                                    <p>Start Date:</p>
                                                    <p class="startdate italic">@trainingAndDevelopment.StartDate.ToString(FormatDate)</p>
                                                </div>
                                            }
                                            else if (trainingAndDevelopment.TypeName == Certificates)
                                            {
                                                <div class="detail certificate">
                                                    <p class="name bold">@trainingAndDevelopment.Name</p>
                                                    <p title="@trainingAndDevelopment.Publish" class=" icon-publish icon-@trainingAndDevelopment.Publish" />
                                                    <p>Organization:</p>
                                                    <p class="organization italic">@trainingAndDevelopment.Organization</p>
                                                    <p>Test Date:</p>
                                                    <p class="testdate italic">@trainingAndDevelopment.ExamDate.ToString(FormatDate)</p>
                                                    @if (!trainingAndDevelopment.ExpirationDate.Equals(DateTime.MinValue))
                                                    {
                                                        <p>Expiration Date</p>
                                                        <p class="enddate italic">@trainingAndDevelopment.ExpirationDate.ToString(FormatDate)</p>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="detail developmentDetail">
                                                    <p class="name bold">@trainingAndDevelopment.Name</p>
                                                    <p title="@trainingAndDevelopment.Publish" class=" icon-publish icon-@trainingAndDevelopment.Publish" />
                                                    <p>Organization:</p>
                                                    <p class="organization italic">@trainingAndDevelopment.Organization</p>
                                                    <p>Start Date:</p>
                                                    <p class="startdate italic">@trainingAndDevelopment.StartDate.ToString(FormatDate)</p>
                                                    <p>End Date:</p>
                                                    <p class="enddate italic">@trainingAndDevelopment.EndDate.ToString(FormatDate)</p>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            }
                            @if (Model.TrainingAndDevelopments.Count == 0)
                            {
                                <p class="none-training">@Messages.NoInformationAvailable</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
