@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@using Fanex.NexHR.Core
@{
    var count = 0;
    const string certificate = "Certificate";
    const string formatDate = "dd MMM, yyyy";
}
@model Employee
@{
    ViewBag.Title = Labels.MyProfile;
}
@section Styles {
    <link rel="stylesheet" href="~/css/Views/course-and-certificate.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/myprofile.min.css" asp-append-version="true">
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="avatarbox m-t--m">
                        <div class="row">
                            <div class="col">
                                <div class="avatar">
                                    <img src="@Url.Action("Avatar","Employee", new {id=Model.Code})" alt="@Model.NickName" />
                                </div>
                            </div>
                            <div class="col">
                                <div class="row">
                                    <div class="col name">
                                        @Model.FullName
                                        <div class="sub-avatar">
                                            <img src="@Url.Action("Avatar","Employee", new {id=Model.Code})" alt="@Model.NickName" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col m-r--xl">
                                        <div class="pinfo">
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.StaffCode:</span> <span>@Model.Code</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.CPU:</span> <span>@Model.DomainUsername</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Email:</span> <span><a href="mailto:@Model.Email">@Model.Email</a></span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Phone:</span> <span>@Model.Phone</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Skype:</span> <span><a href="skype:@(Model.Skype)?chat">@Model.Skype</a></span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Telegram:</span> <span><a href="ymsgr:SendIM?@(Model.Yahoo)">@Model.Yahoo</a></span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Address:</span> <span>@Model.Address</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.CurrentAddress:</span> <span class="address">@Model.CurrentAddress</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.ContactName:</span> <span>@Model.ContactName</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">Relationship:</span> <span>@Model.UserRelationship</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.ContactPhone:</span> <span>@Model.ContactPhone</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.ContactAddress:</span> <span class="address">@Model.ContactAddress</span>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="pinfo">
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.FullName:</span> <span class="txt-bold">@Model.FullName</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.NickName:</span> <span class="txt-bold">@Model.NickName</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">D.O.B:</span> <span class="txt-bold">@Model.DateOfBirth.ToString("dd MMM, yyyy")</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.PlaceOfBirth:</span> <span class="txt-bold">@Model.PlaceOfBirth</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Gender:</span> <span class="txt-bold">@(Model.Gender == 1 ? "Male" : "Female")</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Marriage:</span> <span class="txt-bold">@(Model.Mariage ? "Yes" : "No")</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.IdNo:</span> <span class="txt-bold">@Model.CardNo</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.IssuedDate:</span> <span class="txt-bold">
                                                    @if(Model.IssuedDate != null)
                                                    {
                                                        var issuedDate = (DateTime)Model.IssuedDate;
                                                        @issuedDate.ToString("dd MMM, yyyy")
                                                    }
                                                </span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.IssuingAuthority:</span> <span class="txt-bold">@Model.IssuedPlace</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.PassportNo:</span> <span class="txt-bold">@Model.PassportNo</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.PassportExp:</span> <span class="txt-bold">
                                                    @if(Model.PassportExp != null)
                                                    {
                                                        var passportExp = (DateTime)Model.PassportExp;
                                                        @passportExp.ToString("dd MMM, yyyy")
                                                    }
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="Jobinformation p-x--s m-t--l">
                        <div class="boxtitle">
                            @Labels.JobInformation
                        </div>
                        <div class="pinfo">
                            <p class="accinfo">
                                <span class="label--l">@Labels.JobTitle:</span> <span class="txt-bold">
                                    @if (Model.JobTitle != null)
                                    {
                                        @Model.JobTitle.Name
                                    }
                                </span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">@Labels.Team:</span> <span class="txt-bold">@Model.Team.Name</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">@Labels.Roles:</span> <span class="txt-bold">@Model.DisplayRoles()</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">@Labels.JoinedDate:</span> <span class="txt-bold">
                                    @if (Model.JoinedDate != null)
                                    {
                                        var date = (DateTime)Model.JoinedDate;
                                        @date.ToString("dd MMM, yyyy")
                                    }
                                </span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">@Labels.ConfirmedDate:</span> <span class="txt-bold">
                                    @if (Model.ConfirmedDate != null)
                                    {
                                        var date = (DateTime)Model.ConfirmedDate;
                                        @date.ToString("dd MMM, yyyy")
                                    }
                                </span>
                            </p>
                            @if (Model.ResignedDate != null)
                            {
                                var date = (DateTime)Model.ResignedDate;
                                <p class="accinfo">
                                    <span class="label--l">@Labels.LastWorkingDate:</span> <span class="txt-bold">@date.ToString("dd MMM, yyyy")</span>
                                </p>
                            }
                        </div>
                    </div>
                    <div class="courseAndCertificatereport m-t--l p-x--s">
                        <div class="boxtitle">
                            Course And Certificate
                        </div>
                        <div class="courseAndCertificate">
                            <p>-</p>
                            <p>Certificate</p>
                            <p>AWS Certified Cloud Practition</p>
                            <p>Software development</p>
                            <p>Exam Date</p>
                            <p>01 Jan, 2001</p>
                            <p>Expiration Date</p>
                            <p>19 Apr, 2023</p>
                            <p>Organization</p>
                            <p>AWS</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
