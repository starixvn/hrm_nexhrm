@model Employee
@{
    ViewBag.Title = Labels.MyProfile;
}
@section css{
    @Styles.Render("~/Content/myprofilecss")
}
@section js{
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="avatarbox m-t--m">
                        <div class="row">
                            <div class="col">
                                <div class="avatar">
                                    <img src="~/employee/avatar/@(Model.Code)" alt="@Model.NickName" />
                                </div>
                            </div>
                            <div class="col">
                                <div class="row">
                                    <div class="col name">@Model.FullName</div>
                                </div>
                                <div class="row">
                                    <div class="col m-r--l">
                                        <div class="pinfo">
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.StaffCode:</span> <span>@Model.Code</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.CPU:</span> <span>@Model.DomainUsername</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Email:</span> <span><a href="mailto:@Model.Email">@Model.Email</a></span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Phone:</span> <span>@Model.Phone</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Skype:</span> <span><a href="skype:@(Model.Skype)?chat">@Model.Skype</a></span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Yahoo:</span> <span><a href="ymsgr:SendIM?@(Model.Yahoo)">@Model.Yahoo</a></span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Address:</span> <span>@Model.Address</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.CurrentAddress:</span> <span class="address">@Model.CurrentAddress</span>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="pinfo">
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.FullName:</span> <span class="txt-bold">@Model.FullName</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.NickName:</span> <span class="txt-bold">@Model.NickName</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">D.O.B:</span> <span class="txt-bold">@Model.DateOfBirth.ToString("dd MMM, yyyy")</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Gender:</span> <span class="txt-bold">@(Model.Gender == 1 ? "Male" : "Female")</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.Marriage:</span> <span class="txt-bold">@(Model.Mariage == null ? "Unknown" : (Model.Mariage == true ? "Yes" : "No"))</span>
                                            </p>
                                            <p class="accinfo">
                                                <span class="label--l">@Labels.IdNo:</span> <span class="txt-bold">@Model.CardNo</span>
                                            </p>
                                            @if (Model.PassportNo != null)
                                            {
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.PassportNo:</span> <span class="txt-bold">@Model.PassportNo</span>
                                                </p>
                                            }
                                            @if (Model.PassportExp != null)
                                            {
                                                var date = (DateTime)Model.PassportExp;
                                                <p class="accinfo">
                                                    <span class="label--l">@Labels.PassportExp:</span> <span class="txt-bold">@date.ToString("dd MMM, yyyy")</span>
                                                </p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="Jobinformation p-x--s m-t--m">
                        <div class="boxtitle">
                            @Labels.JobInformation
                        </div>
                        <div class="pinfo">
                            <p class="accinfo">
                                <span class="label--l">@Labels.JobTitle:</span> <span class="txt-bold">@Model.JobTitle.Name</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">@Labels.Team:</span> <span class="txt-bold">@Model.Team.Name</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">@Labels.Roles:</span> <span class="txt-bold">@Model.DisplayRoles()</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">@Labels.JoinedDate:</span> <span class="txt-bold">
                                    @if (Model.JoinedDate != null)
                                    {
                                        var date = (DateTime)Model.JoinedDate;
                                        @date.ToString("dd MMM, yyyy")
                                    }
                                </span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">@Labels.ConfirmedDate:</span> <span class="txt-bold">
                                    @if (Model.ConfirmedDate != null)
                                    {
                                        var date = (DateTime)Model.ConfirmedDate;
                                        @date.ToString("dd MMM, yyyy")
                                    }
                                </span>
                            </p>
                            @if (Model.ResignedDate != null)
                            {
                                var date = (DateTime)Model.ResignedDate;
                                <p class="accinfo">
                                    <span class="label--l">@Labels.LastWorkingDate:</span> <span class="txt-bold">@date.ToString("dd MMM, yyyy")</span>
                                </p>
                            }
                        </div>
                    </div>
                    <div class="scoreCertificates p-x--s m-t--m">
                        <div class="boxtitle">
                            @Labels.ScoreCertificates
                        </div>
                        <div class="pinfo">
                            <p class="accinfo">
                                <span class="label--xl">@Labels.TechnicalSkill:</span> <span class="txt-bold">
                                    @Labels.Photoshop, @Labels.Illustrator, @Labels.Indesign, @Labels.Dreamweaver...
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="attendacereport m-t--m p-x--s">
                        <div class="boxtitle">
                            @Labels.ScheduleWorking
                        </div>
                        <div class="pinfo">
                            <p class="accinfo">
                                <span>@Labels.AnnualLeaveBalance:</span> <span class="txt-bold m-l--m">@Model.AnnualLeaveBalance
                                    day(s)</span>
                            </p>
                            <table class="table bordered striped highlight centered table-custom" style="width: 500px;">
                                <thead>
                                    <tr>
                                        <th>
                                            @Labels.Sun
                                        </th>
                                        <th>
                                            @Labels.Mon
                                        </th>
                                        <th>
                                            @Labels.Tue
                                        </th>
                                        <th>
                                            @Labels.Wed
                                        </th>
                                        <th>
                                            @Labels.Thu
                                        </th>
                                        <th>
                                            @Labels.Fri
                                        </th>
                                        <th>
                                            @Labels.Sat
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="scheduleoff">
                                            @Model.DefaultSchedule.SunShiftName
                                        </td>
                                        <td>
                                            @Model.DefaultSchedule.MonShiftName
                                        </td>
                                        <td>
                                            @Model.DefaultSchedule.TueShiftName
                                        </td>
                                        <td>
                                            @Model.DefaultSchedule.WedShiftName
                                        </td>
                                        <td>
                                            @Model.DefaultSchedule.ThuShiftName
                                        </td>
                                        <td>
                                            @Model.DefaultSchedule.FriShiftName
                                        </td>
                                        <td class="scheduleoff">
                                            @Model.DefaultSchedule.SatShiftName
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    @{ Toeic toeic = Model.ToeicScore; }
                    <div class="toeicscore m-t--m p-x--s">
                        <div class="boxtitle txt-uppercase">
                            @Labels.ToeicScore
                        </div>
                        <div class="boxcontent">
                            <table class="table bordered striped highlight centered table-custom" style="width: 650px;">
                                <thead>
                                    <tr>
                                        <th>@Labels.Listening
                                        </th>
                                        <th>@Labels.Reading
                                        </th>
                                        <th>@Labels.Speaking
                                        </th>
                                        <th>@Labels.Writing
                                        </th>
                                        <th>@Labels.ExamDate (@Labels.L/@Labels.R & @Labels.S/@Labels.W)
                                        </th>
                                        <th>@Labels.OldScores
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@(toeic != null ? (toeic.Listening.HasValue ? toeic.Listening.Value.ToString() : "-") : "-")
                                        </td>
                                        <td>@(toeic != null ? (toeic.Reading.HasValue ? toeic.Reading.Value.ToString() : "-") : "-")
                                        </td>
                                        <td>@(toeic != null ? (toeic.Speaking.HasValue ? toeic.Speaking.Value.ToString() : "-") : "-")
                                        </td>
                                        <td>@(toeic != null ? (toeic.Writing.HasValue ? toeic.Writing.Value.ToString() : "-") : "-")
                                        </td>
                                        @if (toeic == null || (toeic.LRTotal + toeic.Speaking + toeic.Writing) == 0)
                                        {
                                            <td>
                                                -
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @(toeic.LRExamDate.HasValue ? toeic.LRExamDate.Value.ToString("dd MMM, yyyy") : "-")
                                                /
                                                @(toeic.SWExamDate.HasValue ? toeic.SWExamDate.Value.ToString("dd MMM, yyyy") : "-")
                                            </td>
                                        }
                                        @if (toeic == null || (toeic.OldListening + toeic.OldReading + toeic.OldSpeaking + toeic.OldWriting) == 0)
                                        {
                                            <td>
                                                -
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @(toeic.OldListening.HasValue ? toeic.OldListening.Value.ToString() : "-")
                                                /
                                                @(toeic.OldReading.HasValue ? toeic.OldReading.Value.ToString() : "-")
                                                /
                                                @(toeic.OldSpeaking.HasValue ? toeic.OldSpeaking.Value.ToString() : "-")
                                                /
                                                @(toeic.OldWriting.HasValue ? toeic.OldWriting.Value.ToString() : "-")
                                            </td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
