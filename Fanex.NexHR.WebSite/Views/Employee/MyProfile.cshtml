@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@{
    const string Certificates = "Certificates";
    const string InternalTraining = "Internal Training";
    const string FormatDate = "dd MMM yyyy";
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
}
@model Employee
@{
    ViewBag.Title = Labels.MyProfile;
}
@section Styles {
    <link rel="stylesheet" href="~/css/Views/training-and-development.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/myprofile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Employee/employee.profile.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/employee.profile.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <input type="hidden" asp-for="@Model.Id" />
    <input type="hidden" asp-for="@Model.NickName" />
    <div id="dialog-show-history-jobgrade" class="full-view-width over-auto"></div>
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="left-profile">
                        <div class="header-avatar">
                            <div class="avatar">
                                <img src="@Url.Action("Avatar","Employee", new {id=Model.Code})"
                                    alt="@Model.NickName" />
                            </div>
                            <div class="info">
                                <p class="name">@Model.FullName</p>
                                <p class="accinfo">
                                    @Labels.StaffCode:<span>@Model.Code</span>
                                </p>
                                <p class="accinfo">
                                    @Labels.Domain:<span>@Model.DomainUsername</span>
                                </p>
                            </div>
                        </div>
                        <div class="personal-info">
                            <div class="info-title">
                                @Labels.PersonalInformation
                            </div>
                            <div class="info-body">
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.FullName:</span> <span
                                        class="txt-bold">@Model.FullName</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.EnglishName:</span> <span
                                        class="txt-bold">@Model.NickName</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.DoB:</span> <span
                                        class="txt-bold">@Model.DateOfBirth.ToString("dd MMM, yyyy")</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.PlaceOfBirth:</span> <span
                                        class="txt-bold">@Model.PlaceOfBirth</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Gender:</span> <span class="txt-bold">@(Model.Gender
                                        == 1 ? "Male" : "Female")</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Marriage:</span> <span
                                        class="txt-bold">@(Model.Marriage ? "Yes" : "No")</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.IdNo:</span> <span
                                        class="txt-bold">@Model.CardNo</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.IssuedDate:</span> <span class="txt-bold">
                                        @if (Model.IssuedDate != null)
                                        {
                                            var issuedDate = (DateTime)Model.IssuedDate;
                                            @issuedDate.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.IssuingAuthority:</span> <span
                                        class="txt-bold">@Model.IssuedPlace</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.PassportNo:</span> <span
                                        class="txt-bold">@Model.PassportNo</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.PassportExp:</span> <span class="txt-bold">
                                        @if (Model.PassportExp != null)
                                        {
                                            var passportExp = (DateTime)Model.PassportExp;
                                            @passportExp.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.SocialInsuranceNo:</span> <span
                                        class="txt-bold">@Model.SocialInsuranceNo</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.EducationBackground:</span>
                                    <span>@Model.EducationBackground</span>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="right-profile">
                        <div class="contact-details">
                            <div class="info-title">
                                @Labels.ContactDetails
                            </div>
                            <div class="info-body">
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Email:</span> <span><a
                                            href="mailto:@Model.Email">@Model.Email</a></span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Phone:</span> <span>@Model.Phone</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Skype:</span> <span><a
                                            href="skype:@(Model.Skype)?chat">@Model.Skype</a></span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Telegram:</span> <span><a
                                            href="ymsgr:SendIM?@(Model.Yahoo)">@Model.Yahoo</a></span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Address:</span> <span>@Model.Address</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.CurrentAddress:</span> <span
                                        class="address">@Model.CurrentAddress</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.ContactName:</span> <span>@Model.ContactName</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Relationship:</span>
                                    <span>@Model.UserRelationship</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.ContactPhone:</span>
                                    <span>@Model.ContactPhone</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.ContactAddress:</span> <span
                                        class="address">@Model.ContactAddress</span>
                                </p>
                            </div>
                        </div>
                        <div class="job-information">
                            <div class="info-title">
                                @Labels.JobInformation
                            </div>
                            <div class="info-body">
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.JobTitle:</span> <span class="txt-bold">
                                        @if (Model.JobTitle != null)
                                        {
                                            @Model.JobTitle.Name
                                        }
                                    </span>
                                </p>
	                            <p class="accinfo">
		                            <span class="label--xl">@Labels.JobGrade:</span>
		                            <span class="txt-bold tooltip"
		                                  title="@($"{Labels.EffectiveDate}: {Model.AffectedDate.ToString("dd MMM, yyyy")}")">
			                            @if (Model.JobGradeCode != null)
			                            {
				                            @Model.JobGradeCode
			                            }
		                            </span>
		                            @if (Model.JobGradeCode != null)
		                            {
                                        <a class="viewhistoryjobgrade" id="viewhistoryjobgrade" href="javascript:;" id="">
				                            <i class="mdi mdi-information-outline mdi-dark mdi-24px tooltip"
				                               title="View history"></i>
			                            </a>
		                            }
	                            </p>
	                            <p class="accinfo">
		                            <span class="label--xl">@Labels.ManagementGrade:</span>
		                            <span class="txt-bold tooltip"
                                          title="@($"{Labels.EffectiveDate}: {Model.ManagementAffectedDate.ToString("dd MMM, yyyy")}")">
			                            @if (Model.ManagementGradeCode != null)
			                            {
                                            @Model.ManagementGradeCode
			                            }
		                            </span>
                                    @if (Model.ManagementGradeCode != null)
		                            {
                                        <a class="viewhistoryjobgrade" id="viewhistorymanagementgrade" href="javascript:;" id="">
				                            <i class="mdi mdi-information-outline mdi-dark mdi-24px tooltip"
				                               title="View history"></i>
			                            </a>
		                            }
	                            </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Team:</span> <span
                                        class="txt-bold">@Model.Team.Name</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.Roles:</span> <span
                                        class="txt-bold">@Model.DisplayRoles()</span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.JoinedDate:</span> <span class="txt-bold">
                                        @if (Model.JoinedDate != null)
                                        {
                                            var date = (DateTime)Model.JoinedDate;
                                            @date.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.GroupDate:</span> <span class="txt-bold">
                                        @{
                                            var groupDate1 = (DateTime)Model.GroupDate;
                                            @groupDate1.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                <p class="accinfo">
                                    <span class="label--xl">@Labels.ConfirmedDate:</span> <span class="txt-bold">
                                        @if (Model.ConfirmedDate != null)
                                        {
                                            var date = (DateTime)Model.ConfirmedDate;
                                            @date.ToString("dd MMM, yyyy")
                                        }
                                    </span>
                                </p>
                                @if (Model.ResignedDate != null)
                                {
                                    var date = (DateTime)Model.ResignedDate;
                                    <p class="accinfo">
                                        <span class="label--xl">@Labels.LastWorkingDate:</span> <span
                                            class="txt-bold">@date.ToString("dd MMM, yyyy")</span>
                                    </p>
                                }
                            </div>
                        </div>
                        <div class="trainingAndDevelopmentsreport">
                            <div class="info-title">
                                @Labels.LearningAndDevelopment
                            </div>
                            <div class="info-body">
                                @foreach (var item in Model.TrainingAndDevelopmentTypes)
                                {
                                    var trainingAndDevelopments = Model.TrainingAndDevelopments.Where(x => x.TypeId ==
                                    item.Id).ToList();
                                    @if (trainingAndDevelopments.Count > 0)
                                    {
                                        <div class="development">
                                            <div class="boxdevelopmenttitle">
                                                @trainingAndDevelopments[0].TypeName
                                            </div>
                                            @foreach (var trainingAndDevelopment in trainingAndDevelopments)
                                            {
                                                if (trainingAndDevelopment.TypeName == InternalTraining)
                                                {
                                                    <div class="detail training">
                                                        <div class="training-name">
                                                            <span class="icon icon-star"></span>
                                                            <p class="bold ">@trainingAndDevelopment.Name</p>
                                                        </div>
                                                        <div class="display-flex">
                                                            @Labels.ConductedBy: <strong>@trainingAndDevelopment.ConductedBy</strong>
                                                        </div>
                                                        <div class="display-flex">
                                                            @Labels.StartDate: <strong>@trainingAndDevelopment.StartDate.ToString(FormatDate)</strong>
                                                        </div>
                                                        <div></div>
                                                        <p title="@trainingAndDevelopment.Publish"
                                                            class="icon icon-@trainingAndDevelopment.Publish" />
                                                    </div>
                                                }
                                                else if (trainingAndDevelopment.TypeName == Certificates)
                                                {
                                                    <div class="detail certificate">
                                                        <div class="training-name">
                                                            <span class="icon icon-star"></span>
                                                            <p class="bold">@trainingAndDevelopment.Name</p>
                                                        </div>
                                                        <div class="display-flex">
                                                            @Labels.Organization: <strong>@trainingAndDevelopment.Organization</strong>
                                                        </div>
                                                        <div class="display-flex">
                                                            @Labels.TestDate: <strong>@trainingAndDevelopment.ExamDate.ToString(FormatDate)</strong>
                                                        </div>
                                                        @if (!trainingAndDevelopment.ExpirationDate.Equals(DateTime.MinValue))
                                                        {
                                                            <div class="display-flex">
                                                                @Labels.ExpirationDate: <strong>@trainingAndDevelopment.ExpirationDate.ToString(FormatDate)</strong>
                                                            </div>
                                                        }
                                                        else {
                                                            <div></div>
                                                        }
                                                        <p title="@trainingAndDevelopment.Publish"
                                                            class=" icon icon-@trainingAndDevelopment.Publish" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="detail developmentDetail">
                                                        <div class="training-name">
                                                            <span class="icon icon-star"></span>
                                                            <p class="bold">@trainingAndDevelopment.Name</p>
                                                        </div>
                                                        <div class="display-flex">
                                                            @Labels.Organization: <strong>@trainingAndDevelopment.Organization</strong>
                                                        </div>
                                                        <div class="display-flex">
                                                            @Labels.StartDate: <strong>@trainingAndDevelopment.StartDate.ToString(FormatDate)</strong>
                                                        </div>
                                                        <div class="display-flex">
                                                            @Labels.EndDate: <strong>@trainingAndDevelopment.EndDate.ToString(FormatDate)</strong>
                                                        </div>
                                                        <p title="@trainingAndDevelopment.Publish"
                                                            class=" icon icon-@trainingAndDevelopment.Publish" />
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                }
                                @if (Model.TrainingAndDevelopments.Count == 0)
                                {
                                    <p class="no-info">@Messages.NoInformationAvailable</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
