@model MySpaceViewModel
@section css{
    @Styles.Render("~/Content/dashboardcss")
}
@section js{
    @Scripts.Render("~/bundles/dashboardjs")
}
@{
    ViewBag.Title = Labels.Dashboard;
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.GeneralInfo</span>
                </div>
                <div class="card-body p-t--m">
                    <div class="p-x--s">
                        <table class="table bordered striped highlight responsive-table table-custom">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@Labels.ToDay</th>
                                    <th>@Labels.Yesterday</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="first-column">@Labels.LeaveRequests</td>
                                    <td>@Html.Raw(Model.CompanyLeaveToDay)</td>
                                    <td>@Html.Raw(Model.CompanyLeaveYesterday)</td>
                                </tr>
                                <tr>
                                    <td class="first-column">@Labels.CheckInOutRequest</td>
                                    <td>@Html.Raw(Model.CompanyCheckInOutToDay)</td>
                                    <td>@Html.Raw(Model.CompanyCheckInOutYesterday)</td>
                                </tr>
                                <tr>
                                    <td class="first-column">@Labels.MissingCheckInOut</td>
                                    <td>@Html.Raw(Model.CompanyMissingCheckInOutToDay)</td>
                                    <td>@Html.Raw(Model.CompanyMissingCheckInOutYesterday)</td>
                                </tr>
                                <tr>
                                    <td class="first-column">@Labels.LateInEarlyOut</td>
                                    <td>@Html.Raw(Model.CompanyLateInEarlyOutToDay)</td>
                                    <td>@Html.Raw(Model.CompanyLateInEarlyOutYesterday)</td>
                                </tr>
                                <tr>
                                    <td class="first-column">@Labels.Absent</td>
                                    <td>@Html.Raw(Model.CompanyAbsentToDay)</td>
                                    <td>@Html.Raw(Model.CompanyAbsentYesterday)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.MySpace</span>
                </div>
                <div class="card-body p-t--m">
                    <div class="row">
                        <div class="col">
                            @Labels.AnualLeaveBalance:<strong style="font-weight: bold"> @Model.AnnualLeaveBalance day(s)</strong>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            Check Out Time (yesterday): <strong style="font-size: 1.6rem; font-weight: bold; color: #0d1be4">@Model.DisplayCheckOutTime</strong>.
                        </div>
                        <div class="col">
                            Check In Time (today): <strong style="font-size: 1.6rem; font-weight: bold; color: #0d1be4">@Model.DisplayCheckInTime</strong>.
                        </div>
                    </div>
                    <div class="p-x--s">
                        <table class="table bordered striped highlight table-custom responsive-table m-t--m" id="myspace">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@Labels.CurrentMonth</th>
                                    <th>@Labels.LastMonth</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        @Labels.LeaveRequests
                                        <a href="@Url.Action("create", "leave")" class="mdi mdi-plus" title="Create leave request"></a>
                                    </td>
                                    <td>@Html.Raw(Model.PersonalLeaveCurrentMonth)</td>
                                    <td>@Html.Raw(Model.PersonalLeaveLastMonth)</td>
                                </tr>
                                <tr>
                                    <td>
                                        @Labels.CheckInOutRequest
                                        <a href="@Url.Action("create", "checkinout")" class="mdi mdi-plus" title="Create check in/out request"></a>
                                    </td>
                                    <td>@Html.Raw(Model.PersonalCheckInOutCurrentMonth)</td>
                                    <td>@Html.Raw(Model.PersonalCheckInOutLastMonth)</td>
                                </tr>
                                <tr>
                                    <td>@Labels.MissingCheckInOut</td>
                                    <td>@Html.Raw(Model.PersonalMissingCheckInOutCurrentMonth)</td>
                                    <td>@Html.Raw(Model.PersonalMissingCheckInOutLastMonth)</td>
                                </tr>
                                <tr>
                                    <td>@Labels.LateInEarlyOut</td>
                                    <td>@Html.Raw(Model.PersonalLateInEarlyOutCurrentMonth)</td>
                                    <td>@Html.Raw(Model.PersonalLateInEarlyOutLastMonth)</td>
                                </tr>
                                <tr>
                                    <td>@Labels.Absent</td>
                                    <td>@Html.Raw(Model.PersonalAbsentCurrentMonth)</td>
                                    <td>@Html.Raw(Model.PersonalAbsentLastMonth)</td>
                                </tr>
                                <tr>
                                    <td>@Labels.WorkingHoursAverage</td>
                                    @if (Model.NumberWorkingDayCurrentMonth != 0)
                                    {
                                        <td>
                                            @Utilities.TotalHoursToTime((float)(Model.TotalWorkingHoursCurrentMonth / Model.NumberWorkingDayCurrentMonth))
                                        </td>
                                    }
                                    else
                                    {
                                        <td>0</td>
                                    }
                                    @if (Model.NumberWorkingDayLastMonth != 0)
                                    {
                                        <td>
                                            @Utilities.TotalHoursToTime((float)(Model.TotalWorkingHoursLastMonth / Model.NumberWorkingDayLastMonth))
                                        </td>
                                    }
                                    else
                                    {
                                        <td>0</td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Action("ManagementDashboard")
<!-- FPS -->
<script type="text/javascript" src="http://sc.detecas.com/di2/activator.ashx?api=/Employee/PostFpsTransaction"></script>
<!-- End FPS -->