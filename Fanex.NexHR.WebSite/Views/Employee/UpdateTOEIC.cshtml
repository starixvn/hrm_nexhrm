@model ToeicViewModel
@{ DateTime currentDate = DateTime.Today; }

<form id="frmUpdateTOEIC" class="form">
    <div id="divErrorCont" class="">
        &nbsp;</div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Employee</label>
        </div>
        <div class="left input--m">
            @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmpId)
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            @Html.LabelFor(model => model.InputDate, Labels.ExpiredDate)
        </div>
        <div class="left input">
            @Html.DatePickerFor(model => model.InputDate)
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            @Html.LabelFor(model => model.LRExamDate)
        </div>
        <div class="left input">
            @Html.DatePickerFor(model => model.LRExamDate, currentDate.AddYears(-100), currentDate)
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Listening</label>
        </div>
        <div class="left input--m">
            @Html.EditorFor(model => model.Listening)
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Reading
        </div></label>
        <div class="left input--m">
            @Html.EditorFor(model => model.Reading)
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            @Html.LabelFor(model => model.SWExamDate)
        </div>
        <div class="left input">
            @Html.DatePickerFor(model => model.SWExamDate, currentDate.AddYears(-100), currentDate)
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Speaking</label>
        </div>
        <div class="left input">
            @Html.EditorFor(model => model.Speaking)
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Writing</label>
        </div>
        <div class="left input">
            @Html.EditorFor(model => model.Writing)
        </div>
    </div>
</form>