@model Fanex.NexHR.ViewModels.CreateEmployeeViewModel
@{
    ViewBag.Title = "Create account";
}
@section css {
}
@section js {
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm()) {
                        <div class="form">
                            @Html.ValidationSummary(true)                                
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FullName)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.FullName)
                                        @Html.ValidationMessageFor(model => model.FullName)
                                    </div>                                    
                                </div>                                
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.NickName)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.NickName)
                                        @Html.ValidationMessageFor(model => model.NickName)
                                    </div>     
                                </div>                                                               
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.DomainUsername)                                        
                                    </div>

                                    <div class="left label--s">
                                        <label><strong>@System.Configuration.ConfigurationManager.AppSettings["domain"]</strong></label>
                                    </div>

                                    <div class="left input-spvn">                                        
                                        @Html.EditorFor(model => model.DomainUsername)
                                        @Html.ValidationMessageFor(model => model.DomainUsername)
                                    </div>
                                </div>                                
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Code)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Code)
                                        @Html.ValidationMessageFor(model => model.Code)
                                    </div>
                                </div>                                
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.TeamId)
                                    </div>
                                    <div class="left select--l">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(ViewBag.TeamList, "Id", "Name"))
                                    </div>
                                </div>                                
                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>Working schedule</label>
                                    </div>
                                    <div class="left">                                        
                                        <div class="col">
                                            <label>Sun</label><br />
                                            @RazorHelper.ShiftDropDownList("SunShift", Model.SunShift, (IList<SelectListItem>)ViewBag.Shifts)
                                        </div>
                                        <div class="col">
                                            <label>Mon</label><br />
                                            @RazorHelper.ShiftDropDownList("MonShift", Model.MonShift, (IList<SelectListItem>)ViewBag.Shifts)
                                        </div>
                                        <div class="col">
                                            <label>Tue</label><br />
                                            @RazorHelper.ShiftDropDownList("TueShift", Model.TueShift, (IList<SelectListItem>)ViewBag.Shifts)
                                        </div>
                                        <div class="col">
                                            <label>Wed</label><br />
                                            @RazorHelper.ShiftDropDownList("WedShift", Model.WedShift, (IList<SelectListItem>)ViewBag.Shifts)
                                        </div>
                                        <div class="col">
                                            <label>Thu</label><br />
                                            @RazorHelper.ShiftDropDownList("ThuShift", Model.ThuShift, (IList<SelectListItem>)ViewBag.Shifts)
                                        </div>
                                        <div class="col">
                                            <label>Fri</label><br />
                                            @RazorHelper.ShiftDropDownList("FriShift", Model.FriShift, (IList<SelectListItem>)ViewBag.Shifts)
                                        </div>
                                        <div class="col">
                                            <label>Sat</label><br />
                                            @RazorHelper.ShiftDropDownList("SatShift", Model.SatShift, (IList<SelectListItem>)ViewBag.Shifts)
                                        </div>                                        
                                    </div>
                                </div>                                
                            </div>

                            <div class="row form-input">                                
                                <div class="col">
                                    <span class="button-hrm waves-effect waves-light btn blue darken-2"><input type="submit" value="Next" /></span>
                                </div>
                            </div>
                        </div>
                    }                   
                </div>
            </div>
        </div>
    </div>
</div>

