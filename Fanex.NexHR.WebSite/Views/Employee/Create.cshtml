@model CreateEmployeeViewModel
@{
    ViewBag.Title = Labels.CreateAccount;
}
@section css {
    @Styles.Render("~/Content/view-mobile")
}
@section js {
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        @using (Html.BeginForm())
                        {
                            @Html.ValidationSummary()
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.FullName, Labels.FullName)
                                    </div>
                                    <div class="col left input--l">
                                        @Html.EditorFor(model => model.FullName)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.NickName, Labels.NickName)
                                    </div>
                                    <div class="col left input--l">
                                        @Html.EditorFor(model => model.NickName)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.DomainUsername, Labels.DomainUsername)
                                    </div>
                                    <div class="left label--s">
                                        <label><strong>@System.Configuration.ConfigurationManager.AppSettings["domain"]</strong></label>
                                    </div>
                                    <div class="left input-spvn">
                                        @Html.EditorFor(model => model.DomainUsername)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.Code, Labels.Code)
                                    </div>
                                    <div class="col left input--l">
                                        @Html.EditorFor(model => model.Code)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        @Html.LabelFor(model => model.TeamId, Labels.Team)
                                    </div>
                                    <div class="col left select--l">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"))
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--xl">
                                        <label>@Labels.WorkingSchedule</label>
                                    </div>
                                    <div class="left">
                                        <div class="col">
                                            <label class="label--s">@Labels.Sun</label>
                                            <div class="select--xs">@Html.DropDownListFor(model => model.SunShift, new SelectList(Model.Shifts, "Id", "Name"), Labels.Off)</div>
                                        </div>
                                        <div class="col">
                                            <label class="label--s">@Labels.Mon</label>
                                            <div class="select--xs">@Html.DropDownListFor(model => model.MonShift, new SelectList(Model.Shifts, "Id", "Name"), Labels.Off)</div>
                                        </div>
                                        <div class="col">
                                            <label class="label--s">@Labels.Tue</label>
                                            <div class="select--xs">@Html.DropDownListFor(model => model.TueShift, new SelectList(Model.Shifts, "Id", "Name"), Labels.Off)</div>
                                        </div>
                                        <div class="col">
                                            <label class="label--s">@Labels.Wed</label>
                                            <div class="select--xs">@Html.DropDownListFor(model => model.WedShift, new SelectList(Model.Shifts, "Id", "Name"), Labels.Off)</div>
                                        </div>
                                        <div class="col">
                                            <label class="label--s">@Labels.Thu</label>
                                            <div class="select--xs">@Html.DropDownListFor(model => model.ThuShift, new SelectList(Model.Shifts, "Id", "Name"), Labels.Off)</div>
                                        </div>
                                        <div class="col">
                                            <label class="label--s">@Labels.Fri</label>
                                            <div class="select--xs">@Html.DropDownListFor(model => model.FriShift, new SelectList(Model.Shifts, "Id", "Name"), Labels.Off)</div>
                                        </div>
                                        <div class="col">
                                            <label class="label--s">@Labels.Sat</label>
                                            <div class="select--xs">@Html.DropDownListFor(model => model.SatShift, new SelectList(Model.Shifts, "Id", "Name"), Labels.Off)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m col-btn">
                                    <div class="left label--xl">&nbsp;</div>
                                    <div class="left col">
                                        <input class="btn-submit waves-effect waves-light" type="submit" value="@Labels.Next" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

