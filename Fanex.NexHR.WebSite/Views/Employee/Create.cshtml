@model Fanex.NexHR.ViewModels.CreateEmployeeViewModel
@{
    ViewBag.Title = Labels.CreateAccount;
}
@section css {
}
@section js {
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm()) {
                        <div class="form">
                            @Html.ValidationSummary(true)
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FullName, Labels.FullName)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.FullName)
                                    </div>
                                </div>
                                <div class="col">
                                    @Html.ValidationMessageFor(model => model.FullName)
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.NickName, Labels.NickName)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.NickName)
                                    </div>
                                </div>
                                <div class="col">
                                    @Html.ValidationMessageFor(model => model.NickName)
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.DomainUsername, Labels.DomainUsername)
                                    </div>
                                    <div class="left label--s">
                                        <label><strong>@System.Configuration.ConfigurationManager.AppSettings["domain"]</strong></label>
                                    </div>
                                    <div class="left input-spvn">
                                        @Html.EditorFor(model => model.DomainUsername)
                                    </div>
                                </div>
                                <div class="col">
                                    @Html.ValidationMessageFor(model => model.DomainUsername)
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Code, Labels.Code)
                                    </div>
                                    <div class="left input--l">
                                        @Html.EditorFor(model => model.Code)
                                    </div>
                                </div>
                                <div class="col">
                                    @Html.ValidationMessageFor(model => model.Code)
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.TeamId, Labels.Team)
                                    </div>
                                    <div class="left select--l">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"))
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>@Labels.WorkingSchedule</label>
                                    </div>
                                    <div class="left">
                                        <div class="col">
                                            <label>@Labels.Sun</label><br />
                                            @Html.DropDownListFor(model => model.SunShift, Model.Shifts, Labels.Off)
                                        </div>
                                        <div class="col">
                                            <label>@Labels.Mon</label><br />
                                            @Html.DropDownListFor(model => model.MonShift, Model.Shifts, Labels.Off)
                                        </div>
                                        <div class="col">
                                            <label>@Labels.Tue</label><br />
                                            @Html.DropDownListFor(model => model.TueShift, Model.Shifts, Labels.Off)
                                        </div>
                                        <div class="col">
                                            <label>@Labels.Wed</label><br />
                                            @Html.DropDownListFor(model => model.WedShift, Model.Shifts, Labels.Off)
                                        </div>
                                        <div class="col">
                                            <label>@Labels.Thu</label><br />
                                            @Html.DropDownListFor(model => model.ThuShift, Model.Shifts, Labels.Off)
                                        </div>
                                        <div class="col">
                                            <label>@Labels.Fri</label><br />
                                            @Html.DropDownListFor(model => model.FriShift, Model.Shifts, Labels.Off)
                                        </div>
                                        <div class="col">
                                            <label>@Labels.Sat</label><br />
                                            @Html.DropDownListFor(model => model.SatShift, Model.Shifts, Labels.Off)
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <input class="btn-submit waves-effect waves-light" type="submit" value="Next" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

