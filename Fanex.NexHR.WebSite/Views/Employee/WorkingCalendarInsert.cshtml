@model InsertEmployeeCalendarViewModel
@{
    ViewBag.Title = Labels.MultipleInsert;
}
<form class="form">
<div class="row form-input">
    <div class="left label--m">
        @Html.LabelFor(model => model.FromDate)
    </div>
    <div class="left datepicker-button select--s">
        @Html.DatePickerFor(model => model.FromDate)
        <i class="mdi-action-event calendar-icon left"></i>
    </div>
</div>
<div class="row form-input">
    <div class="left label--m">
        @Html.LabelFor(model => model.ToDate)
    </div>
    <div class="left datepicker-button select--s">
        @Html.DatePickerFor(model => model.ToDate)
        <i class="mdi-action-event calendar-icon left"></i>
    </div>
</div>
<div class="row form-input">
    <div class="left label--m">
        @Html.LabelFor(model => model.Employee)
    </div>
    <div class="left input--m">
        @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
        @Html.HiddenFor(model => model.EmployeeId)
    </div>
</div>
<div class="row form-input">
    <span class="btn-ok waves-effect waves-light m-r--m">
        <input id="btnAdd" type="submit" value="@Labels.Add" />
    </span><span class="btn-cancel waves-effect waves-light m-r--m">
        <input id="btnCancel" type="button" value="@Labels.Cancel" />
    </span>
</div>
</form>
