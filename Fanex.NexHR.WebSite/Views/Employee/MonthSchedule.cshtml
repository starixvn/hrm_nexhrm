@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Employee
@model MonthlyScheduleViewModel
@if (Model.EmployeeId > 0)
{
    ViewBag.Title = "Month schedule of " + Model.EmployeeNickName;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/fullcalendar.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/mycalendar.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/moment.js" asp-append-version="true"></script>
        <script src="~/js/Libs/fullcalendar.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/employee.monthschedule.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/fullcalendar.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/monthschedule.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                @if (Model.EmployeeId > 0)
                {
                    @Html.HiddenFor(model => model.EmployeeId)
                    <div class="card-title-block">
                        <span class="card-title left">@ViewBag.Title</span>
                    </div>
                    <div class="card-body">
                        <div class="form">
                            <div class="row form-input">
                                <div class="col">
                                    <input id="defaultschedule" class="with-gap" type="radio" name="defaultschedule" />
                                    <label class="m-r--m" for="defaultschedule">@Labels.DefaultWorkingSchedule</label>
                                    <input id="monthschedule" class="with-gap" type="radio" name="monthschedule" checked="checked" />
                                    <label class="m-r--m" for="monthschedule">@Labels.EditByMonth</label>
                                </div>
                            </div>
                        </div>
                        <div class="p-x--s">
                            <div id="calendar" class="schedule">
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-title-block">
                        <span class="card-title left">@Messages.NoDataIsAvailable</span>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="row hide">
        <div id="dialog" title="Update shift">
            <div class="form">
                <div class="row form-input m-b--m">
                    <div class="left label--l">
                        @Html.Label("Current Shift")
                    </div>
                    <div class="left">
                        <span id="current"></span>
                    </div>
                </div>
                <div class="row form-input">
                    <div class="left label--l">
                        @Html.LabelFor(model => model.ShiftId, "Change To")
                    </div>
                    <div class="left input--s">
                        @Html.DropDownListFor(model => model.ShiftId, new SelectList(Model.Shifts, "Id", "Name"), Labels.Off)
                    </div>
                </div>
                <div class="row">
                    <input type="submit" id="update" class="btn-submit waves-effect waves-light" value="@Labels.Update" />
                </div>
            </div>
        </div>
    </div>
</div>