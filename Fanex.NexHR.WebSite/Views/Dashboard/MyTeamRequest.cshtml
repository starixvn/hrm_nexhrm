@model TeamRequestViewModel
<div class="col s12 card-container-base my-request">
    <div class="card">
        <div class="card-content">
            <div class="card-title-block">
                <span class="card-title txt-uppercase left">MY TEAM REQUEST</span>
            </div>
            <div class="card-body">
                <div class="form">
                    <div class="row form-input">
                         <div class="col m-r--l">
                            <div class="left label--m">
                                <label>
                                    Date range</label></div>
                            <div class="left select--s">
                                @RazorHelper.DateRangeDropDownList("Date", Model.DateRange)
                                @Html.Hidden("DateOption", Model.DateRange)
                            </div>
                        </div>
                         <div class="col m-r--l">
                            <div class="left label--m">
                                <label>
                                    From date</label></div>
                            <div class="datepicker-button select--s left">
                                @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1))
                                <i class="mdi-action-event calendar-icon left"></i>
                            </div>
                        </div>
                        <div class="col m-l--xl m-r--l">
                            <div class="left label--m">
                                <label>
                                    To date</label></div>
                            <div class="datepicker-button select--s left">
                                @Html.DatePickerFor(model => model.ToDate)
                                <i class="mdi-action-event calendar-icon left"></i>
                            </div>
                        </div>
                    </div>
                    <div class="row form-input">
                        <div class="col m-r--l">
                            <div class="left label--m">
                                <label>
                                    Status</label></div>
                            <div class="left select--s">
                                @RazorHelper.StatusDropDownList(Model.StatusId, controlName: "statusId")
                            </div>
                        </div>
                        <div class="col m-r--l">
                            <div class="left label--m">
                                <label>
                                    Team</label></div>
                            <div class="left select-team">
                                @Html.DropDownList("TeamId", Model.GetSelectListItemTeam(Model.TeamId))
                            </div>
                        </div>
                        <div class="col">
                            <div class="left label--m">
                                <label>
                                    Employee</label></div>
                            <div class="left input--s">
                                @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                @Html.HiddenFor(model => model.EmployeeId)
                            </div>
                        </div>
                        <div class="col button">
                            <a class="btn-request waves-effect waves-light m-r--m m-l--s">Submit</a>
                            <a class="btn-submit waves-effect waves-light">Leave Request</a>
                        </div>                        
                    </div>
                </div>
