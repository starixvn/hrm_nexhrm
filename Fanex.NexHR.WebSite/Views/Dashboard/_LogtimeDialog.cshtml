@using Fanex.NexHR.Core.Enums
@model Fanex.NexHR.Models.RedmineAPI.LogTimeIssue
@using Fanex.NexHR.Core

<form id="formLogtime" class="form">

    <input type="hidden" asp-for="IssueId"/>

    <div class="row form-input">
        <div class="left label--m">
            <label>Spent On</label>
        </div>
        <div class="left datepicker-button select--m">
            <date-picker name="SpentOn" max-date="DateTimeOffset.Now.DateTime.ToClientTimeZone()" value="DateTimeOffset.Now.DateTime.ToClientTimeZone()"></date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
            <p class="bold total-hour-message"></p>
            <span asp-validation-for="SpentOn"></span>
        </div>
    </div>

    <div class="row form-input">
        <div class="left label--m">
            <label>Hours</label>
        </div>
        <div class="left select--m">
            <input asp-for="Hours"/>
            <span asp-validation-for="Hours"></span>
        </div>
    </div>

    <div class="row form-input">
        <div class="left label--m">
            <label>Activity</label>
        </div>
        <div class="left select--m">
            <select asp-for="Activity" Id="Activity" name="Activity" asp-items="Html.GetEnumSelectList<RedmineLogTimeActivity>()"></select>
        </div>
    </div>

    <div class="row form-input">
        <div class="left label--m">
            <label>Comments</label>
        </div>
        <div class="left select--m">
            <textarea asp-for="Comments" class="comment" rows="3"></textarea>
            <span asp-validation-for="Comments"></span>
        </div>
    </div>
</form>