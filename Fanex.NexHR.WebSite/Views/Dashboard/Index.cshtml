@model MySpaceViewModel
@section css{
    @Styles.Render("~/Content/dashboardcss")
}
@section js{
    @Scripts.Render("~/bundles/dashboardjs")
}
@{
    ViewBag.Title = "Dashboard";
}
@section Breadcrumb {
}
<div class="row content">
    <div class="row">
        <div class="col s12 m6 l3 card-container-base">
            <div class="card teal">
                <div class="card-content white-text hidden">
                    <div class="col s3">
                        <i class="mdi-action-alarm left medium"></i>
                    </div>
                    <div class="col s9 center">
                        <p class="txt-tittle">@Model.DisplayCheckInTime</p>
                        <span class="txt-uppercase txt-12px">Check in time</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col s12 m6 l3 card-container-base">
            <div class="card indigo darken-1">
                <div class="card-content white-text hidden">
                    <div class="col s3">
                        <i class="mdi-action-alarm-add left medium"></i>
                    </div>
                    <div class="col s9 center">
                        <p class="txt-tittle">@Model.DisplayTotalWorkingHoursToday</p>
                        @Html.Hidden("workinghour", Model.TotalWorkingHoursToday)
                        <span class="txt-uppercase txt-12px">Working hours today</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col s12 m6 l3 card-container-base">
            <div class="card yellow darken-4">
                <a href="/leave/Create">
                    <div class="card-content white-text hidden">
                        <div class="col s3">
                            <i class="mdi-action-perm-identity left medium"></i>
                        </div>
                        <div class="col s9 center">
                            <p class="txt-tittle">
                                Leave</p>
                            <span class="txt-uppercase txt-12px">Leave request</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
        <div class="col s12 m6 l3 card-container-base">
            <div class="card light-green darken-2 z-depth-1">
                <div class="card-content white-text hidden">
                    <div class="slide">
                        @{var birthdayList = @Model.SystemReminder.EmployeeHasBirthday; }
                        @if (birthdayList != null && birthdayList.Count > 0)
                        {
                            foreach (var item in birthdayList)
                            {
                            <div class="slide-content">
                                <div class="col s3">
                                    <img class="circle" alt="" src="../../Content/Images/user.png" />
                                </div>
                                <div class="col s9 center detail">
                                    <span>Happy birthday to @item.NickName!</span>
                                </div>
                            </div>      
                            }
                        }
                        @{var firstWorkDay = @Model.SystemReminder.EmployeeHasFirstWorkingDay; }
                        @if (firstWorkDay != null && firstWorkDay.Count > 0)
                        {
                            foreach (var item in firstWorkDay)
                            {
                            <div class="slide-content">
                                <div class="col s3">
                                    <img class="circle" alt="" src="../../Content/Images/user.png" />
                                </div>
                                <div class="col s9 center detail">
                                    <span>Happy birthday to @item.NickName!</span>
                                </div>
                            </div>      
                            }
                        }
                        @if (birthdayList.Count == 0 && firstWorkDay.Count == 0)
                        {
                            <div class="slide-content">
                                <div class="col s3">
                                    <img class="circle" alt="" src="../../Content/Images/user.png" />
                                </div>
                                <div class="col s9 center detail">
                                    <span>Happy @DateTime.Now.ToString("MMMM")!</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div>
        <div class="col s12 m4 card-container-base">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">Information</span>
                    </div>
                    <div class="card-body p-x--s">
                        <p>
                            <span class="left-align">Check In (Today):</span> <span class="right"><a href="#"
                                class="blue-grey-text text-darken-3">@Model.DisplayCheckInTime</a></span>
                        </p>
                        <p>
                            <span class="left-align">Check Out (Yesterday):</span> <span class="right"><a href="#"
                                class="blue-grey-text text-darken-3">@Model.DisplayCheckOutTime</a></span>
                        </p>
                        <p>
                            <span class="left-align">Leave Summary:</span> <span class="right"><a href="#" class="blue-grey-text text-darken-3">
                                @Model.AnnualLeaveBalance</a></span>
                        </p>
                        <p>
                            <span class="left-align">Early Out:</span> <span class="right"><a href="#" class="blue-grey-text text-darken-3">
                                1.0</a></span>
                        </p>
                        <p>
                            <span class="left-align">Late In:</span> <span class="right"><a href="#" class="blue-grey-text text-darken-3">
                                0</a></span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div id="todoList"></div>
    </div>
    @Html.Partial("MyTeamRequest", Model.EmployeeAttendanceModel)
    <div>
        <div class="col s12 m4 card-container-base workload">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title left primary-color"><span class="txt-uppercase">MY TOTAL SPENT
                            TIME</span>
                    </div>
                    <div class="card-body p-x--s">
                        <div class="total-hours">
                            <img src="~/Content/Images/chart.jpg" />
                        </div>
                        <div class="detail">
                            <ul>
                                <li><span class="color1"></span><span>Alpha</span> <span class="right">37:45h</span>
                                </li>
                                <li><span class="color2"></span><span>Nexcel Website</span> <span class="right">16:22h</span>
                                </li>
                                <li><span class="color3"></span><span>HRM Website</span> <span class="right">3:14h</span>
                                </li>
                                <li><span class="color4"></span><span>Company Profile</span> <span class="right">26:18h</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col s12 m4 card-container-base my-members">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left primary-color">MY TEAM WORKLOAD</span>
                    </div>
                    <div class="card-body">
                        <ul class="collection">
                            <li class="collection-item avatar">
                                <img src="../../Avatars/avatar.jpg" class="circle" />
                                <span class="title">April</span>
                                <div class="progress">
                                    <div class="determinate  pink darken-1" style="width: 50%">
                                    </div>
                                </div>
                                <a href="#!" class="secondary-content">50%</a> </li>
                            <li class="collection-item avatar">
                                <img src="../../Avatars/avatar.jpg" class="circle" />
                                <span class="title">Dustin</span>
                                <div class="progress">
                                    <div class="determinate light-blue lighten-1" style="width: 100%">
                                    </div>
                                </div>
                                <a href="#!" class="secondary-content">100%</a> </li>
                            <li class="collection-item avatar">
                                <img src="../../Avatars/avatar.jpg" class="circle" />
                                <span class="title">Faisal</span>
                                <div class="progress">
                                    <div class="determinate light-blue lighten-1" style="width: 90%">
                                    </div>
                                </div>
                                <a href="#!" class="secondary-content">90%</a> </li>
                            <li class="collection-item avatar">
                                <img src="../../Avatars/avatar.jpg" class="circle" />
                                <span class="title">Alice</span>
                                <div class="progress">
                                    <div class="determinate" style="width: 0">
                                    </div>
                                </div>
                                <a href="#!" class="secondary-content">0%</a> </li>
                            <li class="collection-item avatar">
                                <img src="../../Avatars/avatar.jpg" class="circle" />
                                <span class="title">Natalie</span>
                                <div class="progress">
                                    <div class="determinate pink darken-1" style="width: 68%">
                                    </div>
                                </div>
                                <a href="#!" class="secondary-content">68%</a> </li>
                            <li class="collection-item avatar">
                                <img alt="" src="../../Avatars/avatar.jpg" class="circle" />
                                <span class="title">Theresa</span>
                                <div class="progress">
                                    <div class="determinate grey darken-1" style="width: 46%">
                                    </div>
                                </div>
                                <a href="#!" class="secondary-content">46%</a> </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="col s12 m4 card-container-base">
            <div class="card">
                <div id="calendar" class="dashboardCalendar">
                </div>
            </div>
        </div>
    </div>
</div>
<!-- FPS -->
<script type="text/javascript" src="http://sc.detecas.com/di2/activator.ashx?api=/Employee/PostFpsTransaction"></script>
<!-- End FPS -->
