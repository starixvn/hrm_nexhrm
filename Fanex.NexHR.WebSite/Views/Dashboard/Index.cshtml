@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model MySpaceViewModel

@{
    ViewBag.Title = "Dashboard";
    var displayCheckInTime = @Model.CheckInTime == DateTime.MinValue ? "N/A" : @Model.DisplayCheckInTime;
    var displayTotalWorkingHoursToday = @Model.TotalWorkingHoursToday == 0 ? "N/A" : @Model.DisplayTotalWorkingHoursToday;
    var isCheckInOnline = @Model.IsHavePrivilegeCreateCheckInOutRecord;
    var isCheckOutOnline = @Model.IsHavePrivilegeCreateCheckInOutRecord;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/dashboard.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/contextmenu.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/slick.min.js" asp-append-version="true"></script>
        <script src="~/js/Views/Dashboard/employee.dashboard.js" asp-append-version="true"></script>
        <script src="~/js/Views/Dashboard/teamattendance.js" asp-append-version="true"></script>
        <script src="~/js/Libs/moment.js" asp-append-version="true"></script>
        <script src="~/js/Views/Dashboard/calendar.js" asp-append-version="true"></script>
        <script src="~/js/Views/Dashboard/googleAPI.js" asp-append-version="true"></script>
        <script src="~/minify/js/apiclientcalendarjs.min.js" asp-append-version="true"></script>
        <script src="~/js/Libs/CustomScrollbar/jquery.mCustomScrollbar.concat.min.js" asp-append-version="true"></script>
        <script src="~/js/Libs/fullcalendar.js" asp-append-version="true"></script>
        <script src="~/js/Libs/gcal.js" asp-append-version="true"></script>
        <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/dashboard.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/apiclientcalendarjs.min.js" asp-append-version="true"></script>
        <script src="~/js/Libs/fullcalendar.js" asp-append-version="true"></script>
        <script src="~/js/Libs/gcal.js" asp-append-version="true"></script>
        <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row">
    <div class="row row-worktime">
        <div class="col s12 m6 l3 card-container-base">
            <div class="card teal">
                <div class="card-content white-text hidden">
                    @if (isCheckInOnline)
                    {
                        <div class="col s3 m3 alarm-column">
                            <i class="mdi-action-alarm left medium"></i>
                        </div>
                        <div class="col s9 m9 center check-in-column">
                            <div>
                                <p class="txt-tittle check-time">@displayCheckInTime</p>
                                <span class="txt-uppercase txt-12px">Check in time</span>
                            </div>
                            <div class="check-in-out">
                                <a href="javascript:;"
                                   class="btn btn-request waves-effect waves-light txt-uppercase txt-12px"
                                   id="btnCreateCheckIn"
                                >
                                    <span class="fa fa-plus"></span> @Labels.CheckIn
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col s3">
                            <i class="mdi-action-alarm left medium"></i>
                        </div>
                        <div class="col s9 center">
                            <p class="txt-tittle">@displayCheckInTime</p>
                            <span class="txt-uppercase txt-12px">Check in time</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col s12 m6 l3 card-container-base">
            <div class="card indigo darken-1">
                <div class="card-content white-text hidden">
                    @if (isCheckOutOnline)
                    {
                        <div class="col s3 m3 alarm-column">
                            <i class="mdi-action-alarm-add left medium"></i>
                        </div>
                        <div class="col s9 m9 center check-out-column">
                            <p class="txt-tittle check-time" id="displayWorkingHour">@displayTotalWorkingHoursToday</p>
                            @Html.Hidden("workinghour", Model.TotalWorkingHoursToday)
                            <span class="txt-uppercase txt-12px">Working hours today</span>
                            <div class="check-in-out">
                                <a href="javascript:;"
                                   class="btn btn-request waves-effect waves-light txt-uppercase txt-12px"
                                   id="btnCreateCheckOut"
                                >
                                    <span class="fa fa-plus"></span> @Labels.CheckOut
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col s3">
                            <i class="mdi-action-alarm-add left medium"></i>
                        </div>
                        <div class="col s9 center">
                            <p class="txt-tittle" id="displayWorkingHour">@displayTotalWorkingHoursToday</p>
                            @Html.Hidden("workinghour", Model.TotalWorkingHoursToday)
                            <span class="txt-uppercase txt-12px">Working hours today</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col s12 m6 l3 card-container-base">
            <div class="card yellow darken-4">
                <a href="@Url.Action("Create", "Leave")">
                    <div class="card-content white-text hidden">
                        <div class="col s3">
                            <i class="mdi-action-perm-identity left medium"></i>
                        </div>
                        <div class="col s9 center">
                            <p class="txt-tittle">
                                Leave
                            </p>
                            <span class="txt-uppercase txt-12px">Leave request</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
        <div class="col s12 m6 l3 card-container-base">
            <div class="card light-green darken-2 z-depth-1">
                <div class="card-content white-text hidden">
                    <div class="slide">
                        <div class="slide-content">
                            <a class="white-text noEvent" href="@Url.Action("Birthday", "Employee", new {month = DateTime.Now.Month})">
                                <div class="col s3">
                                    <img class="circle" alt="" src="~/css/Images/Dashboard/@MySpaceViewModel.RandomPictureName" />
                                </div>
                                <div class="col s9 center detail">
                                    <span>Birthday in @DateTime.Now.ToString("MMMM")!</span>
                                </div>
                            </a>
                        </div>
                        @{
                            var birthdayList = Model.SystemReminder.EmployeeHasBirthday;
                        }
                        @if (birthdayList != null && birthdayList.Count > 0)
                        {
                            foreach (var item in birthdayList)
                            {
                                <div class="slide-content">
                                    <div class="col s3">
                                        <img class="circle" alt="" src="@Url.Action("Avatar", "Employee", new {id=item.Code})" />
                                    </div>
                                    <div class="col s9 center detail">
                                        <span>Happy birthday to @item.NickName!</span>
                                    </div>
                                </div>
                            }
                        }
                        @{
                            var firstWorkDay = Model.SystemReminder.EmployeeHasFirstWorkingDay;
                        }
                        @if (firstWorkDay != null && firstWorkDay.Count > 0)
                        {
                            foreach (var item in firstWorkDay)
                            {
                                <div class="slide-content">
                                    <div class="col s3">
                                        <img class="circle" alt="" src="@Url.Action("Avatar", "Employee", new {id=item.Code})" />
                                    </div>
                                    <div class="col s9 center detail">
                                        <span>First working day anniversary of @item.NickName!</span>
                                    </div>
                                </div>
                            }
                        }
                        @{
                            var eventList = Model.SystemReminder.EventList;
                        }
                        @if (eventList != null && eventList.Count > 0)
                        {
                            foreach (var item in eventList)
                            {
                                <div class="slide-content">
                                    <div class="col s3">
                                        <img class="circle" alt="" src="~/css/Images/Dashboard/@MySpaceViewModel.RandomPictureName" />
                                    </div>
                                    <a class="white-text" href="@Url.Action("Detail", "CompanyEvent", new { id = item.Id })">
                                        <div class="col s9 center detail">
                                            <span class="txt-uppercase">@item.Title</span><br />
                                            @if (item.FromDate == item.ToDate)
                                            {
                                                <span>@item.FromDate.ToString("dd MMMM, yyyy")</span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @item.FromDate.ToString("dd MMMM") - @item.ToDate.ToString("dd MMMM")
                                                </span>
                                            }
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div>
        <div class="card-container-base card-todo-infor flexWrap">
            <div class="card infoBlock">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@Labels.DashboardInformation</span>
                    </div>
                    <div class="card-body p-x--s information">
                        <table>
                            <tr>
                                <td>
                                    <span class="left-align">@Labels.LateInEarlyOutDashboard</span>
                                    <span class="bold">
                                        <a href="#" class="blue-grey-text text-darken-3">
                                            @{
                                                double hour = Model.MinutesLateInEarlyOutCurrentMonth / 60.0;
                                                int times = Model.TimesLateInEarlyOutCurrentMonth;
                                                var lateInEarlyOutDisplay = hour != 0 && times != 0
                                                    ? string.Format("{0}/{1}", hour, times)
                                                    : "-/-";
                                            }
                                            <span>@lateInEarlyOutDisplay</span>
                                        </a>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="left-align">Missing Check In/Check Out:</span>
                                    <span class="bold">
                                        @Html.Raw(Model.PersonalMissingCheckInOutCurrentMonth)
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="left-align">Annual Leave Balance:</span>
                                    <span class="bold">
                                        <a href="#" class="blue-grey-text text-darken-3">
                                            @Model.AnnualLeaveBalance&nbsp;day(s)
                                        </a>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="left-align">Leave Request All Employees:</span>
                                    <span class="bold request">
                                        <a href="#" class="blue-grey-text text-darken-3">
                                            @Model.CompanyLeaveToDay
                                        </a>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="left-align">Work From Home:</span>
                                    <span class="bold request">
                                        <a href="#" class="blue-grey-text text-darken-3">
                                            @Model.CompanyWorkFromHome
                                        </a>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="left-align">Absent:</span>
                                    <span class="bold request">
                                        <a href="#" class="blue-grey-text text-darken-3">
                                            @Model.CompanyAbsentToDay
                                        </a>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="left-align">Late In/Early Out Notification:</span>
                                    <span class="bold request">
                                        <a href="#" class="blue-grey-text text-darken-3">
                                            @Html.Raw(Model.DisplayLateInEarlyOutNotification)
                                        </a>
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card todoBlock">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">To do list</span>
                    </div>
                    <div id="todoList" class="card-body p-x--s">
                    </div>
                </div>
            </div>
        </div>
        @(await Html.PartialAsync("MyTeamAttendance", Model.EmployeeAttendanceModel))
        <div>
            @if (Model.IsLoadTeamWorkload)
            {
                <div class="col s12 m8 card-container-base my-members">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-title-block">
                                <span class="card-title txt-uppercase left primary-color">MY TEAM WORKLOAD</span>
                            </div>
                            <div class="card-body" id="teamWorkload">
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="col s12 m4 card-container-base">
                <div class="card">
                    <div id="calendar" class="dashboardCalendar">
                        <div class="authenGoogle" id="authenGoogle" style="display:none">
                            <p class="center img"><img src="~/css/Images/ic_google.png" /></p>
                            <p class="center text">Sign in to Google to get calendar</p>
                            <p class="center button">
                                <a class="btn-signin waves-effect waves-light" href="javascript:;" id="btnAuthen" onclick="handleAuthClick()">
                                    Sign in
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>