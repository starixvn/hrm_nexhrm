@using Fanex.NexHR.Core
@model ToDoViewModel
@if ((Model.MissingCheckInOutList.Count == 0) && (Model.PendingRequestsList.Count == 0) && Model.InProgressTasks.Count == 0)
{
    <p class="green-border">
        <span class="left-align">
            Nothing to do
        </span>
    </p>
}
@foreach (var item in Model.MissingCheckInOutList)
{
    switch (item.MissingType)
    {
        case 1:
            <p class="green-border">
                <span class="left-align">You forgot to Check In on <span class="teal link">@item.AttendanceDate.ToDateMonthYearFormatedDate()</span></span>
                <a href="~/checkinout/Create?date=@item.AttendanceDate.ToString("MM/dd/yyyy")&type=@item.MissingType"
                   class="btn-toDoRequest waves-effect waves-light right">
                    Request
                </a>
            </p>
            break;
        case 2:
            <p class="green-border">
                <span class="left-align">You forgot to Check Out on <span class="teal link">@item.AttendanceDate.ToDateMonthYearFormatedDate()</span></span>
                <a href="~/checkinout/Create?date=@item.AttendanceDate.ToString("MM/dd/yyyy")&type=@item.MissingType"
                   class="btn-toDoRequest waves-effect waves-light right">
                    Request
                </a>
            </p>
            break;
    }
}
@foreach (var item in Model.PendingRequestsList)
{
    if (item.IsAllowUpdateStatus)
    {
        switch (item.RequestType.Id)
        {
            case 1:
                <p class="green-border">
                    <span class="left-align">Please approve Check In request of @item.Requester.NickName: @Html.Raw(RequestService.ConvertToRequestMessage(item))</span>
                    <a class="btn-submit waves-effect waves-light right" onclick="processRequest(@item.Id)">
                        Approve
                    </a>
                </p>
                break;
            case 2:
                <p class="green-border">
                    <span class="left-align">Please approve Check Out request of @item.Requester.NickName: @Html.Raw(RequestService.ConvertToRequestMessage(item))</span>
                    <a class="btn-submit waves-effect waves-light right" onclick="processRequest(@item.Id)">
                        Approve
                    </a>
                </p>
                break;
            default:
                <p class="orange-border">
                    <span class="text-left">
                        Please approve @item.LeaveType.Name request of @item.Requester.NickName:
                        @Html.Raw(RequestService.ConvertToRequestMessage(item))
                    </span>
                    <i class="mdi mdi-information-outline tooltip" title="@item.Remark"></i>
                    <a class="btn-submit waves-effect waves-light right" onclick="processRequest(@item.Id)">
                        Approve
                    </a>
                </p>
                break;
        }
    }
}

@if (Model.InProgressTasks.Count > 0)
{
    <div class="tasks">
        <ul>
            @foreach (var issue in Model.InProgressTasks)
            {
                <li class="text-left task-info">
                    @{
                        var priorityClass = issue.Priority.ToString().ToLowerInvariant();
                    }
                    <div class="priority"><span class="@priorityClass">@issue.Priority.ToString()</span></div>
                    <div class="subject tooltip" title="@issue.Subject">
                        @{
                            var href = string.Format("{0}issues/{1}", AppSetting.Redmine_API_Address, issue.IssueId);
                        }
                        <a href="@href" target="_blank">@issue.Subject</a>
                    </div>
                    <a class="btn waves-light btn-logtime" onclick="getLogtimeDialog(@issue.IssueId)">Log Time</a>
                    <a issueId="@issue.IssueId" href="javascript:;" class="issue-status c-pending">
                        @issue.Status.GetDisplayName()
                        <span class="caret"></span>
                    </a>
                </li>
                            }
        </ul>
    </div>
                            }

<div id="logtime-dialog"></div>