@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Common
@using Fanex.NexHR.ViewModels.Report

@model EmployeeAttendanceViewModel

@if (Model.IsDisplayTeamAttendence) // remove condition  "&& !Request.Browser.IsMobileDevice" to display this table in mobile
{
        <div class="col s12 card-container-base card-team-attendance">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">MY TEAM ATTENDANCE</span>
                    </div>
                    <div class="card-body">
                        <form method="get" id="team-attendance" style="display: none;">
                            <input type="hidden" id="DateTime-Now" name="DateTime-Now" value="@DateTimeOffset.Now.DateTime.ToClientTimeZone().ToString("MMMM dd, yyyy")"/>
                            <div class="form">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>
                                            Date range
                                        </label>
                                    </div>
                                    <div class="left select--s">
                                            @{
                                                var model = new DropdownRenderViewModel 
                                                {
                                                    Name = "Date", 
                                                    SelectedValue = (int)DateRangeFilter.DateRange
                                                };
                                            }
                                            <partial name="Partial/_DateRangeDropdownList" model="model"/>
                                            <input type="hidden" asp-for="DateOption"/>
                                        </div>
                                    </div>
                                    <div class="col m-r--l">
                                        <div class="left label--m">
                                            <label>
                                                From date
                                            </label>
                                        </div>
                                        <div class="datepicker-button input--s left">
                                            <date-picker name="FromDate" min-date="new DateTimeOffset(2010, 1, 1, 0, 0, 0, TimeSpan.Zero).DateTime"></date-picker>
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                    </div>
                                    <div class="col m-l--xl m-r--l">
                                        <div class="left label--m">
                                            <label>
                                                To date
                                            </label>
                                        </div>
                                        <div class="datepicker-button input--s left">
                                            <date-picker name="ToDate"></date-picker>
                                            <i class="mdi-action-event calendar-icon left"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--l">
                                        <div class="left label--m">
                                            <label>Request</label>
                                        </div>
                                        <div class="left select--s">
                                                @{
                                                var modelAttendanceType = new DropdownRenderViewModel 
                                                {
                                                    Name = "AttendanceType", 
                                                    SelectedValue = Model.AttendanceType
                                                };
                                            }
                                            <partial name="Partial/_DateRangeDropdownList" model="modelAttendanceType"/>

                                        </div>
                                    </div>
                                    <div class="col m-r--l">
                                        <div class="left label--m">
                                            <label>
                                                Team
                                            </label>
                                        </div>
                                        <div class="left select-team">
                                            <select id="GroupId" asp-for="GroupId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))" >
                                                <option>@Labels.AllTeams</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="left label--m">
                                            <label>
                                                Employee
                                            </label>
                                        </div>
                                        <div class="left input--s">
                                            <input asp-for="Employee" placeholder="@Messages.SearchEmployeeWatermark"/>
                                            <input type="hidden" asp-for="EmployeeId"/>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <a id="submit" class="btn-submit waves-effect waves-light m-r--b" type="button">Submit</a>
                                        @*@if (Roles.IsUserInRole("AssistantLeader") || Roles.IsUserInRole("Leader"))
                                        {
                                            @Html.ActionLink("My Team Request", "member", "request", null, new { @class = "btn-request waves-effect waves-light" })
                                        }
                                        else
                                        {
                                            @Html.ActionLink("My Leave Request", "employeeview", "leave", null, new { @class = "btn-request waves-effect waves-light" })
                                        }*@
                                    </div>
                                </div>
                            </div>
                        </form>
                        <div class="p-x--s cover-table-team-attendance">
                                
                                <table id="attendance" class="table bordered striped highlight centered table-custom">
                                    <thead>
                                        <tr>
                                            <th>
                                                @Labels.SymbolCount
                                            </th>
                                            <th>
                                                @Labels.Date
                                            </th>
                                            <th>
                                                @Labels.EnglishName
                                            </th>
                                            <th>
                                                @Labels.Code
                                            </th>
                                            <th>
                                                @Labels.Team
                                            </th>
                                            <th>
                                                @Labels.Shift
                                            </th>
                                            <th>
                                                @Labels.CheckIn
                                            </th>
                                            <th>
                                                @Labels.CheckOut
                                            </th>
                                            <th>
                                                @Labels.TotalHours
                                            </th>
                                            <th>
                                                @Labels.LateIn
                                            </th>
                                            <th>
                                                @Labels.EarlyOut
                                            </th>
                                            <th>
                                                @Labels.Request
                                            </th>
                                            <th style="width: 5%;">
                                                @Labels.WorkFromHome
                                            </th>
                                            <th>
                                                @Labels.Note
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script id="template" type="text/x-jsrender">
            <tr {{if IsNotWork != 0}} class="offdate" {{else ShiftId}} {{else}} class="noshift" {{/if}}>
                <td>{{:~index()}}</td>
                <td>
                    {{:~formatJsonDate(AttendanceDate, 'dd MMM, yyyy')}}
                </td>
                <td class="tooltip" title="{{:FullName}}">
                    {{:NickName}}
                </td>
                <td>
                    {{:Code}}
                </td>
                <td class="tooltip" title="{{:Team}}">
                    {{:TeamCode}}
                </td>
                <td>
                    {{:ShiftCode}}
                </td>
                <td>
                    {{if InFixed}} {{:~formatJsonDate(InFixed, 'HH:mm')}} {{/if}}
                </td>
                <td>
                    {{if OutFixed}} {{:~formatJsonDate(OutFixed, 'HH:mm')}} {{/if}}
                </td>
                <td>
                    {{if TotalWorkHours > 0}}
                    {{:~totalHoursToTime(TotalWorkHours)}}
                    {{/if}}
                </td>
                <td>
                    {{if LateIn > 0}}
                    {{:~displayMinute(LateIn)}}
                    {{/if}}
                </td>
                <td>
                    {{if EarlyOut > 0}}
                    {{:~displayMinute(EarlyOut)}}
                    {{/if}}
                </td>
                <td>
                    {{if Requests != null}}
                    {{for Requests}}
                    <a href='javascript:;' class="tooltip-request req"
                       data-requesttype="{{:RequestType.Id}}"
                       data-fromdate="{{:FromDate}}"
                       data-todate="{{:ToDate}}"
                       data-createddate="{{:CreatedDate}}"
                       data-fromshift="{{:FromShift.Name}}"
                       {{if ToShift != null}}
                       data-toshift="{{:ToShift.Name}}"
                       {{else}}
                       data-toshift=""
                       {{/if}}
                       data-totaldays="{{:TotalDays}}"
                       data-totalmins="{{:TotalMins}}"
                       data-remark="{{:Remark}}">
                        {{if RequestType.Id == 6}}
                        {{:RequestType.Name}}
                        {{else}}
                        {{:RequestType.Name}}
                        {{/if}}
                    </a>
                    {{/for}}
                    {{/if}}
                </td>
                <td style="text-align: center;">
                    {{if IsWorkFromHome}}
                    <input type="checkbox" id="isWorkFromHome" class="filled-in" disabled checked />
                    {{else}}
                    <input type="checkbox" id="isWorkFromHome" class="filled-in" disabled />
                    {{/if}}
                    <label hidden style="padding-left: 15px !important; height: 12px !important; cursor: not-allowed"></label>
                </td>
                <td class="align-left">
                    {{:Notes}}
                </td>
            </tr>
        </script>

    }