@model EmployeeAttendanceViewModel
<div class="col s12 card-container-base">
    <div class="card">
        <div class="card-content">
            <div class="card-title-block">
                <span class="card-title txt-uppercase left">MY TEAM ATTENDANCE</span>
            </div>
            <div class="card-body">
                @using (Html.BeginGetForm())
                {
                    @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                    <div class="form">
                        <div class="row form-input">
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    <label>
                                        Date range</label></div>
                                <div class="left select--s">
                                    @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFilter.DateRange)
                                    @Html.Hidden("DateOption", Model.DateOption)
                                </div>
                            </div>
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    <label>
                                        From date</label></div>
                                <div class="datepicker-button input--s left">
                                    @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1))
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                            <div class="col m-l--xl m-r--l">
                                <div class="left label--m">
                                    <label>
                                        To date</label></div>
                                <div class="datepicker-button input--s left">
                                    @Html.DatePickerFor(model => model.ToDate)
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.AttendanceType, "Request")
                                </div>
                                <div class="left select--s">
                                    @RazorHelper.RequestTypeFilter("AttendanceType", Model.AttendanceType)
                                </div>
                            </div>
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    <label>
                                        Team</label></div>
                                <div class="left select-team">
                                    @Html.DropDownListFor(model => model.GroupId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                </div>
                            </div>
                            <div class="col">
                                <div class="left label--m">
                                    <label>
                                        Employee</label></div>
                                <div class="left input--s">
                                    @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                    @Html.HiddenFor(model => model.EmployeeId)
                                </div>
                            </div>
                            <div class="col">
                                <a id="submit" class="btn-submit waves-effect waves-light m-r--b" type="button">Submit</a>
                                @if (Roles.IsUserInRole("AssistantLeader") || Roles.IsUserInRole("Leader"))
                                {
                                    @Html.ActionLink("My Team Request", "member", "request", null, new { @class = "btn-request waves-effect waves-light" })
                                }
                                else
                                {
                                    @Html.ActionLink("My Leave Request", "employeeview", "leave", null, new { @class = "btn-request waves-effect waves-light" })                                    
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="p-x--s">
                    <table id="data" class="table bordered striped highlight centered table-custom">
                        <thead>
                            <tr>
                                <th>@Labels.SymbolCount
                                </th>
                                <th>@Labels.Date
                                </th>
                                <th>@Labels.Code
                                </th>
                                <th>@Labels.Nick
                                </th>
                                <th>@Labels.Team
                                </th>
                                <th>@Labels.Shift
                                </th>
                                <th>@Labels.CheckIn
                                </th>
                                <th>@Labels.CheckOut
                                </th>
                                <th>@Labels.TotalHours
                                </th>
                                <th>@Labels.LateIn
                                </th>
                                <th>@Labels.EarlyOut
                                </th>
                                <th>@Labels.Request
                                </th>
                                <th>@Labels.Note
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script id="template" type="text/x-jsrender">
    <tr {{if IsNotWork != 0}}class="offdate" {{else ShiftId}} {{else}} class="noshift" {{/if}}>
        <td>{{:~index()}}</td>
        <td>
            {{:~formatDate(AttendanceDate, 'dd MMM, yyyy')}}
        </td>
        <td>
            {{:Code}}
        </td>
        <td class="tooltip" title="{{:FullName}}">
            {{:NickName}}
        </td>
        <td class="tooltip" title="{{:Team}}">
            {{:TeamCode}}
        </td>
        <td>
            {{:ShiftCode}}
        </td>
        <td>
            {{if InFixed}} {{:~formatDate(InFixed, 'HH:mm')}} {{/if}}
        </td>
        <td>
            {{if OutFixed}} {{:~formatDate(OutFixed, 'HH:mm')}} {{/if}}
        </td>
        <td>
            {{if TotalWorkHours > 0}}
                {{:~totalHoursToTime(TotalWorkHours)}}
            {{/if}}
        </td>
        <td>
            {{if LateIn > 0}}
                {{:~displayMinute(LateIn)}}
            {{/if}}
        </td>
        <td>
            {{if EarlyOut > 0}}
                {{:~displayMinute(EarlyOut)}}
            {{/if}}
        </td>
        <td class="align-left">
            {{if Requests != null}}
                {{for Requests}}
                    <a href='javascript:;' class="tooltip-request req"
                            data-requesttype="{{:RequestType.Id}}"
                            data-fromdate="{{:FromDate}}"
                            data-todate="{{:ToDate}}"
                            data-createddate="{{:CreatedDate}}"
                            data-fromshift="{{:FromShift.Name}}"
                            {{if ToShift != null}}
                                data-toshift="{{:ToShift.Name}}"
                            {{else}}
                                data-toshift=""
                            {{/if}}
                            data-totaldays="{{:TotalDays}}"
                            data-totalmins="{{:TotalMins}}"
                            data-remark='{{:Remark}}'>
                        {{if RequestType.Id == 6}}
                            {{:RequestType.Name}}
                        {{else}}
                            {{:RequestType.Name}}
                        {{/if}}
                    </a>
                {{/for}}
            {{/if}}
        </td>
        <td class="align-left">
            {{:Notes}}
        </td>
    </tr>
</script>
