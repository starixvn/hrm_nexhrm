@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.TrainingAndDevelopment
@model TrainingAndDevelopmentUpdateViewModel
@{
    DateTime currentDate = DateTime.Today; 
    var types = ViewBag.Types;
}
<form id="frmUpdateTrainingAndDevelopment" class="form form-update-training-and-development">
    <div id="divErrorCont" class="">
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Employee">@Labels.Employee </label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <input asp-for="Employee" disabled value="@Model.Employee" placeholder="@Messages.SearchEmployeeWatermark" />
            <input asp-for="EmployeeId" type="hidden" />
            <input asp-for="Id" type="hidden" value="@Model.Id" />
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label>@Labels.Type</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <select class="typeTrainingAndDevelopment" name="TypeId" id="typeId" asp-items="@(new SelectList(types, "Id", "Name",Model.TypeId))">
            </select>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Name">@Labels.Name</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <input asp-for="Name" value="@Model.Name" />
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Organization">@Labels.Organization</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <input asp-for="Organization" value="@Model.Organization" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label asp-for="ConductedBy">@Labels.ConductedBy</label>
        </div>
        <div class="left input--m">
            <input asp-for="ConductedBy" value="@Model.ConductedBy" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label asp-for="Description">@Labels.Description</label>
        </div>
        <div class="left input--m">
            <textarea class="description textarea" asp-for="Description">@Model.Description</textarea>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label id="fromdate">@Labels.StartDate</label>
            <i class="require">*</i>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="FromDatePopup"
                         min-date="currentDate.AddYears(-100)"
                         value="@Model.FromDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label id="todate">@Labels.EndDate</label>
            <i id="to-date-require" class="require">*</i>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="ToDatePopup"
                         min-date="currentDate.AddYears(-100)"
                         value="@(Model.ToDate.Equals(DateTime.MinValue) ? null : Model.ToDate)">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
</form>