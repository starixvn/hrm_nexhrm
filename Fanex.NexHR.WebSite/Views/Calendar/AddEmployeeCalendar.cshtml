@model AddEmployeeCalendarViewModel
@{
    ViewBag.Title = Labels.MultipleInsert;
}
<form class="form">
    <div class="row form-input">
        <div class="left label--m">
            @Html.LabelFor(model => model.FromDate, Labels.FromDate)
        </div>
        <div class="left datepicker-button select--s">
            @Html.DatePickerFor(model => model.FromDate)
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--m">
            @Html.LabelFor(model => model.ToDate, Labels.ToDate)
        </div>
        <div class="left datepicker-button select--s">
            @Html.DatePickerFor(model => model.ToDate)
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--m">
            @Html.LabelFor(model => model.AddEmployee, "Employee")
        </div>
        <div class="left input--m">
            @Html.TextBoxFor(model => model.AddEmployee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.AddEmployeeId)
        </div>
    </div>

    <div class="row form-input">
        <div class="left label--m">
            @Html.LabelFor(model => model.SetOffDay, Labels.SetOffDay)
        </div>
        <div class="left input--m">
            @Html.CheckBoxFor(model => model.SetOffDay)
        </div>
    </div>
    </br>
    <div class="row form-input center">
        <input class="btn-cancel waves-effect waves-light m-r--m" id="btnCancel" type="button" value="@Labels.Cancel" />
        <input class="btn-ok waves-effect waves-light" id="btnAdd" type="button" value="@Labels.Add" />
    </div>
</form>