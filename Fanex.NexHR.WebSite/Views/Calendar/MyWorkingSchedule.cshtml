@section css{
    @Styles.Render("~/Content/fullcalendarcss", "~/Content/mycalendarcss")
}
@section js{
    @Scripts.Render("~/bundles/fullcalendarjs", "~/bundles/mycalendarjs")
}
@{
    ViewBag.Title = Labels.MyCalendar;
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="p-x--s m-t--m">
                        <div id="calendar" class="schedule">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
