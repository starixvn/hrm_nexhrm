@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Calendar
@model LeaveDaySummarySchedule

<div class="datagrid-wrap panel-body p-x--s">
    <div class="datagrid-view">
        <div class="datagrid-view1">
            <div class="datagrid-header">
                <div class="datagrid-header-inner">
                    <table cellspacing="0" cellpadding="0" border="0">
                        <tbody>
                            <tr>
                                <td colspan="3" align="right">
                                    <div class="datagrid-cell p-l--s">
                                        <b style="text-transform: uppercase">@Model.Month.ToString("MMM yyyy")</b>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="rownumber">
                                    <div class="datagrid-cell-rownumber center">@Labels.SymbolCount</div>
                                </td>
                                <td class="p-l--s rownick">
                                    <div class="datagrid-cell ">@Labels.EnglishName</div>
                                </td>
                                <td class="p-l--s rownick">
                                    <div class="datagrid-cell ">@Labels.Department</div>
                                </td>
                                <td class="p-l--s rownick">
                                    <div class="datagrid-cell ">@Labels.Team</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="datagrid-body">
                <div class="datagrid-body-inner">
                    <table cellspacing="0" cellpadding="0" border="0">
                        <tbody>
                            @{int rowId = 1;}
                            @if (Model.EmployeeLeaveShedules.Count > 0)
                            {
                                foreach (var employeeSchedule in Model.EmployeeLeaveShedules)
                                {
                                    <tr>
                                        <td class="datagrid-header-rownumber center">
                                            <div class="datagrid-cell-rownumber">@rowId</div>
                                        </td>
                                        <td>
                                            <div class="datagrid-cell p-l--s tooltip" title="@employeeSchedule.FullName">@employeeSchedule.NickName</div>
                                        </td>
                                        <td>
                                            <div class="datagrid-cell p-l--s">@employeeSchedule.DepartmentName</div>
                                        </td>
                                        <td>
                                            <div class="datagrid-cell p-l--s tooltip" title="@employeeSchedule.TeamName">@employeeSchedule.TeamCode</div>
                                        </td>
                                    </tr>
                                    rowId++;
                                }
                                <tr class="table-footer">
                                    <td colspan="3" align="center">
                                        <div class="datagrid-cell p-l--s">
                                            <b>Sum</b>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="datagrid-view2">
            <div class="datagrid-header">
                <div class="datagrid-header-inner">
                    <table cellspacing="0" cellpadding="0" border="0">
                        <tbody>
                            @{
                                <tr>
                                    @for (int i = 1; i <= Model.DaysInMonth; i++)
                                    {

                                        <td>
                                            <div class="datagrid-cell ">
                                                @i
                                            </div>
                                        </td>
                                    }
                                </tr>
                                <tr>
                                    @foreach (var date in Model.ListDates)
                                    {
                                        var cssClass = (date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday) ? "SatSunDay" : string.Empty;
                                        <td class="@cssClass">
                                            <div class="datagrid-cell">
                                                @date.ToString("ddd")
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="datagrid-body">
                <table cellspacing="0" cellpadding="0" border="0" class="shift-grid">
                    <tbody>
                        @if (Model.EmployeeLeaveShedules.Count > 0)
                        {
                            foreach (EmployeeLeaveSchedule employeeSchedule in Model.EmployeeLeaveShedules)
                            {
                                <tr class="row">
                                    @foreach (LeaveSchedule leaveSchedule in employeeSchedule.LeaveSchedules)
                                    {
                                        if (leaveSchedule.IsLeaveDay)
                                        {
                                            <td>
                                                <div class="datagrid-cell">@(leaveSchedule.IsHalfDayLeave ? leaveSchedule.LeaveType : "x")</div>
                                            </td>
                                        }
                                        else if (!string.IsNullOrEmpty(leaveSchedule.LeaveType) && (leaveSchedule.LeaveType.Equals("OFF") || leaveSchedule.LeaveType.Equals("PH")))
                                        {
                                            <td class="OFF">
                                                <div class="datagrid-cell">
                                                    @leaveSchedule.LeaveType
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <div class="datagrid-cell">
                                                    @leaveSchedule.LeaveType
                                                </div>
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                            <tr class="row table-footer">
                                @foreach (double total in Model.TotalLeaves)
                                {
                                    <td>
                                        <div class="datagrid-cell">@total</div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>