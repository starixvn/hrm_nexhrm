@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.AddEmployeeCalendarViewModel
@{
    ViewBag.Title = Labels.MultipleInsert;
    var dateTime = DateTime.Now.Date;
}

<form class="form form-calendar-add">
    <div class="row form-input">
        <div class="left label--m">
            <label asp-for="@Model.FromDate">@Labels.FromDate</label>
        </div>
        <div class="left datepicker-button select--s">
            <date-picker
                name="FromDate"
                value="@dateTime"
            >
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>

    <div class="row form-input">
        <div class="left label--m">
            <label asp-for="@Model.ToDate">@Labels.ToDate</label>
        </div>
        <div class="left datepicker-button select--s">
            <date-picker
                name="ToDate"
                value="@dateTime"
            >
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>

    <div class="row form-input">
        <div class="left label--m">
            <label asp-for="@Model.AddEmployee">@Labels.Employee</label>
        </div>
        <div class="left input--m">
            <input asp-for="@Model.AddEmployee" placeholder="@Messages.SearchEmployeeWatermark"/>
            <input type="hidden" asp-for="@Model.AddEmployeeId"/>
        </div>
    </div>

    <div class="row form-input">
        <div class="left label--m">
            <label asp-for="@Model.AddEmployee">@Labels.SetOffDay</label>
        </div>
        <div class="left input--m">
            <input asp-for="@Model.SetOffDay" type="checkbox" />
        </div>
    </div>

    <div class="row form-input center">
        <input class="btn-cancel waves-effect waves-light m-r--m" id="btnCancel" type="button" value="@Labels.Cancel" />
        <input class="btn-ok waves-effect waves-light" id="btnAdd" type="button" value="@Labels.Add" />
    </div>
</form>