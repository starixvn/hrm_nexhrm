@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.AnnualLeave
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model IList<AnnualLeaveTransaction>
@{
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
    var excludedRequestTrans = @ViewBag.ExcludedRequestTrans;
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.AffectFrom</th>
            <th>@Labels.TotalDays</th>
            <th>@Labels.Description</th>
            <th>@Labels.CreatedDate</th>
            @if (isHRRole){
                <th>@Labels.Edit</th>
                <th>@Labels.Delete</th>
            }
            
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>
            @{int index = 1;}
            @foreach (AnnualLeaveTransaction item in Model)
            {
                <tr>
                    <td>@(index++)</td>
                    <td>@item.AffectedFrom.ToDateMonthYearFormatedDate()</td>
                    <td>@item.TotalDays</td>
                    <td class="align-left">
                        @if (item.RequestId != null)
                        {
                            <span>[request]</span>
                        }
                        @item.Description
                    </td>
                    <td>@item.CreatedDate.ToShortFormatedDate()</td>
                    @if (isHRRole)
                    {
                        @if (item.RequestId == null)
                        {
                            <td>
                                <a href="@Url.Action("Edit","AnnualLeave", new {leavetransactionId = item.LeaveTransactionId, excludedRequestTrans = excludedRequestTrans})">@Labels.Edit</a>
                            </td>
                            <td title="Delete">
                                <a href="javascript:;" onclick="deleteLeaveTrans(@item.LeaveTransactionId)">
                                    <i class='mdi mdi-delete mdi-dark'></i>
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                            <td>-</td>
                        }
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        <tr>
            <td colspan="7"></td>
        </tr>
        <tr>
            <td colspan="7" rowspan="2">
                @Messages.NoInformation
            </td>
        </tr>
    }
</table>