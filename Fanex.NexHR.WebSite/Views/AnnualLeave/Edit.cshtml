@using Fanex.NexHR.ViewModels.AnnualLeave
@model EditAnnualLeaveTransactionViewModel
@{
    ViewBag.Title = Labels.EditAnnualLeaveBalance;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/editleavetransactionjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                @if (Model != null)
                {
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@Labels.Edit</span>
                    </div>
                    <div class="card-body">
                        <div class="form">
                            @using (Html.BeginForm())
                            {
                                @Html.HiddenFor(model=>model.LeaveTransactionId)
                                @Html.HiddenFor(model=>model.EmployeeId)
                                @Html.Hidden("year", Model.AffectedFrom.Year)
                                @Html.ValidationSummary()
                                if (ViewBag.Updated == true)
                                {
                                    <input type="hidden" id="successed" value="true" />
                                    <div class="row validation-summary-success">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.Saved
                                    </div>
                                }
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.TotalDays, Labels.TotalDays)
                                        </div>
                                        <div class="left input--xs">
                                            @Html.EditorFor(model => model.TotalDays)
                                            @Html.ValidationMessageFor(model => model.TotalDays)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.Description)
                                        </div>
                                        <div class="left input--m">
                                            @Html.TextAreaFor(model => model.Description, new { @class = "materialize-textarea" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.AffectedFrom, Labels.AffectFrom)
                                        </div>
                                        <div class="left input--s datepicker-button">
                                            @Html.DatePickerFor(model => model.AffectedFrom)
                                            <i class="mdi-action-event calendar-icon left"></i>
                                            @Html.ValidationMessageFor(model => model.AffectedFrom)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--m">
                                            &nbsp;</div>
                                        <div class="left">
                                            <a class="btn-back waves-effect waves-light" href="@Url.Action("employee", new { employeeId = Model.EmployeeId, year = Model.AffectedFrom.Year})">@Labels.Back</a>
                                            <input class="btn-submit waves-effect waves-light right" type="submit" value="@Labels.Update" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@Messages.NoDataIsAvailable</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
