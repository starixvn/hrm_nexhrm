<div id="resetform">
    <div class="form">
        @using (Html.BeginForm())
        {
            <div class="row form-input">
                <div class="col">
                    <div class="left label--l">
                        @Html.Label(Labels.MaxBalance)
                    </div>
                    <div class="left input--m">
                        @Html.Editor("MinBalance")
                    </div>
                </div>
            </div>
            <div class="row form-input">
                <div class="col">
                    <div class="left label--l">
                        @Html.Label(Labels.Description)
                    </div>
                    <div class="left input--m">
                        @Html.TextArea("DescriptionReset", new { @class = "materialize-textarea" })
                    </div>
                </div>
            </div>
            <div class="row center">
                <input type="button" id="cancelReset" class="btn-cancel waves-effect waves-light m-r--m" value="@Labels.Cancel" />
                <input type="submit" id="insert" class="btn-ok waves-effect waves-light" value="@Labels.Submit" />
            </div>
        }
    </div>
</div>
