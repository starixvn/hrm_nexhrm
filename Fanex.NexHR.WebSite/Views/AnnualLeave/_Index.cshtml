@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.AnnualLeave
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;

@model IList<LeaveSummary>;
@{
    int year = ViewBag.Year;
    var notMonthColumn = -99;
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;

    void DisplayNumber(int month, float value, int empId, string nickName)
    {
        const float epsilon = 0.0001f;
        if (Math.Abs(value) > epsilon)
        {
            if (month == notMonthColumn)
            {
                <td class="@(value > 0 ? string.Empty : "red-color")">@value.ToString("0.0")</td>
            }
            else
            {
                var addMonth = month + 1;
                <td>
                    <a class="@(value > 0 ? "viewhistorybymonth" : "red-color")" href="javascript:;" data-name="@nickName"
                       id="/AnnualLeave/ViewHistoryAnnualByMonth?employeeId=@empId&year=@year&month=@addMonth">
                        @value.ToString("0.0")
                    </a>
                </td>
            }
        }
        else
        {
            <td>-</td>
        }
    }

    void DisplayNumberForYear(float value, int empId, string nickName)
    {
        if (value == 0)
        {
            <td>-</td>
        }
        else
        {
            <td>
                <a class="@(value > 0 ? "viewhistorybymonth" : "red-color")" href="javascript:;" data-name="@nickName"
                    id="/AnnualLeave/ViewDetailCreditDaysInYear?employeeId=@empId&year=@year">
                    @value.ToString("0.0")
                </a>
            </td>
        }
    }
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            @if (@isHRRole)
            {
                <th rowspan="2" class="col-checkbox">
                    <input class="checkuncheckall filled-in" id="checkuncheckall" name="checkuncheckall" type="checkbox"
                        value="true">
                    <label for="checkuncheckall"></label>
                    <input name="checkuncheckall" type="hidden" value="false">
                </th>
            }
            else
            {
                <th rowspan="2">#</th>
            }
            <th rowspan="2">@Labels.EnglishName</th>
            <th rowspan="2">@Labels.Team</th>
            <th rowspan="2">@year</th>
            <th colspan="12">
                Take Annual Leave @year
            </th>
            <th rowspan="2">
                Balance of AL @year
            </th>
            @if (@isHRRole)
            {
                <th rowspan="2">@Labels.Edit</th>
            }
            else
            {
                <th rowspan="2">@Labels.Action</th>
            }
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th style="border-right: none;">@Labels.Dec</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        int index = 1;
        var leaveSummaryByDepartments = Model.GroupBy(t => t.DepartmentId).Select(grp => grp.First());
        <tbody>
            @foreach (var leaveSummaryByDepartment in leaveSummaryByDepartments)
            {
                <tr class="row-divider">
                    <td colspan="20">
                        <b>@leaveSummaryByDepartment.DepartmentName.ToUpperInvariant()</b>
                    </td>
                </tr>

                var leaveSummariesByEmp = Model.Where(t => t.DepartmentId == leaveSummaryByDepartment.DepartmentId);
                foreach (var leaveSummary in leaveSummariesByEmp)
                {
                    <tr>
                        @if (isHRRole)
                        {
                            <td class="col-checkbox">
                                <input class="aba filled-in" id="checkbox_@leaveSummary.EmpId" data-id="@leaveSummary.EmpId"
                                    name="checkbox_@leaveSummary.EmpId" type="checkbox" value="true">
                                <label for="checkbox_@leaveSummary.EmpId"></label>
                                <input name="checkbox_@leaveSummary.EmpId" type="hidden" value="false">
                            </td>
                        }
                        else
                        {
                            <td>@(index++)</td>
                        }
                        <td class="tooltip" title="@leaveSummary.FullName">@leaveSummary.NickName</td>
                        <td class="tooltip" title="@leaveSummary.TeamName">@leaveSummary.TeamCode</td>
                        @{
                            DisplayNumberForYear(leaveSummary.AnnualLeaveCurrentYear, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.January, leaveSummary.Jan, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.February, leaveSummary.Feb, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.March, leaveSummary.Mar, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.April, leaveSummary.Apr, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.May, leaveSummary.May, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.June, leaveSummary.Jun, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.July, leaveSummary.Jul, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.August, leaveSummary.Aug, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.September, leaveSummary.Sep, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.October, leaveSummary.Oct, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.November, leaveSummary.Nov, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber((int)Months.December, leaveSummary.Dec, leaveSummary.EmpId, leaveSummary.NickName);
                            DisplayNumber(notMonthColumn, leaveSummary.LeaveBalance, leaveSummary.EmpId, leaveSummary.NickName);
                        }
                        @if (isHRRole)
                        {
                            <td class="center">
                                <a href="~/annualleave/employee?employeeId=@leaveSummary.EmpId&Year=@year">
                                    <i class="mdi mdi-border-color mdi-18px mdi-dark"></i>
                                </a>
                            </td>
                        }
                        else
                        {
                            <td class="center">
                                <a class="viewhistory" href="~/annualleave/employee?employeeId=@leaveSummary.EmpId&Year=@year">View</a>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    }
    else
    {
        <tr>
            <td colspan="18"></td>
        </tr>
        <tr>
            <td colspan="18" rowspan="2">
                @Messages.NoInformation
            </td>
        </tr>
    }
</table>