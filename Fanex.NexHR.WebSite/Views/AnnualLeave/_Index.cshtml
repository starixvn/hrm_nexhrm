@using System.Text
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.AnnualLeave
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;

@model LeaveSummaryTransactions;
@{
    int year = ViewBag.Year;
    var leaveSummaries = @Model.leaveSummaries;
    var annualLeaveTransactions = @Model.annualLeaveTransactions;
    var notMonth = -1;
    var isHRRole = sessionService.CurrentEmployee.RoleList.Any(r => r == (short)Role.HR || r == (short)Role.SA);

    void DisplayNumber(int month, float value, int empId)
    {
        var annualLeaveByEmpId = annualLeaveTransactions.Where(x => x.Employee.Id == empId);
        var annualLeaveByMonth = annualLeaveByEmpId.Where(x => x.AffectedFrom.Month == month + 1);
        var tooltipContents = new StringBuilder();
        foreach(var annualLeave in annualLeaveByMonth){
            var content = string.Format("Total Days: {0} ( {1} )", annualLeave.TotalDays, annualLeave.Description, annualLeave.AffectedFrom);
            tooltipContents.Append(content);
            tooltipContents.Append(System.Environment.NewLine);
        }
        if (value == 0)
        {
            <td>-</td>
        }
        else
        {
            <td title="@tooltipContents.ToString()" class="@(value > 0 ? "tooltip" : "red-color")">@value.ToString("0.0")</td>
        }
    }
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            @if (@isHRRole)
            {
                <th rowspan="2" class="col-checkbox">
                    <input class="checkuncheckall filled-in" id="checkuncheckall" name="checkuncheckall" type="checkbox" value="true">
                    <label for="checkuncheckall"></label>
                    <input name="checkuncheckall" type="hidden" value="false">
                </th>
            }
            else
            {
                <th rowspan="2">#</th>
            }
            <th rowspan="2">@Labels.Nick</th>
            @if (year == 2022)
            {
                <th rowspan="2">@year</th>
            }
            else
            {
                <th colspan="2">@Labels.AnnualLeave</th>
            }
            <th colspan="12">
                Take Annual Leave @year
            </th>
            <th rowspan="2">
                Balance of AL @year
            </th>
            @if (@isHRRole)
            {
                <th rowspan="2">@Labels.Edit</th>
            }else{
                <th rowspan="2">@Labels.Action</th>
            }
        </tr>
        <tr>
            @if (year != 2022)
            {
                <th>@(year - 1)</th>
                <th>@year</th>
            }
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th style="border-right: none;">@Labels.Dec</th>
        </tr>
    </thead>
    @if (leaveSummaries != null && leaveSummaries.Any())
    {
        int index = 1;
        IList<LeaveSummary> leaveSummaryByTeams = leaveSummaries.GroupBy(t => t.Employee.Team.Id).Select(grp => grp.First()).ToList();
        <tbody>
            @foreach (LeaveSummary leaveSummaryByTeam in leaveSummaryByTeams)
            {
                <tr class="row-divider">
                    <td colspan="19">
                        <b>@leaveSummaryByTeam.Employee.Team.Name.ToUpper()</b>
                    </td>
                </tr>

                IList<LeaveSummary> leaveSummariesByEmp = leaveSummaries.Where(t => t.Employee.Team.Id == leaveSummaryByTeam.Employee.Team.Id).ToList();
                foreach (LeaveSummary leaveSummary in leaveSummariesByEmp)
                {
                    var htmlAttributes = HtmlHelper.AnonymousObjectToHtmlAttributes(
                        new
                        {
                            @class = "aba filled-in",
                            data_id = leaveSummary.Employee.Id
                        });
                    <tr>
                        @if (@isHRRole)
                        {
                            <td class="col-checkbox">
                                <input class="aba filled-in" id="checkbox_@leaveSummary.Employee.Id" data-id="@leaveSummary.Employee.Id" name="checkbox_@leaveSummary.Employee.Id" type="checkbox" value="true">
                                <label for="checkbox_@leaveSummary.Employee.Id"></label>
                                <input name="checkbox_@leaveSummary.Employee.Id" type="hidden" value="false">
                            </td>
                        }
                        else
                        {
                            <td>@(index++)</td>
                        }
                        <td class="tooltip" title="@leaveSummary.Employee.FullName">@leaveSummary.Employee.NickName</td>
                        @if (year != 2022)
                        {
                            DisplayNumber(notMonth, leaveSummary.AnnualLeaveLastYear, leaveSummary.Employee.Id);
                        }
                        @{
                            DisplayNumber(notMonth, leaveSummary.AnnualLeaveCurrentYear, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.January, leaveSummary.Jan, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.February, leaveSummary.Feb, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.March, leaveSummary.Mar, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.April, leaveSummary.Apr, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.May, leaveSummary.May, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.June, leaveSummary.Jun, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.July, leaveSummary.Jul, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.August, leaveSummary.Aug, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.September, leaveSummary.Sep, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.October, leaveSummary.Oct, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.November, leaveSummary.Nov, leaveSummary.Employee.Id);
                            DisplayNumber((int)Months.December, leaveSummary.Dec, leaveSummary.Employee.Id);
                            DisplayNumber(notMonth, leaveSummary.LeaveBalance, leaveSummary.Employee.Id);
                        }
                        @if (@isHRRole)
                        {
                            <td class="center">
                                <a href="~/annualleave/employee?employeeId=@leaveSummary.Employee.Id&year=@year">
                                    <i class="mdi mdi-border-color mdi-18px mdi-dark"></i>
                                </a>
                            </td>
                        }else{
                            <td class="center">
                                <a class="viewhistory"  href="~/annualleave/employee?employeeId=@leaveSummary.Employee.Id&year=@year">View</a>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    }
    else
    {
        if (year != 2022)
        {
            <tr>
                <td colspan="18"></td>
            </tr>
            <tr>
                <td colspan="18" rowspan="2">
                    @Messages.NoInformation
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="17"></td>
            </tr>
            <tr>
                <td colspan="17" rowspan="2">
                    @Messages.NoInformation
                </td>
            </tr>
        }
    }
</table>