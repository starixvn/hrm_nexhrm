@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.AnnualLeave
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;

@model LeaveConversionDetailViewModel
@{
    ViewBag.Title = Labels.LeaveDeductionDetail;
    var isHRRole = sessionService.CurrentEmployee.RoleList.Any(r => r == (short)Role.HR || r == (short)Role.SA);
    var teams = new SelectList(Model.Teams, "Id", "Name");
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/AnnualLeave/leave.deduction.detail.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/leavedeductiondetail.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <form action="/AnnualLeave/LeaveDeductionDetail?employeeId=@Model.EmployeeId&fromDate=@Model.FromDate&toDate=@Model.ToDate" method="post" novalidate="novalidate">
                            <input type="hidden" id="DateTime-Now" name="DateTime-Now" value="@DateTime.Now.ToString("MMMM dd, yyyy")"/>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--m">
                                        <select id="Date" name="Date">
                                            @{
                                                foreach (DateRangeFilter dateRange in (DateRangeFilter[])Enum.GetValues(typeof(DateRangeFilter)))
                                                {
                                                    var value = (int)dateRange;
                                                    <option value="@value" selected="@(value == (int)DateRangeFilter.DateRange)">@Utilities.GetDescription(dateRange)</option>
                                                }
                                            }
                                        </select>
                                        <input type="hidden" asp-for="DateOption" value="@Model.DateOption" />
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="@Model.FromDate">@Labels.FromDate</label>
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        <date-picker
                                            name="FromDate"
                                            value="Model.FromDate"
                                        >
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="@Model.ToDate">@Labels.ToDate</label>
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        <date-picker
                                            name="ToDate"
                                            value="Model.ToDate"
                                        >
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="@Model.TeamId">@Labels.Team</label>
                                    </div>
                                    <div class="left select--m">
                                        <select asp-for="@Model.TeamId" asp-items="@teams">
                                            <option value="">@Labels.AllTeams</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="@Model.Employee"></label>
                                    </div>
                                    <div class="left select-team">
                                        <input asp-for="Employee" value="@Model.Employee" placeholder="@Messages.SearchEmployeeWatermark" />
                                        <input type="hidden" asp-for="@Model.EmployeeId" />
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="p-x--s over-auto table-resize table-medium table-row-thead">
                        <table id="data" class="table bordered striped highlight table-custom centered">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Name</th>
                                    <th>@Labels.EnglishName</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.DeductDate</th>
                                    <th>@Labels.Type</th>
                                    <th>@Labels.Days</th>
                                    <th>@Labels.Note</th>
                                    @if (@isHRRole)
                                    {
                                        <th>@Labels.Edit</th>
                                        <th>@Labels.Delete</th>
                                    }
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="hide">
                        <div id="updateform" title="Edit Leave Deduction">
                            <partial name="EditLeaveDeduction" model="@new LeaveDeductionViewModel()" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/x-jsrender">
    <tr>
        <td>{{:~index()}}</td>
        <td class="align-left">{{:Employee.FullName}}</td>
        <td>{{:Employee.NickName}}</td>
        <td class="tooltip" title="{{:Employee.Team.Name}}">
            {{:Employee.Team.Code}}
        </td>
        <td class="deductdate">{{:~formatJsonDate(Date, 'dd MMM, yyyy')}}</td>
        <td>
            {{if IsAnnual}}
            Annual Leave
            {{else}}
            Unpaid Leave
            {{/if}}
        </td>
        <td>{{:LeaveDays.toFixed(1)}}</td>
        <td class="description">{{:Description}}</td>
        {{if ~isHRRole}}
        <td>
            <a href="javascript:;" class="editLeaveDeduction"
               data-id="{{:LeaveConversionId}}"
               data-leavedays="{{:LeaveDays}}"
               data-isannual="{{:IsAnnual}}"
               data-deductdate="{{:~formatJsonDate(Date, 'dd MMM, yyyy')}}">
                <i class="mdi mdi-border-color mdi-dark"></i>
            </a>
        </td>
        <td>
            <a href="javascript:;" class="deleteLeaveDeduction" data-id="{{:LeaveConversionId}}">
                <i class="mdi mdi-delete mdi-dark"></i>
            </a>
        </td>
        {{/if}}
    </tr>
</script>
