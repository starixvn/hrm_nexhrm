@using Fanex.NexHR.ViewModels.AnnualLeave
@model LeaveConversionDetailViewModel
@{
    ViewBag.Title = Labels.LeaveDeductionDetail;
}
@section Breadcrumb {
}
@section css{
    @Styles.Render("~/Content/view-mobile")
}
@section js{
    @Scripts.Render("~/bundles/leavedeductiondetailjs");
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        @using (Html.BeginForm())
                        {
                            @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--m">
                                        @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFilter.DateRange)
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.FromDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ToDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.TeamId, Labels.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left select-team">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-x--s over-auto table-resize table-medium table-row-thead">
                        <table id="data" class="table bordered striped highlight table-custom centered">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Name</th>
                                    <th>@Labels.Nick</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.DeductDate</th>
                                    <th>@Labels.Type</th>
                                    <th>@Labels.Days</th>
                                    <th>@Labels.Note</th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th>@Labels.Edit</th>
                                        <th>@Labels.Delete</th>
                                    }
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="hide">
                        <div id="updateform" title="Edit Leave Deduction">
                            @Html.Action("EditLeaveDeduction", "AnnualLeave")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/x-jsrender">
    <tr>
        <td>{{:~index()}}</td>
        <td class="align-left">{{:Employee.FullName}}</td>
        <td>{{:Employee.NickName}}</td>
        <td class="tooltip" title="{{:Employee.Team.Name}}">
            {{:Employee.Team.Code}}
        </td>
        <td class="deductdate">{{:~formatJsonDate(Date, 'dd MMM, yyyy')}}</td>
        <td>
            {{if IsAnnual}}
            Annual Leave
            {{else}}
            Unpaid Leave
            {{/if}}
        </td>
        <td>{{:LeaveDays.toFixed(1)}}</td>
        <td class="description">{{:Description}}</td>
        {{if ~isHRRole}}
        <td>
            <a href="javascript:;" class="editLeaveDeduction"
               data-id="{{:LeaveConversionId}}"
               data-leavedays="{{:LeaveDays}}"
               data-isannual="{{:IsAnnual}}"
               data-deductdate="{{:~formatJsonDate(Date, 'dd MMM, yyyy')}}">
                <i class="mdi mdi-border-color mdi-dark"></i>
            </a>
        </td>
        <td>
            <a href="javascript:;" class="deleteLeaveDeduction" data-id="{{:LeaveConversionId}}">
                <i class="mdi mdi-delete mdi-dark"></i>
            </a>
        </td>
        {{/if}}
    </tr>
</script>
