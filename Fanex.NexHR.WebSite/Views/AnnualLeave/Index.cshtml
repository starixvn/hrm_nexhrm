@using Fanex.NexHR.ViewModels.AnnualLeave
@model LeaveSummaryViewModel
@{
    ViewBag.Title = Labels.AnualLeaveBalance;
}
@section css{
    @Styles.Render("~/Content/annualleavebalancecss")
}
@section js{
    @Scripts.Render("~/bundles/annualleavebalancejs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm())
                        {
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                @if (Roles.IsUserInRole("HR"))
                                {
                                    <div class="col m-r--m">
                                        <div class="left label--l">
                                            @Html.Label(@Labels.MinBalance)
                                        </div>
                                        <div class="left select--xs">
                                            @Html.DropDownListFor(model => model.MinAnnualBalance, Model.MinAnnualBalances, Labels.None)
                                        </div>
                                    </div>
                                }
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.TeamId, @Labels.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.None)
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark, style = "width:183px;" })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                                @if (Roles.IsUserInRole("HR"))
                                {
                                    if (Model.ShowOpenAndCloseAnnualBalance.IsShowCloseBalance)
                                    {
                                        <div class="col">
                                            <a class="btn-request waves-effect waves-light" href="javascript:;" id="resetblc">@Labels.CloseBalance</a>
                                        </div>
                                    }
                                    if (Model.ShowOpenAndCloseAnnualBalance.IsShowOpenBalance)
                                    {
                                        <div class="col">
                                            <a class="btn-submit waves-effect waves-light" href="javascript:;" id="addbalance">@Labels.AddBalance</a>
                                        </div>
                                    }
                                    <div class="col">
                                        <a class="btn-request waves-effect waves-light" href="javascript:;" id="addadj">@Labels.Adjustment</a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="p-x--s">
                        <div id="div-content"></div>
                    </div>
                    @if (Roles.IsUserInRole("HR"))
                    {
                        <div class="row hide">
                            @Html.Action("MultipleInsert")
                        </div>
                        <div class="row hide">
                            @Html.Action("MultipleReset")
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>