@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.AnnualLeave
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;

@model LeaveSummaryViewModel
@{
    ViewBag.Title = Labels.AnualLeaveBalance;
    var isHRRole = sessionService.CurrentEmployee.RoleList.Any(r => r == (short)Role.HR || r == (short)Role.SA);
    var teams = new SelectList(Model.Teams, "Id", "Name");
    var addMultiAnnualLeaveTransactionViewModel = new AddMultiAnnualLeaveTransactionViewModel {
        AffectedFrom = DateTime.Now
    };
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/annualleavebalance.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/AnnualLeave/index.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/annualleavebalance.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <form action="/annualleave" method="post" novalidate="novalidate">
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label asp-for="@Model.Year"></label>
                                    </div>
                                        <div class="left select--xs select--year">
                                        <select id="Year" name="Year" asp-items="@Extensions.YearPicker(2010, DateTime.Now.Year)">
                                        </select>
                                    </div>
                                </div>
                                @if (@isHRRole)
                                {
                                    <div class="col m-r--m">
                                        <div class="left label--l">
                                            <label>@Labels.MinBalance</label>
                                        </div>
                                        <div class="left select--xs select-min-balance">
                                            <select asp-for="@Model.MinAnnualBalance" asp-items="@Model.MinAnnualBalances">
                                                <option value="">@Labels.None</option>
                                            </select>
                                        </div>
                                    </div>
                                }
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label asp-for="@Model.TeamId">@Labels.Team</label>
                                    </div>
                                    <div class="left select--m select-teamIds">
                                        <select asp-for="@Model.TeamId" asp-items="@teams">
                                            <option value="">@Labels.None</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="left label--m">
                                        <label asp-for="@Model.Employee"></label>
                                    </div>
                                    <div class="left">
                                        <input asp-for="@Model.Employee" placeholder="@Messages.SearchEmployeeWatermark" style="width:183px;"/>
                                        <input type="hidden" asp-for="@Model.EmployeeId"/>
                                    </div>
                                </div>
                                <div class="col btn-none-margin">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                                @if (@isHRRole)
                                {
                                    if (Model.ShowOpenAndCloseAnnualBalance.IsShowCloseBalance)
                                    {
                                        <div class="col btn-none-margin">
                                            <a class="btn-request waves-effect waves-light" href="javascript:;" id="resetblc">@Labels.CloseBalance</a>
                                        </div>
                                    }
                                    if (Model.ShowOpenAndCloseAnnualBalance.IsShowOpenBalance)
                                    {
                                        <div class="col btn-none-margin">
                                            <a class="btn-submit waves-effect waves-light" href="javascript:;" id="addbalance">@Labels.AddBalance</a>
                                        </div>
                                    }
                                    <div class="col btn-none-margin">
                                        <a class="btn-request waves-effect waves-light" href="javascript:;" id="adjustment">@Labels.Adjustment</a>
                                    </div>
                                }
                            </div>
                        </form>
                    </div>
                    <div class="p-x--s">
                        <div id="div-content" class="over-auto table-resize table-medium table-row-thead"></div>
                    </div>
                    <div id="dialoghistorycontent" class="full-view-width over-auto"></div>
                    @if (@isHRRole)
                    {
                        <div class="row hide">
                            <partial name="MultipleInsert" model="addMultiAnnualLeaveTransactionViewModel" />
                        </div>
                        <div class="row hide">
                            <partial name="MultipleReset" model="addMultiAnnualLeaveTransactionViewModel" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
