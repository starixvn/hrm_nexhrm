@helper NagivationItem(List<Fanex.NexHR.ViewModels.NavigationViewModel> navItemList)
    {
        foreach (var navItem in navItemList)
        {
            <li id="@navItem.Id" class="el">
                <i class="mdi mdi-@navItem.Icon"></i>
                @Html.ActionLink(navItem.Title, navItem.Action, navItem.Controller)
            </li>
        }
}
@helper NavigationSection(List<Fanex.NexHR.ViewModels.NavigationViewModel> sectionItemList)
    {
        for (int i = 0; i < sectionItemList.Count; i++)
        {
            var sectionItem = sectionItemList[i];
            
            <li class="bold section" id="@i">
                <a class="collapsible-header waves-effect waves-orange active">
                    @sectionItem.Title<i class="right mdi-navigation-chevron-right"></i>
                </a>
                <div class="collapsible-body" style="display: block;">
                    <ul>
                        @NagivationItem(sectionItem.Childs)
                    </ul>
                </div>
            </li>
        }
}

<li class="no-padding">
    <ul id="navbar" class="collapsible collapsible-expandable" data-collapsible="accordion">
        @NavigationSection(ViewBag.NavigationItems)
    </ul>
</li>

<input type="hidden" id="controller" value="@ViewBag.Controller.ToString().ToLower()" />
<input type="hidden" id="action" value="@ViewBag.Action.ToString().ToLower()" />