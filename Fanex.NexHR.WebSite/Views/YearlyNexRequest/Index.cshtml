@using Fanex.NexHR.ViewModels.YearlyNexRequest

@model YearlyNexRequestViewModel

@section css {
    @Styles.Render("~/Content/view-mobile")
}
@section js{
    @Scripts.Render("~/bundles/yearlynexrequestjs")
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.YearlyNexRequest</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "form" }))
                        {
                            <div class="row form-input">
                                <div class="row">
                                    <div class="col">
                                        <div class="left label--s">
                                            @Html.LabelFor(model => model.Year)
                                        </div>
                                        <div class="left select--xs">
                                            @Html.YearPicker("Year", 2010, DateTime.Now.Year)
                                        </div>
                                    </div>
                                    <div class="col m-l--l m-r--s">
                                        <div class="left label--s">
                                            @Html.Label(Labels.Team)
                                        </div>
                                        <div class="left select-team">
                                            @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                        </div>
                                    </div>
                                    <div class="col m-r--l">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.Employee)
                                        </div>
                                        <div class="left input--m">
                                            @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                            @Html.HiddenFor(model => model.EmployeeId)
                                        </div>
                                    </div>
                                    <div class="col m-r--l col-btn-submit-excel">
                                        <input id="submit" type="button" value="@Labels.Submit" class="processing-submit btn-submit waves-effect waves-light m-r--m" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-x--s over-auto table-resize table-large table-row-thead">
                        <div id="listYearlyNexRequest"> </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>