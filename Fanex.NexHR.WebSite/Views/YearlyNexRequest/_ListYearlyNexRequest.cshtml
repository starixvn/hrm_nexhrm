@model IList<YearlyNexRequest>

<table id="data" class="table bordered striped highlight table-custom centered">
    <thead>
        <tr>
            <th rowspan="2">#</th>
            <th rowspan="2">@Labels.Nick</th>
            <th rowspan="2">@Labels.NEXType</th>
            <th colspan="12">@Labels.NexRequest @ViewBag.Year </th>
            <th rowspan="2">@Labels.Total</th>
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th>@Labels.Dec</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int index = 1;
            var rowColor = "";
            IList<YearlyNexRequest> yearlyNexRequestByTeams = Model.GroupBy(t => t.Employee.Team.Id).Select(grp => grp.First()).ToList();
            foreach (YearlyNexRequest yearlyNexRequestByTeam in yearlyNexRequestByTeams)
            {
                <tr class="row-divider">
                    <td colspan="16">
                        <b>@yearlyNexRequestByTeam.Employee.Team.Name.ToUpper()</b>
                    </td>
                </tr>

                IList<YearlyNexRequest> yearlyNexRequests = Model.Where(t => t.Employee.Team.Id == yearlyNexRequestByTeam.Employee.Team.Id).ToList();

                IList<YearlyNexRequest> tests = yearlyNexRequests.GroupBy(t => t.Employee.Id).Select(grp => grp.First()).ToList();

                foreach (YearlyNexRequest test in tests)
                {
                    IList<YearlyNexRequest> nex = Model.Where(t => t.Employee.Id == test.Employee.Id).ToList();

                    foreach (YearlyNexRequest yearlyNexRequest in nex)
                    {
                        if (yearlyNexRequest.IsHoliday == 1) { rowColor = "isHoliday"; }
                        if (yearlyNexRequest.IsNormalDay == 1) { rowColor = "isNormalday"; }
                        if (yearlyNexRequest.IsOffDay == 1) { rowColor = "isOffday"; }
                        <tr>
                            <td>@(index++)</td>
                            <td class="tooltip align-left" @*rowspan="@nex.Count"*@ title="@yearlyNexRequest.Employee.FullName">@yearlyNexRequest.Employee.NickName</td>
                            @if (yearlyNexRequest.IsHoliday == 1)
                            {
                                <td class="align-left @rowColor">@Labels.Holiday</td>
                            }
                            else
                            {
                                if (yearlyNexRequest.IsNormalDay == 1)
                                {
                                    <td class="align-left @rowColor">@Labels.NormalDay</td>
                                }
                                else
                                {
                                    if (yearlyNexRequest.IsOffDay == 1)
                                    {
                                        <td class="align-left @rowColor">@Labels.OffDay</td>
                                    }
                                    else
                                    {
                                        <td></td>}
                                }
                            }
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Jan)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Feb)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Mar)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Apr)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.May)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Jun)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Jul)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Aug)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Sep)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Oct)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Nov)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Dec)</td>
                            <td class="@rowColor">@YearlyNexRequest.DisplayValue(yearlyNexRequest.TotalHour)</td>
                        </tr>
                    }
                }
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(16)
        }
    </tbody>
</table>