@model IList<YearlyNexRequest>
@if (Model != null && Model.Any())
{
    int index = 1;
    IList<YearlyNexRequest> overtimeSummaryByTeams = Model.GroupBy(t => t.Employee.Team.Id).Select(grp => grp.First()).ToList();
    foreach (YearlyNexRequest overtimeSummaryByTeam in overtimeSummaryByTeams)
    {
        <tr class="row-divider">
            <td colspan="15">
                <b>@overtimeSummaryByTeam.Employee.Team.Name.ToUpper()</b>
            </td>
        </tr>

        IList<YearlyNexRequest> overtimeSummaries = Model.Where(t => t.Employee.Team.Id == overtimeSummaryByTeam.Employee.Team.Id).ToList();
        foreach (YearlyNexRequest overtimeSummary in overtimeSummaries)
        {
        <tr>

            <td>@(index++)</td>
            <td class="tooltip" title="@overtimeSummary.Employee.FullName">@overtimeSummary.Employee.NickName</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Jan)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Feb)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Mar)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Apr)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.May)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Jun)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Jul)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Aug)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Sep)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Oct)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Nov)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.Dec)</td>
            <td>@YearlyNexRequest.DisplayValue(overtimeSummary.TotalHour)</td>
        </tr>
        }
    }
}
else
{
    @RazorHelper.DisplayNoInformation(15)
}