@model IList<YearlyNexRequest>

<table id="data" class="table bordered striped highlight table-custom centered">
    <thead>
        <tr>
            <th rowspan="2">#</th>
            <th rowspan="2">@Labels.Nick</th>
            <th rowspan="2">@Labels.NEXType</th>
            <th colspan="12">@Labels.NexRequest @ViewBag.Year </th>
            <th rowspan="2">@Labels.Total</th>
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th>@Labels.Dec</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int index = 1;
            var nexType = "";
            IList<YearlyNexRequest> yearlyNexRequestByTeams = Model.GroupBy(t => t.Employee.Team.Id).Select(grp => grp.First()).ToList();
            foreach (YearlyNexRequest yearlyNexRequestByTeam in yearlyNexRequestByTeams)
            {
                <tr class="row-divider">
                    <td colspan="16">
                        <b>@yearlyNexRequestByTeam.Employee.Team.Name.ToUpper()</b>
                    </td>
                </tr>

                IList<YearlyNexRequest> yearlyNexRequests = Model.Where(t => t.Employee.Team.Id == yearlyNexRequestByTeam.Employee.Team.Id).ToList();
                IList<YearlyNexRequest> yearlyNexRequestByEmployeeIds = yearlyNexRequests.GroupBy(t => t.Employee.Id).Select(grp => grp.First()).ToList();
                foreach (YearlyNexRequest yearlyNexRequestByEmployeeId in yearlyNexRequestByEmployeeIds)
                {
                    IList<YearlyNexRequest> numberRequestOfPerson = Model.Where(t => t.Employee.Id == yearlyNexRequestByEmployeeId.Employee.Id).ToList();
                    int requestCount = numberRequestOfPerson.Count;
                    <tr>
                        <td rowspan="@requestCount">@(index++)</td>
                        <td class="tooltip align-left" rowspan="@requestCount" title="@yearlyNexRequestByEmployeeId.Employee.FullName">@yearlyNexRequestByEmployeeId.Employee.NickName</td>
                        @foreach (YearlyNexRequest yearlyNexRequest in numberRequestOfPerson)
                        {
                            if (yearlyNexRequest.IsHoliday == 1) { nexType = "isHoliday"; }
                            else
                            {
                                if (yearlyNexRequest.IsNormalDay == 1) { nexType = "isNormalday"; }
                                else
                                {
                                    if (yearlyNexRequest.IsOffDay == 1) { nexType = "isOffday"; }
                                    else { nexType = ""; }
                                }
                            }

                            if (yearlyNexRequest.IsHoliday == 1){<td class="align-left @nexType">@Labels.Holiday</td>}
                            else
                            {
                                if (yearlyNexRequest.IsNormalDay == 1){<td class="align-left @nexType">@Labels.NormalDay</td>}
                                else
                                {
                                    if (yearlyNexRequest.IsOffDay == 1){<td class="align-left @nexType">@Labels.OffDay</td>}
                                    else
                                    {<td></td>}
                                }
                            }
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Jan)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Feb)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Mar)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Apr)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.May)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Jun)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Jul)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Aug)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Sep)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Oct)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Nov)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.Dec)</td>
                            <td class="@nexType">@YearlyNexRequest.DisplayValue(yearlyNexRequest.TotalHour)</td>
                            if (requestCount > 1)
                            {
                            @:</tr><tr>
                            }
                        }
                    </tr>
                }
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(16)
        }
    </tbody>
</table>