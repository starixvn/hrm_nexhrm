@{
    ViewBag.Title = Labels.LateInEarlyOut;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/lateearlyjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">My Late in/Early out Notification</span>
                </div>
                <div class="card-body">
                    <div class="form">                        
                        <div class="row form-input">                                                        
                            <div class="col">
                                <div class="left label--s">
                                    <label>@Labels.Year</label>
                                </div>
                                <div class="left select--xs">
                                    @Html.YearPicker("Year", 2010, DateTime.Now.Year)
                                </div>
                            </div>
                            <div class="col m-l--m">
                                <a id="submit" class="btn-submit waves-effect waves-light m-r--b" href="javascript:;">@Labels.Submit</a>
                                <a class="btn-request waves-effect waves-light" href="@Url.Action("Create")">@Labels.Create</a>
                            </div>
                        </div>
                    </div>
                    <div id="listLateEarly" class="p-x--s">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>