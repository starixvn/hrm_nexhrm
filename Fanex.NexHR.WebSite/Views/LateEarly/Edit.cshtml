@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.LateInEarlyOut.LateInEarlyOutViewModel
@{
    ViewBag.Title = Labels.NewLateInEarlyOutNotification;
    var typesList = new SelectList(Model.TypesList, "Id", "Name");
}

@section Styles {
    <link rel="stylesheet" href="~/minify/css/myrequest.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Request/search.request.js" asp-append-version="true"></script>
        <script src="~/js/Views/LateInEarlyOut/create.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/createlateearly.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form list-item-form style-over">
                        <form action="/LateEarly/Edit" method="post" class="form-create-update">
                            @if (ViewBag.Requested != null && (bool)ViewBag.Requested)
                            {
                                <div class="row validation-summary-success">
                                    <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.RequestCreated
                                    <input type="hidden" id="successed" value="true" />
                                    <input type="hidden" id="year" value="@ViewBag.Year" />
                                </div>
                            }
                            <input type="hidden" name="Id" id="Id" value="@Model.Id"/>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label asp-for="@Model.EmpId">@Labels.Employee</label>
                                    </div>
                                    <div class="left input--m">
                                        <input type="hidden" name="EmpId" id="EmployeeId" value="@Model.EmpId"/>
                                        <input asp-for="@Model.Employee"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label asp-for="@Model.Types">@Labels.Type</label>
                                    </div>
                                    <div class="left select--m">
                                        <select asp-for="@Model.Types" asp-items="@typesList"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-t--s">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label asp-for="@Model.WorkDate">@Labels.Date</label>
                                    </div>
                                    <div class="datepicker-button left select--s">
                                        <date-picker
                                            name="WorkDate"
                                            min-date="DateTimeOffset.Now.DateTime.ToClientTimeZone()"
                                            max-date="Utilities.RequestAvailableToDate"
                                            value="Model.WorkDate"
                                        >
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon from-date left"></i>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left select-time">
                                        <span class="time hide">
                                            <select asp-for="WorkDate" asp-items="Utilities.TimeSteps(30)"></select>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--l">
                                        <label asp-for="@Model.Minutes">@Labels.Minutes</label>
                                    </div>
                                    <div class="left select--m">
                                        @{
                                            var minutesList = new List<SelectListItem>
                                            {
                                                new SelectListItem {Text = "30m", Value = "30", Selected = @Model.Minutes == 30},
                                                new SelectListItem {Text = "60m", Value = "60", Selected = @Model.Minutes == 60},
                                            };
                                            foreach (var item in minutesList)
                                            {
                                                <div class="radioButton">
                                                    <input class="with-gap" type="radio" name="Minutes" id="Minutes_@item.Value" value="@item.Value" checked="@item.Selected"/>
                                                    <label for="Minutes_@item.Value">@item.Text</label>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input line-button">
                                <div class="col m-b--m">
                                    <div class="left label--l">&nbsp;</div>
                                    <div class="left">
                                        <a href="@Url.Action("Index")" class="btn-back waves-effect waves-light">@Labels.Cancel</a>
                                        <input type="submit" class="btn-submit waves-effect waves-light right" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
