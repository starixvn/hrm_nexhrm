@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Postanal/postnatalemployee.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/postnatalemployee.min.js" asp-append-version="true"></script>
    </environment>
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">Postnatal Employee list</span>
                </div>
                <div class="card-body">
                    <div class="form form-postnatal">
                        <div class="row form-input">
                            <div class="col">
                                <div class="col m-r--m col-employee">
                                    <div class="left label--m">
                                        <label>Employee</label>
                                    </div>
                                    <div class="left input--m">
                                        @*<input name="Employee" id="Employee" placeholder="@Messages.SearchEmployeeWatermark"/>*@
                                        <input id="Employee" name="Employee" placeholder="@Messages.SearchEmployeeWatermark" type="text" class="ui-autocomplete-input" autocomplete="off">
                                        <input type="hidden" name="EmployeeId" id="EmployeeId"/>
                                    </div>
                                </div>
                                <div class="left label--s label-year">
                                    <label>@Labels.Year</label>
                                </div>
                                <div class="left select-- year">
                                    <select name="Year" id="Year" asp-items="@Extensions.YearPicker(2010, DateTimeOffset.Now.DateTime.ToClientTimeZone().Year, true)"></select> 
                                </div>
                            </div>
                            <div class="col m-l--m col-btn">
                                <a id="submit" class="btn-submit waves-effect waves-light m-r--b" href="javascript:;">@Labels.Submit</a>
                                <a class="btn-request waves-effect waves-light" href="@Url.Action("Create")">New Postnatal</a>
                            </div>
                        </div>
                    </div>
                    <div id="listPostnatalEmployee" class="p-x--s over-auto cover-form-mb table-postnatal">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
