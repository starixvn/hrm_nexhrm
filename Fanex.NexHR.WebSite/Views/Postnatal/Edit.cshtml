@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Postnatal;
@model PostnatalViewModel
@{
    ViewBag.Title = "Edit postnatal employee";
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/postnatal.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Postanal/create.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/createpostnatalemployee.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <form asp-controller="postnatal" asp-action="Edit" method="post" class="form-create-update">
                            <div asp-validation-summary="All"></div>
                            @if (ViewBag.Requested != null)
                            {
                                if ((bool)ViewBag.Requested)
                                {
                                    <div class="row validation-summary-success">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.RequestCreated
                                        <input type="hidden" id="successed" value="true" />
                                    </div>
                                }
                            }
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label for="Employee">@Labels.Employee</label>
                                    </div>
                                    <div class="left input--employee">
                                        <input type="hidden" asp-for="EmpId" id="EmployeeId" />
                                        <input type="hidden" asp-for="OldEmpId" id="OldEmployeeId" />
                                        <input asp-for="Nickname" id="Employee" />
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--l">
                                        <label>@Labels.Date</label>
                                    </div>
                                    <div class="datepicker-button input--s left m-r--l">
                                        <input type="hidden" asp-for="OldFromDate"/>
                                        <date-picker
                                            name="FromDate"
                                            value="@Model.FromDate"
                                            min-date="new DateTimeOffset(2010, 1, 1, 0, 0, 0, TimeSpan.Zero).DateTime"
                                        >
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                    <div class="datepicker-button input--s left">
                                        <date-picker
                                            name="ToDate"
                                            value="@Model.ToDate"
                                            min-date="new DateTimeOffset(2010, 1, 1, 0, 0, 0, TimeSpan.Zero).DateTime"
                                        >
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                        <input type="hidden" asp-for="OldToDate"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.Type</label>
                                    </div>
                                    <div class="left select--m">
                                        @for (var i = 0; i < Model.TypeList.Count; i++)
                                        {
                                            var id = "ChosenTypes" + @Model.TypeList[i].Value;
                                            <input checked="@Model.TypeList[i].Selected" class="filled-in" id="@id" name="ChosenTypes" type="checkbox" value="@Model.TypeList[i].Value">
                                            <label for="@id">@Model.TypeList[i].Text</label>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-t--m col-btn">
                                <div class="left label--xl">&nbsp;</div>
                                <div class="left">
                                    <a href="@Url.Action("Index")" class="btn-back waves-effect waves-light">@Labels.Cancel</a>
                                    <input type="submit" class="btn-submit waves-effect waves-light right" value="@Labels.Submit" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>