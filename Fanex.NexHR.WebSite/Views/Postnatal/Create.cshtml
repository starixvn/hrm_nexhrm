@using Fanex.NexHR.ViewModels.Postnatal;
@model PostnatalViewModel
@{
    ViewBag.Title = "Create new postnatal employee";
}
@section css{

}
@section js{
    @Scripts.Render("~/bundles/createpostnatalemployeejs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm("Create", "postnatal", FormMethod.Post, new { @class = "form-create-update" }))
                        {
                            @Html.ValidationSummary()
                            if (ViewBag.Requested != null)
                            {
                                if (ViewBag.Requested == true)
                                {
                                    <div class="row validation-summary-success">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.RequestCreated
                                        <input type="hidden" id="successed" value="true" />
                                    </div>
                                }
                            }
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.EmpId, Labels.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.HiddenFor(model => model.EmpId, htmlAttributes: new { @id = "EmployeeId" })
                                        @Html.Editor("Employee")
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--l">
                                        <label>@Labels.FromDate</label>
                                    </div>
                                    <div class="datepicker-button input--m left">
                                        @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.ToDate</label>
                                    </div>
                                    <div class="datepicker-button input--m left">
                                        @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 1, 1))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.ChosenTypes, Labels.Type)
                                    </div>
                                    <div class="left select--l">
                                        @Html.MaterializeCheckBoxListFor(model => model.ChosenTypes, Model.TypeList, new { @class = "filled-in left" })
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Minutes, Labels.Minutes)
                                    </div>
                                    <div class="left select--m">
                                        @{
                            var minutesList = new List<SelectListItem>
                                                {
                                                    new SelectListItem() {Text = "30m", Value = "30", Selected = true},
                                                    new SelectListItem() {Text = "60m", Value = "60"},
                                                };
                                        }
                                        @Html.RadioButtonList(model => model.Minutes, minutesList)
                                    </div>
                                </div>
                            </div>
                            <div class="row m-t--m">
                                <div class="left label--xl">&nbsp;</div>
                                <div class="left">
                                    <a href="@Url.Action("Index")" class="btn-back waves-effect waves-light">@Labels.Back</a>
                                    <input type="submit" class="btn-submit waves-effect waves-light right" value="@Labels.Save" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
