@model IList<PostnatalViewModel>
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Employee</th>
            <th>@Labels.FromDate</th>
            <th>@Labels.ToDate</th>
            <th>@Labels.Type</th>
            <th>@Labels.Minutes</th>
            <th>@Labels.ModifiedBy</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Edit</th>
            <th>@Labels.Delete</th>
        </tr>
    </thead>
    <tbody>
        @{int index = 1;}
        @if (Model.Any())
        {
            foreach (PostnatalViewModel item in Model)
            {
                <tr id="row_@(item.EmpId + item.FromDate.ToString() + item.ToDate.ToString())">
                    <td>@(index++)</td>
                    <td>
                        @item.Nickname
                    </td>
                    <td>@item.FromDate.Date.ToShortDateString()</td>
                    <td>@item.ToDate.Date.ToShortDateString()</td>
                    <td>
                        @item.Type
                    </td>
                    <td>@item.Minutes</td>
                    <td>@item.ModifiedDate.ToShortDateString()</td>
                    <td title="Edit">
                        <a href="/lateearly/Edit?empid=@item.EmpId + fromdate=@item.FromDate + &todate=@item.ToDate">
                            <i class='mdi mdi-border-color mdi-dark'></i>
                        </a>
                    </td>
                    <td title="Delete">
                        <a href="javascript:;" onclick="deleteRequest(@item.EmpId, @item.FromDate, @item.ToDate);">
                            <i class='mdi mdi-delete mdi-dark'></i>
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 8);
        }
    </tbody>
</table>