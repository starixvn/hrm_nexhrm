@model Fanex.NexHR.Models.CompanyEvent.CompanyEvent
@{
    ViewBag.Title = "Edit Event";
}
@section css {
    @Styles.Render("~/Content/companyevent")
}
@section js {
    @Scripts.Render("~/bundles/companyeventeditjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @{ Html.EnableClientValidation(false); }
                        @using (Html.BeginForm())
                        {
                            @Html.ValidationSummary()

                            if (ViewBag.Updated == true)
                            {
                                <div class="row validation-summary-success">
                                    <div class="col success green-text">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.UpdatedSuccessfully
                                    </div>
                                </div>
                                <input type="hidden" id="successed" value="true" />
                            }

                            <div class="row form-input m-t--s">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.LabelFor(m => m.Title)
                                    </div>
                                    <div class="left select--m">
                                        @Html.TextBoxFor(m => m.Title)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        @Html.LabelFor(m => m.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--m">
                                        @Html.DatePickerFor(m => m.FromDate, minDate: new DateTime(2010, 1, 1), maxDate: DateTime.Now.AddMonths(4))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(m => m.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--m">
                                        @Html.DatePickerFor(m => m.ToDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.Label("Duration")
                                    </div>
                                    <div class="left input">
                                        @{
                            if (Model.FromTime != "" && Model.ToTime != "")
                            {
                                @Html.MaterializeCheckBox("chkDuration", true, new { @class = "filled-in" })
                            }
                            else
                            {
                                @Html.MaterializeCheckBox("chkDuration", new { @class = "filled-in" })
                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            <div id="duration" style="display: none">
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.FromTime, Labels.FromTime)
                                        </div>
                                        <div class="left select--m">
                                            @Html.TextBoxFor(m => m.FromTime)
                                        </div>
                                    </div>
                                    <div class="col m-l--xl m-r--l">
                                        <div class="left label--m">
                                            @Html.LabelFor(model => model.ToTime, Labels.ToTime)
                                        </div>
                                        <div class="left input--m">
                                            @Html.TextBoxFor(m => m.ToTime)
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-t--s">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.LabelFor(m => m.Location)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(m => m.Location)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class='col'>
                                    <div class="left label--l">
                                        @Html.LabelFor(m => m.Description)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextAreaFor(m => m.Description, new { @class = "materialize-textarea" })
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        &nbsp;
                                    </div>
                                    <a class="btn-back waves-effect waves-light"
                                       href="@Url.Action("Index","CompanyEvent")">
                                        @Labels.Cancel
                                    </a>
                                    <input class="btn-submit waves-effect waves-light right" type="submit" value="@Labels.Submit" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
