@{
    ViewBag.Title = "Company Events";
}
@section css {
    @Styles.Render("~/Content/fullcalendarcss", "~/Content/eventcalendarcss", "~/Content/contextmenucss", "~/Content/view-mobile")
}
@section js {
    @Scripts.Render("~/bundles/fullcalendarjs", "~/bundles/companyeventjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="p-x--s m-t--m over-auto">
                        <div id="calendar" class="schedule">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
