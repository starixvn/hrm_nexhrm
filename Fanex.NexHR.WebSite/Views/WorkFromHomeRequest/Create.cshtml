@using Fanex.NexHR.ViewModels.Request;
@model WorkFromHomeRequestViewModel
@{
    ViewBag.Title = "Add Work From Home Request";
}
@section js{
    @Scripts.Render("~/bundles/workfromhomerequestjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        @using (Html.BeginForm("Create", "WorkFromHomeRequest", FormMethod.Post, new { @class = "form-create-update" }))
                        {
                            @Html.ValidationSummary()
                            if (ViewBag.Requested != null)
                            {
                                if (ViewBag.Requested == true)
                                {
                                    <div class="row validation-summary-success">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.RequestCreated
                                        <input type="hidden" id="successed" value="true" />
                                    </div>
                                }
                            }
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="datepicker-button input--s left m-r--l">
                                        @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FromDate, Labels.ToDate)
                                    </div>
                                    <div class="datepicker-button input--s left">
                                        @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 1, 1))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label for="Employee">@Labels.Remark</label>
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextAreaFor(model => model.Remark, new { @class = "materialize-textarea" })
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-t--m col-btn">
                                <div class="left label--xl">&nbsp;</div>
                                <div class="left">
                                    <a href="@Url.Action("Index")" class="btn-back waves-effect waves-light">@Labels.Cancel</a>
                                    <input type="submit" class="btn-submit waves-effect waves-light right" value="@Labels.Submit" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
