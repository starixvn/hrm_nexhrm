@model IList<Fanex.NexHR.Models.Team>
@{
    ViewBag.Title = "Team Management";
}
@section css {
}
@section js {
}
@section Breadcrumb {
}
<h2>@ViewBag.Title</h2>
<div class="button-icon">
    <span class="icon plus"></span>@Html.ActionLink("New Team", "Create")</div>
<div class="clear">
</div>
<div class="space">
</div>
<table class="data" style="width: auto; min-width: 600px;">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>@Labels.Code
            </th>
            <th>@Labels.Team
            </th>
            <th>@Labels.Leader
            </th>
            <th>@Labels.AssitantLeader
            </th>
            <th>
                @Labels.Edit
            </th>
            <th>
                @Labels.Delete
            </th>
        </tr>
    </thead>
    <tbody>
        @{int index = 1;}
        @foreach (Fanex.NexHR.Models.Team team in Model)
        {
            string assistantLeaderFullName = team.AssistantLeader != null ? team.AssistantLeader.FullName : string.Empty;
            string assistantLeaderNickName = team.AssistantLeader != null ? team.AssistantLeader.NickName : string.Empty;
            <tr id="row@(team.Id)">
                <td>@(index++)
                </td>
                <td>@team.Code
                </td>
                <td>@team.Name
                </td>
                <td class="tooltip" title="@team.Leader.FullName">@team.Leader.NickName
                </td>
                <td class="tooltip" title="@assistantLeaderFullName">@assistantLeaderNickName
                </td>
                <td class="cmd">
                    <a href="@Url.Action("Edit", "Team", new { Id = team.Id })">
                        <img src="~/Styles/Images/edit-icon.png" /></a>
                </td>
                <td class="cmd">
                    <a href="javascript:;" onclick="deleteTeam(@team.Id);">
                        <img src="~/Styles/Images/delete-icon.png" /></a>
                </td>
            </tr>

        }
    </tbody>
</table>