@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IList<Team>
@{
    ViewBag.Title = Labels.TeamManagement;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}

@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/TeamManagement/team.management.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/teammanagement.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="row m-t--m">
                        <div class="col">
                            <a class="btn-request waves-effect waves-light btn m-r--m" href="@Url.Action("Create", "Team")">
                                <i class="left mdi mdi-plus"></i>@Labels.NewTeam
                            </a>
                            <a class="btn-request waves-effect waves-light btn" href="@Url.Action("Index", "SupervisorFlow")">Flow Setting</a>
                        </div>
                    </div>
                    <div class="p-x--s m-t--m cover-form-mb table-team">
                        <table id="data" class="table bordered striped highlight centered responsive-table table-custom" style="width:60%">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Code</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.Edit</th>
                                    <th>@Labels.Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int index = 1;}
                                @foreach (var team in Model)
                                {
                                    <tr id="row@(team.Id)">
                                        <td>@(index++)</td>
                                        <td>@team.Code</td>
                                        <td class="align-left">@team.Name</td>
                                    <td class="cmd">
                                        <a href="@Url.Action("Edit", "Team", new { team.Id })">
                                            <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
                                        </a>
                                    </td>
                                    <td class="cmd">
                                        <a href="javascript:;" onclick="deleteTeam(@team.Id);">
                                            <i class="mdi mdi-delete mdi-dark mdi-18px"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>