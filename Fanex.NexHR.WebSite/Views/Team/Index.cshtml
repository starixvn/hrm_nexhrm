@model IList<Fanex.NexHR.Models.Team>
@{
    ViewBag.Title = Labels.TeamManagement;
}
@section css {
}
@section js {
    @Scripts.Render("~/bundles/teammanagementjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="row m-t--m">
                        <div class="col">
                            <a href="@Url.Action("Create", "Team")" class="white-text button-hrm waves-effect waves-light btn orange darken-1 m-r--s">
                                <i class="mdi mdi-plus left mdi-18px"></i>@Labels.NewTeam
                            </a>
                        </div>
                    </div>
                    <div class="p-x--s m-t--m">
                        <table class="table bordered striped highlight centered responsive-table table-custom">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@Labels.Code</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.Leader</th>
                                    <th>@Labels.AssitantLeader</th>
                                    <th>@Labels.Edit</th>
                                    <th>@Labels.Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int index = 1;}
                                @foreach (Fanex.NexHR.Models.Team team in Model)
                                {
                                    string assistantLeaderFullName = team.AssistantLeader != null ? team.AssistantLeader.FullName : string.Empty;
                                    string assistantLeaderNickName = team.AssistantLeader != null ? team.AssistantLeader.NickName : string.Empty;
                                    <tr id="row@(team.Id)">
                                        <td>@(index++)</td>
                                        <td>@team.Code</td>
                                        <td>@team.Name</td>
                                        <td class="tooltip" title="@team.Leader.FullName">@team.Leader.NickName</td>
                                        <td class="tooltip" title="@assistantLeaderFullName">@assistantLeaderNickName
                                        </td>
                                        <td class="cmd center">
                                            <a href="@Url.Action("Edit", "Team", new { Id = team.Id })">
                                                <i class="mdi mdi-border-color mdi-dark mdi-18px"></i></a>
                                        </td>
                                        <td class="cmd center">
                                            <a href="javascript:;" onclick="deleteTeam(@team.Id);">
                                                <i class="mdi mdi-delete mdi-dark mdi-18px"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
