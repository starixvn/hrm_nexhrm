@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model TeamViewModel
@{
    ViewBag.Title = Labels.Team;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/TeamManagement/team.management.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/teammanagement.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Edit</span>
                </div>
                <div class="card-body">
                    @if (Model != null)
                    {
                        <div class="form form-stl-table">
                            @using (Html.BeginForm("edit", "team", FormMethod.Post, new { @class = "form-create-edit" }))
                            {
                                @Html.ValidationSummary()
                                if (ViewBag.Updated == true)
                                {
                                    <input type="hidden" id="successed" value="true" />
                                    <div class="row validation-summary-success">
                                        <div class="col success green-text">
                                            <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.TeamUpdated
                                        </div>
                                    </div>
                                }
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.TeamCode)
                                        </div>
                                        <div class="left input--m">
                                            @Html.EditorFor(model => model.TeamCode)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.TeamName)
                                        </div>
                                        <div class="left input--m">
                                            @Html.EditorFor(model => model.TeamName)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.Leader)
                                        </div>
                                        <div class="left input--m">
                                            @Html.TextBox("Leader", Model.Leader, new { placeholder = Messages.SearchEmployeeWatermark })
                                            @Html.HiddenFor(model => model.Leader)
                                            @Html.HiddenFor(model => model.LeaderId)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.AssistantLeader)
                                        </div>
                                        <div class="left input--m">
                                            @Html.TextBox("AssistantLeader", Model.AssistantLeader, new { placeholder = Messages.SearchEmployeeWatermark })
                                            @Html.HiddenFor(model => model.AssistantLeader)
                                            @Html.HiddenFor(model => model.AssistantLeaderId)
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.DepartmentId)
                                        </div>
                                        <div class="left select--m">
                                            @Html.DropDownListFor(model => model.DepartmentId, new SelectList(Model.Departments, "Id", "Name"), "-- " + Messages.SelectDepartment + " --")
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--l">
                                            @Html.LabelFor(model => model.ParentId)
                                        </div>
                                        <div class="left select--m">
                                            @Html.DropDownListFor(model => model.ParentId, new SelectList(Model.Teams, "Id", "Name"), "-- " + Messages.SelectParentTeam + " --")
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input line-button">
                                    <div class="col">
                                        <div class="left label--l">&nbsp;</div>
                                        <div class="left">
                                            <a class="btn-cancel waves-effect waves-light" href="@Url.Action("index", "team")">@Labels.Cancel</a>
                                            <input class="btn-submit waves-effect waves-light right" type="submit" value="@Labels.Submit" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <h2>@Messages.NoDataIsAvailable</h2>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
