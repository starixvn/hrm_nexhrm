@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model TeamViewModel
@{
    ViewBag.Title = Labels.Team;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}

@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/TeamManagement/team.management.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/teammanagement.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Create</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <form asp-controller="team" asp-action="create" method="post" class = "form-create-edit">
                            <div asp-validation-summary="All"></div>
                            @if (ViewBag.Inserted == true)
                            {
                                <input type="hidden" id="successed" value="true" />
                                <div class="row validation-summary-success">
                                    <div class="col success green-text">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.TeamCreated
                                    </div>
                                </div>
                            }
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.Code</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="TeamCode"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.Name</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="TeamName"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>@Labels.Department</label>
                                    </div>
                                    <div class="left select--m"> 
                                        <select asp-for="DepartmentId" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))">
                                            <option value="">-- @Messages.SelectDepartment --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--l">
                                        <label>@Labels.ParentTeam</label>
                                    </div>
                                    <div class="left select--m">
                                        <select asp-for="ParentId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                            <option value="">-- @Messages.SelectParentTeam --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input line-button">
                                <div class="col">
                                    <div class="left label--l">&nbsp;</div>
                                    <div class="left">
                                        <a class="btn-back waves-effect waves-light" href="@Url.Action("index", "team")">@Labels.Cancel</a>
                                        <input class="btn-submit waves-effect waves-light right" type="submit" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>