@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Core
@using Fanex.NexHR.ViewModels.TrainingAndDevelopment
@model TrainingAndDevelopmentCreateViewModel
@{
    DateTime currentDate = DateTime.Today;
    var types = ViewBag.Types;
}
<form id="frmAddTrainingAndDevelopment" class="form form-add-training-and-development">
    <div id="divErrorCont" class="">
        &nbsp;
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Employee">@Labels.Employee</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <input asp-for="Employee" placeholder="@Messages.SearchEmployeeWatermark" />
            <input asp-for="EmployeeId" type="hidden" />
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label>@Labels.Type</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <select class="typeTrainingAndDevelopment" name="TypeId" id="typeId" asp-items="@(new SelectList(types, "Id", "Name"))">
            </select>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label>@Labels.Publish</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <select class="typeTrainingAndDevelopment" name="Publish" id="publish">
                <option value="@Constants.Public">Public</option>
                <option value="@Constants.Protected">Protected</option>
                <option value="@Constants.Private">Private</option>
            </select>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Name">@Labels.Name</label>
            <i class="require">*</i>

        </div>
        <div class="left input--m">
            <input asp-for="Name"/>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Organization">@Labels.Organization</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <input asp-for="Organization"/>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label asp-for="ConductedBy">@Labels.ConductedBy</label>
        </div>
        <div class="left input--m">
            <input asp-for="ConductedBy"/>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label asp-for="Description">@Labels.Description</label>
        </div>
        <div class="left input--m">
            <textarea class="description textarea" asp-for="Description"/>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label id="fromdate">@Labels.StartDate</label>
            <i class="require">*</i>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="FromDatePopup"
                         min-date="currentDate.AddYears(-100)"
                         value="currentDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label id="todate">@Labels.EndDate</label>
            <i id="to-date-require" class="require">*</i>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="ToDatePopup"
                         min-date="currentDate.AddYears(-100)"
                         value="currentDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
</form>