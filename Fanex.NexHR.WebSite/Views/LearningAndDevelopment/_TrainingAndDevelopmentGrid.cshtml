@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model IList<TrainingAndDevelopment>
@{
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
    var count = 0;
    const string Certificate = "Certificates";
    const string FormatDate = "dd MMM yyyy";
    const string TestDate = "- Test Date:";
    const string ExpirationDate = ", Expiration Date: ";
    const string StartDate = "- Start Date:";
    const string EndDate = ", End Date: ";
    const string ConductedBy = "- Conducted By:";
    const string dirCertificate = "common_files/certificates";
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th style="width:4%">#</th>
            <th style="width:12%">@Labels.FullName</th>
            <th style="width:7%">@Labels.EnglishName</th>
            <th style="width:7%">@Labels.Team</th>
            <th style="width:7%">@Labels.Type</th>
            <th style="width:18%">@Labels.Name</th>
            <th style="width:12%">@Labels.Organization</th>
            <th style="width:25%">@Labels.Details</th>
            <th style="width:3%">@Labels.Certificate</th>
            @if (isHRRole)
            {
                <th style="width:5%">@Labels.Action</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                count++;
                var fromDate = item.TypeName.Equals(Certificate) ? item.ExamDate.ToString(FormatDate) : item.StartDate.ToString(FormatDate);
                var toDate = item.TypeName.Equals(Certificate) ? item.ExpirationDate.ToString(FormatDate) : item.EndDate.ToString(FormatDate);
                var titleFromDate = item.TypeName.Equals(Certificate) ? TestDate : StartDate;
                var titleToDate = item.TypeName.Equals(Certificate) ? ExpirationDate : EndDate;
                <tr>
                    <td>@count</td>
                    <td class="content-left">@item.FullName</td>
                    <td>@item.NickName</td>
                    <td>@item.TeamCode</td>
                    <td>@item.TypeName</td>
                    <td class="content-left">@item.Name</td>
                    <td>@item.Organization</td>
                    <td class="content-left">
                        <div class="row row-detail">
                            <div class="col col-content-detail">
                                @if (item.ConductedBy != null)
                                {
                                    <div class="detail">
                                        <span>
                                            <span>@ConductedBy</span>
                                            <span class="bold">@item.ConductedBy</span>
                                        </span>
                                    </div>
                                }
                                <div class="detail">
                                    <span>
                                        <span>@titleFromDate</span>
                                        <span class="bold">@fromDate</span>
                                        @if (!toDate.Equals(DateTime.MinValue.ToString(FormatDate)))
                                        {
                                            <span>@titleToDate</span>
                                            <span class="bold">@toDate</span>
                                        }
                                    </span>

                                </div>
                                @if (item.Description != null)
                                {
                                    <div class="detail">
                                        <span>- @item.Description</span>
                                    </div>
                                }
                            </div>
                            <div title="@item.Publish" class="col icon icon-@item.Publish"  />
                        </div>
                    </td>
                    <td class="col-certificate">
                        @if (!string.IsNullOrEmpty(item.Certificate))
                        {
                            <a class="icon-certificate" href="@($"{dirCertificate}/{item.Certificate}")"></a>
                        }
                    </td>
                    @if (isHRRole)
                    {
                        <td class="action-column">
                            <a href="javascript:;" class="btn_update" data-id="@item.Id">
                                <i class='mdi mdi-border-color mdi-edit mdi-dark' style="top: 5px"></i>
                            </a>
                            <a href="javascript:;" onclick="deleteRequest(@item.Id);">
                                <i class='mdi mdi-delete mdi-dark'></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" rowspan="2">
                    @Messages.NoInformation
                </td>
            </tr>
        }
    </tbody>
</table>