@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@model IList<CourseAndCertificate>
@{
    var count = 0;
    const string certificate = "Certificate";
    const string formatDate = "dd MMM, yyyy";
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th style="width:4%">#</th>
            <th style="width:15%">Department</th>
            <th style="width:8%">@Labels.NickName</th>
            <th style="width:8%">Type</th>
            <th style="width:20%">Name</th>
            <th style="width:20%">Organization</th>
            <th style="width:20%">Detail</th>
            <th style="width:5%">@Labels.Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                count++;
                var fromDate = item.Type.Equals(certificate) ? item.ExamDate.ToString(formatDate) : item.StartDate.ToString(formatDate);
                var toDate = item.Type.Equals(certificate) ? item.ExpirationDate.ToString(formatDate) : item.EndDate.ToString(formatDate);
                var titleFromDate = item.Type.Equals(certificate) ? "Exam Date" : "Start Date";
                var titleToDate = item.Type.Equals(certificate) ? "Expiration Date" : "End Date";
                <tr>
                    <td>@count</td>
                    <td>@item.Department</td>
                    <td>@item.NickName</td>
                    <td>@item.Type</td>
                    <td>@item.Name</td>
                    <td>@item.Organization</td>
                    <td class="detail">
                        <div class="fromdate tooltip">
                            @fromDate
                            <span class="tooltiptext">@titleFromDate</span>
                        </div>
                        <div class="linedate">-</div>
                        <div class="todate tooltip">@toDate
                            <span class="tooltiptext">@titleToDate</span>
                        </div>
                    </td>
                    <td class="action-column">
                        <a href="javascript:;" class="btn_update" data-id="@item.Id">
                            <i class='mdi mdi-border-color mdi-edit mdi-dark' style="top: 5px"></i>
                        </a>
                        <a href="javascript:;" onclick="deleteRequest(@item.Id);">
                            <i class='mdi mdi-delete mdi-dark'></i>
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8"></td>
            </tr>
            <tr>
                <td colspan="8" rowspan="2">
                    @Messages.NoInformation
                </td>
            </tr>
        }
    </tbody>
</table>