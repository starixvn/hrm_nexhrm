@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@model IList<CourseAndCertificate>
@{
    var count = 0;
    const string certificate = "Certificate";
    const string formatDate = "dd MMM, yyyy";
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th style="width:4%">#</th>
            <th style="width:12%">Full Name</th>
            <th style="width:7%">@Labels.NickName</th>
            <th style="width:7%">Team</th>
            <th style="width:7%">Type</th>
            <th style="width:18%">Name</th>
            <th style="width:16%">Organization</th>
            <th style="width:24%">Detail</th>
            <th style="width:5%">@Labels.Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                count++;
                var fromDate = item.Type.Equals(certificate) ? item.ExamDate.ToString(formatDate) : item.StartDate.ToString(formatDate);
                var toDate = item.Type.Equals(certificate) ? item.ExpirationDate.ToString(formatDate) : item.EndDate.ToString(formatDate);
                var titleFromDate = item.Type.Equals(certificate) ? "Test Date:" : "Start Date:";
                var titleToDate = item.Type.Equals(certificate) ? ", Expiration Date: " : ", End Date: ";
                <tr>
                    <td>@count</td>
                    <td style="text-align: left;">@item.FullName</td>
                    <td>@item.NickName</td>
                    <td>@item.TeamCode</td>
                    <td>@item.Type</td>
                    <td style="text-align: left;">@item.Name</td>
                    <td style="text-align: left;">@item.Organization</td>
                    <td>
                        @if (item.ConductedBy != null)
                        {
                            <div class="detail">
                                <p>- Conducted By:</p>
                                <p class="bold">@item.ConductedBy</p>
                            </div>
                        }
                        <div class="detail">
                            <p>- @titleFromDate</p>
                            <p class="bold">@fromDate</p>
                            <p>@titleToDate</p>
                            <p class="bold">@toDate</p>
                        </div>
                        @if(item.Description != null)
                        {
                            <div class="detail">
                                <p>- @item.Description</p>
                            </div>
                        }
                    </td>
                    <td class="action-column">
                        <a href="javascript:;" class="btn_update" data-id="@item.Id">
                            <i class='mdi mdi-border-color mdi-edit mdi-dark' style="top: 5px"></i>
                        </a>
                        <a href="javascript:;" onclick="deleteRequest(@item.Id);">
                            <i class='mdi mdi-delete mdi-dark'></i>
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8"></td>
            </tr>
            <tr>
                <td colspan="8" rowspan="2">
                    @Messages.NoInformation
                </td>
            </tr>
        }
    </tbody>
</table>