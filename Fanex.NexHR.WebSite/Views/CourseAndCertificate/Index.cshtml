@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.CourseAndCertificate
@model CourseAndCertificateFilterViewModel
@{
    DateTime currentDate = DateTime.Today;
    ViewBag.Title = Labels.TrainingInformation;
}
@section Styles {
    <link rel="stylesheet" href="~/css/Views/course-and-certificate.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/contextmenu.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/simplepagination.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/CourseAndCertificate/courseandcertificate.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
        <script src="~/js/Libs/jquery.contextMenu.min.js" asp-append-version="true"></script>
        <script src="~/js/Libs/jquery.simplePagination.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/courseandcertificate.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/simplepagination.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <form asp-controller="CourseAndCertificate" asp-action="index" method="post">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.FromDate</label>
                                    </div>
                                    <div class="left datepicker-button select--m">
                                        <i class="mdi-action-event calendar-icon left"></i>
                                        <date-picker name="FromDate"
                                                     min-date="currentDate.AddYears(-100)"
                                                     value="currentDate.AddDays(-7)">
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.ToDate</label>
                                    </div>
                                    <div class="left datepicker-button select--m">
                                        <date-picker name="ToDate"
                                                     min-date="currentDate.AddYears(-100)"
                                                     value="currentDate">
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>Type</label>
                                    </div>
                                    <div class="left select--datepicker type">
                                        <select name="Type" id="Type">
                                            <option value="">All</option>
                                            <option value="Course">Course</option>
                                            <option value="Certificate">Certificate</option>
                                            <option value="Training">Training</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>Name</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="Name" maxlength="200" />
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.Team</label>
                                    </div>
                                    <div class="left select--m team">
                                        <select asp-for="TeamId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                            <option value="">All teams</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.Employee</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="Employee" placeholder="@Messages.SearchEmployeeWatermark" />
                                        <input type="hidden" asp-for="EmployeeId" />
                                    </div>
                                </div>
                                <div class="col m-l--l">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light m-r--b" />
                                    @if (ViewBag.HasHRRole)
                                    {
                                        <a class="btn-request waves-effect waves-light m-r--m left" href="javascript:;" id="btnAddNew">Add New</a>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="p-x--s">
                        <div id="list-data" class="over-auto table-resize table-medium"></div>
                    </div>
                    <div id="dialog-addnew" title="Add New" style="display:none">&nbsp;</div>
                    <div id="dialog-update" title="Update" style="display:none">&nbsp;</div>
                </div>
            </div>
        </div>
    </div>
</div>