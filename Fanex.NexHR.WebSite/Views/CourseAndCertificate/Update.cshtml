@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.CourseAndCertificate
@model CourseAndCertificateViewModel
@{
    DateTime currentDate = DateTime.Today; 
    var types = ViewBag.Types;
}
<form id="frmUpdateCourseAndCertificate" class="form form-update-course-and-certificate">
    <div id="divErrorCont" class="">
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Employee">@Labels.Employee </label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <input asp-for="Employee" disabled value="@Model.Employee" placeholder="@Messages.SearchEmployeeWatermark" />
            <input asp-for="EmployeeId" type="hidden" />
            <input asp-for="Id" type="hidden" value="@Model.Id" />
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label>Type</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <select class="typeCourseAndCertificate" name="TypeId" id="typeId" asp-items="@(new SelectList(types, "Id", "Name",Model.TypeId))">
            </select>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Name">Name</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <input asp-for="Name" value="@Model.Name" />
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="Organization">Organization</label>
            <i class="require">*</i>
        </div>
        <div class="left input--m">
            <input asp-for="Organization" value="@Model.Organization" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label asp-for="ConductedBy">Conducted By</label>
        </div>
        <div class="left input--m">
            <input asp-for="ConductedBy" value="@Model.ConductedBy" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label asp-for="Description">Description</label>
        </div>
        <div class="left input--m">
            <textarea class="description textarea" asp-for="Description">@Model.Description</textarea>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="ExamDate" id="fromdate">Start Date</label>
            <i class="require">*</i>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="ExamDate"
                         min-date="currentDate.AddYears(-100)"
                         value="@Model.ExamDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="display-flex left label--l">
            <label asp-for="ExpirationDate" id="todate">End Date</label>
            <i class="require">*</i>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="ExpirationDate"
                         min-date="currentDate.AddYears(-100)"
                         value="@Model.ExpirationDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
</form>