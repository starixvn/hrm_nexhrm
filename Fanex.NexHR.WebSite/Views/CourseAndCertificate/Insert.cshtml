@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.CourseAndCertificate
@model CourseAndCertificateViewModel
@{
    DateTime currentDate = DateTime.Today;
}
<form id="frmAddCourseAndCertificate" class="form form-add-course-and-certificate">
    <div id="divErrorCont" class="">
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Employee <i class="require">*</i></label>
        </div>
        <div class="left input--m">
            <input asp-for="Employee" placeholder="@Messages.SearchEmployeeWatermark" />
            <input asp-for="EmployeeId" type="hidden" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>Type</label>
        </div>
        <div class="left input--m">
            <select class="typeCourseAndCertificate" name="Type" id="typeId">
                <option value="Course">Course</option>
                <option value="Certificate">Certificate</option>
                <option value="Training">Training</option>
            </select>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>Name <i class="require">*</i></label>
        </div>
        <div class="left input--m">
            <input asp-for="Name" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>ConductedBy</label>
        </div>
        <div class="left input--m">
            <input asp-for="ConductedBy" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>Organization <i class="require">*</i></label>
        </div>
        <div class="left input--m">
            <input asp-for="Organization" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>Description</label>
        </div>
        <div class="left input--m">
            <textarea class="description textarea" asp-for="Description" />
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label id="fromdate">Start Date</label>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="StartDate"
                         min-date="currentDate.AddYears(-100)"
                         max-date="currentDate" 
                         value="currentDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label id="todate">End Date</label>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="EndDate"
                         min-date="currentDate.AddYears(-100)"
                         max-date="currentDate"
                         value="currentDate">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
</form>