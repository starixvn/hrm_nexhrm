@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Request
@model IList<RequestEntity>
@{
    ViewBag.Title = Labels.LeaveRequest;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render("~/bundles/leavejs")
}
@section Breadcrumb {
}
<div class="row content">
    @using (Html.BeginForm("employeeview", "leave", FormMethod.Post, new { @class = "page" }))
    {
        <div class="col s12 card-container-base my-request">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                    </div>
                    <div class="card-body">
                        <div class="form">
                            <div class="row form-input">
                                <input type="hidden" value="Leave" id="RequestType" />
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label>
                                            @Labels.Year
                                        </label>
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPicker("Year", 2010, (int)ViewBag.Year)
                                    </div>
                                </div>
                                <div class="col button">
                                    <span class="button-hrm waves-effect waves-light btn blue darken-2"><input type="submit" id="submit" value="@Labels.Submit" /></span>
                                </div>
                                <div>
                                    <a href="@Url.Action("Create")" class="button-hrm waves-effect waves-light btn orange darken-1">@Labels.LeaveRequests</a>
                                </div>
                            </div>
                        </div>
                        <div class="p-x--s">
                             <table class="table bordered striped highlight table-custom" id="data">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>@Labels.Employee
                                        </th>
                                        <th>@Labels.Team
                                        </th>
                                        <th>@Labels.LeaveType
                                        </th>
                                        <th>@Labels.From
                                        </th>
                                        <th>@Labels.To
                                        </th>
                                        <th>@Labels.Total
                                        </th>
                                        <th>@Labels.CreatedDate
                                        </th>
                                        <th>@Labels.Remark
                                        </th>
                                        <th>@Labels.Status
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{int index = 1;}
                                    @if (Model.Count > 0)
                                    {
                                        foreach (RequestEntity request in Model)
                                        {
                                        <tr id="row@(request.Id)">
                                            <td class='center'>@(index++)
                                            </td>
                                            <td class="tooltip" title="@request.Requester.FullName">
                                                @request.Requester.NickName
                                            </td>
                                            <td class="tooltip" title="@request.Requester.Team.Name">@request.Requester.Team.Code
                                            </td>
                                            <td>@request.LeaveType.Name
                                            </td>
                                            @if (request.TotalDays == (decimal)0.5)
                                            {
                                                <td class="highlight">@request.FromDate.ToShortFormatedDate()
                                                </td>
                                                <td class="highlight">@request.ToDate.ToShortFormatedDate()
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="highlight">@request.FromDate.ToDateMonthYearFormatedDate()
                                                </td>
                                                <td class="highlight">@request.ToDate.ToDateMonthYearFormatedDate()
                                                </td>
                                            }
                                            <td class="highlight center">@request.TotalDays.ToString("0.0")
                                            </td>
                                            <td class="tooltip" title="@request.CreatedDate.ToShortFormatedDate()">
                                                @request.CreatedDate.ToDateMonthYearFormatedDate()
                                            </td>
                                            @if (!string.IsNullOrWhiteSpace(request.Remark))
                                            {
                                                <td class="tooltip center" title="@request.Remark">
                                                    <span class="mdi mdi-message-text" alt="remark" />
                                                </td>
                                            }
                                            else
                                            {
                                                <td class='center'>
                                                    -
                                                </td>
                                            }
                                            @if (request.Status.ToString() == RequestStatuse.Pending.ToString())
                                            {
                                                <td>
                                                    <a requestid="@request.Id" href="javascript:;" class="@request.Status.ToString() c-pedding">@request.Status.ToString()</a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="tooltip c-approve" title="@request.Status.Name by @request.ModifiedBy.NickName (@request.ModifiedDate.ToShortFormatedDate())">@request.Status.ToString()
                                                </td>
                                            }
                                        </tr>
                                        }
                                    }
                                    else
                                    {
                                        @RazorHelper.DisplayNoInformation(colspan: 10);
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @RazorHelper.EmployeeProcessMenu()
</div>