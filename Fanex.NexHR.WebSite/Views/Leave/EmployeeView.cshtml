@{
    ViewBag.Title = Labels.MyLeaveRequestSummary;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render("~/bundles/contextmenujs", "~/bundles/leavejs")
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <div class="row form-input">
                            <input type="hidden" value="Leave" id="RequestType" />
                            <div class="col m-r--m">
                                <div class="left label--s">
                                    <label>@Labels.Year</label>
                                </div>
                                <div class="left select--xs">
                                    @Html.YearPicker("Year", 2010, DateTime.Now.Year)
                                </div>
                            </div>
                            <div class="col">
                                <a id="submit" class="btn-submit waves-effect waves-light m-r--s" href="javascript:;">@Labels.Submit</a>
                                <a class="btn-request waves-effect waves-light" href="@Url.Action("Create")">@Labels.LeaveRequests</a>
                            </div>
                        </div>
                    </div>
                    <div class="p-x--s">
                            <table class="table bordered striped highlight centered responsive-table table-custom" id="data">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Employee</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.LeaveType</th>
                                    <th>@Labels.From</th>
                                    <th>@Labels.To</th>
                                    <th>@Labels.TotalDays</th>
                                    <th>@Labels.CreatedDate</th>
                                    <th>@Labels.Remark</th>
                                    <th>@Labels.Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script id="template" type="text/x-jquery-tmpl">
    <tr class="row_${Id}">
        <td>${index()}</td>
        <td class="tooltip" title="${Requester.FullName}">
            ${Requester.NickName}
        </td>
        <td class="tooltip" title="${Requester.Team.Name}">
            ${Requester.Team.Code}
        </td>
        <td>
            ${LeaveType.Name}
        </td>
        {{if TotalDays == 0.5}}
            <td class="highlight">${formatJsonDateToShortFormatedDate(FromDate)}</td>
            <td class="highlight">${formatJsonDateToShortFormatedDate(ToDate)}</td>
        {{else}}
            <td class="highlight">${formatJsonDate(FromDate, 'dd MMM, yyyy')}</td>
            <td class="highlight">${formatJsonDate(ToDate, 'dd MMM, yyyy')}</td>
        {{/if}}
        <td class="highlight center">${formatTotalDays(TotalDays)}</td>
        <td class="tooltip" title="${formatJsonDateToShortFormatedDate(CreatedDate)}">
            ${formatJsonDate(CreatedDate, 'dd MMM, yyyy')}
        </td>
        {{if Remark.length > 0}}
            <td class="tooltip" title="${Remark}">
                <span class="mdi mdi-message-text" alt="remark" />
            </td>
        {{else}}
            <td>-</td>
        {{/if}}
        {{if Status.Name == 'Pending'}}
            <td class="tooltip" title="${Remark}">
                <a requestid="${Id}" href="javascript:;" class="${Status.Name} c-pending">
                    ${Status.Name}<i class="mdi-navigation-arrow-drop-down"></i>
                </a>
            </td>
        {{else}}
            <td class="tooltip c-approve" title="${Status.Name} by ${ModifiedBy.NickName} (${formatJsonDateToShortFormatedDate(ModifiedDate)})">${Status.Name}</td>
        {{/if}}
    </tr>
</script>