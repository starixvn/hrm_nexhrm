@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model LeaveRequestViewModel
@{
    ViewBag.Title = Labels.NewLeaveRequest;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/leavejs")
}
@section Breadcrumb {
}
<div class="row content">
    <h6 class="title-page txt-uppercase">@ViewBag.Title</h6>
    <div class="col s6">
        <a style="float: right;" id="legendInfo" href="javascript:;">
            <span class="tooltip icon icon-shiftinfo"></span>
        </a>
        @using (Html.BeginForm("create", "leave", FormMethod.Post, new { @class = "card blue-grey lighten-5" }))
        {
            @Html.ValidationSummary()

            if (ViewBag.Requested == true)
            {
            <div class="success">@Messages.RequestCreated</div>
            <input type="hidden" id="successed" value="true" />
            <input type="hidden" id="year" value="@ViewBag.Year" />
            }
            @Html.HiddenFor(model => model.EmployeeId)

            if (ViewBag.TotalRequest > 0)
            {
            <div class="ui-state-error ui-corner-all" style="padding: 0 .7em;">
                <p>
                    <a href="@Url.Action("EmployeeView")">You've already requested for Leave <strong>@ViewBag.TotalRequest
                        day(s)</strong> in @DateTime.Now.ToString("MMM yyyy")</a>
                </p>
            </div>
            }
            <div class="card-content">
                <div class="row form-input">
                    <div class="left label-80">
                        @Html.LabelFor(model => model.LeaveTypeId, Labels.LeaveType)
                    </div>
                    <div class="left select-small">
                        @Html.DropDownListFor(model => model.LeaveTypeId, new SelectList(ViewBag.LeaveTypes, "Id", "Name"))
                        @Html.HiddenFor(model => model.LeaveTypeName)
                    </div>
                </div>
                <div class="row form-input">
                    <div class="left label-80">
                        @Html.LabelFor(model => model.HalfDayOff, Labels.HalfDayOff)
                    </div>
                    <div class="left">
                        @Html.CheckBoxFor(model => model.HalfDayOff, new { @class = "filled-in" })
                    </div>
                </div>
                <div class="row form-input">
                    <div class="left label-80">
                        @Html.LabelFor(model => model.Employee, Labels.Employee)
                    </div>
                    <div class="left">
                        @Html.EditorFor(model => model.Employee)
                    </div>
                </div>
                <div class="row form-input">
                    <div class="left label-80">
                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                    </div>
                    <div class="datepicker-button left">
                        @Html.DatePickerFor(model => model.FromDate, Utilities.RequestAvailableFromDate,
                        Utilities.RequestAvailableToDate,
                        unavailDates: (IEnumerable<DateTime>)ViewBag.UnavailDates)
                        <i class="mdi-action-event calendar-icon left"></i>
                        <span class="time hide">
                            @Html.DropDownList("FromTime", Utilities.TimeSteps(30))
                        </span>
                    </div>
                </div>
                <div class="row form-input">
                    <div class="left label-80">
                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                    </div>
                    <div class="datepicker-button left">
                        @Html.DatePickerFor(model => model.ToDate, unavailDates: (IEnumerable<DateTime>)ViewBag.UnavailDates)
                        <i class="mdi-action-event calendar-icon left"></i>
                        <span class="time hide">
                            @Html.DropDownList("ToTime", Utilities.TimeSteps(30))
                        </span>
                    </div>
                </div>
                <div class="row form-input">
                    <div class="left label-80">
                        @Html.LabelFor(model => model.TotalDays, Labels.TotalDays)
                    </div>
                    <div class="left">
                        @Html.EditorFor(model => model.TotalDays)
                    </div>
                </div>
                <div class="row form-input">
                    <div class="left label-80">
                        @Html.LabelFor(model => model.Remark)
                    </div>
                    <div class="left">
                        @Html.TextAreaFor(model => model.Remark, new { @class = "materialize-textarea" })
                    </div>
                </div>
                @Html.HiddenFor(model => model.DisplayName)
                @Html.HiddenFor(model => model.ForRequest)
            </div>
            <div class="card-action center-align">
                <input type="submit" value="@Labels.Request" class="button-hrm btn white-text blue darken-2 z-depth-2" />
                <a href="@Url.Action("employeeview", "leave")" class="button-hrm btn white-text blue darken-2 z-depth-2">@Labels.Back</a>
            </div>
        }
    </div>
    <div class="hide">
        @RazorHelper.RequestLeaveLegend()
    </div>
</div>