@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model LeaveRequestViewModel
@{
    ViewBag.Title = Labels.MyLeaveRequest;
    var listLeaveTypes = new SelectList(Model.LeaveTypes, "Id", "Name");
}
@section Styles {
<link rel="stylesheet" href="~/minify/css/myrequest.min.css" asp-append-version="true">
}
@section Scripts {
<environment include="Development">
    <script src="~/js/Libs/jquery.contextMenu.min.js" asp-append-version="true"></script>
    <script src="~/js/Views/Request/leave.request.js" asp-append-version="true"></script>
    <script src="~/js/Views/Request/process.leave-checkinout.byemployee.js" asp-append-version="true"></script>
    <script src="~/js/Views/Request/search.request.js" asp-append-version="true"></script>
</environment>
<environment exclude="Development">
    <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
    <script src="~/minify/js/leave.min.js" asp-append-version="true"></script>
</environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Edit</span>
                </div>
                <div class="card-body">
                    <div class="form list-item-form">
                        <form asp-controller="leave" asp-action="update" method="post" class="form-create-update">
                            <div asp-validation-summary="All"></div>
                            @if (ViewBag.Updated == true)
                            {
                                <div class="row validation-summary-success">
                                    <div class="col success green-text"><i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.RequestUpdated</div>
                                    <input type="hidden" id="successed" value="true" />
                                    <input type="hidden" id="year" value="@ViewBag.Year" />
                                </div>
                            }
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left text-legend">
                                        ※ In <span id='lblMonth'>{0}</span>,
                                        you can use up to <span id='lblAnnualLeaveCanBeUsed' class='red-color'>{1}</span>
                                        day (s) AL in a total of <span id='lblAnnualLeaveBalance' class='red-color'> {2} </span>
                                        day (s) for <span id='lblYear'>{3}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.LeaveType</label>
                                    </div>
                                    <div class="left input--m leaveTypeId">
                                        <select asp-for="LeaveTypeId" asp-items="@listLeaveTypes"></select>
                                        <span asp-validation-for="LeaveTypeId"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--l">
                                        <label>@Labels.Employee</label>
                                    </div>
                                    <div class="left">
                                        <span class="label">@Model.Employee</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--l">
                                        <label>@Labels.HalfDayOff</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="HalfDayOff" type="checkbox" class="filled-in" />
                                        <label for="HalfDayOff"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.FromDate</label>
                                    </div>
                                    <div class="left block-time">
                                        <div class="datepicker-button select--s left">
                                            <date-picker name="FromDate"
                                                         min-date="Utilities.RequestAvailableFromDate"
                                                         max-date="Utilities.RequestAvailableToDate"
                                                         disabled-dates="Model.UnavailDates"
                                                         value="Model.FromDate">
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon from-date left"></i>
                                        </div>
                                        <div class="box-time hide">
                                            <div class="col m-l--m">
                                                <input asp-for="FromHour" type="number" min="0" max="23" step="1" MaxLength="2" />
                                            </div>
                                            <div class="col p-0">
                                                <span class="colon">:</span>
                                            </div>
                                            <div class="col">
                                                <input asp-for="FromMinute" type="number" min="0" max="59" step="1" MaxLength="2" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left select-time">
                                        <span class="time hide">
                                            <select asp-for="FromTime" asp-items="Utilities.TimeSteps(30)"></select>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.ToDate</label>
                                    </div>
                                    <div class="left block-time">
                                        <div class="datepicker-button select--s left">
                                            <date-picker name="ToDate"
                                                         min-date="Utilities.RequestAvailableFromDate"
                                                         max-date="Utilities.RequestAvailableToDate"
                                                         disabled-dates="Model.UnavailDates"
                                                         value="Model.ToDate">
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon from-date left"></i>
                                        </div>
                                        <div class="box-time hide">
                                            <div class="col m-l--m">
                                                <input asp-for="ToHour" type="number" min="0" max="23" step="1" MaxLength="2" />
                                            </div>
                                            <div class="col p-0">
                                                <span class="colon">:</span>
                                            </div>
                                            <div class="col">
                                                <input asp-for="ToMinute" type="number" min="0" max="59" step="1" MaxLength="2" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left select-time">
                                        <span class="time hide">
                                            <select asp-for="ToTime" asp-items="Utilities.TimeSteps(30)"></select>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.TotalDays</label>
                                    </div>
                                    <div class="left input--xs">
                                        <input asp-for="TotalDays" />
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.Remark</label>
                                    </div>
                                    <div class="left input--m">
                                        <textarea asp-for="Remark" class="materialize-textarea"></textarea>
                                    </div>
                                    <div id="remarkInfo" style="margin-top: -15px;"></div>
                                </div>
                            </div>
                            <div class="row form-input line-button">
                                <div class="col">
                                    <div class="left label--xl">&nbsp;</div>
                                    <div class="left">
                                        <a href="@Url.Action("EmployeeView")" class="btn-back waves-effect waves-light">@Labels.Cancel</a>
                                        <input type="submit" class="btn-submit waves-effect waves-light right" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </div>
                            <input asp-for="Employee" type="hidden" />
                            <input asp-for="EmployeeId" type="hidden" />
                            <input asp-for="Id" type="hidden" />
                            <input asp-for="LeaveTypeName" type="hidden" />
                            <input asp-for="ForRequest" type="hidden" />
                        </form>
                    </div>

                    <div class="hide">
                        <div id="warningLeaveRequest">
                            <div class="warningLeaveRequest">
                                <ul>
                                    <li>Annual Leave (>= 5 days) / Unpaid Leave request need to be approved by Management. So please get approval from your supervisor first and note it in the remarks.</li>
                                    <li>e.g:</li>
                                    <div>- home repair ([Supervisor Name] approved)</div>
                                    <div>- family outing - [Supervisor Name] approved</div>
                                    <div>...</div>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>