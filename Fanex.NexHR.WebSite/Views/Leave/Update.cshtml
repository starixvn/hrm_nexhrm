@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels
@model LeaveRequestViewModel
@{
    ViewBag.Title = Labels.MyLeaveRequest;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/myrequest.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/jquery.contextMenu.min.js" asp-append-version="true"></script>
        <script src="~/js/Views/Request/leave.request.js" asp-append-version="true"></script>
        <script src="~/js/Views/Request/process.leave-checkinout.byemployee.js" asp-append-version="true"></script>
        <script src="~/js/Views/Request/search.request.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/leave.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Edit</span>
                </div>
                <div class="card-body">
                    <div class="form list-item-form">
                        @using (Html.BeginForm("update", "leave", FormMethod.Post, new { @class = "form-create-update" }))
                        {
                            @Html.ValidationSummary()
                            if (ViewBag.Updated == true)
                            {
                                <div class="row validation-summary-success">
                                    <div class="col success green-text"><i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.RequestUpdated</div>
                                    <input type="hidden" id="successed" value="true" />
                                    <input type="hidden" id="year" value="@ViewBag.Year" />
                                </div>
                            }
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left text-legend">
                                        @Html.Raw(Messages.LeaveRequestLegendText)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.LeaveTypeId, Labels.LeaveType)
                                    </div>
                                    <div class="left input--m leaveTypeId">
                                        @Html.DropDownListFor(model => model.LeaveTypeId, new SelectList(Model.LeaveTypes, "Id", "Name"))
                                        @Html.ValidationMessageFor(model => model.LeaveTypeId)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Employee, Labels.Employee)
                                    </div>
                                    <div class="left">
                                        <span class="label">@Html.DisplayFor(model => model.Employee)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.HalfDayOff, Labels.HalfDayOff)
                                    </div>
                                    <div class="left input--m">
                                        @Html.CheckBoxFor(model => model.HalfDayOff, new { @class = "filled-in, checkBox" })     
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left block-time">
                                        <div class="datepicker-button select--s left">
                                            <date-picker 
                                                name="FromDate"
                                                min-date="Utilities.RequestAvailableFromDate"
                                                max-date="Utilities.RequestAvailableToDate"
                                                disabled-dates="Model.UnavailDates"
                                                value="Model.FromDate"
                                            >
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon from-date left"></i>
                                        </div>
                                        <div class="box-time hide">
                                            <div class="col m-l--m">
                                                @Html.TextBoxFor(x => x.FromHour, new { type = "number", min = "0", max = "23", step = "1", MaxLength = "2", id = "Hour", name = "Hour" })
                                            </div>
                                            <div class="col p-0">
                                                <span class="colon">:</span>
                                            </div>
                                            <div class="col">
                                                @Html.TextBoxFor(x => x.FromMinute, new { type = "number", min = "0", max = "59", step = "1", MaxLength = "2", id = "Minute", name = "Minute" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left select-time">
                                        <span class="time hide">
                                            @Html.DropDownList("FromTime", Utilities.TimeSteps(30))
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left block-time">
                                        <div class="datepicker-button select--s left">
                                            <date-picker 
                                                name="ToDate"
                                                min-date="Utilities.RequestAvailableFromDate"
                                                max-date="Utilities.RequestAvailableToDate"
                                                disabled-dates="Model.UnavailDates"
                                                value="Model.ToDate"
                                            >
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon from-date left"></i>
                                        </div>
                                        <div class="box-time hide">
                                            <div class="col m-l--m">
                                                @Html.TextBoxFor(x => x.ToHour, new { type = "number", min = "0", max = "23", step = "1", MaxLength = "2", id = "Hour", name = "Hour" })
                                            </div>
                                            <div class="col p-0">
                                                <span class="colon">:</span>
                                            </div>
                                            <div class="col">
                                                @Html.TextBoxFor(x => x.ToMinute, new { type = "number", min = "0", max = "59", step = "1", MaxLength = "2", id = "Minute", name = "Minute" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left select-time">
                                        <span class="time hide">
                                            @Html.DropDownList("ToTime", Utilities.TimeSteps(30))
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.TotalDays, Labels.TotalDays)
                                    </div>
                                    <div class="left input--xs">
                                        @Html.EditorFor(model => model.TotalDays)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Remark)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextAreaFor(model => model.Remark, new { @class = "materialize-textarea" })
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input line-button">
                                <div class="col">
                                    <div class="left label--xl">&nbsp;</div>
                                    <div class="left">
                                        <a href="@Url.Action("EmployeeView")" class="btn-back waves-effect waves-light">@Labels.Cancel</a>
                                        <input type="submit" class="btn-submit waves-effect waves-light right" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </div>
                            @Html.HiddenFor(model => model.Employee)
                            @Html.HiddenFor(model => model.EmployeeId)
                            @Html.HiddenFor(model => model.Id)
                            @Html.HiddenFor(model => model.LeaveTypeName)
                            @Html.HiddenFor(model => model.ForRequest)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>