@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models
@using Fanex.NexHR.Services.Interfaces

@model IList<EmployeeJobGrade>
@{
    var count = 0;
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th style="width:4%">#</th>
            <th style="width:12%">@Labels.FullName</th>
            <th style="width:7%">@Labels.EnglishName</th>
            <th style="width:7%">@Labels.Team</th>
            <th style="width:7%">@Labels.JobGrade</th>
            <th style="width:7%">@Labels.EffectiveDate</th>
            <th style="width:7%">@Labels.Note</th>
            <th style="width:7%">@Labels.History</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                count++;
                <tr>
                    <td>@count</td>
                    <td class="align-left">@item.FullName</td>
                    <td>@item.NickName</td>
                    <td>@item.TeamCode</td>
                    <td>@item.JobGradeCode</td>
                    <td>@item.AffectedDate.ToDateMonthYearFormatedDate()</td>
                    <td>@item.Note</td>
                    <td>-</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7"></td>
            </tr>
            <tr>
                <td colspan="7" rowspan="2">
                    @Messages.NoInformation
                </td>
            </tr>
        }
    </tbody>
</table>