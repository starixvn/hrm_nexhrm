@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.Promotion.EditPromotionViewModel

@{
    DateTime currentDate = DateTime.Today;
    var jobGrade = ViewBag.JobGrade;
}

<form id="edit-form" asp-action="edit" data-ajax="true" data-ajax-method="post" data-ajax-success="promotion.onSuccess">
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="@Model.Id"/>
    <div class="row form-input">
        <div class="col employee-name">
            <div class="left label--l">
                <label>@Labels.Employee</label>
            </div>
            <div class="left input--m">
                @Model.Employee
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.CurrentGrade</label>
            </div>
            <div class="left select--m">
                <select name="OldJobGradeId" id="OldJobGradeId" asp-items="@(new SelectList(jobGrade, "Id", "Name",Model.OldJobGradeId))"></select>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.PromotedGrade</label>
            </div>
            <div class="left select--m">
                <select name="JobGradeId" id="JobGradeId" asp-items="@(new SelectList(jobGrade, "Id", "Name",Model.JobGradeId))"></select>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.EffectiveDate</label>
            </div>
            <div class="datepicker-button left">
                <date-picker name="EffectiveDate" value="@Model.EffectiveDate"></date-picker>
                <i class="mdi-action-event calendar-icon left"></i>
            </div>
        </div>
    </div>
</form>