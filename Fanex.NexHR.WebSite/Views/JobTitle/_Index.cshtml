@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IEnumerable<JobTitle>
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.JobTitle</th>
            <th class="col-sorter" onclick="sortTable(2)">
                @Labels.Employee
                <div class="sorter">
                </div>
            </th>
            <th>@Labels.Edit</th>
            <th>@Labels.Delete</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            var index = 0;
            foreach (var item in Model)
            {
                index++;
                <tr id="row_@item.Id">
                    <td>@index</td>
                    <td class="align-left">
                        <span id="spanJobTitle_@item.Id">@item.Name</span>
                        <input class="jobTitle" type="text" value="@item.Name" id="txtJobTile_@item.Id" style="display:none;" />
                    </td>
                    <td>
                        @if (item.NumberOfEmployee.Equals(0))
                        {
                            <span>@item.NumberOfEmployee</span>
                        }
                        else
                        {
                            <a href="@Url.Action("UserManagement","Employee", new { jobtitleid = item.Id })">@item.NumberOfEmployee</a>
                        }
                    </td>
                    <td class="col-edit">
                        <a href="javascript:;" onclick="editJobTile('@item.Id')" id='btnEditJobTitle_@item.Id'>
                            <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
                        </a>
                        <a href="javascript:;" id="btnUpdateJT_@item.Id" class="action-update" onclick="updateJobTitle('@item.Id')" title="Apply">
                            <i class="mdi-action-done mdi-dark mdi-18px"></i>
                        </a>
                        <a href="javascript:;" id="btnCancelUpdateJT_@item.Id" class="action-cancel" onclick="cancelUpdate('@item.Id')" title="Cancel">
                            <i class="mdi-action-highlight-remove mdi-dark mdi-18px"></i>
                        </a>
                    </td>
                    <td class="col-delete">
                        @if (item.NumberOfEmployee.Equals(0))
                        {
                            <a href="javascript:;" onclick="deleteJobTitle('@item.Id')" id="@item.Id">
                                <i class="mdi mdi-delete mdi-dark mdi-18px"></i>
                            </a>
                        }
                        else
                        {
                            <a href="javascript:;">
                                <i class="mdi mdi-delete mdi-disabled mdi-dark mdi-18px"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5"></td>
            </tr>
            <tr>
                <td colspan="5" rowspan="2">
                    @Messages.NoInformation
                </td>
            </tr>
        }
    </tbody>
</table>