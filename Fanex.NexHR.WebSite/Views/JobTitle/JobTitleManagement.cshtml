@{
    ViewBag.Title = Labels.JobTitleManagement;
}
@section css {
    @Styles.Render("~/Content/jobtitlecss")
}
@section js {
    @Scripts.Render("~/bundles/jobtitlejs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 l7 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <div class="row form-input">
                            <div class="col">
                                <label>@Labels.Keyword</label>
                            </div>
                            <div class="col input--m">
                                <input id="keyword" type="text" placeholder="@Fanex.NexHR.Resources.Messages.JobTitle" />
                            </div>
                            <div class="col">
                                <a class="button-hrm waves-effect waves-light btn orange darken-2" href="#" id="btnNewJobTitle"><i class="left mdi mdi-plus"></i>@Labels.NewJobTitle</a>
                            </div>
                        </div>
                    </div>
                    <table id="data" class="data persist-area table bordered striped highlight centered table-custom">
                        <thead>
                            <tr class="persist-header">
                                <th>@Labels.SymbolCount</th>
                                <th>@Labels.JobTitle</th>
                                <th>@Labels.Employee</th>
                                <th>@Labels.Edit</th>
                                <th>@Labels.Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row hide">
    <div id="dialog-form" title="Create an job title">
        <p class="validateTips"></p>
            @using (Html.BeginForm())
            {
            <div class="row form-input">
                <div class="col">
                    <div class="left label--l">
                        @Html.Label("name", Labels.JobTitle)
                    </div>
                    <div class="left input--m">
                        @Html.Editor("name")
                    </div>
                </div>
            </div>
            }
    </div>
</div>
<script id="itemTemplate" type="text/x-jquery-tmpl">
        <tr id="row${Id}">
            <td>
                ${index()}
            </td>
            <td class="txt-left" style="width: 340px">
                <span id="spanJobTitle_${Id}">${Name}</span>
                <input type="text" value="${Name}" id="txtJobTile_${Id}" style="display:none;" />
            </td>
            <td>
                {{if Value != '0'}}
                    <a href="/employee/usermanagement/?jobtitleid=${Id}">${Value}</a>
                {{else}}
                    0
                {{/if}}
            </td>
            <td class="cmd">
                    <a href="#" onclick="editJobTile('${Id}')" id='btnEditJobTitle_${Id}'><i class="mdi mdi-border-color mdi-dark mdi-18px"></i></a>
                    <a href="#" id="btnUpdateJT_${Id}" style="display:none" onclick="updateJobTitle('${Id}')" title="Apply">
                        <i class="mdi-action-done mdi-dark mdi-18px"></i>
                    </a>
                    <a href="#" id="btnCancelUpdateJT_${Id}" style="display:none;margin-left:10px;" onclick="cancelUpdate('${Id}')" title="Cancel">
                        <i class="mdi-action-highlight-remove mdi-dark mdi-18px"></i>
                    </a>
            </td>
            <td  class="cmd col-delete">
                {{if Value != '0'}}
                        <a href="#"><i class="mdi mdi-delete mdi-disabled mdi-dark mdi-18px"></i></a>
                {{else}}
                        <a href="#" onclick="deleteJobTitle('${Id}')" id="${Id}"><i class="mdi mdi-delete mdi-dark mdi-18px"></i></a>
                {{/if}}
            </td>
        </tr>
</script>
