@model IList<LookupData>
@{
    ViewBag.Title = Labels.JobTitleManagement;
}
@section css {
    @Styles.Render("~/Content/jobtitlecss")
}
@section js {
    @Scripts.Render("~/bundles/jobtitlejs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm())
                        {
                            <div class="row form-input">
                                <div class="col">
                                    <label>@Labels.Keyword</label>
                                </div>
                                <div class="col filter-title">
                                    @Html.TextBox("JobTitle", (string)ViewBag.JobTitle, new { id = "keyword", placeholder = Messages.JobTitle })
                                </div>
                                <div class="col">
                                    <input type="button" id="submit" class="btn-submit waves-effect waves-light m-r--m" value="@Labels.Submit" />
                                    <a class="btn-request waves-effect waves-light btn" href="#" id="btnNewJobTitle">
                                        <i class="left mdi mdi-plus"></i>@Labels.NewJobTitle
                                    </a>
                                </div>
                                <div class="col">
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.JobTitle</th>
                                    <th>@Labels.Employee</th>
                                    <th>@Labels.Edit</th>
                                    <th>@Labels.Delete</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row hide">
    <div id="dialog-form" title="Create an job title">
        <p class="validateTips"></p>
        @using (Html.BeginForm())
        {
            <div class="row form-input">
                <div class="left label--l">
                    @Html.Label("name", Labels.JobTitle)
                </div>
                <div class="left input--m">
                    @Html.Editor("name")
                </div>
            </div>
        }
    </div>
</div>
<script id="template" type="text/x-jquery-tmpl">
    <tr id="row_${Id}">
        <td>${index()}</td>
        <td class="align-left">
            <span id="spanJobTitle_${Id}">${Name}</span>
            <input class="jobTitle" type="text" value="${Name}" id="txtJobTile_${Id}" style="display:none;" />
        </td>
        <td>
        {{if Value == '0'}}
            ${Value}
        {{else}}
            <a href="/employee/usermanagement/?jobtitleid=${Id}">${Value}</a>
        {{/if}}
        </td>
        <td class="col-edit">
            <a href="javascript:;" onclick="editJobTile('${Id}')" id='btnEditJobTitle_${Id}'>
                <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
            </a>
            <a href="javascript:;" id="btnUpdateJT_${Id}" class="action-update" onclick="updateJobTitle('${Id}')" title="Apply">
                <i class="mdi-action-done mdi-dark mdi-18px"></i></a>
            <a href="javascript:;" id="btnCancelUpdateJT_${Id}" class="action-cancel" onclick="cancelUpdate('${Id}')" title="Cancel">
                <i class="mdi-action-highlight-remove mdi-dark mdi-18px"></i>
            </a>
        </td>
        <td class="col-delete">
        {{if Value == '0'}}
            <a href="javascript:;" onclick="deleteJobTitle('${Id}')" id="${Id}">
                <i class="mdi mdi-delete mdi-dark mdi-18px"></i>
            </a>
        {{else}}
            <a href="javascript:;">
                <i class="mdi mdi-delete mdi-disabled mdi-dark mdi-18px"></i>
            </a>
        {{/if}}
        </td>
    </tr>
</script>
