@using Fanex.NexHR.Resources
@model IList<LookupData>
@{
    ViewBag.Title = Labels.JobTitleManagement;
}
@section css {
    @Styles.Render("~/Content/jobtitlecss")
}
@section js {
    @Scripts.Render("~/bundles/jobtitlejs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 l7 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm())
                        {
                        <div class="row form-input">
                            <div class="col">
                                <label>@Labels.Keyword</label>
                            </div>
                            <div class="col input--m">
                                @Html.TextBox("JobTitle", (string)ViewBag.JobTitle, new { id = "keyword", placeholder = Messages.JobTitle })
                            </div>
                            <div class="col">
                                <input type="submit" id="submit" class="btn-submit waves-effect waves-light" value="@Labels.Submit" />
                            </div>
                            <div class="col">
                                <a class="button-hrm waves-effect waves-light btn orange darken-2" href="#" id="btnNewJobTitle">
                                    <i class="left mdi mdi-plus"></i>@Labels.NewJobTitle</a>
                            </div>
                        </div>
                        }
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="data persist-area table bordered striped highlight centered table-custom">
                            <thead>
                                <tr class="persist-header">
                                    <th>@Labels.SymbolCount
                                    </th>
                                    <th>@Labels.JobTitle
                                    </th>
                                    <th>@Labels.Employee
                                    </th>
                                    <th>@Labels.Edit
                                    </th>
                                    <th>@Labels.Delete
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                        @{int index = 1;}
                        @if (Model.Count > 0)
                        {
                            foreach (LookupData jobTitle in Model)
                            {
                                <tr id="row_@jobTitle.Id">
                                    <td>@(index++)</td>
                                    <td class="txt-left">
                                        <span id="spanJobTitle_@jobTitle.Id">@jobTitle.Name</span>
                                        <input type="text" value="@jobTitle.Name" id="txtJobTile_@jobTitle.Id" style="display:none;" />
                                    </td>
                                    <td>
                                        @if (jobTitle.Value.Equals("0"))
                                        {
                                            @Html.Label(jobTitle.Value)
                                        } 
                                        else
                                        {
                                            <a href="/employee/usermanagement/?jobtitleid=@jobTitle.Id">@jobTitle.Value</a>
                                        }
                                    </td>
                                    <td class="col-edit">
                                        <a href="javascript:;" onclick="editJobTile('@jobTitle.Id')" id='btnEditJobTitle_@jobTitle.Id'>
                                            <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
                                        </a>
                                        <a href="javascript:;" id="btnUpdateJT_@jobTitle.Id" class="action-update" onclick="updateJobTitle('@jobTitle.Id')" title="Apply">
                                            <i class="mdi-action-done mdi-dark mdi-18px"></i>
                                        </a>
                                        <a href="javascript:;" id="btnCancelUpdateJT_@jobTitle.Id" class="action-cancel" onclick="cancelUpdate('@jobTitle.Id')" title="Cancel">
                                            <i class="mdi-action-highlight-remove mdi-dark mdi-18px"></i>
                                        </a>
                                    </td>
                                    <td class="col-delete">
                                        @if (jobTitle.Value.Equals("0"))
                                        {
                                            <a href="javascript:;" onclick="deleteJobTitle('@jobTitle.Id')" id="@jobTitle.Id"><i class="mdi mdi-delete mdi-dark mdi-18px"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:;"><i class="mdi mdi-delete mdi-disabled mdi-dark mdi-18px"></i></a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            @RazorHelper.DisplayNoInformation(colspan: 5);
                        }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row hide">
    <div id="dialog-form" title="Create an job title">
        <p class="validateTips">
        </p>
        @using (Html.BeginForm())
        {
            <div class="row form-input">
                <div class="col">
                    <div class="left label--l">
                        @Html.Label("name", Labels.JobTitle)
                    </div>
                    <div class="left input--m">
                        @Html.Editor("name")
                    </div>
                </div>
            </div>
        }
    </div>
</div>
