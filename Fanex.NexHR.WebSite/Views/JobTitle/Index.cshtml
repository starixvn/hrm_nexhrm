@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IList<JobTitle>
@{
    ViewBag.Title = Labels.JobTitleManagement;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/jobtitle.min.css" asp-append-version="true">
}

@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Jobtitle/jobtitle.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/jobtitle.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <div class="row form-input">
                            <div class="col">
                                <label>@Labels.Keyword</label>
                            </div>
                            <div class="col filter-title">
                                <input type="text" id="keyword" placeholder="@Messages.JobTitle" />
                            </div>
                            <div class="col">
                                <input type="button" id="submit" class="btn-submit waves-effect waves-light m-r--m" value="@Labels.Submit" />
                                <a class="btn-request waves-effect waves-light btn" href="javascript:;" id="btnNewJobTitle">
                                    <i class="left mdi mdi-plus"></i>@Labels.NewJobTitle
                                </a>
                            </div>
                        </div>
                    </div>
                    <div id="job-title-detail" class="p-x--s">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row hide">
    <div id="dialog-form" title="Create An Job Title">
        <p class="validateTips"></p>
        @using (Html.BeginForm())
        {
            <div class="row form-input">
                <div class="left label--l">
                    @Html.Label("name", Labels.JobTitle)
                </div>
                <div class="left input--m">
                    @Html.Editor("name")
                </div>
            </div>
        }
    </div>
</div>
