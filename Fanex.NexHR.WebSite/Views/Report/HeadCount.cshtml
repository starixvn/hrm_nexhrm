@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@{
    ViewBag.Title = "Head Count";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/minify/css/contextmenu.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/jquery.contextMenu.min.js" asp-append-version="true"></script>
        <script src="~/js/Views/Report/report.headcount.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/contextmenu.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/headcount.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-head-count">
                        <div class="row form-input">
                            <div class="col">
                                <div class="left label--s">
                                    <label>@Labels.Year</label>
                                </div>
                                <div class="left select--xs">
                                    <select id="Year" asp-items="@Extensions.YearPicker(2010, DateTime.Now.Year)">
                                    </select> 
                                </div>
                            </div>
                            <div class="col col-btn-submit-excel">
                                <input id="submit" type="submit" value="@Labels.Submit" class="processing-submit btn-submit waves-effect waves-light m-r--m" />
                                <input id="exportExcel" type="button" value="@Labels.Excel" class="waves-effect waves-light btn-export-excel m-r--b" />
                            </div>
                        </div>
                    </div>
                    <div id="head-count-grid" class="p-x--s cover-form-mb over-auto table-head-count">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>