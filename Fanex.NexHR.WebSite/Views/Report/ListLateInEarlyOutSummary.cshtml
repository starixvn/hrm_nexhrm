@model IList<LateInEarlyOutSummaryByTeamModel>

<table id="data" class="table bordered striped highlight table-custom centered">
    <thead>
        <tr>
            <th>@Labels.FullName</th>
            <th>@Labels.Nick</th>
            <th>@Labels.Total</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        <tbody>
            @{
                int index = 0;
            }
            @foreach (LateInEarlyOutSummaryByTeamModel item in Model)
            {
                index++;

                if (item.LateInEarlyOutSummaryInTeams != null && item.LateInEarlyOutSummaryInTeams.Count > 0) {
                    <tr class="row-divider">
                        <td class="align-left txt-uppercase" colspan="3">
                            <b>@item.Team.Name.ToUpper()</b>
                        </td>
                    </tr>
                }
                foreach (LateInEarlyOutSummaryModel lateInEarlyOut in item.LateInEarlyOutSummaryInTeams)
                {
                    <tr>
                        <td class="align-left">@lateInEarlyOut.Employee.FullName</td>
                        <td>@lateInEarlyOut.Employee.NickName</td>
                        @if (lateInEarlyOut.TotalTimes != 0)
                        {
                            <td>
                                <a href='javascript:;' class="tooltip-detail">@lateInEarlyOut.TotalTimes</a>
                                <div class="latein-earlyout-summary-detail hide">
                                    <table class="table bordered striped highlight table-custom centered">
                                        <thead>
                                            <tr>
                                                <th>@Labels.Month</th>
                                                <th>@Labels.Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (LateInEarlyOutSummaryDetailModel detail in lateInEarlyOut.LateInEarlyOutSummaryDetails)
                                            {
                                                <tr>
                                                    <td>@detail.Month.ToString("MMM, yyyy")</td>
                                                    <td>@detail.TotalTimes</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                        }
                    </tr>
                }
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 3);
    }
</table>