@using Fanex.NexHR.Core;
@using Fanex.NexHR.Models;
@model Fanex.NexHR.ViewModels.LeaveSummaryViewModel
@{
    ViewBag.Title = Labels.LeaveSummary;
}
@section css{
}
@section js{
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm())
                        {
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>

                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Team)
                                    </div>
                                    <div class="left select--m">
                                        <select id="TeamId" name="TeamId">
                                            <option value="">@Labels.AllTeams</option>
                                            @foreach (Fanex.NexHR.Models.Team team in ViewBag.Groups)
                                            {
                                                <option selected="@(ViewBag.TeamId == team.Id)" value="@team.Id">@team.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = @Fanex.NexHR.Resources.Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                
                                <div class="col">
                                    <span class="button-hrm waves-effect waves-light btn yellow darken-4 z-depth-2 m-r--s"><input type="submit" value="@Labels.Submit" class="processing-submit" /></span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="p-x--s">
                        <table class="data persist-area table bordered striped highlight table-custom">
                            <thead class="persist-header">
                                <tr>
                                    <th rowspan="2">
                                        #
                                    </th>
                                    <th rowspan="2">@Labels.Nick
                                    </th>
                                    <th colspan="2">@Labels.AnnualLeave
                                    </th>
                                    <th colspan="12">
                                        Take Annual Leave @Model.Year
                                    </th>
                                    <th rowspan="2">
                                        Balance of AL @Model.Year
                                    </th>
                                    <th rowspan="2">@Labels.Remark
                                    </th>
                                </tr>
                                <tr>
                                    <th>@(Model.Year - 1)
                                    </th>
                                    <th>@Model.Year
                                    </th>
                                    <th>@Labels.Jan
                                    </th>
                                    <th>@Labels.Feb
                                    </th>
                                    <th>@Labels.Mar
                                    </th>
                                    <th>@Labels.Apr
                                    </th>
                                    <th>@Labels.May
                                    </th>
                                    <th>@Labels.Jun
                                    </th>
                                    <th>@Labels.Jul
                                    </th>
                                    <th>@Labels.Aug
                                    </th>
                                    <th>@Labels.Sep
                                    </th>
                                    <th>@Labels.Oct
                                    </th>
                                    <th>@Labels.Nov
                                    </th>
                                    <th>@Labels.Dec
                                    </th>
                                </tr>
                            </thead>
                            @*Check if exists*@
                            @{
                                bool checkSummaryList = true;
                                foreach (LeaveSummaryByTeam leaveSumaryByTeam in ViewBag.LeaveSummaryByTeamList)
                                {
                                    if (leaveSumaryByTeam.LeaveSummaryInTeam.Count > 0)
                                    {
                                        checkSummaryList = true;
                                        break;
                                    }
                                    else
                                    {
                                        checkSummaryList = false;
                                    }

                                }
                            }
                            @if (checkSummaryList)
                            {
                                <tbody>
                                    @{int index = 1;}
                                    @foreach (LeaveSummaryByTeam item in ViewBag.LeaveSummaryByTeamList)
                                    {
                                        if (item.LeaveSummaryInTeam.Count > 0)
                                        {
                                        <tr>
                                            <td class="rowdivider highlight" colspan="18">
                                                <b>@item.Team.Name.ToUpper()</b>
                                            </td>
                                        </tr>
                                        }

                                        foreach (LeaveSummary leave in item.LeaveSummaryInTeam)
                                        {
                                        <tr>
                                            <td>@(index++)
                                            </td>
                                            <td class="tooltip" title="@leave.Employee.FullName">@leave.Employee.NickName
                                            </td>
                                            <td style="@(leave.AnnualLeaveLastYear < 0 ? "color:red;" : string.Empty)">@leave.AnnualLeaveLastYear.ToString("0.0")
                                            </td>
                                            <td style="@(leave.AnnualLeaveCurrentYear < 0 ? "color:red;" : string.Empty)">@leave.AnnualLeaveCurrentYear.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Jan < 0 ? "color:red;" : string.Empty)">@leave.Jan.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Feb < 0 ? "color:red;" : string.Empty)">@leave.Feb.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Mar < 0 ? "color:red;" : string.Empty)">@leave.Mar.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Apr < 0 ? "color:red;" : string.Empty)">@leave.Apr.ToString("0.0")
                                            </td>
                                            <td style="@(leave.May < 0 ? "color:red;" : string.Empty)">@leave.May.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Jun < 0 ? "color:red;" : string.Empty)">@leave.Jun.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Jul < 0 ? "color:red;" : string.Empty)">@leave.Jul.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Aug < 0 ? "color:red;" : string.Empty)">@leave.Aug.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Sep < 0 ? "color:red;" : string.Empty)">@leave.Sep.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Oct < 0 ? "color:red;" : string.Empty)">@leave.Oct.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Nov < 0 ? "color:red;" : string.Empty)">@leave.Nov.ToString("0.0")
                                            </td>
                                            <td style="@(leave.Dec < 0 ? "color:red;" : string.Empty)">@leave.Dec.ToString("0.0")
                                            </td>
                                            <td style="@(leave.LeaveBalance < 0 ? "color:red;" : string.Empty)">@leave.LeaveBalance.ToString("0.0")
                                            </td>
                                            <td>@leave.Remark
                                            </td>
                                        </tr>
                                        }
                                    }
                                </tbody>
                            }
                            else
                            {
                                @RazorHelper.DisplayNoInformation(18)
                            }
                        </table>
                    </div>                    
                </div>
            </div>
        </div>
    </div>
</div>

