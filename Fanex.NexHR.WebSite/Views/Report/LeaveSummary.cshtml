@model LeaveSummaryViewModel
@{
    ViewBag.Title = Labels.LeaveSummary;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/leavesummaryjs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <form action="">
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.TeamCollection, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model=>model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <div id="leave-summary-detail" class="p-x--s">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

