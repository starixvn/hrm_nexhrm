@using Fanex.NexHR.Core
@using Fanex.NexHR.Models.Report
@using Fanex.NexHR.Models.Request
@using Fanex.NexHR.Resources
@using System.Globalization
@model IList<EmployeeAttendanceModel>

@{
    var pagerOption = ViewBag.PagerOption;
}
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter">
                @Labels.Date
                <div class="sorter" data-property="AttendanceDate"></div>
            </th>
            <th class="col-sorter">
                @Labels.Code
                <div class="sorter" data-property="Code"></div>
            </th>
            <th class="col-sorter">
                @Labels.EnglishName
                <div class="sorter" data-property="NickName"></div>
            </th>
            <th class="col-sorter">
                @Labels.FullName
                <div class="sorter" data-property="FullName"></div>
            </th>
            <th class="col-sorter">
	            @Labels.Department
	            <div class="sorter" data-property="Team"></div>
            </th>
            <th class="col-sorter">
                @Labels.Team
                <div class="sorter" data-property="Team"></div>
            </th>
            <th class="col-sorter">
                @Labels.Shift
                <div class="sorter" data-property="ShiftCode"></div>
            </th>
            <th class="col-sorter">
                @Labels.CheckIn
                <div class="sorter" data-property="InFixed"></div>
            </th>
            <th class="col-sorter">
                @Labels.CheckOut
                <div class="sorter" data-property="OutFixed"></div>
            </th>
            <th class="col-sorter">
                @Labels.TotalHours
                <div class="sorter" data-property="TotalWorkHours"></div>
            </th>
            <th class="col-sorter">
                @Labels.LateIn
                <div class="sorter" data-property="LateIn"></div>
            </th>
            <th class="col-sorter">
                @Labels.EarlyOut
                <div class="sorter" data-property="EarlyOut"></div>
            </th>
            <th>@Labels.Request</th>
            <th style="width: 5%;">@Labels.WorkFromHome</th>
            <th class="col-sorter">
                @Labels.Note
                <div class="sorter" data-property="Notes"></div>
            </th>
        </tr>
    </thead>
    @if (Model.Any())
    {
        <tbody>

            @{
                var index = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage;
            }
            @foreach (var employeeAttendance in Model)
            {
                index++;
                var cssClass = string.Empty;
                if (employeeAttendance.IsNotWork != 0)
                {
                    cssClass = "offdate";
                }
                else if (employeeAttendance.ShiftId != null)
                {
                }
                else
                {
                    cssClass = "noshift";
                }

                <tr class="@cssClass">
                    <td>@index</td>
                    <td>@employeeAttendance.AttendanceDate.ToDateMonthYearFormatedDate()</td>
                    <td>@employeeAttendance.Code</td>
                    <td>@employeeAttendance.NickName</td>
                    <td class="align-left">@employeeAttendance.FullName</td>
                    <td >@employeeAttendance.DepartmentName</td>
                    <td class="tooltip" title="@employeeAttendance.Team">
                        @employeeAttendance.TeamCode
                    </td>
                    <td>@employeeAttendance.ShiftCode</td>
                    <td>
                        @if (employeeAttendance.InFixed != null)
                        {
                            @employeeAttendance.InFixed.Value.ToString("HH:mm")
                        }
                    </td>
                    <td>
                        @if (employeeAttendance.OutFixed != null)
                        {
                            @employeeAttendance.OutFixed.Value.ToString("HH:mm")
                        }
                    </td>
                    @if (employeeAttendance.TotalWorkHours > 0)
                    {
                        <td>
                            @{
                                var display = string.Empty;
                                var hour = Math.Floor(employeeAttendance.TotalWorkHours);

                                if (hour > 0)
                                {
                                    display = hour < 10 ? "0" + hour + "h" : hour + "h";
                                }

                                var minute = Math.Round((employeeAttendance.TotalWorkHours - hour) * 60);

                                <span>@(minute < 10 ? display + "0" + minute + "\'" : display + minute + "\'")</span>
                            }
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (employeeAttendance.LateIn > 0)
                    {
                        <td>
                            @{
                                const double second = 60;
                                const double epsilon = 0.0001;
                                var hour = Math.Floor(employeeAttendance.LateIn / second);
                                var minute = employeeAttendance.LateIn % 60;
                                string display;

                                if (Math.Abs(hour) > epsilon)
                                {
                                    display = (hour > 9 ? hour.ToString(CultureInfo.InvariantCulture) : "0" + hour) + ":" + (minute > 9 ? minute.ToString(CultureInfo.InvariantCulture) : "0" + minute);
                                }
                                else
                                {
                                    display = minute > 9 ? "00:" + minute : "00:0" + minute;
                                }

                                <span>@display</span>
                            }
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (employeeAttendance.EarlyOut > 0)
                    {
                        <td>
                            @{
                                double s = 60;
                                var hour = Math.Floor(employeeAttendance.EarlyOut / s);
                                var minute = employeeAttendance.EarlyOut % 60;
                                string display;

                                if (hour == 0)
                                {
                                    display = minute > 9 ? "00:" + minute : "00:0" + minute;
                                }
                                else
                                {
                                    display = (hour > 9 ? hour.ToString(CultureInfo.InvariantCulture) : "0" + hour) + ":" + (minute > 9 ? minute.ToString(CultureInfo.InvariantCulture) : "0" + minute);
                                }

                                <span>@display</span>
                            }
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>
                        @if (employeeAttendance.Requests != null)
                        {
                            foreach (RequestEntity request in employeeAttendance.Requests)
                            {
                                var dataToShift = "";
                                if (request.ToShift != null)
                                {
                                    dataToShift = request.ToShift.Name;
                                }

                                <a href='javascript:;' class="tooltip-request req"
                                   data-requesttype="@request.RequestType.Id"
                                   data-fromdate="@request.FromDate.ToFormatedDate()"
                                   data-todate="@request.ToDate.ToFormatedDate()"
                                   data-createddate="@request.CreatedDate.ToFormatedDate()"
                                   data-fromshift="@request.FromShift.Name"
                                   data-toshift="@dataToShift"
                                   data-totaldays="@request.TotalDays"
                                   data-totalmins="@request.TotalMins"
                                   data-remark='@request.Remark'>
                                    @request.RequestType.Name
                                </a>
                            }
                        }
                    </td>
                    <td style="text-align: center;">
                        <input type="checkbox" id="isWorkFromHome" class="filled-in" disabled checked=@employeeAttendance.IsWorkFromHome />
                        <label hidden style="padding-left: 15px !important; height: 12px !important; cursor: not-allowed"></label>
                    </td>
                    <td class="align-left">@employeeAttendance.Notes</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="15" id="pagination" class="row form-input">
                    <div id="detailtext" class="col m-t--m">
                        @{
                            var from = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage + 1;
                            var to = from + (Model.Count - 1);
                        }
                        Showing <strong>@from</strong> to <strong>@to</strong> of <strong>@pagerOption.TotalItem</strong> entries
                    </div>
                    <div class="col right">
                        <input type="hidden" id="CurrentPage" value="@((int)pagerOption.CurrentPage)" />
                        <input type="hidden" id="ItemsPerPage" value="@((int)pagerOption.ItemsPerPage)" />
                        <input type="hidden" id="TotalItem" value="@((int)pagerOption.TotalItem)" />
                        <ul id="numberlist" class="pagination"></ul>
                    </div>
                </td>
            </tr>
        </tfoot>
    }
    else
    {
         <tr>
            <td colspan="15"></td>
        </tr>
        <tr>
            <td colspan="15" rowspan="2">
                @Messages.NoInformation
            </td>
        </tr>
    }
</table>
