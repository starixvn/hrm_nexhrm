@model LateInEarlyOutDetailViewModel
@{
    ViewBag.Title = Labels.LateInEarlyOutDetail;
}
@section Breadcrumb {
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/lateinearlyoutdetailjs")
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                    @using (Html.BeginForm())
                    {
                        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                        <div class="row form-input">
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    <label>@Labels.DateRange</label>
                                </div>
                                <div class="left select--m">
                                    @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFilter.DateRange)
                                    @Html.Hidden("DateOption", Model.DateOption)
                                </div>
                            </div>
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                </div>
                                <div class="left datepicker-button input--s">
                                    @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                </div>
                                <div class="left datepicker-button input--s">
                                    @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.TeamId, Labels.Team)
                                </div>
                                <div class="left select--m">
                                    @Html.DropDownListFor(model=>model.TeamId, new SelectList(Model.TeamCollection, "Id", "Name"), Labels.AllTeams)
                                </div>
                            </div>
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.Employee)
                                </div>
                                <div class="left input--s">
                                    @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                    @Html.HiddenFor(model => model.EmployeeId)
                                </div>
                            </div>
                            <div class="col">
                                <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect wave-light" />
                            </div>
                        </div>
                    }
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Name</th>
                                    <th>@Labels.Nick</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.WorkigDay</th>
                                    <th>@Labels.Type</th>
                                    <th>@Labels.Hours</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script id="template" type="text/x-jquery-tmpl">
    <tr>
        <td>${index()}</td>
        <td class="align-left">${Employee.FullName}</td>
        <td>${Employee.NickName}</td>
        <td class="tooltip" title="${Employee.Team.Name}">
            ${Employee.Team.Code}
        </td>
        <td>${formatJsonDate(WorkDate, 'dd MMM, yyyy')}</td>
        <td>
            {{if TypeId == 0}}
                Leave Deduction
            {{else TypeId == 1}}
                Late In
            {{else}}
                Early Out
            {{/if}}
        </td>
        <td>${(Minutes / 60).toFixed(1)}</td>
    </tr>
</script>
