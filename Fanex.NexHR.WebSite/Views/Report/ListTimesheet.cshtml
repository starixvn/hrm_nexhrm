@model IList<EmployeeAttendanceModel>

<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Date</th>
            <th>@Labels.Nick</th>
            <th>@Labels.Team</th>
            <th>@Labels.Shift</th>
            <th>@Labels.CheckIn</th>
            <th>@Labels.CheckOut</th>
            <th>@Labels.TotalHours</th>
            <th>@Labels.LateIn</th>
            <th>@Labels.EarlyOut</th>
            <th>@Labels.Request</th>
            <th>@Labels.Note</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        int index = 0;

        <tbody>
            @foreach (EmployeeAttendanceModel item in Model)
            {
                index++;

                var trClass = "";
                if (item.IsNotWork != 0)
                {
                    trClass = "offdate";
                }
                else if (item.ShiftId != 0)
                {

                }
                else
                {
                    trClass = "noshift";
                }

                <tr class="@trClass">
                    <td>@index</td>
                    <td>@item.AttendanceDate.ToDateMonthYearFormatedDate()</td>
                    <td class="tooltip" title="@item.FullName">@item.NickName</td>
                    <td class="tooltip" title="@item.Team">@item.TeamCode</td>
                    <td>@item.ShiftCode</td>
                    @if (item.InFixed != null)
                    {
                        <td>@item.InFixed.Value.ToString("HH:mm")</td>
                    }
                    else if (item.IsMissingCheckin.Equals(1))
                    {
                        <td>
                            <a href="../checkinout/create?type=1&date=@item.AttendanceDate.ToDateMonthYearFormatedDate()">Request</a>
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (item.OutFixed != null)
                    {
                        <td>@item.OutFixed.Value.ToString("HH:mm")</td>
                    }
                    else if (item.IsMissingCheckOut.Equals(1))
                    {
                        <td>
                            <a href="../checkinout/create?type=2&date=@item.AttendanceDate.ToDateMonthYearFormatedDate()">Request</a>
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (item.TotalWorkHours > 0)
                    {
                        <td>@RazorHelper.TotalHoursToTime(item.TotalWorkHours)</td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (item.LateIn > 0)
                    {
                        <td>@RazorHelper.DisplayMinute(item.LateIn)</td>
                    }
                    else
                    {
                        <td></td>
                    }
                    @if (item.EarlyOut > 0)
                    {
                        <td>@RazorHelper.DisplayMinute(item.EarlyOut)</td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td class="align-left">
                        @if (item.Requests != null)
                        {
                            foreach (RequestEntity request in item.Requests)
                            {
                                var dataToShift = "";
                                if (request.ToShift != null)
                                {
                                    dataToShift = request.ToShift.Name;
                                }

                                <a href='javascript:;' class="tooltip-request req"
                                   data-requesttype="@request.RequestType.Id"
                                   data-fromdate="@request.FromDate.ToFormatedDate()"
                                   data-todate="@request.ToDate.ToFormatedDate()"
                                   data-createddate="@request.CreatedDate.ToFormatedDate()"
                                   data-fromshift="@request.FromShift.Name"
                                   data-toshift="@dataToShift"
                                   data-totaldays="@request.TotalDays"
                                   data-totalmins="@request.TotalMins"
                                   data-remark='@request.Remark'>
                                    @request.RequestType.Name
                                </a>
                            }
                        }
                    </td>
                    <td class="align-left">@item.Notes</td>
                </tr>
            }
        </tbody>
    }
    else
    {
        @RazorHelper.DisplayNoInformation(colspan: 12);
    }
</table>