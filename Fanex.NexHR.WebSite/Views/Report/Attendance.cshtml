@using Fanex.NexHR.Core;
@model Fanex.NexHR.ViewModels.EmployeeAttendanceViewModel
@{
    ViewBag.Title = "Attendance report";
}
@section css{
}
@section js{
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginGetForm())
                        {
                            @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--m">
                                        <select id="Date" name="Date">
                                            <option value="0">@Labels.DateRange</option>
                                            <option value="1">@Labels.ToDay</option>
                                            <option value="2">@Labels.Yesterday</option>
                                            <option value="3">@Labels.CurrentWeek</option>
                                            <option value="4">@Labels.LastWeek</option>
                                            <option value="5">@Labels.CurrentMonth</option>
                                            <option value="6">@Labels.LastMonth</option>
                                            <option value="7">@Labels.SinceLastMonth</option>
                                        </select>
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>                                
                                </div>

                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        <label>@Labels.FromDate</label>
                                    </div>
                                    <div class="left datepicker-button input--m">
                                        @Html.DatePicker("FromDate", Model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now.AddMonths(4))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>

                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        <label>@Labels.ToDate</label>
                                    </div>
                                    <div class="left datepicker-button input--m">
                                        @Html.DatePicker("ToDate", Model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now.AddMonths(4))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div> 
                            </div>
                                                        
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.AttendanceType, "Request")
                                    </div>
                                    <div class="left select--m">
                                        @{
                                            var types = new List<SelectListItem>
                                            {
                                                new SelectListItem() {Text = "All", Value = "0"},
                                                new SelectListItem() {Text = "Checkin", Value = "1"},
                                                new SelectListItem() {Text = "Checkout", Value = "2"},
                                                new SelectListItem() {Text = "Late in", Value = "3"},
                                                new SelectListItem() {Text = "Early out", Value = "4"},
                                                new SelectListItem() {Text = "Not working", Value = "5"},
                                            };
                                        }
                                        @Html.DropDownListFor(model => model.AttendanceType, types)
                                    </div>
                                </div>

                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        <label>@Labels.Team</label>
                                    </div>
                                    <div class="left select--m">
                                        <select id="GroupId" name="GroupId">
                                            <option value="">@Labels.AllTeams</option>
                                            @foreach (Fanex.NexHR.Models.Team item in ViewBag.Groups)
                                            {
                                                <option value="@item.Id">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.EmpId)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = @Fanex.NexHR.Resources.Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmpId)
                                        @Html.ValidationMessageFor(model => model.EmpId)
                                    </div>
                                </div> 
                            </div>                            
                            
                            <div class="row form-input">
                                <div class="col">
                                    <div class="left label--m">&nbsp</div>
                                    <div class="left select--m">
                                        <label for="ExcludeUserDelete">Exclude Users deleted</label>
                                        @Html.CheckBoxFor(model => model.ExcludeUserDelete)                                        
                                    </div>
                                </div>
                                
                                <div class="col">
                                    <span class="button-hrm waves-effect waves-light btn yellow darken-4 z-depth-2 m-r--s"><input type="button" value="@Labels.Submit" id="view" /></span>
                                    <span class="button-hrm waves-effect waves-light btn green darken-1 z-depth-2 m-r--s"><input type="button" value="@Labels.Excel" id="exportExcel" /></span>
                                </div>                                
                            </div>                            
                        }
                    </div>
                    
                    <div class="p-x--s">
                        <table id="data" class="data persist-area table bordered striped highlight table-custom">
                            <thead>
                                <tr class="persist-header">
                                    <th>
                                        #
                                    </th>
                                    <th>
                                        @Labels.Date
                                    </th>
                                    <th>
                                        @Labels.Code
                                    </th>
                                    <th>
                                        @Labels.Nick
                                    </th>
                                    <th>
                                        @Labels.FullName
                                    </th>
                                    <th>
                                        @Labels.Team
                                    </th>
                                    <th>
                                        @Labels.Shift
                                    </th>
                                    <th>
                                        @Labels.CheckIn
                                    </th>
                                    <th>
                                        @Labels.CheckOut
                                    </th>
                                    <th>
                                        @Labels.TotalHours
                                    </th>
                                    <th>
                                        @Labels.LateIn
                                    </th>
                                    <th>
                                        @Labels.EarlyOut
                                    </th>
                                    <th>
                                        @Labels.Request
                                    </th>
                                    <th>
                                        @Labels.Note
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>                    
                </div>
            </div>
        </div>
    </div>
</div>

<script id="itemTemplate" type="text/x-jquery-tmpl">
    <tr {{if IsNotWork != 0}}class="offdate"{{else ShiftId}} {{else}} class="noshift"{{/if}}>
        <td>${index()}</td>
        <td class="ddMMyyyy">
            ${jsonToShortDate(AttendanceDate)}
        </td>
        <td>
            ${Code}
        </td>
        <td title="${FullName}" class="left tooltip">
            ${NickName}
        </td>
        <td class="left">
            ${FullName}
        </td>
        <td class="tooltip" title="${Team}">
            ${TeamCode}
        </td>
        <td>
            ${ShiftCode}
        </td>
        <td>
            {{if InFixed}}${jsonTojsDate(InFixed).format("HH:MM")}{{/if}}
        </td>
        <td>
            {{if OutFixed}}${jsonTojsDate(OutFixed).format("HH:MM")}{{/if}}
        </td>
        <td>
            {{if TotalWorkHours > 0}}
                ${totalHoursToTime(TotalWorkHours)}
            {{/if}}
        </td>
        <td>
            {{if LateIn > 0}}
                ${displayMinute(LateIn)}
            {{/if}}
        </td>
        <td>
            {{if EarlyOut > 0}}
                ${displayMinute(EarlyOut)}
            {{/if}}
        </td>
        <td class='left'>
            {{if Requests != null > 0}}
                {{each Requests}}
                    <a href='javascript:;' class="tooltip-request req"
                            data-requesttype="${RequestType.Id}"
                            data-fromdate="${FromDate}"
                            data-todate="${ToDate}"
                            data-createddate="${CreatedDate}"
                            data-fromshift="${FromShift.Name}"
                            {{if ToShift != null}} data-toshift="${ToShift.Name}" {{else}} data-toshift="" {{/if}}
                            data-totaldays="${TotalDays}"
                            data-totalmins="${TotalMins}"
                            data-remark='${Remark}'>
                            {{if RequestType.Id == 6}}  ${RequestType.Name} {{else}} ${RequestType.Name} {{/if}}
                        </a>
                {{/each}}

            {{/if}}
        </td>
        <td class="left">
            ${Notes}
        </td>
    </tr>
</script>