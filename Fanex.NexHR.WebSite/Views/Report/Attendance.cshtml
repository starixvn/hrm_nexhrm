@model EmployeeAttendanceViewModel
@{
    ViewBag.Title = Labels.AttendanceReport;
}
@section css{
    @Styles.Render("~/Content/simplepaginationcss",
                "~/Content/view-mobile")
}
@section js{
    @Scripts.Render(
        "~/bundles/simplepaginationjs",
        "~/bundles/attendancejs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                       
                        <form action="" class="form-filter">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--s">
                                        @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFilter.DateRange)
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1), maxDate: DateTime.Now.AddMonths(4))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ToDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.AttendanceType, "Request")
                                    </div>
                                    <div class="left select--s">
                                        @RazorHelper.RequestTypeFilter("AttendanceType", Model.AttendanceType)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.Team</label>
                                    </div>
                                    <div class="left select-team">
                                        @Html.DropDownListFor(model => model.GroupId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        &nbsp;
                                    </div>
                                    <div class="left">
                                        @Html.MaterializeCheckBoxFor(model => model.ExcludeUserDelete, new { @class = "filled-in" })
                                    </div>
                                    <div class="left">
                                        @Html.LabelFor(model => model.ExcludeUserDelete, Labels.ExcludeUserDelete)
                                    </div>
                                </div>
                                <div class="col col-btn">
                                    <div class="left">
                                        &nbsp;
                                    </div>
                                    <div class="left">
                                        @Html.HiddenFor(model => model.CurrentPage)
                                        @Html.HiddenFor(model => model.ItemsPerPage)
                                        <input class="btn-submit waves-effect waves-light m-r--m" type="button" value="@Labels.Submit" id="submit" />
                                        <input class="btn-export-excel waves-effect waves-light" type="button" value="@Labels.Excel" id="exportExcel" />
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="p-x--s cover-form-mb over-auto table-report-attendance" id="attendance-detail">
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>