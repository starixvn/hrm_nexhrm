@model EmployeeAttendanceViewModel
@{
    ViewBag.Title = Labels.AttendanceReport;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/attendancejs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginGetForm())
                        {
                            @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--s">
                                        @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFilter.DateRange)
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 1, 1), maxDate: DateTime.Now.AddMonths(4))
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ToDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.AttendanceType, "Request")
                                    </div>
                                    <div class="left select--s">
                                        @RazorHelper.RequestTypeFilter("AttendanceType", Model.AttendanceType)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.Team</label>
                                    </div>
                                    <div class="left select-team">
                                        @Html.DropDownListFor(model => model.GroupId, new SelectList(Model.TeamCollection, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.Employee, new { placeholder = @Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmpId)
                                        @Html.ValidationMessageFor(model => model.EmpId)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l checkBox">
                                    <div class="left label--m">
                                        &nbsp;</div>
                                    <div class="left">
                                        @Html.MaterializeCheckBoxFor(model => model.ExcludeUserDelete, new { @class = "filled-in" })
                                    </div>
                                    <div class="left">
                                        @Html.LabelFor(model => model.ExcludeUserDelete, Labels.ExcludeUserDelete)
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m label">
                                        &nbsp;</div>
                                    <div class="left">
                                        @Html.HiddenFor(model => model.CurrentPage)
                                        @Html.HiddenFor(model => model.ItemsPerPage)
                                        @Html.HiddenFor(model => model.GetAll)
                                        <input class="btn-submit waves-effect waves-light m-r--m" type="button" value="@Labels.Submit" id="submit" />
                                        <input class="btn-export-excel waves-effect waves-light" type="button" value="@Labels.Excel" id="exportExcel" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div id="datatable_length" class="row m-b--m">
                        <div class="col">
                            <div class="inline label--s">
                                <label>Show</label>
                            </div>
                            <div class="inline select--xs m-r--s">
                                @Html.DropDownList("EntryId", Model.ItemsPerPageArray, new { @class = "browser-default" })
                            </div>
                            <div class="inline label--m">
                                <label>entries</label>
                            </div>
                        </div>
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight table-custom centered">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Date</th>
                                    <th>@Labels.Code</th>
                                    <th>@Labels.Nick</th>
                                    <th>@Labels.FullName</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.Shift</th>
                                    <th>@Labels.CheckIn</th>
                                    <th>@Labels.CheckOut</th>
                                    <th>@Labels.TotalHours</th>
                                    <th>@Labels.LateIn</th>
                                    <th>@Labels.EarlyOut</th>
                                    <th>@Labels.Request</th>
                                    <th>@Labels.Note</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot></tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="pager" class="hide">
    <table>
        <tfoot>
            <tr>
                <td colspan="14" id="pagination" class="row form-input">
                    <div id="detailtext" class="col m-t--s"></div>
                    <div class="col right">
                        <ul id="numberlist" class="pagination"></ul>
                    </div>
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<script id="template" type="text/x-jsrender">
    <tr {{if IsNotWork != 0}}class="offdate" {{else ShiftId}} {{else}} class="noshift" {{/if}}>
        <td>{{:~index()}}</td>
        <td>
            {{:~formatDate(AttendanceDate, 'dd MMM, yyyy')}}
        </td>
        <td>
            {{:Code}}
        </td>
        <td>
            {{:NickName}}
        </td>
        <td class="align-left">
            {{:FullName}}
        </td>
        <td class="tooltip" title="{{:Team}}">
            {{:TeamCode}}
        </td>
        <td>
            {{:ShiftCode}}
        </td>
        <td>
            {{if InFixed}} {{:~formatDate(InFixed, 'HH:mm')}} {{/if}}
        </td>
        <td>
            {{if OutFixed}} {{:~formatDate(OutFixed, 'HH:mm')}} {{/if}}
        </td>
        <td>
            {{if TotalWorkHours > 0}}
                {{:~totalHoursToTime(TotalWorkHours)}}
            {{/if}}
        </td>
        <td>
            {{if LateIn > 0}}
                {{:~displayMinute(LateIn)}}
            {{/if}}
        </td>
        <td>
            {{if EarlyOut > 0}}
                {{:~displayMinute(EarlyOut)}}
            {{/if}}
        </td>
        <td class="align-left">
            {{if Requests != null}}
                {{for Requests}}
                    <a href='javascript:;' class="tooltip-request req"
                            data-requesttype="{{:RequestType.Id}}"
                            data-fromdate="{{:FromDate}}"
                            data-todate="{{:ToDate}}"
                            data-createddate="{{:CreatedDate}}"
                            data-fromshift="{{:FromShift.Name}}"
                            {{if ToShift != null}}
                                data-toshift="{{:ToShift.Name}}"
                            {{else}}
                                data-toshift=""
                            {{/if}}
                            data-totaldays="{{:TotalDays}}"
                            data-totalmins="{{:TotalMins}}"
                            data-remark='{{:Remark}}'>
                        {{if RequestType.Id == 6}}
                            {{:RequestType.Name}}
                        {{else}}
                            {{:RequestType.Name}}
                        {{/if}}
                    </a>
                {{/for}}
            {{/if}}
        </td>
        <td class="align-left">
            {{:Notes}}
        </td>
    </tr>
</script>
