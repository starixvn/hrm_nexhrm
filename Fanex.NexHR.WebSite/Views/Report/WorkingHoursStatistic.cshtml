@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Report
@model WorkingHoursStatisticViewModel
@{
    ViewBag.Title = Labels.WorkingHoursStatistic;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/mytimesheet.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/monthpicker.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
        <script src="~/js/Views/Report/report.workinghoursstatistic.js" asp-append-version="true"></script>
        <script src="~/js/Libs/monPickr-0.0.3.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/workinghoursstatistic.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/monthpicker.min.js" asp-append-version="true"></script>
    </environment>
}
@{
    //Set max month we can select in MonthPick
    int Month = 12;
    int year = DateTimeOffset.Now.DateTime.ToClientTimeZone().Date.GetMaxDate().Year + 1;

    var maxDate = new System.Text.StringBuilder();
    maxDate.AppendFormat("{0}/{1}/1", year, Month);
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">

                    <div class="form form-stl-table">
                        <form method="post" id="form">
                            <div class="row form-input">
                                <div class="row">
                                    <div class="col m-r--l">
                                        <div class="left label--l">
                                            <label>Current Month</label>
                                        </div>
                                        <div class="left select--s">
                                            <div id="monthPickr"></div>
                                            <input type="hidden" id="maxDate" value="@maxDate.ToString()" />
                                            <input type="hidden" asp-for="Month" />
                                            <input type="hidden" asp-for="Year" />
                                            <input type="hidden" asp-for="DateOption" />
                                        </div>
                                    </div>

                                    <div class="col m-r--s">
                                        <div class="left label--s">
                                            <label>@Labels.From</label>
                                        </div>
                                        <div class="left datepicker-button input--s">
                                            <date-picker name="FromDate" min-date="new DateTime(2010, 01, 01)"
                                                max-date="DateTimeOffset.Now.DateTime.ToClientTimeZone()"
                                                value="Model.FromDate">
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon from-date left"></i>
                                        </div>
                                    </div>

                                    <div class="col m-l--l m-r--s">
                                        <div class="left label--s">
                                            <label>@Labels.To</label>
                                        </div>
                                        <div class="left datepicker-button input--s">
                                            <date-picker name="ToDate" min-date="new DateTime(2010, 01, 01)"
                                                max-date="DateTimeOffset.Now.DateTime.ToClientTimeZone()"
                                                value="Model.ToDate">
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon from-date left"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col m-r--l">
                                        <div class="left label--l">
                                            <label>@Labels.FromLastMonth</label>
                                        </div>
                                        <div class="left datepicker-button input--s">
                                            <date-picker name="FromDateLastMonth" min-date="new DateTime(2010, 01, 01)"
                                                max-date="DateTimeOffset.Now.DateTime.ToClientTimeZone()"
                                                value="Model.FromDateLastMonth">
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon from-date left"></i>
                                        </div>
                                    </div>
                                    <div class="col m-l--l m-r--s">
                                        <div class="left label--s">
                                            <label>@Labels.To</label>
                                        </div>
                                        <div class="left datepicker-button input--s">
                                            <date-picker name="ToDateLastMonth" min-date="new DateTime(2010, 01, 01)"
                                                max-date="DateTimeOffset.Now.DateTime.ToClientTimeZone()"
                                                value="Model.ToDateLastMonth">
                                            </date-picker>
                                            <i class="mdi-action-event calendar-icon from-date left"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col m-l--l m-r--s">
                                        <div class="left label--m">
                                            <label>@Labels.Department</label>
                                        </div>
                                        <div class="left select-team">
                                            <select asp-for="DepartmentId"
                                                asp-items="@(new SelectList(Model.Departments, "Id", "Name"))">
                                                <option value="">@Labels.AllDepartments</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col m-l--l m-r--s">
                                        <div class="left label--s">
                                            <label>@Labels.Team</label>
                                        </div>
                                        <div class="left select-team">
                                            <select asp-for="TeamId"
                                                asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                                <option value="">@Labels.AllTeams</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col m-r--l">
                                        <div class="left label--m">
                                            <label>@Labels.Employee</label>
                                        </div>
                                        <div class="left input--m">
                                            <input asp-for="Employee" placeholder="@Messages.SearchEmployeeWatermark" />
                                            <input type="hidden" asp-for="EmployeeId" />
                                        </div>
                                    </div>
                                    <div class="col m-r--l col-btn-submit-excel">
                                        <input id="btnSubmit" type="button" value="@Labels.Submit" class="processing-submit btn-submit waves-effect waves-light m-r--m" />
                                        <input id="btnExport" class="btn-export-excel waves-effect waves-light" type="button" value="Excel" />
                                        <input type="hidden" asp-for="IsExportExcel"/>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="p-x--s over-auto table-resize table-large table-row-thead">
                        <table id="data" class="table bordered striped highlight table-custom centered">
                            <thead>
                                <tr>
                                    <th rowspan="2">@Labels.SymbolCount</th>
                                    <th rowspan="2">@Labels.Code</th>
                                    <th rowspan="2">@Labels.EnglishName</th>
                                    <th rowspan="2">@Labels.Department</th>
                                    <th rowspan="2">@Labels.Team</th>
                                    <th rowspan="2">@Labels.ActualWorkingDay</th>
                                    <th colspan="2">@Labels.PaidLeave</th>
                                    <th colspan="2">@Labels.InsuranceLeave</th>
                                    <th rowspan="2">@Labels.UnpaidLeave</th>
                                    <th rowspan="2">@Labels.BusinessLeave</th>
                                    <th rowspan="2">@Labels.WFH</th>
                                    <th rowspan="2">@Labels.TotalWorkingDay</th>
                                    <th rowspan="2">@Labels.ALBalance</th>
                                    <th colspan="5">@Labels.PreviousMonth</th>
                                </tr>
                                <tr>
                                    <th>@Labels.AnnualLeave</th>
                                    <th>@Labels.Others</th>
                                    <th>@Labels.SickLeave</th>
                                    <th>@Labels.Others</th>
                                    <th>@Labels.AnnualLeave</th>
                                    <th>@Labels.SickLeave</th>
                                    <th>@Labels.UnpaidLeave</th>
                                    <th>@Labels.BusinessLeave</th>
                                    <th>@Labels.WFH</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/x-jsrender">
    <tr>
        <td>{{:~index()}}</td>
        <td>{{:Employee.Code}}</td>
        <td title="{{:Employee.FullName}}" class="tooltip">{{:Employee.NickName}}</td>
        <td class="align-left">{{:Employee.DepartmentName}}</td>
        <td class="tooltip" title="{{:Employee.Team.Name}}">{{:Employee.Team.Code}}</td>
        <td>{{:ActualWorkingDay}}</td>
        <td>{{:AnnualLeave.toFixed(1)}}</td>
        <td>{{:PaidLeave.toFixed(1)}}</td>
        <td>{{:SickLeave.toFixed(1)}}</td>
        <td>{{:InsuranceLeave.toFixed(1)}}</td>
        <td id="unpaidLeave">
            {{if ~isHRRole}}
            <form id="form" style="display:none;">
                <input type="text" class="DateOption" id="DateOption" name="DateOption" value="{{:~dateOption}}" />
                <input type="text" class="FromDate" id="FromDate" name="FromDate" value="01 Dec, 2016" />
                <input type="text" class="ToDate" id="ToDate" name="ToDate" value="31 Dec, 2016" />
                <input type="text" id="EmployeeId" name="EmployeeId" value="{{:Employee.Id}}" />
                <input type="text" id="Employee" name="Employee" value="{{:Employee.NickName}} ({{:Employee.FullName}})" />
                <input type="text" class="TeamId" id="TeamId" name="TeamId" value="{{if Employee.TeamId == null}} -2 {{else}} Employee.TeamId {{/if}}" />
                <input type="text" id="StatusId" name="StatusId" value="0" />
                <input type="text" id="RequestType" name="RequestType" value="1" />
                <input type="text" id="IsFilterByEffectedDate" name="IsFilterByEffectedDate" value="true" />
                <input type="text" class="LeaveTypeId" id="LeaveTypeId" name="LeaveTypeId" value="26" />
            </form>
            {{/if}}
            {{if ~isHRRole && UnpaidLeave > 0}}
            <a class="UnpaidLeave" href="javascript:;">
                {{:UnpaidLeave.toFixed(1)}}
            </a>
            {{else}}
            {{:UnpaidLeave.toFixed(1)}}
            {{/if}}
        </td>
        <td>{{:BusinessLeave.toFixed(1)}}</td>
        <td>{{:WorkFromHome.toFixed(1)}}</td>
        <td>{{:TotalWorkingDay}}</td>
        <td></td>
        <td>{{:PreAnnualLeave.toFixed(1)}}</td>
        <td>{{:PreMonthSickLeave.toFixed(1)}}</td>
        <td>{{:PreMonthUnpaidLeave.toFixed(1)}}</td>
        <td>{{:PreMonthBusinessLeave.toFixed(1)}}</td>
        <td>{{:PreWorkFromHome.toFixed(1)}}</td>
    </tr>
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        @foreach (var team in Model.Teams)
            {
                @:$('#TeamId option[value="@team.Id"]').attr('data-department-id', '@team.DepartmentId');
        }
    });
</script>