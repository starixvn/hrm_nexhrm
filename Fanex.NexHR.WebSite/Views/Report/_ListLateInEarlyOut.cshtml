@using Fanex.NexHR.Core
@using Fanex.NexHR.Models.Report
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model IList<LateInEarlyOutSummary>

@{
    var year = ViewBag.Year;

    DateTime GetFirstDayOfMonth(byte month) => new DateTimeOffset(year, month, 1, 0, 0, 0, TimeSpan.Zero).DateTime;
    DateTime GetLastDayOfMonth(byte month) => new DateTimeOffset(year, month, DateTime.DaysInMonth(year, month), 0, 0, 0, TimeSpan.Zero).DateTime;

    void DisplayFormatTotalLateInEarlyOut(int minutes, int times, int employeeId, DateTime fromDate, DateTime toDate, bool isHighlight = true)
    {
        var url = "LateInEarlyOutDetail?employeeId=" + employeeId + "&fromDate=" + fromDate.ToDateMonthYearFormatedDate()
            + "&toDate=" + toDate.ToDateMonthYearFormatedDate();

        if (minutes != 0)
        {
            <td>
                <a class="@((times > 3 && isHighlight) ? "red-color" : string.Empty)" href="@url">@((minutes / 60.0).ToString("0.0")) / @times</a>
            </td>
        }
        else
        {
            <td>-</td>
        }
    }
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
}

<table id="data" class="table bordered striped highlight table-custom centered">
    <thead>
        <tr>
            <th rowspan="2">@Labels.EnglishName</th>
            <th rowspan="2">
                <span id="last-year">@(ViewBag.Year - 1)</span> (@Labels.Hours)
            </th>
            <th colspan="13">
                <span id="current-year">@ViewBag.Year</span> (@Labels.Hours / @Labels.Times)
            </th>
            <th rowspan="2">@Labels.DeductionTaken</th>
            <th rowspan="2">@Labels.UsedNEX</th>
            <th rowspan="2">@Labels.Balance</th>
            @if (@isHRRole)
            {
                <th rowspan="2">@Labels.Deduct</th>
            }
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th>@Labels.Dec</th>
            <th style="border-right: none;">@Labels.Total</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        IList<LateInEarlyOutSummary> lateInEarlyOutByTeams = Model.GroupBy(t => t.TeamId).Select(grp => grp.First()).ToList();
        <tbody>
            @foreach (var lateInEarlyOutByTeam in lateInEarlyOutByTeams)
            {
                <tr class="row-divider">
                    <td class="align-left txt-uppercase" colspan="19">
                        <b>@lateInEarlyOutByTeam.TeamName.ToUpperInvariant()</b>
                    </td>
                </tr>

                IList<LateInEarlyOutSummary> lateInEarlyOuts = Model.Where(t => t.TeamId == lateInEarlyOutByTeam.TeamId).ToList();
                foreach (var lateInEarlyOut in lateInEarlyOuts)
                {
                    <tr>
                        <td class="tooltip" title="@lateInEarlyOut.FullName"> @lateInEarlyOut.NickName</td>
                        <td>@(lateInEarlyOut.BalanceLastYear != 0 ? (lateInEarlyOut.BalanceLastYear / 60.0).ToString("0.0") : "-")</td>
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Jan, lateInEarlyOut.TimesInJan, lateInEarlyOut.EmpId, GetFirstDayOfMonth(1), GetLastDayOfMonth(1)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Feb, lateInEarlyOut.TimesInFeb, lateInEarlyOut.EmpId, GetFirstDayOfMonth(2), GetLastDayOfMonth(2)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Mar, lateInEarlyOut.TimesInMar, lateInEarlyOut.EmpId, GetFirstDayOfMonth(3), GetLastDayOfMonth(3)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Apr, lateInEarlyOut.TimesInApr, lateInEarlyOut.EmpId, GetFirstDayOfMonth(4), GetLastDayOfMonth(4)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.May, lateInEarlyOut.TimesInMay, lateInEarlyOut.EmpId, GetFirstDayOfMonth(5), GetLastDayOfMonth(5)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Jun, lateInEarlyOut.TimesInJun, lateInEarlyOut.EmpId, GetFirstDayOfMonth(6), GetLastDayOfMonth(6)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Jul, lateInEarlyOut.TimesInJul, lateInEarlyOut.EmpId, GetFirstDayOfMonth(7), GetLastDayOfMonth(7)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Aug, lateInEarlyOut.TimesInAug, lateInEarlyOut.EmpId, GetFirstDayOfMonth(8), GetLastDayOfMonth(8)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Sep, lateInEarlyOut.TimesInSep, lateInEarlyOut.EmpId, GetFirstDayOfMonth(9), GetLastDayOfMonth(9)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Oct, lateInEarlyOut.TimesInOct, lateInEarlyOut.EmpId, GetFirstDayOfMonth(10), GetLastDayOfMonth(10)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Nov, lateInEarlyOut.TimesInNov, lateInEarlyOut.EmpId, GetFirstDayOfMonth(11), GetLastDayOfMonth(11)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Dec, lateInEarlyOut.TimesInDec, lateInEarlyOut.EmpId, GetFirstDayOfMonth(12), GetLastDayOfMonth(12)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.TotalCurrentYear, lateInEarlyOut.TotalTimesCurrentYear, lateInEarlyOut.EmpId, GetFirstDayOfMonth(1), GetLastDayOfMonth(12), false); }

                        @if (lateInEarlyOut.LeaveDeduction != 0)
                        {
                            var url = "/AnnualLeave/LeaveDeductionDetail?employeeId=" + lateInEarlyOut.EmpId
                                + "&fromDate=" + GetFirstDayOfMonth(1).ToDateMonthYearFormatedDate()
                                + "&toDate=" + GetLastDayOfMonth(12).ToDateMonthYearFormatedDate();

                            <td>
                                <a href="@url">@((lateInEarlyOut.LeaveDeduction / 60.0).ToString("0.0"))</a>
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                        }
                        <td>@(lateInEarlyOut.OvertimeBalance != 0 ? (lateInEarlyOut.OvertimeBalance / 60.0).ToString("0.0") : "-")</td>
                        <td class="@(lateInEarlyOut.BalanceCurrentYear >= 240 ? "red-color" : string.Empty)">
                            @(lateInEarlyOut.BalanceCurrentYear != 0 ? (lateInEarlyOut.BalanceCurrentYear / 60.0).ToString("0.0") : "-")
                        </td>
                        @if (@isHRRole)
                        {
                            if(lateInEarlyOut.BalanceCurrentYear >= 240)
                            {
                                <td>
                                    <a href="javascript:;" class="addLeavededuction" data-id="@lateInEarlyOut.EmpId" 
                                       data-annualbalance="@lateInEarlyOut.AnnualLeaveBalance">
                                        <i class="mdi mdi-border-color mdi-18px mdi-dark"></i>
                                    </a>
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                    </tr>
                }
            }
        </tbody>
    }
    else
    {
        <tr>
            <td colspan="19"></td>
        </tr>
        <tr>
            <td colspan="19" rowspan="2">
                @Messages.NoInformation
            </td>
        </tr>
    }
</table>