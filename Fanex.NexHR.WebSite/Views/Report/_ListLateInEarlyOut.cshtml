
@using Fanex.NexHR.Core
@using Fanex.NexHR.Models.Report
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model IList<LateInEarlyOutSummary>

@{
    void DisplayFormatTotalLateInEarlyOut(int minutes, int times, int employeeId, DateTime fromDate, DateTime toDate, bool isHightlight = true)
    {
        var url = "LateInEarlyOutDetail?employeeId=" + employeeId + "&fromDate=" + fromDate.ToDateMonthYearFormatedDate()
            + "&toDate=" + toDate.ToDateMonthYearFormatedDate();

        if (minutes != 0)
        {
            <td>
                <a class="@((times > 3 && isHightlight) ? "red-color" : string.Empty)" href="@url">@((minutes / 60.0).ToString("0.0")) / @times</a>
            </td>
        }
        else
        {
            <td>-</td>
        }
    }
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
}

<table id="data" class="table bordered striped highlight table-custom centered">
    <thead>
        <tr>
            <th rowspan="2">@Labels.EnglishName</th>
            <th rowspan="2">
                <span id="last-year">@(ViewBag.Year - 1)</span> (@Labels.Hours)
            </th>
            <th colspan="13">
                <span id="current-year">@ViewBag.Year</span> (@Labels.Hours / @Labels.Times)
            </th>
            <th rowspan="2">@Labels.DeductionTaken</th>
            <th rowspan="2">@Labels.UsedNEX</th>
            <th rowspan="2">@Labels.Balance</th>
            @if (@isHRRole)
            {
                <th rowspan="2">@Labels.Deduct</th>
            }
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th>@Labels.Dec</th>
            <th style="border-right: none;">@Labels.Total</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        IList<LateInEarlyOutSummary> lateInEarlyOutByTeams = Model.GroupBy(t => t.TeamId).Select(grp => grp.First()).ToList();
        <tbody>
            @foreach (LateInEarlyOutSummary lateInEarlyOutByTeam in lateInEarlyOutByTeams)
            {
                <tr class="row-divider">
                    <td class="align-left txt-uppercase" colspan="19">
                        <b>@lateInEarlyOutByTeam.TeamName.ToUpper()</b>
                    </td>
                </tr>

                IList<LateInEarlyOutSummary> lateInEarlyOuts = Model.Where(t => t.TeamId == lateInEarlyOutByTeam.TeamId).ToList();
                foreach (LateInEarlyOutSummary lateInEarlyOut in lateInEarlyOuts)
                {
                    <tr>
                        <td class="tooltip" title="@lateInEarlyOut.FullName"> @lateInEarlyOut.NickName</td>
                        <td>@(lateInEarlyOut.BalanceLastYear != 0 ? (lateInEarlyOut.BalanceLastYear / 60.0).ToString("0.0") : "-")</td>
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Jan, lateInEarlyOut.TimesInJan, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 1, 1), new DateTime(ViewBag.Year, 1, 31)); }
                        @{
                            DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Feb, lateInEarlyOut.TimesInFeb, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 2, 1), new DateTime(ViewBag.Year, 3, 1).AddDays(-1));
                        }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Mar, lateInEarlyOut.TimesInMar, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 3, 1), new DateTime(ViewBag.Year, 3, 31)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Apr, lateInEarlyOut.TimesInApr, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 4, 1), new DateTime(ViewBag.Year, 4, 30)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.May, lateInEarlyOut.TimesInMay, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 5, 1), new DateTime(ViewBag.Year, 5, 31)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Jun, lateInEarlyOut.TimesInJun, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 6, 1), new DateTime(ViewBag.Year, 6, 30)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Jul, lateInEarlyOut.TimesInJul, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 7, 1), new DateTime(ViewBag.Year, 7, 31)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Aug, lateInEarlyOut.TimesInAug, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 8, 1), new DateTime(ViewBag.Year, 8, 31)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Sep, lateInEarlyOut.TimesInSep, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 9, 1), new DateTime(ViewBag.Year, 9, 30)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Oct, lateInEarlyOut.TimesInOct, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 10, 1), new DateTime(ViewBag.Year, 10, 31)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Nov, lateInEarlyOut.TimesInNov, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 11, 1), new DateTime(ViewBag.Year, 11, 30)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.Dec, lateInEarlyOut.TimesInDec, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 12, 1), new DateTime(ViewBag.Year, 12, 31)); }
                        @{ DisplayFormatTotalLateInEarlyOut(lateInEarlyOut.TotalCurrentYear, lateInEarlyOut.TotalTimesCurrentYear, lateInEarlyOut.EmpId, new DateTime(ViewBag.Year, 1, 1), new DateTime(ViewBag.Year, 12, 31), false); }

                        @if (lateInEarlyOut.LeaveDeduction != 0)
                        {
                            var url = "/AnnualLeave/LeaveDeductionDetail?employeeId=" + lateInEarlyOut.EmpId
                                + "&fromDate=" + new DateTime(ViewBag.Year, 1, 1).ToDateMonthYearFormatedDate()
                                + "&toDate=" + new DateTime(ViewBag.Year, 12, 31).ToDateMonthYearFormatedDate();

                            <td>
                                <a href="@url">@((lateInEarlyOut.LeaveDeduction / 60.0).ToString("0.0"))</a>
                            </td>
                        }
                        else
                        {
                            <td>-</td>
                        }
                        <td>@(lateInEarlyOut.OvertimeBalance != 0 ? (lateInEarlyOut.OvertimeBalance / 60.0).ToString("0.0") : "-")</td>
                        <td class="@(lateInEarlyOut.BalanceCurrentYear >= 240 ? "red-color" : string.Empty)">
                            @(lateInEarlyOut.BalanceCurrentYear != 0 ? (lateInEarlyOut.BalanceCurrentYear / 60.0).ToString("0.0") : "-")
                        </td>
                        @if (@isHRRole)
                        {
                            if(lateInEarlyOut.BalanceCurrentYear >= 240)
                            {
                                <td>

                                <a href="javascript:;" class="addLeavededuction" data-id="@lateInEarlyOut.EmpId" 
                                   data-annualbalance="@lateInEarlyOut.AnnualLeaveBalance">
                                    <i class="mdi mdi-border-color mdi-18px mdi-dark"></i>
                                </a>
                            </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            
                        }
                    </tr>
                }
            }
        </tbody>
    }
    else
    {
        <tr>
            <td colspan="19"></td>
        </tr>
        <tr>
            <td colspan="19" rowspan="2">
                @Messages.NoInformation
            </td>
        </tr>
    }
</table>