@model LateInEarlyOutSummaryViewModel
@{
    ViewBag.Title = Labels.LateInEarlyOutDiscipline;
}
@section css{
    @Styles.Render(
        "~/Content/monthpickercss",
                "~/Content/lateinearlyoutdisciplinecss")
}
@section js {
    @Scripts.Render(
        "~/bundles/monthpickerjs",
                "~/bundles/lateinearlyoutdisciplinejs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <form class="form-filter" action="" novalidate="novalidate">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.Label(@Labels.FromDate)
                                    </div>
                                    <div class="left select--s">
                                        <div id="fromMonthPickr"></div>
                                        @Html.HiddenFor(model => model.FromYear)
                                        @Html.HiddenFor(model => model.FromMonth)
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.Label(@Labels.ToDate)
                                    </div>
                                    <div class="left select--s">
                                        <div id="toMonthPickr"></div>
                                        @Html.HiddenFor(model => model.ToYear)
                                        @Html.HiddenFor(model => model.ToMonth)
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--s">
                                        @Html.Label(@Labels.Team)
                                    </div>
                                    <div class="left select-team">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), @Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left">
                                        @Html.MaterializeCheckBoxFor(model => model.IsUserWarning, new { @class = "filled-in" })
                                    </div>
                                    <div class="left">
                                        @Html.LabelFor(model => model.IsUserWarning, Labels.UserWarning)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                            @Html.Hidden("minDate", (new DateTime(2010, 1, 1)).ToString("yyyy/MM/dd"))
                            @Html.Hidden("maxDate", DateTime.Now.ToString("yyyy/MM/dd"))
                        </form>
                    </div>
                    <div id="list-detail" class="p-x--s">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>