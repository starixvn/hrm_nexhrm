@model TimeRecordViewModel
@{
    ViewBag.Title = @Labels.TimeRecord;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render(
        "~/bundles/contextmenujs",
        "~/bundles/timerecordjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                    <div class="form">
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    <label>@Labels.DateRange</label>
                                </div>
                                <div class="left select--m">
                                    @RazorHelper.DateRangeDropDownList("Date", (int)DateRange.DateRange)
                                    @Html.Hidden("DateOption", Model.DateOption)
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                </div>
                                <div class="left datepicker-button select--s">
                                    @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                </div>
                                <div class="left datepicker-button select--s">
                                    @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.TeamIds, Labels.Team)
                                </div>
                                <div class="left select--m">
                                    @Html.DropDownList("GroupId", new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.Employee)
                                </div>
                                <div class="left select--m">
                                    @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                    @Html.HiddenFor(model => model.EmployeeId)
                                </div>
                            </div>
                            <div class="col">
                                <span class="button-hrm waves-effect waves-light btn blue darken-2 m-r--s">
                                    <input id="btnSubmit" type="button" value="@Labels.Submit" /></span>
                            </div>
                        </div>
                    </div>
                    <div id="TimeRecordContent">
                    </div>
                    <ul id="outMenu" class="hide">
                        <li class="out"><a command="out" href="javascript:;">@Labels.Out</a> </li>
                    </ul>
                    <ul id="inMenu" class="hide">
                        <li class="in"><a command="in" href="javascript:;">@Labels.In</a> </li>
                    </ul>
                    <ul id="inOutMenu" class="hide">
                        <li class="in"><a command="in" href="javascript:;">@Labels.In</a> </li>
                        <li class="out"><a command="out" href="javascript:;">@Labels.Out</a> </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
