@model TimeRecordViewModel
@{
    ViewBag.Title = @Labels.TimeRecord;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render(
        "~/bundles/contextmenujs",
        "~/bundles/timerecordjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                        <form class="form-filter" action="">
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--m">
                                        @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFilter.DateRange)
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s m-r--s">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.TeamIds, Labels.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamIds, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left select--s">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    @Html.HiddenFor(model => model.ItemsPerPage)
                                    @Html.HiddenFor(model => model.CurrentPage)
                                    <input id="submit" class="btn-submit waves-effect waves-light" type="button" value="@Labels.Submit" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <div id="datatable_length" class="row form-input m-b--m hide">
                        <div class="col">
                            <div class="inline label--s">
                                <label>Show</label>
                            </div>
                            <div class="inline select--xs m-r--s">
                                @Html.DropDownListFor(model => model.ItemsPerPage, Model.ItemsPerPageArray)
                            </div>
                            <div class="inline label--m">
                                <label>entries</label>
                            </div>
                        </div>
                    </div>
                     <div id="time-record-detail" class="p-x--s">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
