@model TimeRecordViewModel
@{
    ViewBag.Title = @Labels.TimeRecord;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render(
        "~/bundles/contextmenujs",
        "~/bundles/timerecordjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                    @using (Html.BeginForm("timerecord", "report", FormMethod.Post, new { id = "form" }))
                    {
                    <div class="form">
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    <label>@Labels.DateRange</label>
                                </div>
                                <div class="left select--m">
                                    @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFiltering.DateRange)
                                    @Html.Hidden("DateOption", Model.DateOption)
                                </div>
                            </div>
                            <div class="col m-r--l">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                </div>
                                <div class="left datepicker-button select--s">
                                    @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--s m-r--s">
                                    @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                </div>
                                <div class="left datepicker-button select--s">
                                    @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.TeamIds, Labels.Team)
                                </div>
                                <div class="left select--m">
                                    @Html.DropDownListFor(model => model.TeamIds, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    @Html.LabelFor(model => model.Employee)
                                </div>
                                <div class="left select--m">
                                    @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                    @Html.HiddenFor(model => model.EmployeeId)
                                </div>
                            </div>
                            <div class="col">
                                @Html.HiddenFor(model => model.ItemsPerPage)
                                @Html.HiddenFor(model => model.CurrentPage)
                                <input id="submit" class="btn-submit waves-effect waves-light" type="button" value="@Labels.Submit" />
                            </div>
                        </div>
                    </div>
                    }
                    <div id="datatable_length" class="row m-b--m hide">
                        <div class="col">
                            <div class="left label--s">
                                <label>Show</label>
                            </div>
                            <div class="left select--xs m-r--s">
                                @Html.DropDownListFor(model => model.ItemsPerPage, Model.ItemsPerPageArray, new { @class = "browser-default" })
                            </div>
                            <div class="left label--m">
                                <label>entries</label>
                            </div>
                        </div>
                    </div>
                     <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered responsive-table table-custom">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Code</th>
                                    <th>@Labels.Nick</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.TimeRecord</th>
                                    <th>@Labels.InOut</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot></tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="pager" class="hide">
    <table>
        <tfoot>
            <tr>
                <td colspan="6" id="pagination" class="row form-input">
                    <div id="detailtext" class="col"></div>
                    <div class="col right">
                        <ul id="numberlist" class="pagination"></ul>
                    </div>
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<script id="template" type="text/x-jquery-tmpl">
    <tr>
        <td>${index()}</td>
        <td>
            ${Employee.Code}
        </td>
        <td class="tooltip" title="${Employee.FullName}">
            ${Employee.NickName}
        </td>
        <td class="tooltip" title="${Employee.Team.Name}">
            ${Employee.Team.Code}
        </td>
        <td>${formatJsonDateToDetailFormatedDate(RecordTime)}</td>
        <td>
        {{if InOutType == 0}}
            <a data-id="${RecordTimeId}" href="javascript:void(0);" class="out-action">
                ${GetInOutName}
            </a>
        {{else InOutType == 1}}
            <a data-id="${RecordTimeId}" href="javascript:void(0);" class="in-action">
                ${GetInOutName}
            </a>
        {{else}}
            <a data-id="${RecordTimeId}" href="javascript:void(0);" class="inout-action">
                ${GetInOutName}
            </a>
        {{/if}}
        </td>
    </tr>
</script>
