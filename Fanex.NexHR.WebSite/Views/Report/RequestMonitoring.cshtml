@model RequestsMonitoringViewModel
@{
    ViewBag.Title = Labels.RequestMonitoring;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/requeststatisticjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm())
                        {
                            @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--s">
                                        @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFiltering.DateRange)
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.FromDate)
                                        <i class="mdi-action-event calendar-icon from-date left"></i>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ToDate)
                                        <i class="mdi-action-event calendar-icon to-date left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.MaxRequest)
                                    </div>
                                    <div class="left select--s">
                                        @RazorHelper.MaxRequestDropDownList(Model.MaxRequest)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th rowspan="2">@Labels.SymbolCount</th>
                                    <th rowspan="2">@Labels.Name</th>
                                    <th rowspan="2">@Labels.Nick</th>
                                    <th rowspan="2">@Labels.Team</th>
                                    <th colspan="4">@Labels.Leave</th>
                                    <th colspan="2">@Labels.CheckInOut</th>
                                    <th rowspan="2">@Labels.LateInEarlyOut (@Labels.Times)</th>
                                    <th rowspan="2">@Labels.Absent (@Labels.Times)</th>
                                </tr>
                                <tr>
                                    <th>@Labels.Request (@Labels.Times)</th>
                                    <th>@Labels.Annual (Days)</th>
                                    <th>@Labels.Unpaid (Days)</th>
                                    <th>@Labels.Others (Days)</th>
                                    <th>@Labels.Request (@Labels.Times)</th>
                                    <th>@Labels.Missing (@Labels.Times)</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var maxRequest = @Model.MaxRequest,
        isLeader = '@ViewBag.isLeader' == 'True' ? true : false,
        fromDate = '@ViewBag.FromDate',
        toDate = '@ViewBag.ToDate';
</script>

<script id="template" type="text/x-jquery-tmpl">
    <tr>
        <td>${index()}</td>
        <td class="align-left">
            ${Requester.FullName}
        </td>
        <td>
            ${Requester.NickName}
        </td>
        <td class="tooltip" title="${Requester.Team.Name}">
            ${Requester.Team.Code}
        </td>
        <td {{if TotalLeaveTimes > maxRequest}}class="overloadRequest"{{else}} class=""{{/if}}>
            {{if TotalLeaveTimes > 0}}
                <form class="request-model hide">
                    <input class="DateOption" type="text" name="DateOption" value="0" />
                    <input class="FromDate" type="text" name="FromDate" value="${fromDate}" />
                    <input class="ToDate" type="text" name="ToDate" value="${toDate}" />
                    <input type="text" name="EmployeeId" value="${Requester.Id}" />
                    <input type="text" name="Employee" value="${Requester.NickName} (${Requester.FullName})" />
                    <input type="text" name="TeamId" value="-2" />
                    <input type="text" name="StatusId" value="2" />
                    <input type="text" name="IsFilterByEffectedDate" value="true" />
                    <input type="text" name="RequestType" value="1" />
                </form>
                {{if isLeader}}
                    <a class="TotalLeaveTimes" href="javascript:;" data-controller="request" data-action="member">${TotalLeaveTimes}</a>
                {{else}}
                    <a class="TotalLeaveTimes" href="javascript:;" data-controller="request" data-action="hrview">${TotalLeaveTimes}</a>
                {{/if}}
            {{else}}
                -
            {{/if}}
        </td>
        <td {{if TotalAnnualLeave > maxRequest}}class="overloadRequest"{{else}} class=""{{/if}}>
            {{if TotalAnnualLeave > 0}}
                <form class="request-model hide">
                    <input class="DateOption" type="text" name="DateOption" value="0" />
                    <input class="FromDate" type="text" name="FromDate" value="${fromDate}" />
                    <input class="ToDate" type="text" name="ToDate" value="${toDate}" />
                    <input type="text" name="EmployeeId" value="${Requester.Id}" />
                    <input type="text" name="Employee" value="${Requester.NickName} (${Requester.FullName})" />
                    <input type="text" name="TeamId" value="-2" />
                    <input type="text" name="StatusId" value="2" />
                    <input type="text" name="IsFilterByEffectedDate" value="true" />
                    <input type="text" name="RequestType" value="1" />
                </form>
                {{if isLeader}}
                    <a class="TotalAnnualLeave" href="javascript:;" data-controller="request" data-action="member">${formatTotalDays(TotalAnnualLeave)}</a>
                {{else}}
                    <a class="TotalAnnualLeave" href="javascript:;" data-controller="request" data-action="hrview">${formatTotalDays(TotalAnnualLeave)}</a>
                {{/if}}
            {{else}}
                -
            {{/if}}
        </td>
        <td {{if TotalUnpaidLeave > maxRequest}}class="overloadRequest"{{else}} class=""{{/if}}>
            {{if TotalUnpaidLeave > 0}}
                <form class="request-model hide">
                    <input class="DateOption" type="text" name="DateOption" value="0" />
                    <input class="FromDate" type="text" name="FromDate" value="${fromDate}" />
                    <input class="ToDate" type="text" name="ToDate" value="${toDate}" />
                    <input type="text" name="EmployeeId" value="${Requester.Id}" />
                    <input type="text" name="Employee" value="${Requester.NickName} (${Requester.FullName})" />
                    <input type="text" name="TeamId" value="-2" />
                    <input type="text" name="StatusId" value="2" />
                    <input type="text" name="IsFilterByEffectedDate" value="true" />
                    <input type="text" name="RequestType" value="1" />
                </form>
                {{if isLeader}}
                    <a class="TotalUnpaidLeave" href="javascript:;" data-controller="request" data-action="member">${formatTotalDays(TotalUnpaidLeave)}</a>
                {{else}}
                    <a class="TotalUnpaidLeave" href="javascript:;" data-controller="request" data-action="hrview">${formatTotalDays(TotalUnpaidLeave)}</a>
                {{/if}}
            {{else}}
                -
            {{/if}}
        </td>
        <td {{if TotalOtherLeave > maxRequest}}class="overloadRequest"{{else}} class=""{{/if}}>
            {{if TotalOtherLeave > 0}}
                <form class="request-model hide">
                    <input class="DateOption" type="text" name="DateOption" value="0" />
                    <input class="FromDate" type="text" name="FromDate" value="${fromDate}" />
                    <input class="ToDate" type="text" name="ToDate" value="${toDate}" />
                    <input type="text" name="EmployeeId" value="${Requester.Id}" />
                    <input type="text" name="Employee" value="${Requester.NickName} (${Requester.FullName})" />
                    <input type="text" name="TeamId" value="-2" />
                    <input type="text" name="StatusId" value="2" />
                    <input type="text" name="IsFilterByEffectedDate" value="true" />
                    <input type="text" name="RequestType" value="1" />
                </form>
                {{if isLeader}}
                    <a class="TotalOtherLeave" href="javascript:;" data-controller="request" data-action="member">${formatTotalDays(TotalOtherLeave)}</a>
                {{else}}
                    <a class="TotalOtherLeave" href="javascript:;" data-controller="request" data-action="hrview">${formatTotalDays(TotalOtherLeave)}</a>
                {{/if}}
            {{else}}
                -
            {{/if}}
        </td>
        <td {{if TotalCheckInOutTimes > maxRequest}}class="overloadRequest"{{else}} class=""{{/if}}>
            {{if TotalCheckInOutTimes > 0}}
                <form class="request-model hide">
                    <input class="DateOption" type="text" name="DateOption" value="0" />
                    <input class="FromDate" type="text" name="FromDate" value="${fromDate}" />
                    <input class="ToDate" type="text" name="ToDate" value="${toDate}" />
                    <input type="text" name="EmployeeId" value="${Requester.Id}" />
                    <input type="text" name="Employee" value="${Requester.NickName} (${Requester.FullName})" />
                    <input type="text" name="TeamId" value="-2" />
                    <input type="text" name="StatusId" value="2" />
                    <input type="text" name="IsFilterByEffectedDate" value="true" />
                    <input type="text" name="RequestType" value="4" />
                </form>
                {{if isLeader}}
                    <a class="TotalCheckInOutTimes" href="javascript:;" data-controller="request" data-action="member">${TotalCheckInOutTimes}</a>
                {{else}}
                    <a class="TotalCheckInOutTimes" href="javascript:;" data-controller="request" data-action="hrview">${TotalCheckInOutTimes}</a>
                {{/if}}
            {{else}}
                -
            {{/if}}
        </td>
        <td {{if TotalMissingCheckInOutTimes > maxRequest}}class="overloadRequest"{{else}} class=""{{/if}}>
            {{if TotalMissingCheckInOutTimes > 0}}
                <form class="request-model hide">
                    <input class="FromDate" type="text" name="FromDate" value="${fromDate}" />
                    <input class="ToDate" type="text" name="ToDate" value="${toDate}" />
                    <input type="text" name="EmpId" value="${Requester.Id}" />
                    <input type="text" name="Employee" value="${Requester.DisplayName}" />
                </form>
                <a class="TotalCheckInOutTimes" href="javascript:;" data-controller="report" data-action="attendance">${TotalMissingCheckInOutTimes}</a>
            {{else}}
                -
            {{/if}}
        </td>
        <td {{if LateInEarlyOutTimes > maxRequest}}class="overloadRequest"{{else}} class=""{{/if}}>
            {{if LateInEarlyOutTimes > 0}}
                <form class="request-model hide">
                    <input class="FromDate" type="text" name="FromDate" value="${fromDate}" />
                    <input class="ToDate" type="text" name="ToDate" value="${toDate}" />
                    <input type="text" name="EmpId" value="${Requester.Id}" />
                    <input type="text" name="Employee" value="${Requester.DisplayName}" />
                </form>
                <a class="TotalCheckInOutTimes" href="javascript:;" data-controller="report" data-action="attendance">${LateInEarlyOutTimes}</a>
            {{else}}
                -
            {{/if}}
        </td>
        <td {{if TotalAbsent > maxRequest}}class="overloadRequest"{{else}} class=""{{/if}}>
            {{if TotalAbsent > 0}}
                <form class="request-model hide">
                    <input class="FromDate" type="text" name="FromDate" value="${fromDate}" />
                    <input class="ToDate" type="text" name="ToDate" value="${toDate}" />
                    <input type="text" name="EmpId" value="${Requester.Id}" />
                    <input type="text" name="Employee" value="${Requester.DisplayName}" />
                </form>
                <a class="TotalCheckInOutTimes" href="javascript:;" data-controller="report" data-action="attendance">${TotalAbsent}</a>
            {{else}}
                -
            {{/if}}
        </td>
    </tr>
</script>
