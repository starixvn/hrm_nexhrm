@model IList<YearlyNexRequest>

<table id="data" class="table bordered striped highlight table-custom centered">
    <thead>
        <tr>
            <th rowspan="2">#</th>
            <th rowspan="2">@Labels.Nick</th>
            <th rowspan="2">@Labels.NEXType</th>
            <th colspan="12">@Labels.NexRequest @ViewBag.Year </th>
            <th rowspan="2">@Labels.Total</th>
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th>@Labels.Dec</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int index = 1;
            var nexType = "";
            IList<YearlyNexRequest> yearlyNexRequestByTeams = Model.GroupBy(t => t.Employee.Team.Id).Select(grp => grp.First()).ToList();
            foreach (YearlyNexRequest yearlyNexRequestByTeam in yearlyNexRequestByTeams)
            {
                <tr class="row-divider">
                    <td colspan="16">
                        <b>@yearlyNexRequestByTeam.Employee.Team.Name.ToUpper()</b>
                    </td>
                </tr>

                IList<YearlyNexRequest> yearlyNexRequests = Model.Where(t => t.Employee.Team.Id == yearlyNexRequestByTeam.Employee.Team.Id).ToList();
                IList<YearlyNexRequest> yearlyNexRequestByEmployeeIds = yearlyNexRequests.GroupBy(t => t.Employee.Id).Select(grp => grp.First()).ToList();
                foreach (YearlyNexRequest yearlyNexRequestByEmployeeId in yearlyNexRequestByEmployeeIds)
                {
                    IList<YearlyNexRequest> numberRequestOfPerson = Model.Where(t => t.Employee.Id == yearlyNexRequestByEmployeeId.Employee.Id).ToList();
                    int requestCount = numberRequestOfPerson.Count;
                    <tr>
                        <td rowspan="@requestCount">@(index++)</td>
                        <td class="tooltip align-left" rowspan="@requestCount" title="@yearlyNexRequestByEmployeeId.Employee.FullName">@yearlyNexRequestByEmployeeId.Employee.NickName</td>
                        @foreach (YearlyNexRequest yearlyNexRequest in numberRequestOfPerson)
                        {
                            if (yearlyNexRequest.IsHoliday == 1) { nexType = "isHoliday"; }
                            else
                            {
                                if (yearlyNexRequest.IsNormalDay == 1) { nexType = "isNormalday"; }
                                else
                                {
                                    if (yearlyNexRequest.IsOffDay == 1) { nexType = "isOffday"; }
                                    else { nexType = ""; }
                                }
                            }

                            if (yearlyNexRequest.IsHoliday == 1)
                            {
                                <td class="align-left @nexType">@Labels.Holiday</td>}
                            else
                            {
                                if (yearlyNexRequest.IsNormalDay == 1)
                                {
                                    <td class="align-left @nexType">@Labels.NormalDay</td>}
                                else
                                {
                                    if (yearlyNexRequest.IsOffDay == 1)
                                    {
                                        <td class="align-left @nexType">@Labels.OffDay</td>}
                                    else
                                    {
                                        <td></td>}
                                }
                            }

                            var url = "/overtime";

                            if (yearlyNexRequest.Jan > 0)
                            {
                                <td class="@nexType">
                                    <a href="@url">@yearlyNexRequest.Jan</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }

                            if (yearlyNexRequest.Feb > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Feb</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }

                            if (yearlyNexRequest.Mar > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Mar</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }

                            if (yearlyNexRequest.Apr > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Apr</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }

                            if (yearlyNexRequest.May > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.May</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (yearlyNexRequest.Jun > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Jun</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (yearlyNexRequest.Jul > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Jul</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (yearlyNexRequest.Aug > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Aug</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (yearlyNexRequest.Sep > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Sep</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (yearlyNexRequest.Oct > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Oct</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (yearlyNexRequest.Nov > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Nov</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (yearlyNexRequest.Dec > 0)
                            {
                                <td class="@nexType">
                                    <a href="">@yearlyNexRequest.Dec</a>
                                </td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (yearlyNexRequest.TotalHour > 0)
                            {
                                <td class="@nexType">@yearlyNexRequest.TotalHour</td>
                            }
                            else
                            {
                                <td class="@nexType">-</td>
                            }
                            if (requestCount > 1)
                            {
                            @:</tr><tr>
                            }
                        }
                    </tr>
                }
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(16)
        }
    </tbody>
</table>