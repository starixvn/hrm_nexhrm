@model TotalWorkingHoursViewModel
@{
    ViewBag.Title = Labels.TotalWorkingHours;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/totalworkinghourjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "form" }))
                    {
                        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                        <div class="form">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--m">
                                        @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFilter.DateRange)
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left datepicker-button input--s">
                                        @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left datepicker-button input--s">
                                        @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model=>model.TeamId, new SelectList(Model.TeamCollection, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div>
                                    <input id="btnSubmit" type="button" value="@Labels.Submit" onclick="submitForm('False')" class="btn-submit waves-effect waves-light m-r--m" />
                                    <input id="btnExport" class="btn-export-excel waves-effect waves-light" type="button" value="Excel"/>
                                    @Html.HiddenFor(model => model.IsExportExcel)
                                </div>
                            </div>
                            &nbsp;
                            <div class="p-x--s">
                                <table id="data" class="table bordered striped highlight table-custom centered">
                                    <thead>
                                        <tr>
                                            <th>@Labels.SymbolCount</th>
                                            <th>@Labels.Code</th>
                                            <th>@Labels.FullName</th>
                                            <th>@Labels.Nick</th>
                                            <th>@Labels.Team</th>
                                            <th>@Labels.WorkigDay</th>
                                            <th>@Labels.ActualWorkingDay</th>
                                            <th>@Labels.PaidLeave</th>
                                            <th>@Labels.UnpaidLeave</th>
                                            <th>@Labels.SickLeave</th>
                                            <th>@Labels.AccidentLaborLeave</th>
                                            <th>@Labels.LateIn</th>
                                            <th>@Labels.EarlyOut</th>
                                            <th>@Labels.TotalHours</th>
                                            <th>@Labels.AverageHours</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var isHR = '@Roles.IsUserInRole("HR")' == 'True',
        dateOption = '@Model.DateOption',
        fromDate = '@Model.FromDate',
        toDate = '@Model.ToDate';
</script>
<script id="template" type="text/x-jquery-tmpl">
    <tr>
        <td>${index()}</td>
        <td>${Employee.Code}</td>
        <td class="align-left">${Employee.FullName}</td>
        <td>${Employee.NickName}</td>
        <td class="tooltip" title="${Employee.Team.Name}">${Employee.Team.Code}</td>
        <td>${WorkingDay}</td>
        <td>${ActualWorkingDay}</td>
        <td>${PaidLeave.toFixed(1)}</td>
        <td id="unpaidLeave">
            {{if isHR}}
                <form id="form" style="display:none;">
                    <input type="text" class="DateOption" id="DateOption" name="DateOption" value="${dateOption}" />
                    <input type="text" class="FromDate" id="FromDate" name="FromDate" value="${fromDate}" />
                    <input type="text" class="ToDate" id="ToDate" name="ToDate" value="${toDate}" />
                    <input type="text" id="EmployeeId" name="EmployeeId" value="${Employee.Id}" />
                    <input type="text" id="Employee" name="Employee" value="${Employee.NickName + ' (' + Employee.FullName + ')'}" />
                    <input type="text" class="TeamId" id="TeamId" name="TeamId" value="${Employee.TeamId == null ? -2 : Employee.TeamId}" />
                    <input type="text" id="StatusId" name="StatusId" value="0" />
                    <input type="text" id="RequestType" name="RequestType" value="1" />
                    <input type="text" id="IsFilterByEffectedDate" name="IsFilterByEffectedDate" value="true" />
                    <input type="text" class="LeaveTypeId" id="LeaveTypeId" name="LeaveTypeId" value="26"/>
                </form>
            {{/if}}
            {{if isHR && UnpaidLeave > 0}}
                <a class="UnpaidLeave" href="javascript:;">
                    ${UnpaidLeave.toFixed(1)}
                </a>
            {{else}}
                ${UnpaidLeave.toFixed(1)}
            {{/if}}
        </td>
        <td>
            {{if isHR && SickLeave > 0}}
                <a class="SickLeave" href="javascript:;">
                    ${SickLeave.toFixed(1)}
                </a>
            {{else}}
                ${SickLeave.toFixed(1)}
            {{/if}}
        </td>
        <td>
            {{if isHR && AccidentLaborLeave > 0}}
                <a class="AccidentLaborLeave" href="javascript:;">
                    ${AccidentLaborLeave.toFixed(1)}
                </a>
            {{else}}
                ${AccidentLaborLeave.toFixed(1)}
            {{/if}}
        </td>
        <td>${displayMinuteForTotalWorking(LateIn)}</td>
        <td>${displayMinuteForTotalWorking(EarlyOut)}</td>
        <td>${totalHoursToTime(TotalHours)}</td>
        <td>${totalHoursToTime(AverageHours)}</td>
    </tr>
</script>
