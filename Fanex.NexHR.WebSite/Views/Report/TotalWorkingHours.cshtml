@using Newtonsoft.Json;
@model TotalWorkingHoursViewModel
@{
    ViewBag.Title = Labels.ReportWorkingHours;
    var form = JsonConvert.SerializeObject(Model);
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/totalworkinghourjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "form" }))
                    {
                        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                        <div class="form">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--m">
                                        <select id="Date" name="Date">
                                            <option value="0">@Labels.DateRange</option>
                                            <option value="1">@Labels.ToDay</option>
                                            <option value="2">@Labels.Yesterday</option>
                                            <option value="3">@Labels.CurrentWeek</option>
                                            <option value="4">@Labels.LastWeek</option>
                                            <option value="5">@Labels.CurrentMonth</option>
                                            <option value="6">@Labels.LastMonth</option>
                                            <option value="7">@Labels.SinceLastMonth</option>
                                        </select>
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate, Labels.FromDate)
                                    </div>
                                    <div class="left datepicker-button input--s">
                                        @Html.DatePickerFor(model => model.FromDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate, Labels.ToDate)
                                    </div>
                                    <div class="left datepicker-button input--s">
                                        @Html.DatePickerFor(model => model.ToDate, minDate: new DateTime(2010, 01, 01), maxDate: DateTime.Now)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Team)
                                    </div>
                                    <div class="left select--m">
                                        <select id="TeamId" name="TeamId">
                                            <option value="">@Labels.AllTeams</option>
                                            @foreach (Fanex.NexHR.Models.Team team in ViewBag.Groups)
                                            {
                                                <option selected="@(ViewBag.TeamId == team.Id)" value="@team.Id">@team.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = @Fanex.NexHR.Resources.Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div>
                                    <input id="btnSubmit" type="button" value="@Labels.Submit" onclick="submitForm('False')" class="btn-submit waves-effect waves-light m-r--m" />
                                    <input id="btnExport" class="btn-export-excel waves-effect waves-light" type="button" value="Excel"/>
                                    @Html.HiddenFor(model => model.IsExportExcel)
                                </div>
                            </div>
                            &nbsp;
                            <div class="p-x--s">
                                <table id="data" class="table bordered striped highlight table-custom centered">
                                    <thead>
                                        <tr>
                                            <th>@Labels.SymbolCount</th>
                                            <th>@Labels.Code</th>
                                            <th>@Labels.FullName</th>
                                            <th>@Labels.Nick</th>
                                            <th>@Labels.Team</th>
                                            <th>@Labels.WorkigDay</th>
                                            <th>@Labels.ActualWorkingDay</th>
                                            <th>@Labels.PaidLeave</th>
                                            <th>@Labels.UnpaidLeave</th>
                                            <th>@Labels.SickLeave</th>
                                            <th>@Labels.AccidentLaborLeave</th>
                                            <th>@Labels.LateIn</th>
                                            <th>@Labels.EarlyOut</th>
                                            <th>@Labels.TotalHours</th>
                                            <th>@Labels.AverageHours</th>
                                        </tr>
                                    </thead>
                                        <tbody>                                           
                                        </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var isHR = '@Roles.IsUserInRole("HR")' == 'True' ? true : false;        
</script>
<script id="template" type="text/x-jquery-tmpl">   
    <tr>
        <td>${index()}</td>
        <td>${Employee.Code}</td>
        <td class="align-left">${Employee.FullName}</td>
        <td>${Employee.NickName}</td>
        <td class="tooltip" title="${Employee.Team.Name}">${Employee.Team.Code}</td>
        <td>${WorkingDay}</td>
        <td>${ActualWorkingDay}</td>
        <td>${PaidLeave.toFixed(1)}</td>
        <td id="unpaidLeave">     
            {{if isHR }}     
                <form id="form" style="display:none;">
                    <input type="type" class="DateOption" id="DateOption" name="DateOption"/>
                    <input type="type" class="FromDate" id="FromDate" name="FromDate" />
                    <input type="type" class="ToDate" id="ToDate" name="ToDate"/>
                    <input type="type" id="EmployeeId" name="EmployeeId" value="${Employee.Id}" />                
                    <input type="type" id="Employee" name="Employee" value="${Employee.NickName + ' (' + Employee.FullName + ')'}" />
                    <input type="type" class="TeamId" id="TeamId" name="TeamId" value="${Employee.TeamId == null ? -2 : Employee.TeamId}" />
                    <input type="type" id="StatusId" name="StatusId" value="0" />
                    <input type="type" id="RequestType" name="RequestType" value="1" />
                    <input type="type" id="IsFilterByEffectedDate" name="IsFilterByEffectedDate" value="true" />     
                    <input type="type" class="LeaveTypeId" id="LeaveTypeId" name="LeaveTypeId" value="26"/>                         
                </form>       
            {{/if}}                          
            {{if isHR && UnpaidLeave > 0}}                
                <a class="UnpaidLeave" href="javascript:;">
                    ${UnpaidLeave.toFixed(1)}
                </a>
            {{else}}
                ${UnpaidLeave.toFixed(1)}
            {{/if}}
        </td>
        <td>
            {{if isHR && SickLeave > 0}}                
                <a class="SickLeave" href="javascript:;">
                    ${SickLeave.toFixed(1)}
                </a>
            {{else}}
                ${SickLeave.toFixed(1)}
            {{/if}}            
        </td>
        <td>
            {{if isHR && AccidentLaborLeave > 0}}                
                <a class="AccidentLaborLeave" href="javascript:;">
                    ${AccidentLaborLeave.toFixed(1)}
                </a>
            {{else}}
                ${AccidentLaborLeave.toFixed(1)}
            {{/if}}               
        </td>
        <td>${displayMinuteForTotalWorking(LateIn)}</td>
        <td>${displayMinuteForTotalWorking(EarlyOut)}</td>
        <td>${totalHoursToTime(TotalHours)}</td>
        <td>${totalHoursToTime(AverageHours)}</td>
    </tr>    
</script>
