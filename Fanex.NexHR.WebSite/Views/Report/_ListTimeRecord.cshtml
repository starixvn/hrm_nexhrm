@model IList<TimeRecord>
@{
    var pagerOption = ViewBag.PagerOption;
}
@{
    string alertTable = ""; //use this class to style table when table has data or not
}
@if (Model.Any())
{
    alertTable = "table-success";
}
else
{
    alertTable = "table-fail";
}

<table id="data" class="table bordered striped highlight centered table-custom @alertTable">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.Nick</th>
            <th>@Labels.Team</th>
            <th>@Labels.TimeRecord</th>
            <th>@Labels.InOut</th>
            <th>@Labels.BioStation</th>
            <th>@Labels.EventName</th>
            <th style="width: 5%;">@Labels.CheckInOutOnline</th>
            <th>@Labels.IPAddress</th>
            <th>@Labels.Status</th>
            <th style="width: 5%;">@Labels.EditCheckInOutOnline</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            var index = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage;
            foreach (TimeRecord item in Model)
            {
                index++;
            <tr>
                <td>@index</td>
                <td>
                    @item.Employee.Code
                </td>
                <td class="tooltip" title="@item.Employee.FullName">
                    @item.Employee.NickName
                </td>
                <td class="tooltip" title="@item.Employee.Team.Name">
                    @item.Employee.Team.Code
                </td>
                <td>
                    @item.RecordTime.ToDetailFormatedDate()
                </td>
                <td>
                    @if (Roles.IsUserInRole("HR"))
                    {
                        if (item.InOutType == 0)
                        {
                            <a data-id="@item.RecordTimeId" href="javascript:void(0);" class="out-action">
                                @item.GetInOutName
                            </a>
                        }
                        else if (item.InOutType == 1)
                        {
                            <a data-id="@item.RecordTimeId" href="javascript:void(0);" class="in-action">
                                @item.GetInOutName
                            </a>
                        }
                        else
                        {
                            <a data-id="@item.RecordTimeId" href="javascript:void(0);" class="inout-action">
                                @item.GetInOutName
                            </a>
                        }
                    }
                    else
                    {
                        @item.GetInOutName
                    }
                </td>
                <td>@item.ReaderName</td>
                <td>@item.EventName</td>
                <td style="text-align: center;">
                    <input type="checkbox" id="isCheckInOutOnline" class="filled-in" disabled checked=@item.IsCheckInOutOnline />
                    <label hidden style="padding-left: 15px !important; height: 12px !important; cursor: not-allowed"></label>
                </td>
                <td>@item.IPAddress</td>
                <td>@item.GetStatusName</td>
                <td style="text-align: center;">
                    <input type="checkbox" id="isEditCheckInOutOnline" class="filled-in" disabled checked=@item.IsEditCheckInOutOnline />
                    <label hidden style="padding-left: 15px !important; height: 12px !important; cursor: not-allowed"></label>
                </td>
            </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(colspan: 12)
        }
    </tbody>
    <tfoot>
        @if (Model.Any())
        {
            <tr>
                <td colspan="6" id="pagination" class="row form-input">
                    <div id="detailtext" class="col m-t--m">
                        @{
                            var from = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage + 1;
                            var to = from + (Model.Count - 1);
                        }
                        Showing <strong>@from</strong> to <strong>@to</strong> of <strong>@pagerOption.TotalItem</strong> entries
                    </div>
                    <div class="col right">
                        @Html.Hidden("CurrentPage", (int)pagerOption.CurrentPage)
                        @Html.Hidden("ItemsPerPage", (int)pagerOption.ItemsPerPage)
                        @Html.Hidden("TotalItem", (int)pagerOption.TotalItem)
                        <ul id="numberlist" class="pagination"></ul>
                    </div>
                </td>
            </tr>
        }
    </tfoot>
</table>