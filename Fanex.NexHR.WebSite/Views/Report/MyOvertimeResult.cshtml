@model IEnumerable<Overtime>

@{
    Layout = null;
    var index = 1;
}
@if (Model.Any())
{
    foreach (var item in Model)
    {
        <tr>
            <td>@(index++)</td>
            <td class="align-left">@item.CreatedBy.DisplayName</td>
            <td>@item.Date.ToDateMonthYearFormatedDate()</td>
            <td>@item.Hour</td>
            <td class="tooltip" title="@item.Description">
                @RazorHelper.DisplayLimitedString(item.Description)
            </td>

            @if (item.Status == (int)RequestStatuse.Approve)
            {
                <td class="c-approve">@Labels.Approved</td>
            }
            else if (item.Status == (int)RequestStatuse.Pending)
            {
                <td class="c-pending">@Labels.Pending</td>
            }
            else
            {
                <td class="c-reject"> @Labels.Rejected</td>
            }
        </tr>
    }
}
else
{
    <tr>
        <td colspan="6"></td>
    </tr>
    <tr>
        <td colspan="6">@Labels.NoData</td>
    </tr>
}