@model LeaveDeductionDetailViewModel
@{
    ViewBag.Title = Labels.LeaveDeductionDetail;
}
@section Breadcrumb {
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/leaveDeductionDetailjs");
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                        <div class="form">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--m">
                                        <select id="Date" name="Date">
                                            <option value="0">@Labels.DateRange</option>
                                            <option value="1">@Labels.ToDay</option>
                                            <option value="2">@Labels.Yesterday</option>
                                            <option value="3">@Labels.CurrentWeek</option>
                                            <option value="4">@Labels.LastWeek</option>
                                            <option value="5">@Labels.CurrentMonth</option>
                                            <option value="6">@Labels.LastMonth</option>
                                            <option value="7">@Labels.SinceLastMonth</option>
                                        </select>
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.FromDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ToDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.TeamId)
                                    </div>
                                    <div class="left select--m">
                                        <select id="TeamId" name="TeamId">
                                            <option value="">@Labels.AllTeams</option>
                                            @foreach (Team team in Model.Teams)
                                            {
                                                <option selected="@(Model.TeamId == team.Id)" value="@team.Id">@team.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left select-team">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="submit" value="@Labels.Submit" class="processing-submit btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        </div>
                    }
                    <div class="p-x--s">
                        <table class="data persist-area table bordered striped highlight table-custom centered">
                            <thead>
                                <tr class="persist-header">
                                    <th>
                                        #
                                    </th>
                                    <th>@Labels.Name
                                    </th>
                                    <th>@Labels.Nick
                                    </th>
                                    <th>@Labels.Team
                                    </th>
                                    <th>@Labels.DeductDate
                                    </th>
                                    <th>@Labels.Type
                                    </th>
                                    <th>@Labels.Days
                                    </th>
                                    <th>@Labels.Note
                                    </th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th>@Labels.Edit
                                        </th>
                                        <th>@Labels.Delete
                                        </th>
                                    }
                                </tr>
                            </thead>
                            @if (Model.LeaveDeductions != null && Model.LeaveDeductions.Any())
                            {
                                int index = 1;
                                <tbody>
                                    @foreach (LeaveDeductionDetail item in Model.LeaveDeductions)
                                    {
                                        <tr>
                                            <td>@(index++)
                                            </td>
                                            <td class="align-left">@item.Employee.FullName
                                            </td>
                                            <td>@item.Employee.NickName
                                            </td>
                                            <td>@item.Employee.Team.Code
                                            </td>
                                            <td class="deductdate">@item.DeductDate.ToDateMonthYearFormatedDate()
                                            </td>
                                            <td>@(item.IsAnnual ? Labels.AnnualLeave : Labels.UnpaidLeave)
                                            </td>
                                            <td>@(item.LeaveDays.ToString("0.0"))
                                            </td>
                                            <td class="description">@item.Description
                                            </td>
                                            @if (Roles.IsUserInRole("HR"))
                                            {
                                                <td>
                                                    <a href="javascript:;" class="editLeaveDeduction"
                        data-id="@item.LeaveDeductionId" data-leavedays="@item.LeaveDays" data-isannual="@item.IsAnnual"
                        data-deductdate = "@item.DeductDate.ToDateMonthYearFormatedDate()"><i class="mdi mdi-border-color mdi-dark">
                        </i></a>
                                                </td>

                                                <td>
                                                    <a href="javascript:;" class="deleteLeaveDeduction" data-id="@item.LeaveDeductionId">
                                                        <i class="mdi mdi-delete mdi-dark"></i></a>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            }
                            else
                            {
                                @RazorHelper.DisplayNoInformation(colspan: 10)
                            }
                        </table>
                    </div>
                    <div class="hide">
                        <div id="updateform" title="Edit leave deduction">
                            @Html.Action("EditLeaveDeduction")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
