@model LeaveDeductionDetailViewModel
@{
    ViewBag.Title = Labels.LeaveDeductionDetail;
}
@section Breadcrumb {
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/leaveDeductionDetailjs");
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                        <div class="form">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--m">
                                        @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFiltering.DateRange)
                                        @Html.Hidden("DateOption", Model.DateOption)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.FromDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ToDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.TeamId)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model=>model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left select-team">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="submit" value="@Labels.Submit" class="processing-submit btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        </div>
                    }
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight table-custom centered">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Name</th>
                                    <th>@Labels.Nick</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.DeductDate</th>
                                    <th>@Labels.Type</th>
                                    <th>@Labels.Days</th>
                                    <th>@Labels.Note</th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th>@Labels.Edit</th>
                                        <th>@Labels.Delete</th>
                                    }
                                </tr>
                            </thead>
                            @if (Model.LeaveDeductions != null && Model.LeaveDeductions.Any())
                            {
                                int index = 1;
                                <tbody>
                                    @foreach (LeaveDeductionDetail item in Model.LeaveDeductions)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td class="align-left">@item.Employee.FullName</td>
                                            <td>@item.Employee.NickName</td>
                                            <td>@item.Employee.Team.Code</td>
                                            <td class="deductdate">
                                                @item.DeductDate.ToDateMonthYearFormatedDate()
                                            </td>
                                            <td>
                                                @(item.IsAnnual ? Labels.AnnualLeave : Labels.UnpaidLeave)
                                            </td>
                                            <td>@(item.LeaveDays.ToString("0.0"))</td>
                                            <td class="description">@item.Description</td>
                                            @if (Roles.IsUserInRole("HR"))
                                            {
                                                <td>
                                                    <a href="javascript:;" class="editLeaveDeduction"
                                                        data-id="@item.LeaveDeductionId" data-leavedays="@item.LeaveDays" data-isannual="@item.IsAnnual"
                                                        data-deductdate = "@item.DeductDate.ToDateMonthYearFormatedDate()">
                                                        <i class="mdi mdi-border-color mdi-dark"></i>
                                                    </a>
                                                </td>
                                                <td>
                                                    <a href="javascript:;" class="deleteLeaveDeduction" data-id="@item.LeaveDeductionId">
                                                        <i class="mdi mdi-delete mdi-dark"></i>
                                                    </a>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            }
                            else
                            {
                                @RazorHelper.DisplayNoInformation(colspan: 10)
                            }
                        </table>
                    </div>
                    <div class="hide">
                        <div id="updateform" title="Edit leave deduction">
                            @Html.Action("EditLeaveDeduction")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
