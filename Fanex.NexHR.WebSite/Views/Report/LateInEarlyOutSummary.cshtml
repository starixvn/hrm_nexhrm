@model LateInEarlyOutSummaryViewModel
@{
    ViewBag.Title = Labels.LateInEarlyOutSummary;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/lateinearlyoutsummaryjs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm())
                        {
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--s">
                                        @Html.Label(@Labels.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.TeamCollection, "Id", "Name"), @Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <div class="formrow">
                                        <span class="bold-color">※ Deduction Taken (Hours): </span>
                                        <span class="font-description">@Messages.DeductionTakenDescription.</span>
                                    </div>
                                    <div class="formrow">
                                        <span class="bold-color">※ Balance (Hours):</span>
                                        <span class="font-description"> @Messages.BalanceDescription.</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight table-custom centered">
                            <thead>
                                <tr>
                                    <th rowspan="2">@Labels.Nick</th>
                                    <th rowspan="2">
                                        <span id="last-year">@(Model.Year - 1)</span> (@Labels.Hours)
                                    </th>
                                    <th colspan="13">
                                        <span id="current-year">@Model.Year</span> (@Labels.Hours / @Labels.Times)
                                    </th>
                                    <th rowspan="2">@Labels.DeductionTaken (@Labels.Hours)</th>
                                    <th rowspan="2">@Labels.OT (@Labels.Hours)</th>
                                    <th rowspan="2">@Labels.Balance (Hours)</th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th rowspan="2">@Labels.Deduct</th>
                                    }
                                </tr>
                                <tr>
                                    <th>@Labels.Jan</th>
                                    <th>@Labels.Feb</th>
                                    <th>@Labels.Mar</th>
                                    <th>@Labels.Apr</th>
                                    <th>@Labels.May</th>
                                    <th>@Labels.Jun</th>
                                    <th>@Labels.Jul</th>
                                    <th>@Labels.Aug</th>
                                    <th>@Labels.Sep</th>
                                    <th>@Labels.Oct</th>
                                    <th>@Labels.Nov</th>
                                    <th>@Labels.Dec</th>
                                    <th>@Labels.Total</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="hide">
                        <div id="insertform" title="Add Leave Deduction">
                            @Html.Action("CreateLeaveDeduction")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var isHRRole = '@Roles.IsUserInRole("HR")' == 'True';
</script>
<script id="template" type="text/x-jquery-tmpl">
    {{if LateInEarlyOutSummaryInTeam.length > 0}}
        <tr class="row-divider">
            <td class="align-left txt-uppercase" colspan="19">
                <b>${Team.Name}</b>
            </td>
        </tr>
    {{/if}}
    {{each LateInEarlyOutSummaryInTeam}}
        <tr>
            <td class="tooltip" title="${Employee.FullName}">
                ${Employee.NickName}
            </td>
            <td>
                {{if BalanceLastYear != 0}}
                    ${formatBalanceLastYear(BalanceLastYear)}
                {{else}}
                    -
                {{/if}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Jan, TimesInJan, Employee.Id, 1, 1, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Feb, TimesInFeb, Employee.Id, 2, 2, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Mar, TimesInMar, Employee.Id, 3, 3, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Apr, TimesInApr, Employee.Id, 4, 4, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(May, TimesInMay, Employee.Id, 5, 5, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Jun, TimesInJun, Employee.Id, 6, 6, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Jul, TimesInJul, Employee.Id, 7, 7, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Aug, TimesInAug, Employee.Id, 8, 8, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Sep, TimesInSep, Employee.Id, 9, 9, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Oct, TimesInOct, Employee.Id, 10, 10, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Nov, TimesInNov, Employee.Id, 11, 11, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(Dec, TimesInDec, Employee.Id, 12, 12, true)}}
            </td>
            <td>
                {{html displayFormatTotalLateInEarlyOut(TotalCurrentYear, TotalTimesCurrentYear, Employee.Id, 1, 12, false)}}
            </td>
            <td>
                {{html displayNumberHours(LeaveDeduction, Employee.Id, 1, 12)}}
            </td>
            <td>
                {{html displayOTHours(OTBalance, Employee.Id, 1, 12)}}
            </td>
            <td {{if BalanceCurrentYear >= 240}}style="color:red"{{/if}}>
                <strong>
                    ${displayBalance(BalanceCurrentYear)}
                </strong>
            </td>
            {{if isHRRole}}
                <td>
                    <a href="javascript:;" class="addLeavededuction" data-id="${Employee.Id}" data-annualbalance="${Employee.AnnualLeaveBalance}">
                        <i class="mdi mdi-border-color mdi-18px mdi-dark"></i>
                    </a>
                </td>
            {{/if}}
        </tr>
    {{/each}}
</script>
