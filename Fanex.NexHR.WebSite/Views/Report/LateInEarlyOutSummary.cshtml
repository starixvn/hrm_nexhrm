@using Fanex.NexHR.Core;
@using Fanex.NexHR.Models;
@using Fanex.NexHR.Models.Report;
@using Fanex.NexHR.Resources;
@model Fanex.NexHR.ViewModels.Report.LateInEarlyOutSummaryViewModel
@{
    ViewBag.Title = Labels.LateInEarlyOutSummary;
}
@section css{
}
@section js{
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm())
                        {
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>

                                <div class="col m-r--m">
                                    <div class="left label--s m-r--s">
                                        @Html.LabelFor(model => model.TeamId)
                                    </div>
                                    <div class="left select--s">
                                        <select id="TeamId" name="TeamId" class="yearpicker">
                                            <option value="">@Labels.AllTeams</option>
                                            @foreach (Team team in Model.Groups)
                                            {
                                                <option selected="@(Model.TeamId == team.Id)" value="@team.Id">@team.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--s">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                
                                <div class="col">
                                    <span class="button-hrm waves-effect waves-light btn blue darken-2 m-r--s"><input type="submit" value="@Labels.Submit" class="processing-submit" /></span>
                                </div>
                            </div>   
                            
                            <div class="row">
                                <div class="col">
                                    <div class="formrow">
                                        <span class="bold-color">※ Deduction Taken (Hours): </span><span class="font-description">
                                            @Messages.DeductionTakenDescription.</span>
                                    </div>
                                    <div class="formrow">
                                        <span class="bold-color">※ Balance (Hours):</span><span class="font-description"> @Messages.BalanceDescription.</span>
                                    </div>
                                </div>
                            </div>                         
                        }
                    </div>
                    <div class="p-x--s">
                        <table class="data persist-area table bordered striped highlight table-custom centered">
                            <thead class="persist-header">
                                <tr>
                                    <th rowspan="2">@Labels.Nick</th>
                                    <th rowspan="2">@(Model.Year - 1)(Hours)</th>
                                    <th colspan="13">@Model.Year (Hours / Times)</th>
                                    <th rowspan="2">@Labels.DeductionTaken (Hours)</th>
                                    <th rowspan="2">@Labels.Balance (Hours)</th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th rowspan="2">@Labels.Deduct</th>
                                    }
                                </tr>
                                <tr>
                                    <th>@Labels.Jan</th>
                                    <th>@Labels.Feb</th>
                                    <th>@Labels.Mar</th>
                                    <th>@Labels.Apr</th>
                                    <th>@Labels.May</th>
                                    <th>@Labels.Jun</th>
                                    <th>@Labels.Jul</th>
                                    <th>@Labels.Aug</th>
                                    <th>@Labels.Sep</th>
                                    <th>@Labels.Oct</th>
                                    <th>@Labels.Nov</th>
                                    <th>@Labels.Dec</th>
                                    <th>@Labels.Total</th>
                                </tr>
                            </thead>
                            @if (Model.LateInEarlyOutSummary != null && Model.LateInEarlyOutSummary.Any())
                            {
                                <tbody>
                                    @{int index = 1;}
                                    @foreach (LateInEarlyOutSummaryByTeam item in Model.LateInEarlyOutSummary)
                                    {
                                        if (item.LateInEarlyOutSummaryInTeam.Count > 0)
                                        {
                                        <tr>
                                            <td class="rowdivider highlight txt-left" colspan="32">
                                                <b>@item.Team.Name.ToUpper()</b>
                                            </td>
                                        </tr>
                                        }
                                        foreach (LateInEarlyOutSummary lateIn in item.LateInEarlyOutSummaryInTeam)
                                        {
                                        <tr>
                                            <td class="tooltip" title="@lateIn.Employee.FullName">@lateIn.Employee.NickName</td>
                                            <td>@(lateIn.BalanceLastYear != 0 ? (lateIn.BalanceLastYear / 60.0).ToString("0.0") : "-")</td>
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Jan, lateIn.TimesInJan, lateIn.Employee.Id, new DateTime(Model.Year, 1, 1), new DateTime(Model.Year, 1, 31))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Feb, lateIn.TimesInFeb, lateIn.Employee.Id, new DateTime(Model.Year, 2, 1), new DateTime(Model.Year, 3, 1).AddDays(-1))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Mar, lateIn.TimesInMar, lateIn.Employee.Id, new DateTime(Model.Year, 3, 1), new DateTime(Model.Year, 3, 31))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Apr, lateIn.TimesInApr, lateIn.Employee.Id, new DateTime(Model.Year, 4, 1), new DateTime(Model.Year, 4, 30))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.May, lateIn.TimesInMay, lateIn.Employee.Id, new DateTime(Model.Year, 5, 1), new DateTime(Model.Year, 5, 31))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Jun, lateIn.TimesInJun, lateIn.Employee.Id, new DateTime(Model.Year, 6, 1), new DateTime(Model.Year, 6, 30))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Jul, lateIn.TimesInJul, lateIn.Employee.Id, new DateTime(Model.Year, 7, 1), new DateTime(Model.Year, 7, 31))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Aug, lateIn.TimesInAug, lateIn.Employee.Id, new DateTime(Model.Year, 8, 1), new DateTime(Model.Year, 8, 31))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Sep, lateIn.TimesInSep, lateIn.Employee.Id, new DateTime(Model.Year, 9, 1), new DateTime(Model.Year, 9, 30))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Oct, lateIn.TimesInOct, lateIn.Employee.Id, new DateTime(Model.Year, 10, 1), new DateTime(Model.Year, 10, 31))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Nov, lateIn.TimesInNov, lateIn.Employee.Id, new DateTime(Model.Year, 11, 1), new DateTime(Model.Year, 11, 30))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.Dec, lateIn.TimesInDec, lateIn.Employee.Id, new DateTime(Model.Year, 12, 1), new DateTime(Model.Year, 12, 31))
                                            @DisplayFormatTotalLateInEarlyOut(lateIn.TotalCurrentYear, lateIn.TotalTimesCurrentYear, lateIn.Employee.Id, new DateTime(Model.Year, 1, 1), new DateTime(Model.Year, 12, 31), false)
                                            @DisplayNumberHours(lateIn.LeaveDeduction, lateIn.Employee.Id, new DateTime(Model.Year, 1, 1), new DateTime(Model.Year, 12, 31))
                                            <td class="@(lateIn.BalanceCurrentYear >= 240 ? "red-color bold-color" : "bold-color")">@(lateIn.BalanceCurrentYear != 0 ? (lateIn.BalanceCurrentYear / 60.0).ToString("0.0") : "-")</td>
                                            @if (Roles.IsUserInRole("HR"))
                                            {
                                                <td class="center">
                                                    <a href="javascript:;" class="addLeavededuction" data-id="@lateIn.Employee.Id" data-annualbalance="@lateIn.Employee.AnnualLeaveBalance">
                                                        <i class="mdi mdi-border-color mdi-18px mdi-dark"></i>
                                                    </a>
                                                </td>
                                            }
                                        </tr>
                                        }
                                    }
                                </tbody>
                            }
                            else
                            {
                                @RazorHelper.DisplayNoInformation(32)
                            }
                        </table>
                    </div>
                    
                    <div class="hide">
                        <div id="insertform" title="Add leave deduction">
                            @Html.Action("CreateLeaveDeduction")
                        </div>
                    </div>
                    @helper DisplayFormatTotalLateInEarlyOut(int minutes, int times, int employeeId, DateTime fromDate, DateTime toDate, bool isHightlight = true)
                        {
                            var url = "LateInEarlyOutDetail?employeeId=" + employeeId
                                + "&fromDate=" + fromDate.ToDateMonthYearFormatedDate()
                                + "&toDate=" + toDate.ToDateMonthYearFormatedDate();

                            if (minutes != 0)
                            {
                        <td>
                            <a class="@((times > 3 && isHightlight) ? "red-color" : string.Empty)" href="@url">@((minutes / 60.0).ToString("0.0"))
                                / @times</a>
                        </td>
                            }
                            else
                            {
                        <td>
                            -
                        </td>
                            }
                    }
                    @helper DisplayNumberHours(int number, int employeeId, DateTime fromDate, DateTime toDate)
                        {
                            var url = "LeaveDeductionDetail?employeeId=" + employeeId
                                + "&fromDate=" + fromDate.ToDateMonthYearFormatedDate()
                                + "&toDate=" + toDate.ToDateMonthYearFormatedDate();

                            if (number != 0)
                            {
                        <td>
                            <a href="@url">@((number / 60.0).ToString("0.0"))</a>
                        </td>
                            }
                            else
                            {
                        <td>
                            -
                        </td>
                            }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

