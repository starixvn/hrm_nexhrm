@using Fanex.NexHR.ViewModels.YearlyNexRequest

@model YearlyNexRequestViewModel

@{
    ViewBag.Title = Labels.YearlyNexRequest;
}
@section css {
    @Styles.Render("~/Content/yearlynexrequestcss",
                    "~/Content/view-mobile")
}

@section js{
    @Scripts.Render("~/bundles/yearlynexrequestjs")
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        @using (Html.BeginForm("GetYearlyNexRequest", "Report", FormMethod.Post))
                        {
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.TeamId, Labels.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        }
                    </div>
                    <div id="listYearlyNexRequest" class="p-x--s over-auto">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>