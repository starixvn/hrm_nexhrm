@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.YearlyNexRequest

@model YearlyNexRequestViewModel

@{
    ViewBag.Title = Labels.YearlyNexRequest;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/yearlynexrequest.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Report/report.yearlynexrequest.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/yearlynexrequest.min.js" asp-append-version="true"></script>
    </environment>
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <form asp-controller="Report" asp-action="GetYearlyNexRequest" method="post">
                             <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label>@Labels.Year</label>
                                    </div>
                                    <div class="left select--xs year">
                                        <select id="Year" asp-items="@Extensions.YearPicker(2010, DateTime.Now.Year)">
                                        </select> 
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label>@Labels.Team</label>
                                    </div>
                                    <div class="left select--m team">
                                        <select asp-for="TeamId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                            <option value="">@Labels.AllTeams</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        <label>@Labels.Employee</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="Employee" placeholder = "@Messages.SearchEmployeeWatermark"/>
                                        <input type="hidden" asp-for="EmployeeId"/>
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <div id="listYearlyNexRequest" class="p-x--s over-auto">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>