@model TimesheetViewModel
@{
    ViewBag.Title = Labels.MyTimesheet;
}
@section css{
    @Styles.Render("~/Content/monthpickercss", "~/Content/mytimesheetcss")
}
@section js{
    @Scripts.Render("~/bundles/monthpickerjs", "~/bundles/mytimesheetjs")
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginGetForm())
                        {
                        @Html.ValidationSummary(true)
                        <div class="row form-input">
                            <div class="col">
                                <div class="left label--s">
                                    <label>@Labels.Month</label>
                                </div>
                                <div class="left select--m">
                                    <div id="monthPickr"></div>
                                    <input type="hidden" id="Year" name="Year" value="@DateTime.Now.Year" />
                                    <input type="hidden" id="Month" name="Month" value="@DateTime.Now.Month" />
                                    <input type="hidden" id="maxDate" value="@DateTime.Now.AddMonths(3).GetMaxDate().ToString("yyyy/MM/dd")" />
                                    @Html.HiddenFor(model => model.EmpId)
                                </div>
                            </div>
                            <div class="col">
                                <div class="left label--l">
                                    @Html.LabelFor(model => model.RequestType)
                                </div>
                                <div class="left select--s">
                                    @RazorHelper.RequestTypeFilter("RequestType", Model.RequestType)
                                </div>
                            </div>
                            <div class="col">
                                <a id="query" class="btn-submit waves-effect waves-light" href="javascript:;">@Labels.Submit</a>
                            </div>
                        </div>
                    }
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered responsive-table table-custom">
                            <thead>
                                <tr>
                                    <th>@Labels.SymbolCount</th>
                                    <th>@Labels.Date</th>
                                    <th>@Labels.Nick</th>
                                    <th>@Labels.Team</th>
                                    <th>@Labels.Shift</th>
                                    <th>@Labels.CheckIn</th>
                                    <th>@Labels.CheckOut</th>
                                    <th>@Labels.TotalHours</th>
                                    <th>@Labels.LateIn</th>
                                    <th>@Labels.EarlyOut</th>
                                    <th>@Labels.Request</th>
                                    <th>@Labels.Note</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="itemTemplate" type="text/x-jquery-tmpl">
    <tr {{if IsNotWork != 0}}class="offdate"{{else ShiftId }} {{else}} class="noshift"{{/if}}>
        <td>${index()}</td>
        <td>
            ${formatJsonDate(AttendanceDate, 'dd MMM, yyyy')}
        </td>
        <td title="${FullName}" class="tooltip">
            ${NickName}
        </td>
        <td class="tooltip" title="${Team}">
            ${TeamCode}
        </td>
        <td>
            ${ShiftCode}
        </td>
        <td>
            {{if InFixed}} ${formatJsonDate(InFixed, 'HH:MM')} {{else IsMissingCheckin == 1 }} <a href="../checkinout/create?type=1&date=${formatJsonDate(AttendanceDate, 'dd MMM, yyyy')}">Request</a> {{/if}}
        </td>
        <td>
            {{if OutFixed }} ${formatJsonDate(OutFixed, 'HH:MM')} {{else IsMissingCheckOut == 1}} <a href="../checkinout/create?type=2&date=${formatJsonDate(AttendanceDate, 'dd MMM, yyyy')}">Request</a>{{/if}}
        </td>
        <td>
            {{if TotalWorkHours > 0}}
                ${totalHoursToTime(TotalWorkHours)}
            {{/if}}
        </td>
        <td>
            {{if LateIn > 0}}
                ${displayMinute(LateIn)}
            {{/if}}
        </td>
        <td>
            {{if EarlyOut > 0}}
                ${displayMinute(EarlyOut)}
            {{/if}}
        </td>
        <td class="col-request">
            {{if Requests != null > 0}}
                {{each Requests}}
                    <a href='javascript:;' class="tooltip-request req"
                            data-requesttype="${RequestType.Id}"
                            data-fromdate="${formatJsonDate(FromDate, 'dd MMM, yyyy HH:MM:ss')}"
                            data-todate="${formatJsonDate(ToDate, 'dd MMM, yyyy HH:MM:ss')}"
                            data-createddate="${formatJsonDate(CreatedDate, 'dd MMM, yyyy HH:MM:ss')}"
                            data-fromshift="${FromShift.Name}"
                            {{if ToShift != null}} data-toshift="${ToShift.Name}" {{else}} data-toshift="" {{/if}}
                            data-totaldays="${TotalDays}"
                            data-totalmins="${TotalMins}"
                            data-remark='${Remark}'>
                            {{if RequestType.Id == 6}}  ${RequestType.Name} {{else}} ${RequestType.Name} {{/if}}
                        </a>
                {{/each}}
            {{/if}}
        </td>
        <td>
            ${Notes}
        </td>
    </tr>
</script>