@using Fanex.NexHR.Core
@using Fanex.NexHR.Models.Applicant
@using Fanex.NexHR.Resources
@model IEnumerable<Applicant>
@{
    var index = 1;
    string dirCV = "file/uploads/cv";
}
<div id="divErrorCont"></div>
<table id="data-detail" class="table bordered striped highlight table-custom centered">
    <thead>
        <tr>
            <th style="width:2%" rowspan="2">@Labels.SymbolCount</th>
            <th style="width:14%" rowspan="2">@Labels.FullName</th>
            <th style="width:6%" rowspan="2">@Labels.Phone</th>
            <th style="width:6%" rowspan="2">@Labels.Email</th>
            <th style="width:14%" rowspan="2">@Labels.Position</th>
            <th colspan="2">@Labels.Interview1</th>
            <th colspan="2">@Labels.Interview2</th>
            <th style="width:2%" rowspan="2">@Labels.Status</th>
            <th style="width:7%" rowspan="2">@Labels.OnBoard</th>
            <th style="width:20%" rowspan="2">@Labels.Note</th>
            <th style="width:4%" rowspan="2">@Labels.Source</th>
            <th style="width:2%" rowspan="2">@Labels.CV</th>
            <th style="width:2%" rowspan="2">@Labels.Edit</th>
            <th style="width:2%" rowspan="2">@Labels.Delete</th>
            <th style="width:2%" rowspan="2">@Labels.CreateAccount</th>
        </tr>
        <tr>
            <th style="width:8%">@Labels.Date</th>
            <th style="width:2%">@Labels.Result</th>
            <th style="width:8%">@Labels.Date</th>
            <th style="width:2%; border-right: none">@Labels.Result</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                string hightlight = (item.ResultName1 == "KIV" || item.ResultName2 == "KIV") ? "background-color: #f5e7e1;" : "";
                <tr id="row@(item.Id)" style="@hightlight">
                    <td>@(index++)</td>
                    <td class="align-left">
                        <a href="@Url.Action("Detail", "Applicants", new { id = item.Id })">@item.FullName</a>
                    </td>
                    <td>@item.Phone</td>
                    <td class="align-left">@item.Email</td>
                    <td class="align-left">@item.Position</td>
                    <td>@item.InterviewDate1.ToDateMonthYearFormatedDate()</td>
                    <td>@item.ResultName1</td>
                    <td>@item.InterviewDate2.ToDateMonthYearFormatedDate()</td>
                    <td>@item.ResultName2</td>
                    <td>@item.CVStatus</td>
                    <td>@item.JoinDate.ToDateMonthYearFormatedDate()</td>
                    <td class="align-left">@item.Note</td>
                    <td>@item.SourceName</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Resume))
                        {
                            <a href="@($"{dirCV}/{item.Resume}")">@Labels.View</a>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", "Applicants", new { @item.Id})">
                            <i class="mdi mdi-border-color mdi-dark mdi-18px"></i>
                        </a>
                    </td>
                    <td>
                        <a href="javascript:;" onclick="deleteApplicant(@item.Id, '@item.Resume')">
                            <i class="mdi mdi-delete mdi-dark mdi-18px"></i>
                        </a>
                    </td>
                     <td>
                         <a asp-controller="employee" asp-action="create"
                            asp-route-fullName="@item.FullName"
                            asp-route-phone="@item.Phone"
                            asp-route-DOB="@item.DOB"
                            asp-route-joinDate="@item.JoinDate"
                            asp-route-educationBackground="@item.EducationBackground"
                            >
                            <i class="mdi mdi-plus-circle mdi-dark mdi-18px"></i>
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="17">@Labels.NoData</td>
            </tr>
        }
    </tbody>
</table>