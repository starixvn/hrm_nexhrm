@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Applicant
@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Helpers
@model DetailApplicantViewModel

@{
    ViewBag.Title = Labels.Applicants;
    var dirCV = FileHelpers.GetResumeDir();
    var isManager = ViewBag.IsManager;
}

@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Views/applicant.min.css" asp-append-version="true">
}

<div class="row content applicant-detail">
    <div class="col s12 card-container-base over-auto">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.Detail</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.FullName:</label>
                                </div>
                                <div class="left input--m">
                                    @Model.FullName
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.Position:</label>
                                </div>
                                <div class="left select--m">
                                    @Model.Position
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.Phone:</label>
                                </div>
                                <div class="left input--m">
                                    @Model.Phone
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.Email:</label>
                                </div>
                                <div class="left input--m">
                                    @Model.Email
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.DoB:</label>
                                </div>
                                <div class="left datepicker-button select--m">
                                    @Model.DOB.ToDateMonthYearFormatedDate()
                                </div>
                            </div>

                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.YearsOfExperience:</label>
                                </div>
                                <div class="left input--m">
                                    @Model.YearsOfExperience
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.ApplyDate:</label>
                                </div>
                                <div class="left datepicker-button select--m">
                                    @Model.ApplyDate.ToDateMonthYearFormatedDate()
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.ProfessionalLevel:</label>
                                </div>
                                <div class="left select--m">
                                    @Model.ProfessionalLevel
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.ProfessionalMajor:</label>
                                </div>
                                <div class="left input--m">
                                    @Model.ProfessionalMajor
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.CVStatus:</label>
                                </div>
                                <div class="left select--m">
                                    @Model.Status
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.InterviewDate1:</label>
                                </div>
                                <div class="left select--m">
                                    @if (Model.InterviewDate1 != null)
                                    {
                                        @Model.InterviewDate1.ToFormatedDate()
                                    }
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.Result1</label>
                                </div>
                                <div class="left select--m">
                                    @Model.Result1
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.InterviewDate2:</label>
                                </div>
                                <div class="left datepicker-button select--m">
                                    @if (Model.InterviewDate2 != null)
                                    {
                                        @Model.InterviewDate2.ToFormatedDate()
                                    }
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.Result2:</label>
                                </div>
                                <div class="left select--m">
                                    @Model.Result2
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.JoinDate:</label>
                                </div>
                                <div class="left datepicker-button select--m">
                                    @if (Model.JoinDate != null)
                                    {
                                        @Model.JoinDate.ToDateMonthYearFormatedDate()
                                    }
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.Source:</label>
                                </div>
                                <div class="left select--m">
                                    @Model.Source
                                </div>
                            </div>
                        </div>
	                    <div class="row form-input">
		                    <div class="col m-r--m">
			                    <div class="left label--mxxl">
				                    <label>@Labels.Recruiter:</label>
			                    </div>
			                    <div class="left input--m">
				                    @Model.Recruiter
			                    </div>
		                    </div>
		                    <div class="col m-r--m">
			                    <div class="left label--mxxl">
                                    <label>@Labels.JobGrade:</label>
			                    </div>
			                    <div class="left input--m">
				                    @Model.Grade
			                    </div>
		                    </div>
	                    </div>
	                    <div class="row form-input">
		                    <div class="col m-r--m">
			                    <div class="left label--mxxl">
				                    <label>@Labels.ManagementGrade:</label>
			                    </div>
			                    <div class="left input--m">
                                    @Model.ManagementGrade
			                    </div>
		                    </div>
	                    </div>
                        <div class="row form-input form-file">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.ResumeFile:</label>
                                </div>
                                <div class="left file-input input-custom">
                                    @if (!string.IsNullOrEmpty(Model.Resume))
                                    {
                                        string resumeUrl = $"{dirCV}/{Model.Resume}";
                                        <div class="resume-container">
                                            <a href="@resumeUrl">
                                                @Model.Resume
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.EducationBackground:</label>
                                </div>
                                <div class="left input-custom">
                                    @Model.EducationBackground
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.Interviewers:</label>
                                </div>
                                <div class="left input-custom">
                                    @Model.Interviewer
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.InterviewerCmt:</label>
                                </div>
                                <div class="left input-custom">
                                    @Model.InterviewerComment
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--mxxl">
                                    <label>@Labels.Note:</label>
                                </div>
                                <div class="left input-custom">
                                    @Model.Note
                                </div>
                            </div>
                        </div>
                        @if (isManager)
                        {
                            <div class=" form-salary">
                                <div class="row form-input">
                                    <div class="col m-r--m">
                                        <div class="left label--mxxl">
                                            <label>@Labels.FinalCmt:</label>
                                        </div>
                                        <div class="left input-custom">@Model.FinalComment
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-input">
                                    <div class="group-salary">
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label>@Labels.ExpectedSalary:</label>
                                            </div>
                                            <div class="left input--m">@Model.ExpectedSalary
                                            </div>
                                        </div>
                                        <div class="col m-r--m">
                                            <div class="left label--mxxl">
                                                <label>@Labels.OfferedSalary:</label>
                                            </div>
                                            <div class="left input--m">@Model.OfferSalary
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="row form-input line-button">
                            <div class="left">
                                <a class="btn-back waves-effect waves-light" asp-controller="applicants"
                                    asp-action="index">@Labels.Back</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('.resume-container a').on('click', function (e) {
            e.preventDefault();
            var newLocation = $(this).attr('href');
            var openNewTab = new URL(newLocation, window.location.origin);
            window.open(openNewTab, '_blank');
        });
    });
</script>