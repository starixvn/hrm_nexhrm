@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Applicant
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model ApplicantViewModel

@{
    ViewBag.Title = Labels.Applicants;
}

@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Applicant/applicant.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/applicant.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--s">
                                    <label>@Labels.Position</label>
                                </div>
                                <div class="left select--m team">
                                    <select asp-for="PositionId" asp-items="@(new SelectList(null, "Id", "Name"))">
                                        <option value="">@Labels.Position</option>
                                    </select>
                                </div>
                            </div>
                             @* <div class="col m-r--m">
                                <div class="left label--s">
                                    <label>@Labels.Status</label>
                                </div>
                                <div class="left select--m team">
                                    <select asp-for="TeamId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                        <option value="">@Labels.Status</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col">
                                <div class="left label--m">
                                    <label>@Labels.Name</label>
                                </div>
                                <div class="left input--m">
                                    <input asp-for="Employee"/>
                                    <input type="hidden" asp-for="EmployeeId"/>
                                </div>
                            </div> *@
                            <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="@Model.FromDate">@Labels.FromDate</label>
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        <date-picker
                                            name="FromDate"
                                            value="Model.FromDate"
                                        >
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="@Model.ToDate">@Labels.ToDate</label>
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        <date-picker
                                            name="ToDate"
                                            value="Model.ToDate"
                                        >
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            <div class="col">
                                <input type="button" id="submit" class="btn-submit waves-effect waves-light m-r--m" value="@Labels.Submit" />
                                <a class="btn-request waves-effect waves-light btn" href="javascript:;" id="btnNewApplicant">
                                    <i class="left mdi mdi-plus"></i>@Labels.NewApplicant
                                </a>
                            </div>
                        </div>
                    </div>
                    <div id="applicants-detail" class="p-x--s">
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>
</div>