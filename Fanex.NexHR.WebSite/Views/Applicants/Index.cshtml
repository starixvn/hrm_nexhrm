@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Applicant
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model ApplicantViewModel

@{
    ViewBag.Title = Labels.Applicants;
    var PageSizeList = new List<SelectListItem>
    {
        new SelectListItem { Text = "50", Value = "50" },
        new SelectListItem { Text = "100", Value = "100" },
        new SelectListItem { Text = "200", Value = "200" },
        new SelectListItem { Text = "300", Value = "300" },
        new SelectListItem { Text = "400", Value = "400" },
        new SelectListItem { Text = "500", Value = "500" },
        new SelectListItem { Text = "1000", Value = "1000" }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Views/applicant.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Applicant/applicant.index.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/applicant.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base over-auto">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    <label>@Labels.FullName</label>
                                </div>
                                <div class="left input--m">
                                    <input asp-for="FullName" />
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    <label>@Labels.Position</label>
                                </div>
                                <div class="left select--m">
                                    <select asp-for="PositionId" asp-items="@(new SelectList(Model.Positions, "PositionId", "PositionName"))">
                                        <option value="">@Labels.All</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--s">
                                    <label>@Labels.Status</label>
                                </div>
                                <div class="left select--s">
                                    <select asp-for="Status" asp-items="@(new SelectList(Model.StatusList, "Value", "Name"))">
                                        <option value="">@Labels.All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    <label asp-for="@Model.FromDate">@Labels.FromDate</label>
                                </div>
                                <div class="left datepicker-button select--s">
                                    <date-picker name="FromDate" value="@Model.FromDate">
                                    </date-picker>
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                            <div class="col m-r--m">
                                <div class="left label--m">
                                    <label asp-for="@Model.ToDate">@Labels.ToDate</label>
                                </div>
                                <div class="left datepicker-button select--s">
                                    <date-picker name="ToDate" value="@Model.ToDate">
                                    </date-picker>
                                    <i class="mdi-action-event calendar-icon left"></i>
                                </div>
                            </div>
                            <div class="col group-button">
                                <input type="button" id="submit" class="btn-submit waves-effect waves-light m-r--m" value="@Labels.Submit" />
                                <a id="exportExcel" class="waves-effect waves-light btn-export-excel m-r--b">@Labels.Excel</a>
                                <a asp-controller="applicants" asp-action="create" class="btn-request waves-effect waves-light btn m-r--m">
                                    <i class="mdi mdi-plus"></i>@Labels.NewApplicant
                                </a>
                                <a asp-controller="position" asp-action="index" class="btn-request waves-effect waves-light btn">@Labels.Position</a>
                            </div>
                        </div>
                    </div>
                    <div id="applicants-detail" class="p-x--s over-auto">
                    </div>
                    <div class="pagination">
                        <div class="page-size">
                            <span>Page size</span>
                            <div class="left">
                                <select asp-for="PageSize" asp-items="@PageSizeList" onchange="pageSizeChanged()">
                                </select>
                            </div>
                        </div>
                        <div class="page-number">
                            <button class="mdi mdi-chevron-double-left" id="btnDoublePrev"></button>
                            <button class="mdi mdi-chevron-left" id="btnPrev"></button>
                            <input asp-for="PageNumber" min="1" type="number"/>
                            <button class="mdi mdi-chevron-right" id="btnNext"></button>
                            <button class="mdi mdi-chevron-double-right" id="btnDoubleNext"></button>
                        </div>
                        <span>Display <span id="item-range-start"></span> to <span id="item-range-end"></span> of <span id="total-items"></span> item(s)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>