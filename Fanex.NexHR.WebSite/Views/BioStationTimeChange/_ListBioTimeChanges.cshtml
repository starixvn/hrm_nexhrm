@using Fanex.NexHR.Models.Bio
@model IList<BioTimeChange>
<table id="data" class="table bordered striped highlight table-custom centered">
    <thead>
    <tr>
        <th>@Labels.DeviceId</th>
        <th>@Labels.DeviceName</th>
        <th>@Labels.DisplayName</th>
        <th>@Labels.TimeChanged</th>
        <th>@Labels.PreviousLoggedTimeOnOtherDevice</th>
        <th>@Labels.NextLoggedTimeOnOtherDevice</th>
        <th>@Labels.Warning</th>
    </tr>
    </thead>
    <tbody>
    @foreach (BioTimeChange bio in Model)
    {
        <tr>
            <td>@bio.DeviceId</td>
            <td>@bio.DeviceName</td>
            <td>@bio.DisplayName</td>
            <td>@bio.TimeChange.ToDetailFormatedDate()</td>
            <td>@bio.PreviousLogTime.ToDetailFormatedDate()</td>
            <td>@bio.NextLogTime.ToDetailFormatedDate()</td>
            <td>
                @if (bio.Warning)
                {
                    <i class="alert mdi-alert-warning deep-orange-text"></i>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
