@section css {
}
@section js {
}
@{
    ViewBag.Title = "Employee Geolocation Map";
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 l7 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <div class="row form-input">
                            <div class="col m-r--m"><label>Employee</label></div>
                            <div class="col m-r--m">@Html.Editor("Employee")</div>                            
                            <span class="button-hrm waves-effect waves-light btn white-text orange darken-1 m-r--s"><input type="button" value="Search" id="searchmap" /></span>
                        </div>                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="http://maps.google.com/maps/api/js?sensor=false" type="text/javascript"></script>
<div id="map_canvas">
</div>
@Html.Hidden("currentUser", (string)ViewBag.NickName)
@Html.Hidden("roleHR", (bool)ViewBag.RoleHR)
@Html.Hidden("Latitude")
@Html.Hidden("Longitude")
