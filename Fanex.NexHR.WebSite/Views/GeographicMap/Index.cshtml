@section css {
    @Styles.Render("~/Content/geolocationcss")
}
@section js {
    @Scripts.Render("~/bundles/geolocationjs")
}
@{
    ViewBag.Title = Labels.EmployeeGeolocationMap;
}
@section Breadcrumb {
}

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8">
    <link rel="stylesheet" type="text/css" href="https://js.api.here.com/v3/3.1/mapsjs-ui.css" />
    <script type="text/javascript" src="https://js.api.here.com/v3/3.1/mapsjs-core.js"></script>
    <script type="text/javascript" src="https://js.api.here.com/v3/3.1/mapsjs-service.js"></script>
    <script type="text/javascript" src="https://js.api.here.com/v3/3.1/mapsjs-ui.js"></script>
    <script type="text/javascript" src="https://js.api.here.com/v3/3.1/mapsjs-mapevents.js"></script>
    <script>window.ENV_VARIABLE = 'developer.here.com'</script>
</head>
<body>
    <div class="row content">
        <div class="col s12 l12 card-container-base">
            <div class="card">
                <div class="card-content">
                    <div class="card-title-block">
                        <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                    </div>
                    <div class="card-body">
                        <div class="form">
                            <script src="https://maps.google.com/maps/api/js" type="text/javascript"></script>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <label>
                                        @Labels.Employee
                                    </label>
                                </div>
                                <div class="col m-r--m input--m">@Html.Editor("Employee")</div>
                                <input id="searchmap" class="btn-request waves-effect waves-light" type="button" value="@Labels.Search" />
                            </div>
                        </div>
                        <div class="p-x--s">
                            <div id="map_canvas">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
@Html.Hidden("currentUser", (string)ViewBag.NickName)
@Html.Hidden("roleHR", (bool)ViewBag.RoleHR)
@Html.Hidden("Latitude")
@Html.Hidden("Longitude")
