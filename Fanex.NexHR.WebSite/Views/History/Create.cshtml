@using Fanex.NexHR.Resources
@model Fanex.NexHR.ViewModels.History.CreateHistoryViewModel
@{
    DateTime currentDate = DateTime.Today;
    var categories = new List<SelectListItem>
    {
        new SelectListItem { Value = "0", Text = "" },
        new SelectListItem { Value = "1", Text = "Team" },
        new SelectListItem { Value = "2", Text = "Job Title" },
        new SelectListItem { Value = "3", Text = "Job Grade" }
    };
}

<form id="create-form" asp-action="create" data-ajax="true" data-ajax-method="post"
    data-ajax-success="historyTransfer.onInsertSuccess">
    <div asp-validation-summary="All"></div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.Employee</label>
                <span class="required">*</span>
            </div>
            <div class="left input--m">
                <input asp-for="Employee" placeholder="@Messages.SearchEmployeeWatermark" />
                <input asp-for="@Model.EmpId" type="hidden" />
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.AffectedDate</label>
                <span class="required">*</span>
            </div>
            <div class="datepicker-button left">
                <date-picker name="AffectedDate" value="currentDate"></date-picker>
                <i class="mdi-action-event calendar-icon left"></i>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.Category</label>
            </div>
            <div class="left select--m">
                <select id="category" asp-items="@(new SelectList(categories, "Value", "Text"))"
                    onchange="handleSelectionChange()">
                </select>
            </div>
        </div>
    </div>
    <div class="row form-input" id="select-team">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.NewTeam</label>
            </div>
            <div class="left select--m">
                <select asp-for="GroupId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                    <option value=""></option>
                </select>
            </div>
            <img src="~/css/Images/icon-cancel.png" alt="icon-cancel" onclick="handleTeamClick()">
        </div>
    </div>
    <div class="row form-input" id="select-jobtitle">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.NewJobTitle</label>
            </div>
            <div class="left select--m">
                <select asp-for="JobTitleId" asp-items="@(new SelectList(Model.JobTitles, "Id", "Name"))">
                    <option value=""></option>
                </select>
            </div>
            <img src="~/css/Images/icon-cancel.png" alt="icon-cancel" onclick="handleJobTitleClick()">
        </div>
    </div>
    <div class="row form-input" id="select-jobgrade">
        <div class="col">
            <div class="left label--l">
                <label>@Labels.NewJobGrade</label>
            </div>
            <div class="left select--m">
                <select asp-for="JobGradeId" asp-items="@(new SelectList(Model.JobGrades, "Id", "Name"))">
                    <option value=""></option>
                </select>
            </div>
            <img src="~/css/Images/icon-cancel.png" alt="icon-cancel" onclick="handleJobGradeClick()">
        </div>
    </div>
</form>