@using Fanex.NexHR.Core.Enums;
@using Fanex.NexHR.Resources;
@using Fanex.NexHR.ViewModels.History;
@using Fanex.NexHR.Services.Interfaces;
@inject ISessionService sessionService;
@model FilterHistoryViewModel
@{
    DateTime currentDate = DateTime.Today;
    ViewBag.Title = Labels.HistoryWork;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Views/history.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/jquery.unobtrusive-ajax.js" asp-append-version="true"></script>
        <script src="~/js/Libs/jquery.validate.unobtrusive.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
        <script src="~/js/Views/History/history.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/history.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <div class="form">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="FromDate">@Labels.FromDate</label>
                                    </div>
                                    <div class="left datepicker-button select--m">
                                        <date-picker name="FromDate" value="currentDate.AddYears(-1)">
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div id="filter-todate" class="col m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="ToDate">@Labels.ToDate</label>
                                    </div>
                                    <div class="left datepicker-button select--m">
                                        <date-picker name="ToDate" value="currentDate">
                                        </date-picker>
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="TeamId">@Labels.Team</label>
                                    </div>
                                    <div class="left select--m team">
                                        <select asp-for="TeamId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                            <option value="">All teams</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label asp-for="@Model.Employee">@Labels.Employee</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="Employee" placeholder="@Messages.SearchEmployeeWatermark" />
                                        <input type="hidden" asp-for="EmployeeId" />
                                    </div>
                                </div>
                                <div class="col m-l--l">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light m-r--b" />
                                        <a class="btn-request waves-effect waves-light btn m-r--m" href="@Url.Action("Create")"
                                           data-ajax="true" data-ajax-mode="replace" data-ajax-update="#dialog-history" data-ajax-success="historyTransfer.onLoadingCreateFormSuccess">
                                            @Labels.NewHistory
                                        </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="p-x--s">
                        <div id="list-history" class="over-auto table-resize table-medium"></div>
                    </div>
                    <div id="dialog-history"></div>
                </div>
            </div>
        </div>
    </div>
</div>