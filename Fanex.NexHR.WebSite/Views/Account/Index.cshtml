@using Fanex.NexHR.Models
@model Fanex.NexHR.Models.Employee
@{
    ViewBag.Title = Labels.MyProfile;
}
@section css{
}
@section js{
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="avatarbox m-t--m">
                        <div class="row">
                            <div class="col">
                                <div class="avatar">
                                    <img src="~/employee/avatar/@(Model.Code)" alt="@Model.NickName" />
                                </div>
                            </div>
                            <div class="col">
                                <div class="pinfo">
                                    <div class="name">@Model.FullName</div>
                                    <p class="accinfo">
                                        <span class="label--l">Staff Code:</span> <span>@Model.Code</span>
                                    </p>
                                    <p class="accinfo">
                                        <span class="label--l">CPU:</span> <span>@Model.DomainUsername</span>
                                    </p>
                                    <p class="accinfo">
                                        <span class="label--l">Email:</span> <span><a href="mailto:@Model.Email">@Model.Email</a></span>
                                    </p>
                                    <p class="accinfo">
                                        <span class="label--l">Phone:</span> <span>@Model.Phone</span>
                                    </p>
                                    <p class="accinfo">
                                        <span class="label--l">Skype:</span> <span><a href="skype:@(Model.Skype)?chat">@Model.Skype</a></span>
                                    </p>
                                    <p class="accinfo">
                                        <span class="label--l">Yahoo:</span> <span><a href="ymsgr:SendIM?@(Model.Yahoo)">@Model.Yahoo</a></span>
                                    </p>
                                    <p class="accinfo">
                                        <span class="label--l">Address:</span> <span>@Model.Address</span>
                                    </p>
                                    <p class="accinfo">
                                        <span class="label--l">Current Address:</span> <span>@Model.CurrentAddress</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="personalinformation p-x--s m-t--m">
                        <div class="boxtitle">
                            Personal information</div>
                        <div class="pinfo">
                            <p class="accinfo">
                                <span class="label--l">Full Name:</span> <span class="txt-bold">@Model.FullName</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">Nick Name:</span> <span class="txt-bold">@Model.NickName</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">D.O.B:</span> <span class="txt-bold">@Model.DateOfBirth.ToString("dd MMM, yyyy")</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">Gender:</span> <span class="txt-bold">@(Model.Gender == 1 ? "Male" : "Female")</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">Marriage:</span> <span class="txt-bold">@(Model.Mariage == null ? "Unknown" : (Model.Mariage == true ? "Yes" : "No"))</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">Id No:</span> <span class="txt-bold">@Model.CardNo</span>
                            </p>
                            @if (Model.PassportNo != null)
                            {
                                <p class="accinfo">
                                    <span class="label--l">Passport No:</span> <span class="txt-bold">@Model.PassportNo</span>
                                </p>                                
                            }
                            @if (Model.PassportExp != null)
                            {
                                var date = (DateTime)Model.PassportExp;
                                <p class="accinfo">
                                    <span class="label--l">Passport Exp:</span> <span class="txt-bold">@date.ToString("dd MMM, yyyy")</span>
                                </p>                                
                            }
                        </div>
                    </div>
                    <div class="Jobinformation p-x--s m-t--m">
                        <div class="boxtitle">
                            JOB INFORMATION
                        </div>
                        <div class="pinfo">
                            <p class="accinfo">
                                <span class="label--l">Job Title:</span> <span class="txt-bold">@ViewBag.JobTitle</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">Team:</span> <span class="txt-bold">@Model.Team.Name</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">Roles:</span> <span class="txt-bold">@Model.DisplayRoles()</span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">Joined Date:</span> <span class="txt-bold">
                                    @if (Model.JoinedDate != null)
                                    {
                                        var date = (DateTime)Model.JoinedDate;
                                        @date.ToString("dd MMM, yyyy")
                                    }
                                </span>
                            </p>
                            <p class="accinfo">
                                <span class="label--l">Confirmed Date:</span> <span class="txt-bold">
                                    @if (Model.ConfirmedDate != null)
                                    {
                                        var date = (DateTime)Model.ConfirmedDate;
                                        @date.ToString("dd MMM, yyyy")
                                    }
                                </span>
                            </p>
                            @if (Model.ResignedDate != null)
                            {
                                var date = (DateTime)Model.ResignedDate;
                                <p class="accinfo">
                                    <span class="label--l">Last Working Date:</span> <span class="txt-bold">@date.ToString("dd MMM, yyyy")</span>
                                </p>                                
                            }
                        </div>
                    </div>
                    <div class="scoreCertificates p-x--s m-t--m">
                        <div class="boxtitle">
                            Score Certificates
                        </div>
                        <div class="pinfo">
                            <p class="accinfo">
                                <span class="label--xl">Technical Skill:</span> <span class="txt-bold">Photoshop, Illustrator,
                                    Indesign, Dreamweaver...</span>
                            </p>
                        </div>
                    </div>
                    <div class="attendacereport m-t--m p-x--s">
                        <div class="boxtitle">
                            Schedule working
                        </div>
                        <div class="pinfo">
                            <p class="accinfo">
                                <span>Annual Leave Balance:</span> <span class="txt-bold m-l--m">@ViewBag.Working.AnnualLeaveBalance
                                    day(s)</span>
                            </p>
                            <table class="table bordered striped highlight centered table-custom" style="width: 500px;">
                                <thead>
                                    <tr>
                                        <th>
                                            Sun
                                        </th>
                                        <th>
                                            Mon
                                        </th>
                                        <th>
                                            Tue
                                        </th>
                                        <th>
                                            Wed
                                        </th>
                                        <th>
                                            Thu
                                        </th>
                                        <th>
                                            Fri
                                        </th>
                                        <th>
                                            Sat
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="scheduleoff">
                                             @ViewBag.Sun
                                        </td>
                                        <td>
                                             @ViewBag.Mon
                                        </td>
                                        <td>
                                             @ViewBag.Tue
                                        </td>
                                        <td>
                                             @ViewBag.Wed
                                        </td>
                                        <td>
                                             @ViewBag.Thu
                                        </td>
                                        <td>
                                             @ViewBag.Fri
                                        </td>
                                        <td class="scheduleoff">
                                             @ViewBag.Sat
                                        </td>
                                    </tr>
                                </tbody>
                            </table>                            
                        </div>
                    </div>
                    @{ Toeic toeic = (Toeic)ViewBag.TOEIC; }
                    
                    <div class="toeicscore m-t--m p-x--s">
                        <div class="boxtitle">
                            TOEIC SCORE
                        </div>
                        <div class="boxcontent">
                            <table class="table bordered striped highlight centered table-custom" style="width: 650px;">
                                <thead>
                                    <tr>
                                        <th>@Labels.Listening
                                        </th>
                                        <th>@Labels.Reading
                                        </th>
                                        <th>@Labels.Speaking
                                        </th>
                                        <th>@Labels.Writing
                                        </th>
                                        <th>@Labels.ExamDate (@Labels.L/@Labels.R & @Labels.S/@Labels.W)
                                        </th>
                                        <th>@Labels.OldScores
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@(toeic != null ? (toeic.Listening.HasValue ? toeic.Listening.Value.ToString() : "-") : "-")
                                        </td>
                                        <td>@(toeic != null ? (toeic.Reading.HasValue ? toeic.Reading.Value.ToString() : "-") : "-")
                                        </td>
                                        <td>@(toeic != null ? (toeic.Speaking.HasValue ? toeic.Speaking.Value.ToString() : "-") : "-")
                                        </td>
                                        <td>@(toeic != null ? (toeic.Writing.HasValue ? toeic.Writing.Value.ToString() : "-") : "-")
                                        </td>
                                        @if (toeic == null || (toeic.LRTotal + toeic.Speaking + toeic.Writing) == 0)
                                        {
                                            <td>
                                                -
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @(toeic.LRExamDate.HasValue ? toeic.LRExamDate.Value.ToString("dd MMM, yyyy") : "-")
                                                /
                                                @(toeic.SWExamDate.HasValue ? toeic.SWExamDate.Value.ToString("dd MMM, yyyy") : "-")
                                            </td>
                                        }
                                        @if (toeic == null || (toeic.OldListening + toeic.OldReading + toeic.OldSpeaking + toeic.OldWriting) == 0)
                                        {
                                            <td>
                                                -
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @(toeic.OldListening.HasValue ? toeic.OldListening.Value.ToString() : "-")
                                                /
                                                @(toeic.OldReading.HasValue ? toeic.OldReading.Value.ToString() : "-")
                                                /
                                                @(toeic.OldSpeaking.HasValue ? toeic.OldSpeaking.Value.ToString() : "-")
                                                /
                                                @(toeic.OldWriting.HasValue ? toeic.OldWriting.Value.ToString() : "-")
                                            </td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
