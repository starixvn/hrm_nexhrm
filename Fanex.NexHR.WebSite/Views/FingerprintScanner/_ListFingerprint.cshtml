@using Fanex.NexHR.Models.Bio
@model IList<FingerprintAndCardSummary>

<table id="data" class="table bordered striped highlight table-custom centered">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Code</th>
            <th>@Labels.Nick</th>
            <th>@Labels.FullName</th>
            <th>@Labels.Team</th>
            <th>@Labels.Fingerprint</th>
            <th>@Labels.Card</th>
            <th>@Labels.Warning</th>
        </tr>
    </thead>

    @if (Model.Any())
    {
        <tbody>
            @{
                var index = 0;
            }
            @foreach (FingerprintAndCardSummary item in Model)
                {
                    index++;
                <tr>
                    <td>@index</td>
                    <td>@item.Employee.Code</td>
                    <td>@item.Employee.NickName</td>
                    <td class="align-left">@item.Employee.FullName</td>
                    <td class="tooltip" title="@item.Employee.Team.Name">@item.Employee.Team.Code</td>
                    <td>
                        @if (@item.Fingerprint > 0)
                        {
                            @Html.ActionLink(@item.Fingerprint.ToString(), "Fingerprint", new { @empId = @item.Employee.Id })
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (@item.Card > 0)
                        {
                            @Html.ActionLink(@item.Card.ToString(), "Card", new { @empId = @item.Employee.Id })
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (item.IsWarning)
                        {
                            <i class="alert mdi-alert-warning deep-orange-text"></i>
                        }
                    </td>
                </tr>
            }
        </tbody>

                }
                else
                {
                    @RazorHelper.DisplayNoInformation(colspan: 14)
                }
</table>