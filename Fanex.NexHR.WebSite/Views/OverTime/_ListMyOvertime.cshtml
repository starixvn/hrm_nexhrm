@model IList<EmployeeOvertime>

@{
    var index = 1;
}
@if (Model.Any())
{
    foreach (var item in Model)
    {
        <tr>
            <td>@(index++)</td>
            <td>@item.Employee.NickName</td>
            <td>@item.Employee.FullName</td>
            <td>@item.OnDate.ToDateMonthYearFormatedDate()</td>
            <td>@item.Hour</td>
            <td class="align-left">
                @if (item.Description.Length > 50)
                {
                    <span class="tooltip" title="@item.Description">
                        @RazorHelper.DisplayLimitedString(item.Description)
                    </span>
                }
                else
                {
                    <span>@item.Description</span>
                }
            </td>

            <td>@item.CreatedBy.NickName</td>
            @if (item.Status == (int)RequestStatuse.Approve)
            {
                <td>@Labels.Approved</td>
            }
            else if (item.Status == (int)RequestStatuse.Pending)
            {
                <td>@Labels.Pending</td>
            }
            else
            {
                <td> @Labels.Rejected</td>
            }
        </tr>
    }
}
else
{
    @RazorHelper.DisplayNoInformation(colspan: 8)
}