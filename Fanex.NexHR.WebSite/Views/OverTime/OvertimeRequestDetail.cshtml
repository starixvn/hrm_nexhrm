@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Overtime
@model MemberOvertimeViewModel

@{
    ViewBag.Title = Labels.NexDetail;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Overtime/overtimeDetail.js" asp-append-version="true"></script>
        <script src="~/js/Views/Overtime/overtimeRequest.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/overtimedetail.min.js" asp-append-version="true"></script>
    </environment>
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div id="OTRequest"> @{await Html.RenderPartialAsync("OvertimeRequest", Model); }</div>
                </div>
            </div>
        </div>
    </div>
</div>