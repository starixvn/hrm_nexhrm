@using Fanex.NexHR.ViewModels.Overtime
@model MemberOvertimeViewModel

@{
    ViewBag.Title = Labels.NexDetail;
}
@section css{
    @Styles.Render("~/Content/view-mobile")
}
@section js{
    @Scripts.Render("~/bundles/overtimeDetailjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div id="OTRequest"> @{Html.RenderPartial("OvertimeRequest", Model); }</div>
                </div>
            </div>
        </div>
    </div>
</div>