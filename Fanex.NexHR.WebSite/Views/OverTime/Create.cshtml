@model OverTimeViewModel
@{
    ViewBag.Title = "New OT Request";
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/overtimejs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase">@ViewBag.Title</span> <a id="legendInfo" href="javascript:;">
                    </a>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm("create", "overtime", FormMethod.Post, new { id = "form", @class = "form-create-update" }))
                        {
                            @Html.ValidationSummary()

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Date)
                                    </div>
                                    <div class="datepicker-button left select--s">
                                        @Html.DatePickerFor(model => model.Date)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Hour)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.TextBoxFor(model => model.Hour, new { type = "number", step = "0.5" })
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Description)
                                    </div>
                                    <div class="left txtArea">
                                        @Html.TextAreaFor(model => model.Description, new { @class = "materialize-textarea" })
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.Label(Labels.Employee)
                                    </div>
                                    <div class="left input--m">
                                        <input type="text" id="Employee" placeholder = "@Messages.SearchEmployeeWatermark" />
                                        <input type="hidden" id="EmployeeId" /> 
                                        @Html.HiddenFor(model => model.RecordData)                                       
                                    </div>
                                </div>
                            </div>
                            
                            
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.Label("Member List")
                                    </div>
                                </div>
                            </div>  

                            <div class="p-x--s">
                                <table class="table bordered striped highlight centered responsive-table table-custom"
                                    style="width: 800px;">
                                    <thead>
                                        <tr>
                                            <th>
                                                #
                                            </th>
                                            <th>@Labels.Employee
                                            </th>
                                            <th>
                                                Hour
                                            </th>
                                            <th>@Labels.Delete
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="memberList">
                                    </tbody>
                                </table>
                            </div>
                            
                            <div class="row m-t--m">
                                <div class="left label--l">
                                    <input type="submit"  class="btn-submit waves-effect waves-light m-r--s" value="@Labels.Save" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
