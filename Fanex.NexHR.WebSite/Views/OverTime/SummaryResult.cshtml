@model IEnumerable<OverTime>

@{
    Layout = null;
}
@if (Model.Count() > 0)
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.Date.ToDateMonthYearFormatedDate()</td>
            <td>@item.Hour</td>
            <td>@item.CreatedBy.NickName</td>
            <td>@item.Employee.NickName (@item.Employee.FullName)</td>
            <td>@item.Description</td>

            @if (Roles.GetRolesForUser().Length == 1) // Has only a Member role
            {
                <td>@((OTRequestStatus)item.Status)</td>
            }
            else
            {
                if (item.Status == (int)OTRequestStatus.Pending)
                {
                    <td>
                        <a requestid="@item.Id" href="javascript:;" class="@OTRequestStatus.Pending.ToString() c-pending">
                            @OTRequestStatus.Pending.ToString()<i class="mdi-navigation-arrow-drop-down"></i>
                        </a>
                    </td>
                }
                if (item.Status == (int)OTRequestStatus.Approved)
                {
                    <td>
                        <a requestid="@item.Id" href="javascript:;" class="@OTRequestStatus.Approved.ToString() c-approve">
                            @OTRequestStatus.Approved.ToString()<i class="mdi-navigation-arrow-drop-down"></i>
                        </a>
                    </td>
                }
                if (item.Status == (int)OTRequestStatus.Verified)
                {
                    <td>@OTRequestStatus.Verified</td>
                }
            }



        </tr>
    }
}
else
{
    <tr>
        <td colspan="6"></td>
    </tr>
    <tr>
        <td colspan="6">@Labels.NoData</td>
    </tr>
}