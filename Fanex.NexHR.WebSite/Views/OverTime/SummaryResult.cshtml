@model IEnumerable<OverTime>

@{
    Layout = null;
    ViewBag.Title = "SummaryResult";
}
@if (Model.Count() > 0)
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.FromDate.ToDateMonthYearFormatedDate()</td>
            <td>@item.Hour</td>
            <td>@item.CreatedBy.NickName</td>
            <td>@item.Employee.NickName (@item.Employee.FullName)</td>
            <td>@item.Description</td>
            <td>@((OTRequestStatus)item.Status)</td>
            <td>
                @if (item.Status != (int)OTRequestStatus.Verified)
                {
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id })

                    if (item.Status == (int)OTRequestStatus.New)
                    {
                        <a href="javascript:;" onclick="approveRequest(@item.Id);">
                            <input class="btn-ok waves-effect waves-light m-r--m" type="button" value="@Labels.Approve" />
                        </a>
                    }
                    if (item.Status == (int)OTRequestStatus.Approved)
                    {
                        <a href="javascript:;" onclick="verifyRequest(@item.Id);">
                            <input class="btn-ok waves-effect waves-light m-r--m" type="button" value="@Labels.Verify" />
                        </a>
                    }
                }
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="7"></td>
    </tr>
    <tr>
        <td colspan="7">@Labels.NoData</td>
    </tr>
}