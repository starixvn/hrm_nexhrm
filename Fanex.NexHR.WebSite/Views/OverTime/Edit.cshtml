@using Fanex.NexHR.ViewModels.Overtime
@model CreateOvertimeViewModel

@{
    ViewBag.Title = Labels.EditOTRequest;
}
@section css{
    @Styles.Render("~/Content/overtimemanagecss", "~/Content/view-mobile")
}
@section js{
    @Scripts.Render("~/bundles/manageovertimejs");
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase">@ViewBag.Title</span> <a id="legendInfo" href="javascript:;">
                    </a>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        @using (Html.BeginForm("edit", "overtime", FormMethod.Post, new { id = "form", @class = "form-create-update" }))
                        {
                            @Html.ValidationSummary()
                            if (ViewBag.Updated == true)
                            {
                                <input type="hidden" id="successed" value="true" />
                                <div class="row validation-summary-success">
                                    <div class="col success green-text">
                                        <i class="mdi mdi-checkbox-marked-circle-outline m-r--s"></i>@Messages.UpdatedSuccessfully
                                    </div>
                                </div>
                            }

                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Date, Labels.CreatedDate)
                                    </div>
                                    <div class="left">
                                        <h5 class="label">@Model.Date.ToDateMonthYearFormatedDate()</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-b--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.CreatedByName, Labels.RequestedBy)
                                    </div>
                                    <div class="left">
                                        <h5 class="label">@Html.DisplayFor(model => model.CreatedByName)</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input m-t--s">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.LabelFor(model => model.Description, Labels.Project)
                                    </div>
                                    <div class="left input--l">
                                        @Html.TextAreaFor(model => model.Description, new { @class = "materialize-textarea" })
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--l">
                                        @Html.Label(Labels.Employee)
                                    </div>
                                    <div class="left input--m">
                                        <input type="text" id="Employee" placeholder="@Messages.SearchEmployeeWatermark" />
                                        <input type="hidden" id="EmployeeId" />
                                        @Html.HiddenFor(model => model.TimeSheetData)
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--m col-list-emp">
                                    <div class="left label--l">
                                        @Html.Label("Employee List")
                                    </div>
                                    <div class="left cover-form-mb over-auto table-overtime-create">
                                        <table class="table bordered striped highlight centered table-custom list-emp">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>@Labels.Employee</th>
                                                    <th>@Labels.Date</th>
                                                    <th>@Labels.Duration</th>
                                                    <th>@Labels.NexHour</th>
                                                    <th>@Labels.Note</th>
                                                    <th>@Labels.Remove</th>
                                                </tr>
                                            </thead>
                                            <tbody id="timeSheets">
                                                @if (Model.TimeSheets.Any())
                                                {
                                                    var i = 1;
                                                    foreach (var item in Model.TimeSheets)
                                                    {
                                                        @Html.Partial("_EditEmployeeRecord", item, new ViewDataDictionary { { "index", i } });
                                                        i++;
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="7"></td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="7">No Employee</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="row form-input m-t--m">
                                <div class="left label--xl">&nbsp;</div>
                                <div class="left">
                                    @Html.HiddenFor(m => m.Id)
                                    <a href="@Url.Action("Index")" class="btn-back waves-effect waves-light">@Labels.Cancel</a>
                                    <input type="submit" class="btn-submit waves-effect waves-light right" value="@Labels.Submit" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
