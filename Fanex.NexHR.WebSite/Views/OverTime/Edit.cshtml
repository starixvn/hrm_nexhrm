@model OverTime

@{
    ViewBag.Title = "Edit";
}
@section css{
}
@section js{
}
@section Breadcrumb {
}

<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase">@ViewBag.Title</span> <a id="legendInfo" href="javascript:;">
                    </a>
                </div>
                <div class="card-body">

                    <form id="form" class="form">
                        <div id="divErrorCont" class="">
                            &nbsp;
                        </div>
                        <div class="row form-input">
                            <div class="left label--l">
                                @Html.LabelFor(model => model.FromDate)
                            </div>
                            <div class="datepicker-button left select--s">
                                @Html.DatePickerFor(model => model.FromDate)
                                <i class="mdi-action-event calendar-icon left"></i>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="left label--l">
                                @Html.LabelFor(m => m.Hour)
                            </div>
                            <div class="left input--m">
                                @Html.TextBoxFor(model => model.Hour, new { type = "number", step = "0.5" })
                            </div>
                        </div>

                        <div class="row form-input">
                            <div class="left label--l">
                                @Html.LabelFor(m => m.Status)
                            </div>
                            <div class="left input--m">
                                @((OTRequestStatus)Model.Status)
                            </div>
                        </div>

                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--l">
                                    @Html.LabelFor(model => model.Description)
                                </div>
                                <div class="left txtArea">
                                    @Html.TextAreaFor(model => model.Description, new { @class = "materialize-textarea" })
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--l">
                                    @Html.LabelFor(model => model.Employee)
                                </div>
                                <div class="left txtArea">
                                    <input type="text" id="Employee" placeholder="@Messages.SearchEmployeeWatermark" />
                                    <input type="hidden" id="EmployeeId" />
                                </div>
                            </div>
                        </div>

                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--l">
                                    @Html.LabelFor(model => model.CreatedBy)
                                </div>
                                <div class="left txtArea">
                                    @(Model.CreatedBy.NickName)
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--l">
                                    @Html.LabelFor(model => model.ApprovedBy)
                                </div>
                                <div class="left txtArea">
                                    @(Model.ApprovedBy != null ? Model.ApprovedBy.NickName : string.Empty)
                                </div>
                            </div>
                        </div>
                        <div class="row form-input">
                            <div class="col m-r--m">
                                <div class="left label--l">
                                    @Html.LabelFor(model => model.VerifiedBy)
                                </div>
                                <div class="left txtArea">
                                    @(Model.VerifiedBy != null ? Model.VerifiedBy.NickName : string.Empty)                                    
                                </div>
                            </div>
                        </div>
                        <div class="row form-input m-t--m center">
                            <input id="submitEdit" type="button" value="@Labels.Submit" class="btn-ok waves-effect waves-light m-r--m" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>