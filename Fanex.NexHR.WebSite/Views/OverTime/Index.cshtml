@{
    ViewBag.Title = Labels.Overtime;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render("~/bundles/overtimejs",
                "~/bundles/contextmenujs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <ul class="tabs">
                        <li class="tab col"><a class="@(ViewBag.Tab == "MyNex" ? "active" : string.Empty) card-title" href="#myOT">@Labels.MyOvertime</a></li>
                        @if (User.IsInRole("AssistantLeader")
                        || User.IsInRole("HR")
                        || User.IsInRole("PM"))
                        {
                            <li class="tab col"><a class="@(ViewBag.Tab == "NexRequest" ? "active" : string.Empty) card-title" href="#memberOT">@Labels.OTRequests</a></li>
                        }
                        <li class="tab col"><a class="@(ViewBag.Tab == "NexDetail" ? "active" : string.Empty) card-title" href="#OTRequest">@Labels.OvertimeDetail</a></li>
                    </ul>
                </div>
                <div class="card-body">
                    @*My Overtime*@
                    <div id="myOT">
                        <div class="loading-process" style="display: none;"></div>
                        <div class="form">
                            @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                            <form class="form-filter" id="form">
                                <div class="row form-input">
                                    <div class="col">
                                        <div class="left label--s">
                                            <label>@Labels.Year</label>
                                        </div>
                                        <div class="left select--xs">
                                            @Html.YearPicker("Year", 2010, DateTime.Now.Year)
                                        </div>
                                    </div>
                                    <div class="col">
                                        <input id="btn-submit" class="btn-submit waves-effect waves-light" type="button" value="@Labels.Submit" />
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="p-x--s">
                            <table id="dataMyOT" class="table bordered striped highlight table-custom centered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>@Labels.Nick</th>
                                        <th>@Labels.FullName</th>
                                        <th>@Labels.Date</th>
                                        <th>@Labels.Duration</th>
                                        <th>@Labels.Project</th>
                                        <th>@Labels.RequestedBy</th>
                                        <th>@Labels.Status</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    @if (User.IsInRole("AssistantLeader")
                        || User.IsInRole("HR")
                        || User.IsInRole("PM"))
                    {
                        @*Member Overtime*@
                        <div id="memberOT">
                        </div>
                    }
                    @*Overtime Request*@
                    <div id="OTRequest">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>