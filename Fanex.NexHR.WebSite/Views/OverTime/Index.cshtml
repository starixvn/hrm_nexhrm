@{
    ViewBag.Title = Labels.MyOvertime;
}
@section css{
    @Styles.Render("~/Content/contextmenucss")
}
@section js{
    @Scripts.Render("~/bundles/overtimejs")
    @Scripts.Render("~/bundles/myovertimejs")
    @Scripts.Render("~/bundles/overtimememberjs", "~/bundles/contextmenujs")
    @Scripts.Render("~/bundles/overtimerequestjs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <ul class="tabs">
                        <li class="tab col s4"><a class="active" href="#myOT">@Labels.MyOvertime</a></li>
                        <li class="tab col s4"><a href="#memberOT">@Labels.MemberOvertime</a></li>
                        <li class="tab col s4"><a href="#OTRequest">@Labels.OTRequest</a></li>
                    </ul>
                    @*My Overtime*@
                    <div id="myOT">
                        <div class="loading-process" style="display: none;"></div>
                    </div>
                    @*Member Overtime*@
                    <div id="memberOT">
                        <div class="loading-process" style="display: none;"></div>
                    </div>
                    @*Overtime Request*@
                    <div id="OTRequest">
                        <div class="loading-process" style="display: none;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>