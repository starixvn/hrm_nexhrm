@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Overtime
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;

@model IList<OvertimeSummary>
@{
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
}
@if (Model != null && Model.Any())
{
    int index = 1;
    IList<OvertimeSummary> overtimeSummaryByTeams = Model.GroupBy(t => t.Employee.Team.Id).Select(grp => grp.First()).ToList();
    foreach (OvertimeSummary overtimeSummaryByTeam in overtimeSummaryByTeams)
    {
        <tr class="row-divider">
            <td colspan="21">
                <b>@overtimeSummaryByTeam.Employee.Team.Name.ToUpper()</b>
            </td>
        </tr>

        IList<OvertimeSummary> overtimeSummaries = Model.Where(t => t.Employee.Team.Id == overtimeSummaryByTeam.Employee.Team.Id).ToList();
        foreach (OvertimeSummary overtimeSummary in overtimeSummaries)
        {
        <tr>

            <td>@(index++)</td>
            <td class="tooltip" title="@overtimeSummary.Employee.FullName">@overtimeSummary.Employee.NickName</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.BalanceLastYear)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Jan)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Feb)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Mar)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Apr)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.May)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Jun)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Jul)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Aug)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Sep)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Oct)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Nov)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.Dec)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.TotalHour)</td>
            @if (overtimeSummary.LeaveConversion != 0)
            {
                var url = "/request/employeeview?DateOption=0&TeamId=-2&IsFilterByEffectedDate=true&RequestType=6&LeaveTypeId=31&StatusId=2&FromDate="
                    + new DateTime(ViewBag.Year, 1, 1).ToDateMonthYearFormatedDate()
                    + "&toDate=" + new DateTime(ViewBag.Year, 12, 31).ToDateMonthYearFormatedDate()
                    + "&EmployeeId=" + overtimeSummary.Employee.Id
                    + "&Employee=" + overtimeSummary.Employee.DisplayName;

                <td>
                    <a href="@url">@(overtimeSummary.LeaveConversion.ToString("0.0"))</a>
                </td>
            }
            else
            {
                <td>-</td>
            }
            @if (overtimeSummary.OvertimeDeduct > 0)
            {
                var url = "/overtime/overtimeConversionDetail?employeeId=" + overtimeSummary.Employee.Id
                                + "&fromDate=" + new DateTime(ViewBag.Year, 1, 1).ToDateMonthYearFormatedDate()
                                + "&toDate=" + new DateTime(ViewBag.Year, 12, 31).ToDateMonthYearFormatedDate();
                <td>
                    <a href="@url">@(overtimeSummary.OvertimeDeduct.ToString("0.0"))</a>
                </td>
            }
            else
            {
                <td>-</td>
            }
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.LateInEarlyOut)</td>
            <td>@OvertimeSummary.DisplayValue(overtimeSummary.BalanceCurrentYear)</td>
            @if (@isHRRole)
            {
                <td>
                    @if (overtimeSummary.BalanceCurrentYear > 0)
                    {
                        <a href="#" class="createConversion" data-id="@overtimeSummary.Employee.Id">
                            <i class="mdi mdi-border-color mdi-dark"></i>
                        </a>
                    }
                </td>
            }
        </tr>
        }
    }
}
else
{
    <tr>
        <td colspan="21"></td>
    </tr>
    <tr>
        <td colspan="21" rowspan="2">
            @Messages.NoInformation
        </td>
    </tr>
}