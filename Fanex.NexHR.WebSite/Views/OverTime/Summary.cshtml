@model OverTimeSummaryFilterViewModel
@{
    ViewBag.Title = "Summary";
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/overtimejs");
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base my-request">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">

                        <form id="form">
                            @Html.Hidden("DateTime-Now", DateTime.Now.ToString("MMMM dd, yyyy"))
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.DateRange</label>
                                    </div>
                                    <div class="left select--s">
                                        @RazorHelper.DateRangeDropDownList("Date", (int)DateRangeFiltering.DateRange)
                                    </div>
                                </div>
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.FromDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.FromDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                                <div class="col m-l--xl m-r--l">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.ToDate)
                                    </div>
                                    <div class="left datepicker-button select--s">
                                        @Html.DatePickerFor(model => model.ToDate)
                                        <i class="mdi-action-event calendar-icon left"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.Status</label>
                                    </div>
                                    <div class="left select--s">                                        
                                        @RazorHelper.OTRequestStatusDropDownList("Status", Model.Status)
                                    </div>
                                </div>

                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.CreatedBy</label>
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("CreateAccount")
                                        @Html.HiddenFor(model => model.CreatedBy)
                                    </div>
                                </div>

                                <div class="col m-r--l">
                                    <div class="left label--m">
                                        <label>@Labels.Employee</label>
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("Employee")
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>


                            </div>

                            <div class="row form-input">
                                <div class="col">
                                    <input class="btn-submit waves-effect waves-light m-r--m" type="button" value="@Labels.Submit" id="btn-submit" />
                                    <a class="btn-request waves-effect waves-light" href="@Url.Action("Create")">@Labels.LeaveRequests</a>                                    
                                </div>
                            </div>
                        </form>
                    </div>


                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight table-custom centered">
                            <thead>
                                <tr>
                                    <th>@Labels.Date</th>
                                    <th>@Labels.Hours</th>
                                    <th>@Labels.CreatedBy</th>
                                    <th>@Labels.Employee</th>
                                    <th>@Labels.Description</th>
                                    <th>@Labels.Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
