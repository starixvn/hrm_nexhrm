@using Fanex.NexHR.ViewModels.Overtime
@model OvertimeSummaryViewModel
@{
    ViewBag.Title = Labels.OvertimeSummary;
}
@section css{
    @Styles.Render("~/Content/view-mobile")
}
@section js{
    @Scripts.Render("~/bundles/overtimesummaryjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.OvertimeSummary</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        @using (Html.BeginForm("OvertimeSummary", "Overtime", FormMethod.Post))
                        {
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.TeamId, Labels.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="formrow">
                                        <span class="bold-color">※ @Labels.NexLeave: </span>
                                        <span class="font-description">@Messages.NexLeaveDescription.</span>
                                    </div>
                                    <div class="formrow">
                                        <span class="bold-color">※ @Labels.DeductByMoney:</span>
                                        <span class="font-description">@Messages.DeductByMoneyDescription.</span>
                                    </div>
                                    <div class="formrow">
                                        <span class="bold-color">※ @Labels.DeductedByLateInEarlyOut:</span>
                                        <span class="font-description">@Messages.LateInEarlyOutDeductedDescription.</span>
                                    </div>
                                    <div class="formrow">
                                        <span class="bold-color">※ @Labels.Balance:</span>
                                        <span class="font-description">@Messages.NexBalanceDescription.</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-x--s over-auto">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th rowspan="2">#</th>
                                    <th rowspan="2">@Labels.Nick</th>
                                    <th rowspan="2" id="oldYear">@(Model.Year)</th>
                                    <th colspan="13" id="curYear">
                                        @Labels.OT @Model.Year
                                    </th>
                                    <th rowspan="2">@Labels.NexLeave</th>
                                    <th rowspan="2">@Labels.DeductByMoney</th>
                                    <th rowspan="2">@Labels.DeductedByLateInEarlyOut</th>
                                    <th rowspan="2">@Labels.Balance</th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th rowspan="2">@Labels.Deduct</th>
                                    }
                                </tr>
                                <tr>
                                    <th>@Labels.Jan</th>
                                    <th>@Labels.Feb</th>
                                    <th>@Labels.Mar</th>
                                    <th>@Labels.Apr</th>
                                    <th>@Labels.May</th>
                                    <th>@Labels.Jun</th>
                                    <th>@Labels.Jul</th>
                                    <th>@Labels.Aug</th>
                                    <th>@Labels.Sep</th>
                                    <th>@Labels.Oct</th>
                                    <th>@Labels.Nov</th>
                                    <th>@Labels.Dec</th>
                                    <th style="border-right: none;">@Labels.Total</th>
                                </tr>
                            </thead>
                            <tbody id="listOvertimeSummary"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        @*<div class="hide">
            <div id="insertformLeaveConversion" title="Add Leave Conversion">
                @Html.Action("CreateLeaveConversion", "AnnualLeave")
            </div>
        </div>*@
        <div class="hide">
            <div id="createConversion" title="Add Overtime Conversion" class="align-left">
                @Html.Action("CreateOvertimeConversion", "Overtime")
            </div>
        </div>
        
    </div>
</div>