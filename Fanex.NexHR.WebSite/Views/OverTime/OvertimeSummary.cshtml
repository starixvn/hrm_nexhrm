@using Fanex.NexHR.ViewModels.Overtime
@model OvertimeSummaryViewModel
@{
    ViewBag.Title = Labels.OvertimeSummary;
}
@section css{
}
@section js{
    @Scripts.Render("~/bundles/overtimesummaryjs")
}
@section Breadcrumb {
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.OvertimeSummary</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        @using (Html.BeginForm("OvertimeSummary", "Overtime", FormMethod.Post))
                        {
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.Year)
                                    </div>
                                    <div class="left select--xs">
                                        @Html.YearPickerFor(model => model.Year, 2010)
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        @Html.LabelFor(model => model.TeamId, @Labels.Team)
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.None)
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        @Html.LabelFor(model => model.Employee)
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBox("Employee", Model.Employee, new { placeholder = Messages.SearchEmployeeWatermark})
                                        @Html.HiddenFor(model => model.EmployeeId)
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th rowspan="2">#</th>
                                    <th rowspan="2">@Labels.Nick</th>
                                    <th rowspan="2">@(Model.Year-1)</th>
                                    <th colspan="13">
                                        NEX @Model.Year
                                    </th>
                                    <th rowspan="2">NEX Leave</th>
                                    <th rowspan="2">@Labels.LateInEarlyOut</th>
                                    <th rowspan="2">@Labels.Balance</th>
                                </tr>
                                <tr>
                                    <th>@Labels.Jan</th>
                                    <th>@Labels.Feb</th>
                                    <th>@Labels.Mar</th>
                                    <th>@Labels.Apr</th>
                                    <th>@Labels.May</th>
                                    <th>@Labels.Jun</th>
                                    <th>@Labels.Jul</th>
                                    <th>@Labels.Aug</th>
                                    <th>@Labels.Sep</th>
                                    <th>@Labels.Oct</th>
                                    <th>@Labels.Nov</th>
                                    <th>@Labels.Dec</th>
                                    <th>@Labels.Total</th>
                                </tr>
                            </thead>
                            <tbody id="listOvertimeSummary"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="hide">
            <div id="insertform" title="Add Leave Conversion">
                @Html.Action("CreateLeaveConversion", "AnnualLeave")
            </div>
        </div>
    </div>
</div>