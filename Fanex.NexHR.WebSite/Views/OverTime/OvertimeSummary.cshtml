@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Overtime
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;
@model OvertimeSummaryViewModel

@{
    ViewBag.Title = Labels.OvertimeSummary;
    var isHRRole = sessionService.CurrentEmployee.HasHRRole;
    var departments = new SelectList(Model.Departments, "Id", "Name");
    var overtimeConversionCreateViewModel = new OvertimeConversionCreateViewModel();
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Views/Overtime/overtimeSummary.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/_employee.search.in.company.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/overtimesummary.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@Labels.OvertimeSummary</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        @using (Html.BeginForm("OvertimeSummary", "Overtime", FormMethod.Post))
                        {
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label asp-for="@Model.Year">@Labels.Year</label>
                                    </div>
                                    <div class="left select--xs year">
                                        <select id="Year" name="Year"
                                            asp-items="@Extensions.YearPicker(2010, DateTimeOffset.Now.DateTime.ToClientTimeZone().Year)"></select>
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--m">
                                        <label asp-for="@Model.DepartmentId">@Labels.Department</label>
                                    </div>
                                    <div class="left select--m department">
                                        <select asp-for="@Model.DepartmentId" asp-items="@departments">
                                            <option value="">@Labels.AllDepartments</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label asp-for="@Model.TeamId">@Labels.Team</label>
                                    </div>
                                    <div class="left select--m team">
                                        <select asp-for="TeamId">
                                            <option value="">@Labels.AllTeams</option>
                                            @foreach (var team in Model.Teams)
                                            {
                                                <option value="@team.Id" data-department-id="@team.DepartmentId">@team.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="left label--m">
                                        <label asp-for="@Model.Employee">@Labels.Employee</label>
                                    </div>
                                    <div class="left input--m">
                                        <input asp-for="@Model.Employee" placeholder="@Messages.SearchEmployeeWatermark"/>
                                        <input type="hidden" asp-for="@Model.EmployeeId"/>
                                    </div>
                                </div>
                                <div class="col">
                                    <input type="button" value="@Labels.Submit" id="submit" class="btn-submit waves-effect waves-light" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="formrow">
                                        <span class="bold-color">※ @Labels.NexLeave: </span>
                                        <span class="font-description">@Messages.NexLeaveDescription.</span>
                                    </div>
                                    <div class="formrow">
                                        <span class="bold-color">※ @Labels.Paid:</span>
                                        <span class="font-description">@Messages.PaidDescription.</span>
                                    </div>
                                    <div class="formrow">
                                        <span class="bold-color">※ @Labels.DeductedByLateInEarlyOut:</span>
                                        <span class="font-description">@Messages.LateInEarlyOutDeductedDescription.</span>
                                    </div>
                                    <div class="formrow">
                                        <span class="bold-color">※ @Labels.Balance:</span>
                                        <span class="font-description">@Messages.NexBalanceDescription.</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="p-x--s over-auto">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th rowspan="2">#</th>
                                    <th rowspan="2">@Labels.EnglishName</th>
                                    <th rowspan="2">@Labels.Team</th>
                                    <th rowspan="2" id="oldYear">@(Model.Year)</th>
                                    <th colspan="13" id="curYear">
                                        @Labels.OT @Model.Year
                                    </th>
                                    <th rowspan="2">@Labels.NexLeave</th>
                                    <th rowspan="2">@Labels.Paid</th>
                                    <th rowspan="2">@Labels.DeductedByLateInEarlyOut</th>
                                    <th rowspan="2">@Labels.Balance</th>
                                    @if (@isHRRole)
                                    {
                                        <th rowspan="2">@Labels.Edit</th>
                                    }
                                </tr>
                                <tr>
                                    <th>@Labels.Jan</th>
                                    <th>@Labels.Feb</th>
                                    <th>@Labels.Mar</th>
                                    <th>@Labels.Apr</th>
                                    <th>@Labels.May</th>
                                    <th>@Labels.Jun</th>
                                    <th>@Labels.Jul</th>
                                    <th>@Labels.Aug</th>
                                    <th>@Labels.Sep</th>
                                    <th>@Labels.Oct</th>
                                    <th>@Labels.Nov</th>
                                    <th>@Labels.Dec</th>
                                    <th style="border-right: none;">@Labels.Total</th>
                                </tr>
                            </thead>
                            <tbody id="listOvertimeSummary"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="hide">
            <div id="createConversion" title="Add Overtime Conversion" class="align-left">
                <partial name="_CreateOvertimeConversion" model="overtimeConversionCreateViewModel" />
            </div>
        </div>
        
    </div>
</div>