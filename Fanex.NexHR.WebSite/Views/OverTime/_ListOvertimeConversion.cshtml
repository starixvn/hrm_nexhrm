@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.Models.Overtime
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Services.Interfaces
@inject ISessionService sessionService;

@model IList<OvertimeConversion>
@{
    var isHRRole = sessionService.CurrentEmployee.RoleList.Any(r => r == (short)Role.HR || r == (short)Role.SA);
}

@if (Model != null && Model.Any())
{
    int index = 1;
    foreach (var item in Model)
    {
        <tr>
            <td>@(index++)</td>
            <td class="align-left">@item.Employee.FullName</td>
            <td>@item.Employee.NickName</td>
            <td class="tooltip" title="@item.Employee.Team.Name">
                @item.Employee.Team.Code
            </td>
            <td class="deductdate">@item.DeductDate.ToDateMonthYearFormatedDate()</td>
            <td>@item.Deduct</td>
            <td class="description">@item.Description</td>
            @if (@isHRRole)
            {
                <td>
                    <a href="javascript:;" class="editConversion"
                       data-id="@item.Id"
                       data-deduct="@item.Deduct"
                       data-deductdate="@item.DeductDate.ToDateMonthYearFormatedDate()"
                       data-description="@item.Description">
                        <i class="mdi mdi-border-color mdi-dark"></i>
                    </a>
                </td>
                <td>
                    <a href="javascript:;" class="deleteConversion" data-id="@item.Id">
                        <i class="mdi mdi-delete mdi-dark"></i>
                    </a>
                </td>
            }

        </tr>
    }
}
else
{
    <tr>
        <td colspan="9"></td>
    </tr>
    <tr>
        <td colspan="9" rowspan="2">
            @Messages.NoInformation
        </td>
    </tr>
}