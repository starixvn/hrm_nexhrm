@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model IList<EmployeeOvertime>

@{
    var index = 1;
}
@if (Model.Any())
{
    foreach (var item in Model)
    {
        <tr>
            <td>@(index++)</td>
            <td>@item.EmployeeNickName</td>
            <td class="align-left">@item.EmployeeFullName</td>
            <td>@item.OnDate.ToDateMonthYearFormatedDate()</td>
            <td>@item.Hour</td>
            <td class="align-left">
                @if (item.Description.Length > 50)
                {
                    <span class="tooltip" title="@item.Description">
                        @{
                            var value = item.Description;
                            if (value.Length > 50)
                            {
                                value = value.Substring(0, 50) + "...";
                            }
                            <span class="truncate-remark">@value</span>
                        }  
                    </span>
                }
                else
                {
                    <span>@item.Description</span>
                }
            </td>
            @if (!string.IsNullOrWhiteSpace(item.Note))
            {
                <td class="tooltip" title="@item.Note">
                    <span class="mdi mdi-message-text" alt="remark"></span>
                </td>
            }
            else
            {
                <td>-</td>
            }
            <td>@item.CreatedBy</td>
            @if (item.Status == (int)RequestStatuse.Approve)
            {
                <td>@Labels.Approved</td>
            }
            else if (item.Status == (int)RequestStatuse.Pending)
            {
                <td>@Labels.Pending</td>
            }
            else if (item.Status == (int)RequestStatuse.Verified)
            {
                <td>@Labels.Verified</td>
            }
            else if (item.Status == (int)RequestStatuse.Void)
            {
                <td>@Labels.Void</td>
            }
            else
            {
                <td> @Labels.Rejected</td>
            }
        </tr>
    }
}
else
{
    <tr>
        <td colspan="9"></td>
    </tr>
    <tr>
        <td colspan="9">@Labels.NoData</td>
    </tr>
}