@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Overtime
@using Fanex.NexHR.Resources
@model IEnumerable<Overtime>
@{
    var index = 1;
}
@if (Model.Any())
{
    foreach (var item in Model)
    {
        <tr>
            <td>@(index++)</td>
            <td class="align-left">@item.Description</td>
            <td class="align-left">@item.CreatedBy.DisplayName</td>
            <td>@item.CreatedDate.ToDateMonthYearFormatedDate()</td>
            <td>
                <span class="contextmenu">
                    <a href='javascript:;' requestid="@item.Id" projectName="@item.Description">@item.TotalMember</a>
                    <ul class='list-unstyled drop-menu'>
                        @foreach (OvertimeRecord detail in item.OvertimeRecords)
                        {
                            <li>
                                <span class='mdi-navigation-chevron-right'></span>
                                <span>(@detail.Date.ToDateMonthYearFormatedDate()) @detail.Employee.NickName: @detail.Hour</span>
                            </li>
                        }
                    </ul>
                </span>
            </td>
            @if (item.Status == (int)RequestStatuse.Approve)
            {
                <td>
                    <a requestid="@item.Id" href="javascript:;" class="@RequestStatuse.Approve.ToString() c-approve" projectName="@item.Description">
                        @Labels.Approved<i class="mdi-navigation-arrow-drop-down"></i>
                    </a>
                </td>
            }
            @if (item.Status == (int)RequestStatuse.Verified)
            {
                <td>
                    <a requestid="@item.Id" href="javascript:;" class="@RequestStatuse.Verified.ToString() c-verify" projectName="@item.Description">
                        @Labels.Verified<i class="mdi-navigation-arrow-drop-down"></i>
                    </a>
                </td>
            }
            @if (item.Status == (int)RequestStatuse.Void)
            {
                <td>
                    <a requestid="@item.Id" href="javascript:;" class="@RequestStatuse.Void.ToString() c-void" projectName="@item.Description">
                        @Labels.Void<i class="mdi-navigation-arrow-drop-down"></i>
                    </a>
                </td>
            }
            <td>
                <a href="javascript:;" class="btnReset" title="Reset request to pending" requestid="@item.Id">
                    <i class="mdi mdi-refresh mdi-dark mdi-18px"></i>
                </a>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="7"></td>
    </tr>
    <tr>
        <td colspan="7">@Labels.NoData</td>
    </tr>
}