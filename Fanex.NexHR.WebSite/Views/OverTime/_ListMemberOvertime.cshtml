@using Fanex.NexHR.Core
@using Fanex.NexHR.Core.Enums
@using Fanex.NexHR.Models.Overtime
@using Fanex.NexHR.Resources
@model IEnumerable<Overtime>
@{
    var index = 1;
    var isManager = ViewBag.IsManager;
}
@if (Model.Any())
{
    foreach (Overtime item in Model)
    {
        <tr>
            <td>@(index++)</td>
            <td class="align-left">@item.CreatedBy.DisplayName</td>
            <td>@item.CreatedDate.ToDateMonthYearFormatedDate()</td>
            <td>
                <span class='contextmenu'>
                    <a href='javascript:;'>@item.Totalhours</a>
                    <ul class='list-unstyled drop-menu'>
                        @foreach (OvertimeRecord detail in item.OvertimeRecords)
                        {
                            <li>
                                <span class='mdi-navigation-chevron-right'></span>
                                <span>(@detail.Date.ToDateMonthYearFormatedDate()) @detail.Employee.NickName: @detail.Hour</span>
                            </li>
                        }

                    </ul>
                </span>
            </td>
            <td>
                <a href="javascript:;"
                   onclick="loadDetailTotalMembers(false, @item.CreatedBy.Id, @item.Status ,@item.Id)">
                    @item.TotalMember.ToString()
                </a>
            </td>
            <td class="align-left">
                @if (item.Description.Length > 50)
                {
                    <span class="tooltip" title="@item.Description">
                        @{
                            var value = item.Description;
                            if (value.Length > 50)
                            {
                                value = value.Substring(0, 50) + "...";
                            }

                            <span class="truncate-remark">@value</span>
                        }
                    </span>
                }
                else
                {
                    <span>@item.Description</span>
                }
            </td>
            @if (isManager)
            {
                if (item.Status == (int)RequestStatuse.Pending)
                {
                    <td>
                        <a requestid="@item.Id" createdBy="@item.CreatedBy.Id" href="javascript:;" class="@RequestStatuse.Pending.ToString() c-pending">
                            @Labels.Pending<i class="mdi-navigation-arrow-drop-down"></i>
                        </a>
                    </td>
                }
                if (item.Status == (int)RequestStatuse.Approve)
                {
                    <td>
                        <a requestid="@item.Id" href="javascript:;" class="@RequestStatuse.Approve.ToString() c-approve">
                            @Labels.Approved<i class="mdi-navigation-arrow-drop-down"></i>
                        </a>
                    </td>
                }
                if (item.Status == (int)RequestStatuse.Reject)
                {
                    <td>
                        <a requestid="@item.Id" href="javascript:;" class="@RequestStatuse.Reject.ToString() c-reject">
                            @Labels.Rejected<i class="mdi-navigation-arrow-drop-down"></i>
                        </a>
                    </td>
                }
                if (item.Status == (int)RequestStatuse.Verified)
                {
                    <td class="c-verify">
                        @Labels.Verified
                    </td>
                }
                if (item.Status == (int)RequestStatuse.Void)
                {
                    <td class="c-void">
                        @Labels.Void
                    </td>
                }
            }
            else
            {
                switch (item.Status)
                {
                    case (int)RequestStatuse.Pending:
                        <td>@Labels.Pending</td>
                        break;
                    case (int)RequestStatuse.Approve:
                        <td>@Labels.Approved</td>
                        break;
                    case (int)RequestStatuse.Reject:
                        <td>@Labels.Reject</td>
                        break;
                    case (int)RequestStatuse.Verified:
                        <td>@Labels.Verified</td>
                        break;
                    case (int)RequestStatuse.Void:
                        <td>@Labels.Void</td>
                        break;
                    default:
                        <td>-</td>
                        break;
                }
            }

            @if (item.Own && item.Status == (int)RequestStatuse.Pending)
            {
                <td>
                    <a href="@Url.Action("Edit", "Overtime", new { item.Id})">
                        <i class="mdi mdi-border-color mdi-dark"></i>
                    </a>
                </td>
                <td>
                    <a href="javascript:;" class="delete-overtime" requestid="@item.Id">
                        <i class="mdi mdi-delete mdi-dark"></i>
                    </a>
                </td>
            }
            else
            {
                <td>
                    <span>
                        <i class="mdi mdi-border-color mdi-dark mdi-inactive"></i>
                    </span>
                </td>
                <td>
                    <span>
                        <i class="mdi mdi-delete mdi-dark mdi-inactive"></i>
                    </span>
                </td>
            }

        </tr>
    }
}
else
{
    <tr>
        <td colspan="9"></td>
    </tr>
    <tr>
        <td colspan="9">@Labels.NoData</td>
    </tr>
}