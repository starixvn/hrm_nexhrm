@using Fanex.NexHR.Core
@using Fanex.NexHR.Resources
@using Fanex.NexHR.ViewModels.Toeic
@model ToeicManagementViewModel

@{
    ViewBag.Title = Labels.TOEICScoreMgmt;
}

@section Styles {
    <link rel="stylesheet" href="~/minify/css/view-mobile.min.css" asp-append-version="true">
}

@section Scripts {
    <environment include="Development">
        <script src="~/js/Libs/moment.js" asp-append-version="true"></script>
        <script src="~/js/Views/Employee/employee.toeic.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/toeic.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form form-stl-table">
                        <form action="#" class="form-filter">
                            <div class="row form-input">
                                <div class="col m-r--l">
                                    <div class="left label--l">
                                        <label>@Labels.EnglishName</label>
                                    </div>
                                    <div class="left input--m">
                                        <input type="text" id="Query" name="Query" value="@Model.Query">
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label>@Labels.Team</label>
                                    </div>
                                    <div class="left select--m">  
                                    <select id="TeamId" name="TeamId" asp-items="@(new SelectList(Model.Teams, "Id", "Name"))">
                                            <option>@Labels.AllTeams</option>
                                    </select>
                                    </div>
                                </div>
                                <div class="col">
                                    <input id="submit" type="button" value="@Labels.Submit" class="btn-submit waves-effect waves-light m-r--m" />
                                    @if (ViewBag.HasHRRole)
                                    {
                                        <a class="btn-request waves-effect waves-light" id="btnNewTOEIC" href="javascript:;">Update TOEIC Score</a>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="p-x--s over-auto table-resize table-large table-row-thead">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th rowspan="2">
                                        @Labels.SymbolCount
                                    </th>
                                    <th class="col-sorter" rowspan="2">
                                        @Labels.EnglishName
                                        <div class="sorter" data-property="NickName"></div>
                                    </th>
                                    <th class="col-sorter" rowspan="2">
                                        @Labels.Team
                                        <div class="sorter" data-property="CodeOfTeam"></div>
                                    </th>
                                    <th class="col-sorter" rowspan="2">
                                        @Labels.JobTitle
                                        <div class="sorter" data-property="JobTitles"></div>
                                    </th>
                                    <th colspan="4">@Labels.Listening/@Labels.Reading</th>
                                    <th class="col-sorter" rowspan="2">
                                        @Labels.Deadline
                                        <div class="sorter" data-property="InputDate"></div>
                                    </th>
                                    @if (ViewBag.HasHRRole)
                                    {
                                        <th class="col-sorter" rowspan="2">
                                            @Labels.RequiredScore
                                            <div class="sorter" data-property="RequiredScore"></div>
                                        </th>
                                        <th rowspan="2">
                                            @Labels.Edit
                                        </th>
                                    }
                                </tr>
                                <tr>
                                    <th class="col-sorter">
                                        @Labels.L
                                        <div class="sorter" data-property="Listening"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.R
                                        <div class="sorter" data-property="Reading"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.LRTotal
                                        <div class="sorter" data-property="LRTotal"></div>
                                    </th>
                                    <th class="col-sorter" style="border-right: none;">
                                        @Labels.ExamDate
                                        <div class="sorter" data-property="LRExamDate"></div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="toeic-detail"></tbody>
                        </table>

                    </div>
                    <div id="dialog-toeic" title="Update TOEIC Score">&nbsp;</div>
                </div>
            </div>
        </div>
    </div>
</div>