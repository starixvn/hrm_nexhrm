@using Fanex.NexHR.ViewModels.Toeic
@model ToeicManagementViewModel

@{
    ViewBag.Title = Labels.TOEICScoreMgmt;
}

@section js {
    @Scripts.Render("~/bundles/toeicjs")
}
<div class="row content">
    <div class="col s12 card-container-base">
        <div class="card">
            <div class="card-content">
                <div class="card-title-block">
                    <span class="card-title txt-uppercase left">@ViewBag.Title</span>
                </div>
                <div class="card-body">
                    <div class="form">
                        <form action="#" class="form-filter">
                            <div class="row form-input">
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label>@Labels.Nick</label>
                                    </div>
                                    <div class="left input--m">
                                        @Html.TextBoxFor(model => model.Query)
                                    </div>
                                </div>
                                <div class="col m-r--m">
                                    <div class="left label--s">
                                        <label>@Labels.Team</label>
                                    </div>
                                    <div class="left select--m">
                                        @Html.DropDownListFor(model => model.TeamId, new SelectList(Model.Teams, "Id", "Name"), Labels.AllTeams)
                                    </div>
                                </div>
                                <div class="col">
                                    <input id="submit" type="button" value="@Labels.Submit" class="btn-submit waves-effect waves-light m-r--m" />
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <a class="btn-request waves-effect waves-light" id="btnNewTOEIC" href="javascript:;">Update TOEIC Score</a>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="p-x--s">
                        <table id="data" class="table bordered striped highlight centered table-custom">
                            <thead>
                                <tr>
                                    <th rowspan="2">
                                        @Labels.SymbolCount
                                    </th>
                                    <th class="col-sorter" rowspan="2">
                                        @Labels.Nick
                                        <div class="sorter" data-property="NickName"></div>
                                    </th>
                                    <th class="col-sorter" rowspan="2">
                                        @Labels.Team
                                        <div class="sorter" data-property="CodeOfTeam"></div>
                                    </th>
                                    <th class="col-sorter" rowspan="2">
                                        @Labels.JobTitle
                                        <div class="sorter" data-property="JobTitle"></div>
                                    </th>
                                    <th colspan="4">@Labels.Listening/@Labels.Reading</th>
                                    <th class="col-sorter" rowspan="2">
                                        @Labels.Deadline
                                        <div class="sorter" data-property="InputDate"></div>
                                    </th>
                                    @if (Roles.IsUserInRole("HR"))
                                    {
                                        <th class="col-sorter" rowspan="2">
                                            @Labels.RequiredScore
                                            <div class="sorter" data-property="RequiredScore"></div>
                                        </th>
                                        <th rowspan="2">
                                            @Labels.Edit
                                        </th>
                                    }
                                </tr>
                                <tr>
                                    <th class="col-sorter">
                                        @Labels.L
                                        <div class="sorter" data-property="Listening"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.R
                                        <div class="sorter" data-property="Reading"></div>
                                    </th>
                                    <th class="col-sorter">
                                        @Labels.LRTotal
                                        <div class="sorter" data-property="LRTotal"></div>
                                    </th>
                                    <th class="col-sorter" style="border-right: none;">
                                        @Labels.ExamDate
                                        <div class="sorter" data-property="LRExamDate"></div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="toeic-detail"></tbody>
                        </table>

                    </div>
                    <div id="dialog-toeic" title="Update TOEIC Score">&nbsp;</div>
                </div>
            </div>
        </div>
    </div>
</div>