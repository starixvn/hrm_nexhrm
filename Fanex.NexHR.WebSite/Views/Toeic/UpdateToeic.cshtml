@using Fanex.NexHR.Core
@using Fanex.NexHR.Models
@using Fanex.NexHR.Resources
@model Toeic
@{ DateTime currentDate = DateTimeOffset.Now.DateTime.ToClientTimeZone(); }
<form id="frmUpdateTOEIC" class="form form-update-toeic">
    <div id="divErrorCont" class="">
        &nbsp;
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Employee</label>
        </div>
        <div class="left input--m">
            <input asp-for="Employee" placeholder = "@Messages.SearchEmployeeWatermark"/>
            <input asp-for="EmpId" type="hidden"/>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Deadline</label>
        </div>
        <div class="datepicker-button left select--s">           
            <date-picker name="InputDate" value="@(Model != null ? Model.InputDate : null)">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.LRExamDate</label>
        </div>
        <div class="datepicker-button left select--s">
            <date-picker name="LRExamDate"
                         min-date="currentDate.AddYears(-100)"
                         max-date="currentDate"
                         value="@(Model != null ? Model.LRExamDate : null)">
            </date-picker>
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.NewOldListening</label>
        </div>
        <div class="left score-toeic">
            <div class="left select--xs m-r--s">
                <input asp-for="Listening" type = "number" step = "5" onchange = "calculateToeicScore()"/>
                <span asp-validation-for="Listening"></span>
            </div>
            <div class="col left colon">
                /
            </div>
            <div class="left select--xs">
                <input asp-for="OldListening" type = "number" step = "5" onchange = "calculateOldToeicScore()"/>
                <span asp-validation-for="OldListening"></span>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.NewOldReading</label>
        </div>
        <div class="left score-toeic">
            <div class="left select--xs m-r--s">
                <input asp-for="Reading" type = "number" step = "5" onchange = "calculateToeicScore()"/>
                <span asp-validation-for="Reading"></span>
            </div>
            <div class="col left colon">
                /
            </div>
            <div class="left select--xs">
                <input asp-for="OldReading" type = "number" step = "5" onchange = "calculateOldToeicScore()"/>
                <span asp-validation-for="OldReading"></span>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.NewOldTotal</label>
        </div>
        <div class="left score-toeic">
            <div class="left select--xs m-r--s">
                <input asp-for="Total" readonly = "readonly" class = "readonly-input"/>
            </div>
            <div class="col left colon">
                /
            </div>
            <div class="left select--xs">
                <input asp-for="OldTotal" readonly = "readonly" class = "readonly-input"/>
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.RequiredScore</label>
        </div>
        <div class="left input--s">
            <input asp-for="MinimumScore" type = "number" step = "5"/>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.SendMail</label>
        </div>
        <div class="left input--s">
            <input asp-for="SendMail" type="checkbox" class="filled-in"/>
            <label for="SendMail"></label>
        </div>
    </div>
</form>
