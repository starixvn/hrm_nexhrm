@using Fanex.NexHR.ViewModels.Toeic
@model Toeic
@{ DateTime currentDate = DateTime.Today; }
<form id="frmUpdateTOEIC" class="form form-update-toeic">
    <div id="divErrorCont" class="">
        &nbsp;
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.Employee</label>
        </div>
        <div class="left input--m">
            @Html.TextBoxFor(model => model.Employee, new { placeholder = Messages.SearchEmployeeWatermark })
            @Html.HiddenFor(model => model.EmpId)
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            @Html.LabelFor(model => model.InputDate, Labels.Deadline)
        </div>
        <div class="datepicker-button left select--s">
            @Html.DatePickerFor(model => model.InputDate)
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            @Html.LabelFor(model => model.LRExamDate)
        </div>
        <div class="datepicker-button left select--s">
            @Html.DatePickerFor(model => model.LRExamDate, currentDate.AddYears(-100), currentDate)
            <i class="mdi-action-event calendar-icon left"></i>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.NewOldListening</label>
        </div>
        <div class="left score-toeic">
            <div class="left select--xs m-r--s">
                @Html.TextBoxFor(model => model.Listening, new { type = "number", step = "5", onchange = "calculateToeicScore()" })
                @Html.ValidationMessageFor(model => model.Listening)
            </div>
            <div class="col left colon">
                /
            </div>
            <div class="left select--xs">
                @Html.TextBoxFor(model => model.OldListening, new { type = "number", step = "5", onchange = "calculateOldToeicScore()" })
                @Html.ValidationMessageFor(model => model.OldListening)
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.NewOldReading</label>
        </div>
        <div class="left score-toeic">
            <div class="left select--xs m-r--s">
                @Html.TextBoxFor(m => m.Reading, new { type = "number", step = "5", onchange = "calculateToeicScore()" })
                @Html.ValidationMessageFor(model => model.Reading)
            </div>
            <div class="col left colon">
                /
            </div>
            <div class="left select--xs">
                @Html.TextBoxFor(m => m.OldReading, new { type = "number", step = "5", onchange = "calculateOldToeicScore()" })
                @Html.ValidationMessageFor(model => model.OldReading)
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.NewOldTotal</label>
        </div>
        <div class="left score-toeic">
            <div class="left select--xs m-r--s">
                @Html.TextBoxFor(model => model.Total, new { @readonly = "readonly", @class = "readonly-input" })
            </div>
            <div class="col left colon">
                /
            </div>
            <div class="left select--xs">
                @Html.TextBoxFor(model => model.OldTotal, new { @readonly = "readonly", @class = "readonly-input" })
            </div>
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            <label>@Labels.RequiredScore</label>
        </div>
        <div class="left input--s">
            @Html.TextBoxFor(m => m.MinimumScore, new { type = "number", step = "5" })
        </div>
    </div>
    <div class="row form-input">
        <div class="left label--l">
            @Html.LabelFor(m => m.SendMail, Labels.SendMail)
        </div>
        <div class="left input--s">
            @Html.MaterializeCheckBoxFor(m => m.SendMail, new { @class = "filled-in" })
        </div>
    </div>
</form>
