@model IList<Employee>
<table id="data" class="table bordered striped highlight centered table-custom">
    <thead>
        <tr>
            <th rowspan="2">
                @Labels.SymbolCount
            </th>
            <th class="col-sorter" rowspan="2">
                @Labels.Nick
                <div class="sorter" data-property="NickName"></div>
            </th>
            <th class="col-sorter" rowspan="2">
                @Labels.Team
                <div class="sorter" data-property="Team"></div>
            </th>
            <th class="col-sorter" rowspan="2">
                @Labels.JobTitle
                <div class="sorter" data-property="JobTitle"></div>
            </th>
            <th colspan="4">@Labels.Listening/@Labels.Reading</th>
            <th class="col-sorter" rowspan="2">
                @Labels.Deadline
                <div class="sorter" data-property="Deadline"></div>
            </th>
            @if (Roles.IsUserInRole("HR"))
            {
            <th class="col-sorter" rowspan="2">
                @Labels.RequiredScore
                <div class="sorter" data-property="RequiredScore"></div>
            </th>
                <th rowspan="2">@Labels.Edit
            </th>
            }
        </tr>
        <tr>
            <th class="col-sorter">
                @Labels.L
                <div class="sorter" data-property="Listening"></div>
            </th>
            <th class="col-sorter">
                @Labels.R
                <div class="sorter" data-property="Reading"></div>
            </th>
            <th class="col-sorter">
                @Labels.LRTotal
                <div class="sorter" data-property="LRTotal"></div>
            </th>
            <th class="col-sorter" style="border-right: none;">
                @Labels.ExamDate
                <div class="sorter" data-property="ExamDate"></div>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            var index = 0;
            foreach(Employee employee in Model) {
                index++;
                <tr id="row_@employee.Id">
                    <td>@index</td>
                    <td class="tooltip" title="@employee.FullName">
                        @employee.NickName
                    </td>
                    <td class="tooltip" title="@employee.Team.Name">
                        @employee.Team.Code
                    </td>
                    <td class="align-left">
                        @if (employee.JobTitle != null)
                        {
                            @employee.JobTitle.Name
                        }</td>
                    <td>
                        @if(employee.ToeicScore.Listening.HasValue && employee.ToeicScore.Listening.Equals(0))
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>@employee.ToeicScore.Listening</span>
                        }
                    </td>
                    <td>
                        @if (employee.ToeicScore.Reading.HasValue && employee.ToeicScore.Reading.Equals(0))
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>@employee.ToeicScore.Reading</span>
                        }
                    </td>
                    <td>
                        @if (employee.ToeicScore.LRTotal.HasValue && employee.ToeicScore.LRTotal.Equals(0))
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>@employee.ToeicScore.LRTotal</span>
                        }
                    </td>
                    <td>
                        @if (employee.ToeicScore.LRExamDate.HasValue)
                        {
                            @employee.ToeicScore.LRExamDate.Value.ToDateMonthYearFormatedDate()
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    @if (employee.ToeicScore.InputDate.HasValue)
                    {
                        if (employee.ToeicScore.InputDate < DateTime.Now)
                        {
                            <td class="expired-date">@employee.ToeicScore.InputDate.ToDateMonthYearFormatedDate()</td>
                        }
                        else
                        {
                            <td>@employee.ToeicScore.InputDate.ToDateMonthYearFormatedDate()</td>
                        }
                    }
                    else
                    {
                        <td>-</td>
                    }
                    @if (Roles.IsUserInRole("HR"))
                    {
                        <td>
                            @if (employee.ToeicScore.MinimumScore.HasValue && employee.ToeicScore.MinimumScore.Value != 0)
                            {
                                <span>@employee.ToeicScore.MinimumScore</span>
                            }
                            else
                            { 
                                <span>-</span>
                            }
                        </td>
                        <td>
                            @if (employee.IsDeleted)
                            {
                                <span>-</span>
                            }
                            else
                            {
                                <a href="javascript:;" onclick="editTOEIC(@employee.Id,'@employee.NickName');">
                                    <i class="mdi mdi-border-color mdi-dark"></i>
                                </a>
                            }
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @RazorHelper.DisplayNoInformation(13)
        }
    </tbody>
</table>